{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "rootDir": "../..",
    "rootDirs": [
      ".",
      ".vibe/declarations/apps/app"
    ],
    "paths": {
      "@capacitor/core": [
        "./node_modules/@capacitor/core"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "gen/*.ts",
    "gen/*.vibe",
    "*.config.ts"
  ],
  "vibe": {
    "sidecarDir": ".vibe/declarations"
  }
}
