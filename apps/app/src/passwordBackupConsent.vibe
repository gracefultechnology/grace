// spec/app/setup.md, "Story: Approve a password backup in my browser"
import { mayResumeSavedBackupApproval, type BrowserBackupSignInReturn } from "../gen/app__setup.effect.vibe"
import { apiOrigin, browserCodeSignIn, browserSignInProviders, type CodeSignIn } from "./graceAccount.vibe"
import { webView } from "./surfacePlugin.ts"

const consentPath = "/android/passwords/approve"
const approvalPath = "/api/v1/app-auth/mobile/password-backup"
const resumeKey = "grace-password-backup-google-approval"
const legacyResumeKey = "grace-password-backup-approval"
const site = () => webView.window

function clearSavedApproval(storage: Storage) {
  storage.removeItem(resumeKey)
  storage.removeItem(legacyResumeKey)
}

schema Consent {
  clientId: string
  environment: "staging" | "production"
  redirectUri: string
  state: string
  codeChallenge: string
  codeChallengeMethod: "S256"
  purpose: "read" | "save" | "delete" | "verify"
}

export type Approval = typeof Consent.Type
const Account = Schema.Struct({ id: Schema.NonEmptyString, email: Schema.NullOr(Schema.String) })
const Session = Schema.Struct({ account: Schema.NullOr(Account) })
schema ApprovedReturn { redirectUrl: string }
export type ConsentResult = { kind: "returning"; href: string } | { kind: "signInRequired" | "accountChanged" | "unavailable" }
export type SignedInAccount = typeof Account.Type
export const noBackupSignInProviders = { google: false, email: false, sms: false }

export function backupSignInProviders() {
  return runPromise(effect {
    return browserSignInProviders() catch () => noBackupSignInProviders
  })
}

export function signInWithBackupCode(operation: CodeSignIn) {
  return runPromise(effect {
    return effect {
      try browserCodeSignIn(operation)
      if (operation.kind === "sendCode") return { kind: "sent" } as const
      const account = try accountInBrowser()
      return account ? { kind: "signedIn", account } as const : { kind: "unavailable" } as const
    } catch () => ({ kind: "unavailable" } as const)
  })
}

function valid(approval: Approval) {
  const callback = new URL(approval.redirectUri)
  return approval.clientId === "technology.graceful.grace" && callback.protocol === "https:" && callback.origin === site().location.origin && callback.pathname === "/android/auth/callback" &&
    callback.href === callback.origin + callback.pathname &&
    /^[A-Za-z0-9._~-]{43,128}$/.test(approval.state) && /^[A-Za-z0-9_-]{43}$/.test(approval.codeChallenge)
}

export function pendingPasswordApproval() {
  return runPromise(effect {
    const decoded = Effect.try(() => {
      const { location, sessionStorage, history } = site()
      if (site().top !== site()) return { present: location.pathname === consentPath, approval: null }
      const onApprovalPage = location.pathname === consentPath
      let returned: BrowserBackupSignInReturn | null = null
      if (onApprovalPage && location.search !== "") {
        if (location.hash !== "") return { present: true, approval: null }
        if (location.search === "?resume=google") returned = "ProtectedGoogleBackupReturn"
        else if (location.search === "?resume=google&authError=google_failed") returned = "FailedGoogleBackupReturn"
        else return { present: true, approval: null }
      } else if (location.pathname === "/" && location.hash === "#account") {
        returned = "LegacyGoogleAccountReturn"
      }
      const legacy = returned === null ? null : sessionStorage.getItem(legacyResumeKey)
      const current = returned === "ProtectedGoogleBackupReturn" || returned === "FailedGoogleBackupReturn"
        ? sessionStorage.getItem(resumeKey) : null
      if (returned === "LegacyGoogleAccountReturn") sessionStorage.removeItem(legacyResumeKey)
      else if (returned !== null) clearSavedApproval(sessionStorage)
      const saved = current ?? legacy
      if (!onApprovalPage && saved === null) return { present: false, approval: null }
      const pending = current !== null ? "ProtectedPendingBrowserBackupApproval" :
        legacy !== null ? "LegacyPendingBrowserBackupApproval" : "NoPendingBrowserBackupApproval"
      if (returned !== null && !mayResumeSavedBackupApproval(returned, pending)) return { present: true, approval: null }
      const raw: unknown = saved === null ? Object.fromEntries(new URLSearchParams(location.hash.slice(1))) :
        JSON.parse(saved)
      const parsed = Schema.decodeUnknownOption(Consent, { onExcessProperty: "error" })(raw)
      if (Option.isNone(parsed) || !valid(parsed.value)) return { present: true, approval: null }
      history.replaceState(null, "", consentPath)
      return { present: true, approval: parsed.value }
    }) catch () => ({ present: false, approval: null })
    if (!decoded.present || !decoded.approval) return { ...decoded, account: null }
    const account = try accountInBrowser()
    return { ...decoded, account }
  })
}

effect function accountInBrowser() {
  const response = timeout(tryPromise((signal) => site().fetch(apiOrigin + "/api/auth/session", {
    credentials: "include", cache: "no-store", signal,
  })), "10 seconds") catch () => null
  if (!response?.ok) return null
  const payload: unknown = (tryPromise(() => response.json()) catch () => null)
  const parsed = Schema.decodeUnknownOption(Session)(payload)
  return Option.isSome(parsed) ? parsed.value.account : null
}

export function signInForApproval(approval: Approval) {
  return runPromise(effect {
    return Effect.try(() => {
      clearSavedApproval(site().sessionStorage)
      site().sessionStorage.setItem(resumeKey, JSON.stringify(approval))
      site().location.assign(apiOrigin + "/api/auth/google/start?password_backup=1")
      return true
    }) catch () => false
  })
}

export function cancelPasswordApproval() {
  return runPromise(effect {
    Effect.try(() => {
      clearSavedApproval(site().sessionStorage)
      site().location.replace("/#account")
    }) catch () => undefined
  })
}

export function confirmPasswordApproval(approval: Approval, expectedOwnerId: string): Promise<ConsentResult> {
  return runPromise(effect {
    const response = timeout(tryPromise((signal) => site().fetch(apiOrigin + approvalPath, {
      method: "POST", credentials: "include", cache: "no-store", signal,
      headers: { "content-type": "application/json" }, body: JSON.stringify({ approval, expectedOwnerId }),
    })), "10 seconds") catch () => null
    if (response?.status === 401) return { kind: "signInRequired" } as const
    if (response?.status === 409) return { kind: "accountChanged" } as const
    if (!response?.ok) return { kind: "unavailable" } as const
    const input: unknown = tryPromise(() => response.json()) catch () => null
    const parsed = Schema.decodeUnknownOption(ApprovedReturn)(input)
    if (Option.isNone(parsed)) return { kind: "unavailable" } as const
    return Effect.try(() => {
      const callback = new URL(parsed.value.redirectUrl)
      if (callback.origin + callback.pathname !== approval.redirectUri || callback.username || callback.password || callback.hash ||
        callback.searchParams.get("state") !== approval.state || !/^pbackup_[A-Za-z0-9_-]{43}$/.test(callback.searchParams.get("code") ?? "") ||
        [...callback.searchParams].length !== 2) return { kind: "unavailable" } as const
      clearSavedApproval(site().sessionStorage)
      const intent = "intent://" + callback.host + callback.pathname + callback.search +
        "#Intent;scheme=https;package=technology.graceful.grace;end"
      return { kind: "returning", href: /Android/i.test(site().navigator.userAgent) ? intent : callback.href } as const
    }) catch () => ({ kind: "unavailable" } as const)
  })
}
