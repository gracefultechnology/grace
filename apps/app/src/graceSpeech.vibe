// spec/app/conversation.md, "Story: Talk or type without losing the conversation"; spec/app/conversation.md, "Talk and the wake phrase open cloud capture only for the current exchange"; spec/app/conversation.md, "Listening waits eight seconds for her first word"; spec/app/wake.md, "Story: Call Grace from any app or while the screen sleeps"
import { Machine as PasswordViews, type GuideMic } from "../gen/app.effect.vibe"
import { firstWordLimitMs, sendsHerVoice, speechFailureText, voiceDisclosure } from "../gen/app__conversation.effect.vibe"
import { Machine as Setup, type Setup as SetupState } from "../gen/app__setup.effect.vibe"
import { Machine as Workspaces, canDetectWake, listeningAfterWake, localPasswordCommands, priorWindow, privateSurfaceActive, type Workspace } from "../gen/app__workspace.effect.vibe"
import { accountPlugin } from "./accountPlugin.ts"
import { apiOrigin } from "./graceAccount.vibe"
import { gracePlayback, openMicrophone, openSpeechSocket, releaseSpeechSocket, speechFrame, type Microphone, type WakePort } from "./graceSpeechPlatform.ts"
import { Passwords } from "./passwords.vibe"
import { webView } from "./surfacePlugin.ts"

const route = "/api/v1/voice/speech"
const shared = import.meta.env.VITE_GRACE_CLOUD_PROFILE === "shared-production" || import.meta.env.VITE_GRACE_CLOUD_PROFILE === "shared-staging"
const leaseToken = shared ? /^[A-Za-z0-9_-]{43}$/ : /^[a-f0-9]{64}$/

schema Consent { consentNonce: string }
schema Lease { version: 1; sessionId: string; token: string; expiresAt: string; wsUrl: string }
schema Transcript { type: string; transcript?: string }
schema Ready { t: "ready"; version: 1; sampleRate: 16000; channels: 1 }
schema Input { t: "stt"; event: Transcript }
schema Complete { t: "complete"; id: string }
schema UnavailableEvent { t: "error"; code: string }
schema NativeWakeStatus { available: boolean; permitted: boolean }
schema NativeWakeDetection { generation: Schema.Int }

error SpeechUnavailable
type PasswordViewState = Effect.Success<ReturnType<PasswordViews.Shape["get"]>>
type InputFrame = { kind: "setup"; setup: SetupState } | { kind: "view"; view: PasswordViewState } | { kind: "state"; workspace: Workspace } | { kind: "open" } | { kind: "closed" } |
  { kind: "received"; payload: unknown } | { kind: "drained"; token: number; played: boolean }

type VoiceCapture = { microphone: Microphone; guide?: { person: string; ticket: number } }
type VoiceUse = "talk" | "command" | "wake"
export type WakeStatus = typeof NativeWakeStatus.Type & { disclosed: boolean; armed: boolean }
type WakeArm = { generation: number; interaction: number }
type WakeUpdate = { kind: "status"; value: unknown } | { kind: "detection"; value: unknown } | { kind: "reconcile" }
const wakeDisclosureKey = "grace/voice-disclosure/wake"
const wakeServiceUnavailable = "I can’t reach my voice service right now. You can still type."
const noWake: WakeStatus = { available: false, permitted: false, disclosed: false, armed: false }
export type VoiceNotice = { scope: string | undefined; use: VoiceUse }

export service SpeechActions {
  talk(acknowledged?: VoiceNotice): (VoiceNotice | undefined)!!
  readonly wakeStatus: SubscriptionRef.SubscriptionRef<WakeStatus>
  setUpWake(acknowledged?: VoiceNotice): (VoiceNotice | undefined)!!
}

export function mayOfferTalk(state: Workspace) {
  return !privateSurfaceActive(state) && state.device.surface !== "Browser" && state.device.reasoningAvailable && state.device.connectivity === "Online"
}

function outputVolume(prefs: Workspace["preferences"]["session"]) {
  return prefs.voiceOutput && !prefs.muted ? prefs.volume / 100 : 0
}

function microphoneGeneration(state: Workspace) {
  const { conversation } = state.assistant
  return sendsHerVoice(conversation) && mayOfferTalk(state) && (conversation.turn !== "Speaking" || outputVolume(state.preferences.session) > 0)
    ? conversation.generation : null
}

effect function cloudPost(path: string, body: object) {
  const response = try timeout(tryPromise((signal) => webView.window.fetch(apiOrigin + path, {
    method: "POST", credentials: "include", cache: "no-store",
    headers: { "Content-Type": "application/json" }, body: JSON.stringify(body), signal
  })), "10 seconds")
  if (!response.ok) throw new SpeechUnavailable()
  return try tryPromise(() => response.json())
}

effect function mint(native: boolean) {
  if (native) {
    if (!accountPlugin) throw new SpeechUnavailable()
    const plugin = accountPlugin
    return try Schema.decodeUnknownEffect(Lease)(try timeout(tryPromise(() => plugin.startSpeech()), "20 seconds"))
  }
  const consent = try Schema.decodeUnknownEffect(Consent)(try cloudPost(route + "/consent", {}))
  return try Schema.decodeUnknownEffect(Lease)(try cloudPost(route + "/session", { consentNonce: consent.consentNonce }))
}

function revoke(native: boolean, lease: typeof Lease.Type) {
  if (native && accountPlugin) {
    const plugin = accountPlugin
    return Effect.ignore(timeout(tryPromise(() => plugin.stopSpeech({ sessionId: lease.sessionId })), "3 seconds"))
  }
  return Effect.ignore(timeout(cloudPost(route + "/session/" + encodeURIComponent(lease.sessionId) + "/revoke", {}), "3 seconds"))
}

effect function checkedLease(native: boolean) {
  const lease = try mint(native)
  const verified = effect {
    const url = try Effect.try(() => new URL(lease.wsUrl))
    const expected = try Effect.try(() => new URL(apiOrigin || "http://localhost:8787"))
    if (url.hostname !== expected.hostname || url.port !== expected.port || url.protocol !== (expected.protocol === "https:" ? "wss:" : "ws:") ||
      url.username || url.password || url.hash || url.pathname !== route + "/ws" ||
      url.searchParams.size !== 1 || url.searchParams.get("sessionId") !== lease.sessionId ||
      !/^[a-f0-9-]{36}$/i.test(lease.sessionId) || !leaseToken.test(lease.token) ||
      !(Date.parse(lease.expiresAt) > (try Clock.currentTimeMillis))) throw new SpeechUnavailable()
    return lease
  }
  return verified catch effect (failure) => {
    try revoke(native, lease)
    throw failure
  }
}

function speechWanted(workspace: Workspace) {
  const { assistant, device } = workspace
  return !privateSurfaceActive(workspace) && assistant.presentation !== "Closed" && device.reasoningAvailable && device.connectivity === "Online" &&
    ((assistant.conversation.voice && device.surface !== "Browser") || assistant.conversation.turn === "Speaking" || assistant.conversation.turn === "Paused")
}

effect function wire(socket: WebSocket, payload: object) {
  if (socket.readyState !== 1) throw new SpeechUnavailable()
  try Effect.try(() => socket.send(JSON.stringify(payload)))
}

function phrases(text: string) {
  const rest = text.trim().slice(0, 4096)
  const chunks: string[] = []
  let at = 0
  while (at < rest.length) {
    const maximum = Math.min(rest.length, at + 900)
    const split = maximum < rest.length ? rest.lastIndexOf(" ", maximum) : maximum
    const end = split > at ? split : maximum
    const phrase = rest.slice(at, end).trim()
    if (phrase) chunks.push(phrase)
    at = end
  }
  return chunks
}

function speechEvents(socket: WebSocket) {
  return Stream.callback<InputFrame>((queue) => acquireRelease(Effect.orDie(Effect.try(() => {
    const open = () => { Queue.offerUnsafe(queue, { kind: "open" }) }
    const end = () => { Queue.offerUnsafe(queue, { kind: "closed" }) }
    const message = (event: MessageEvent) => { Queue.offerUnsafe(queue, { kind: "received", payload: event.data }) }
    socket.addEventListener("open", open)
    socket.addEventListener("error", end)
    socket.addEventListener("close", end)
    socket.addEventListener("message", message)
    if (socket.readyState === 1) open()
    if (socket.readyState > 1) end()
    return () => {
      socket.removeEventListener("open", open)
      socket.removeEventListener("error", end)
      socket.removeEventListener("close", end)
      socket.removeEventListener("message", message)
    }
  })), (remove) => Effect.ignore(Effect.try(remove))))
}

effect function speechConnection(native: boolean) {
  const lease = try acquireRelease(checkedLease(native), (leased) => revoke(native, leased))
  const socket = try acquireRelease(Effect.try(() => openSpeechSocket(lease.wsUrl)),
    (connected) => Effect.ignore(timeout(tryPromise((signal) => releaseSpeechSocket(connected, signal)), "2 seconds")))
  return { lease, socket }
}

effect function runSpeech(native: boolean, workspace: Workspaces.Shape, mic: Ref.Ref<VoiceCapture | null>, currentMic: () => VoiceCapture | null, heardIn: Ref.Ref<number | null>, readyWake: Ref.Ref<number | null>, wake?: WakePort) {
  const passwords = try Passwords
  const view = try PasswordViews
  const setup = try Setup
  const current = try workspace.get()
  const card = localPasswordCommands(current.device)
  const capture = try Ref.get(mic)
  const person = capture?.guide?.person
  let latestWorkspace = current
  let latestSetup = try setup.get()
  let latestView = try view.get()
  const passwordOwner = latestView.generation
  const ticket = latestView.guideMicEpoch
  if (card) try addFinalizer(() => Effect.ignore(view.send({ type: "finishGuideMic", ticket, result: "GuideMicIdle" }, "PasswordsHost")))
  const currentPerson = (accountState: SetupState = latestSetup, viewState: PasswordViewState = latestView) => {
    const account = accountState.graceAccount
    return native ? viewState.generation === passwordOwner :
      account.tag === "GraceSignedIn" && "web/" + account.accountId === person
  }
  const sameCard = (next: Workspace, accountState: SetupState = latestSetup, viewState: PasswordViewState = latestView) =>
    !privateSurfaceActive(next) && localPasswordCommands(next.device) === card &&
    (!card || next.device.contextVersion === current.device.contextVersion && currentPerson(accountState, viewState) && viewState.guideMicEpoch === ticket)
  if (card && (!person || capture?.guide?.ticket !== ticket || (try voiceNoticeScope(native, setup)) !== person || !currentPerson())) throw new SpeechUnavailable()
  const { lease, socket } = try speechConnection(native)
  latestWorkspace = try workspace.get()
  latestSetup = try setup.get()
  latestView = try view.get()
  if (!speechWanted(latestWorkspace) || !sameCard(latestWorkspace)) return
  const speaker = try acquireRelease(Effect.try(gracePlayback), (player) => Effect.ignore(tryPromise(() => player.close())))
  const notifications = try Queue.unbounded<InputFrame>()
  const fromSocket = speechEvents(socket)
  const frames = Stream.mergeAll([
    fromSocket, Stream.fromQueue(notifications),
    Stream.map(setup.changes, (state): InputFrame => ({ kind: "setup", setup: state })),
    Stream.map(view.changes, (state): InputFrame => ({ kind: "view", view: state })),
    Stream.map(workspace.changes, (state): InputFrame => ({ kind: "state", workspace: state })),
    Stream.filterMap(Stream.fromEventListener(webView.document, "visibilitychange"), () =>
      webView.hidden() ? Result.succeed({ kind: "closed" } as const) : Result.failVoid),
  ], { concurrency: "unbounded" })
  let ready = false
  let speaking: { token: number; receivedAudio: boolean } | null = null
  let paused = false
  let sendingGeneration: number | null = null
  let micGateOpen = false
  const refreshMicGate = () => {
    micGateOpen = sendingGeneration !== null && microphoneGeneration(latestWorkspace) === sendingGeneration && sameCard(latestWorkspace)
  }
  try addFinalizer(() => Effect.sync(() => { sendingGeneration = null; micGateOpen = false }))

  effect function stopPlayback() {
    const current = speaking
    if (current === null) return
    wire(socket, { t: "cancel", id: String(current.token) }) catch () => undefined
    speaking = null
    try Effect.try(() => speaker.cancel())
  }

  effect function update(state: Workspace) {
    if (!ready) return
    const { conversation } = state.assistant
    const prefs = state.preferences.session
    const volume = outputVolume(prefs)
    try Effect.try(() => speaker.volume(volume))
    sendingGeneration = microphoneGeneration(state)
    refreshMicGate()
    if (sendingGeneration !== null) {
      const device = try Ref.get(mic)
      if (device) try Effect.try(() => device.microphone.attach((pcm) => {
        if (micGateOpen && currentMic() === device && !webView.hidden() && socket.readyState === 1 && socket.bufferedAmount < 128_000) socket.send(pcm)
      }))
    }
    if (card) return
    if (volume === 0) {
      try stopPlayback()
      workspace.send({ type: "interact", input: { tag: "FinishSpeech", token: conversation.generation, played: false } }, "Host") catch () => undefined
      return
    }
    if (conversation.turn !== "Speaking" && conversation.turn !== "Paused") {
      try stopPlayback()
      return
    }
    const shouldPause = conversation.turn === "Paused"
    if (shouldPause !== paused || speaking === null) {
      paused = shouldPause
      try timeout(tryPromise(() => speaker.paused(paused)), "2 seconds")
    }
    if (conversation.turn !== "Speaking" || speaking?.token === conversation.generation) return
    try stopPlayback()
    const last = conversation.messages.at(-1)
    if (last?.author !== "GraceMessage") return
    const output = phrases(last.text)
    if (output.length === 0) return
    speaking = { token: conversation.generation, receivedAudio: false }
    const id = String(speaking.token)
    try wire(socket, { t: "prepare", id })
    for (const text of output) try wire(socket, { t: "tts", id, text, flush: true })
    try wire(socket, { t: "finish", id })
  }

  try Stream.runForEach(frames, effect (frame) => {
    if (frame.kind === "setup") {
      latestSetup = frame.setup
      refreshMicGate()
      if (!sameCard(latestWorkspace)) throw new SpeechUnavailable()
      return
    }
    if (frame.kind === "view") {
      latestView = frame.view
      refreshMicGate()
      if (!sameCard(latestWorkspace)) throw new SpeechUnavailable()
      return
    }
    if (frame.kind === "state") {
      latestWorkspace = frame.workspace
      refreshMicGate()
      if (!sameCard(latestWorkspace)) throw new SpeechUnavailable()
      try update(latestWorkspace)
      return
    }
    if (!sameCard(latestWorkspace)) throw new SpeechUnavailable()
    if (frame.kind === "open") {
      try wire(socket, { t: "hello", token: lease.token, errorReasons: true })
      return
    }
    if (frame.kind === "closed") throw new SpeechUnavailable()
    const state = latestWorkspace
    const volume = outputVolume(state.preferences.session)
    if (frame.kind === "drained") {
      if (speaking?.token === frame.token) {
        speaking = null
        workspace.send({ type: "interact", input: { tag: "FinishSpeech", token: frame.token, played: frame.played && volume > 0 } }, "Host") catch () => undefined
      }
      return
    }
    const { conversation } = state.assistant
    const token = conversation.generation
    const received = frame.payload
    if (received instanceof ArrayBuffer) {
      const sample = try Effect.try(() => speechFrame(received))
      const prefs = state.preferences.session
      if (speaking && token === speaking.token && sample?.context === String(token) && volume > 0) {
        try Effect.try(() => speaker.play(sample.pcm, volume, prefs.pace === "Slower" ? 0.85 : prefs.pace === "Faster" ? 1.15 : 1))
        speaking.receivedAudio = true
      }
      return
    }
    if (typeof received !== "string" || received.length > 64_000) throw new SpeechUnavailable()
    const payload: unknown = try Effect.try(() => JSON.parse(received))
    if (Option.isSome(Schema.decodeUnknownOption(UnavailableEvent)(payload))) throw new SpeechUnavailable()
    if (!ready) {
      if (Option.isNone(Schema.decodeUnknownOption(Ready)(payload))) throw new SpeechUnavailable()
      ready = true
      latestWorkspace = try workspace.get()
      refreshMicGate()
      if (wake && current.wake.phase === "AwaitingSpeech" && latestWorkspace.wake.generation === current.wake.generation) {
        if (latestWorkspace.preferences.session.volume > 0 && !latestWorkspace.preferences.session.muted)
          try Effect.ignore(timeout(tryPromise(() => wake.chime()), "1 second"))
        try Ref.set(readyWake, current.wake.generation)
      }
      latestWorkspace = try workspace.get()
      refreshMicGate()
      try update(latestWorkspace)
      return
    }
    const completed = Schema.decodeUnknownOption(Complete)(payload)
    if (Option.isSome(completed) && speaking?.token === token && completed.value.id === String(token)) {
      const played = speaking.receivedAudio
      try Effect.try(() => speaker.whenDrained(() => { Queue.offerUnsafe(notifications, { kind: "drained", token, played }) }))
      return
    }
    const recognized = Schema.decodeUnknownOption(Input)(payload)
    if (Option.isNone(recognized) || !conversation.voice || !mayOfferTalk(state)) return
    const event = recognized.value.event
    if (event.type === "start-of-turn") try Ref.set(heardIn, token)
    if (event.type === "start-of-turn" && conversation.turn === "Speaking") {
      try stopPlayback()
      workspace.send({ type: "interact", input: { tag: "BargeIn", token, spoken: 0, owner: "HumanAudio" } }, "Host") catch () => undefined
    }
    if (event.type === "end-of-turn" && card) {
      const text = event.transcript?.trim() ?? ""
      const live = try view.get()
      latestView = live
      latestSetup = try setup.get()
      latestWorkspace = try workspace.get()
      refreshMicGate()
      if (live.guideMic !== "GuideMicListening" || live.guideMicEpoch !== ticket || (try voiceNoticeScope(native, setup)) !== person || !sameCard(latestWorkspace)) return
      if (text.length > 0 && text.length <= 160 && (try Effect.uninterruptible(passwords.guideSpeech({ token, text, owner: "HumanAudio", complete: true })))) return
      view.send({ type: "finishGuideMic", ticket, result: "GuideMicNoMatch" }, "PasswordsHost") catch () => undefined
      workspace.send({ type: "interact", input: { tag: "StopVoice" } }, "Person") catch () => undefined
      return
    }
    if (event.type === "end-of-turn") {
      const text = event.transcript?.trim().slice(0, 8_192) ?? ""
      if (text) {
        try stopPlayback()
        const input = { tag: "Hear", token, text, owner: "HumanAudio" } as const
        if (try Effect.uninterruptible(passwords.guideSpeech({ ...input, complete: true }))) return
        workspace.send({ type: "interact", input }, "Host") catch () => undefined
      } else {
        workspace.send({ type: "interact", input: { tag: "UnusableSpeech", token, owner: "HumanAudio" } }, "Host") catch () => undefined
      }
    }
  })
}

effect function voiceNoticeScope(native: boolean, setup: Setup.Shape) {
  if (!native) {
    const { graceAccount } = try setup.get()
    return graceAccount.tag === "GraceSignedIn" ? "web/" + graceAccount.accountId : undefined
  }
  const plugin = accountPlugin
  if (!plugin) return undefined
  const status = tryPromise(() => plugin.status()) catch () => undefined
  return status?.kind === "signedIn" && typeof status.voiceDisclosureScope === "string" && /^[a-f0-9]{64}$/.test(status.voiceDisclosureScope)
    ? "device/" + status.voiceDisclosureScope : undefined
}

export const graceSpeech = (native: boolean, wake?: WakePort) => Layer.effect(SpeechActions, effect {
  const workspace = try Workspaces
  const setup = try Setup
  const views = try PasswordViews
  const mic = try Ref.make<VoiceCapture | null>(null)
  let activeMic: VoiceCapture | null = null
  const setMic = (next: VoiceCapture | null) => effect {
    activeMic = next
    try Ref.set(mic, next)
  }
  const heardIn = try Ref.make<number | null>(null)
  const readyWake = try Ref.make<number | null>(null)
  const opening = try Semaphore.make(1)
  const wakeStatus = try SubscriptionRef.make(noWake)
  let arm: WakeArm | undefined
  let nextArm = 0
  effect function closeMic() {
    activeMic = null
    const current = try Ref.getAndSet(mic, null)
    if (current) try Effect.ignore(tryPromise(() => current.microphone.close()))
  }
  effect function reportMic(allowed: boolean) {
    const { device } = try workspace.get()
    if (device.microphoneAllowed !== allowed) {
      const availability = { connection: device.connectivity, reasoning: device.reasoningAvailable, observation: device.observationAllowed, microphone: allowed }
      workspace.send({ type: "setAvailability", availability }, "Host") catch () => undefined
    }
  }
  effect function wakeDisclosed() {
    return (Effect.try(() => webView.window.localStorage.getItem(wakeDisclosureKey)) catch () => null) === voiceDisclosure
  }
  effect function pauseWake() {
    if (!wake || !arm) return true
    try SubscriptionRef.update(wakeStatus, (status) => ({ ...status, armed: false }))
    const stopped = (tryPromise(() => wake.configure({ generation: null })) |> Effect.as(%, true)) catch () => false
    if (stopped) arm = undefined
    return stopped
  }
  effect function pageVisible() {
    return !(Effect.try(() => webView.hidden()) catch () => true)
  }
  function eligibleWake(state: Workspace, status: WakeStatus) {
    const { device, assistant } = state
    return status.available && status.permitted && status.disclosed &&
      state.preferences.session.wakeEnabled && device.microphoneAllowed &&
      (device.readiness === "Ready" || device.readiness === "Sleeping") && state.wake.phase === "Dormant" &&
      !privateSurfaceActive(state) && !localPasswordCommands(device) && !assistant.conversation.voice &&
      assistant.conversation.turn !== "Speaking" && assistant.conversation.turn !== "Paused"
  }
  effect function syncWake() {
    if (!wake) return
    const status = try SubscriptionRef.get(wakeStatus)
    const state = try workspace.get()
    if (!eligibleWake(state, status) || !(try pageVisible()) || (try Ref.get(mic)) !== null) {
      try pauseWake()
      return
    }
    if (arm?.interaction === state.wake.generation) return
    const lease = { generation: ++nextArm, interaction: state.wake.generation }
    arm = lease
    const started = (tryPromise(() => wake.configure({ generation: lease.generation })) |> Effect.as(%, true)) catch () => false
    if (!started) arm = undefined
    try SubscriptionRef.update(wakeStatus, (current) => ({ ...current, armed: started }))
  }
  effect function updateWakeStatus(value: unknown) {
    const status = Schema.decodeUnknownEffect(NativeWakeStatus)(value) catch () => noWake
    const previous = try SubscriptionRef.get(wakeStatus)
    const disclosed = try wakeDisclosed()
    try SubscriptionRef.set(wakeStatus, { ...status, disclosed, armed: previous.armed && status.available && status.permitted })
    if (status.available || previous.available) try reportMic(status.permitted && (try pageVisible()))
  }
  effect function failWake(session: Workspace["wake"], text: string) {
    workspace.send({ type: "interact", input: { tag: "ServiceFailure", token: session.conversationVersion, text } }, "Host",
      (state) => state.wake.phase === "AwaitingSpeech" && state.wake.generation === session.generation) catch () => undefined
  }
  effect function startWake(value: unknown) {
    if (!wake) return
    const observed = Schema.decodeUnknownEffect(NativeWakeDetection)(value) catch () => undefined
    const lease = arm
    if (!observed || observed.generation !== lease?.generation) return
    arm = undefined
    try SubscriptionRef.update(wakeStatus, (status) => ({ ...status, armed: false }))
    const status = try SubscriptionRef.get(wakeStatus)
    const state = try workspace.get()
    if (lease.interaction !== state.wake.generation || !eligibleWake(state, status) || !(try pageVisible())) return
    const detection = {
      generation: lease.interaction, now: try Clock.currentTimeMillis,
      conversationVersion: listeningAfterWake(state).conversation.generation,
      prior: priorWindow(state.assistant),
      context: { enabled: true, permitted: status.permitted, available: status.available, ready: true, source: "HumanWake" as const },
    }
    if (!canDetectWake(state, detection, "Host")) return
    const accepted = workspace.send({ type: "detectWake", detection }, "Host") catch () => undefined
    if (!accepted || accepted.state.wake.phase !== "AwaitingSpeech") return
    const exchange = accepted.state.wake
    const current = try workspace.get()
    if (current.wake.generation !== exchange.generation || !current.assistant.conversation.voice || !(try pageVisible())) return
    const opened = timeout(tryPromise((signal) => openMicrophone(signal)), "4 seconds") catch () => null
    if (opened === null) {
      try failWake(exchange, speechFailureText("MicrophoneProblem"))
      return
    }
    const after = try workspace.get()
    if (after.wake.generation !== exchange.generation || !after.assistant.conversation.voice || !(try pageVisible())) {
      try Effect.ignore(tryPromise(() => opened.close()))
      return
    }
    try setMic({ microphone: opened })
  }
  if (wake !== undefined) {
    const nativeUpdates = Stream.callback<WakeUpdate>((queue) => Effect.ignore(effect {
      try tryPromise(() => wake.configure({ generation: null }))
      for (const [event, kind] of [["wakeDetected", "detection"], ["wakeStatus", "status"]] as const) {
        try acquireRelease(
          tryPromise(() => wake.addListener(event, (value) => { Queue.offerUnsafe(queue, { kind, value }) })),
          (handle) => Effect.ignore(tryPromise(() => handle.remove())),
        )
      }
      const value = tryPromise(() => wake.status()) catch () => undefined
      Queue.offerUnsafe(queue, { kind: "status", value })
    }))
    const changes = Stream.mergeAll([
      nativeUpdates,
      Stream.map(workspace.changes, (): WakeUpdate => ({ kind: "reconcile" })),
      Stream.mapEffect(Stream.fromEventListener(webView.document, "visibilitychange"), effect (): WakeUpdate!! => {
        const value = tryPromise(() => wake.status()) catch () => undefined
        return { kind: "status", value }
      }),
    ], { concurrency: "unbounded" })
    try fork.scoped Effect.ignore(Stream.runForEach(changes, (update) => opening.withPermits(1)(effect {
      if (update.kind === "status") try updateWakeStatus(update.value)
      if (update.kind === "detection") try startWake(update.value)
      try syncWake()
    })))
    try addFinalizer(() => Effect.ignore(tryPromise(() => wake.configure({ generation: null }))))
  }
  const wakeTimers = Stream.changesWith(Stream.map(workspace.changes, (state) => state.wake),
    (previous, next) => previous.phase === next.phase && previous.generation === next.generation)
  try fork.scoped Stream.runDrain(Stream.switchMap(wakeTimers, (session) => session.phase === "Dormant" ? Stream.empty : Stream.fromEffect(effect {
    const now = try Clock.currentTimeMillis
    try Effect.sleep(Math.max(0, session.deadline - now))
    const timer = { generation: session.generation, conversationVersion: session.conversationVersion, now: try Clock.currentTimeMillis }
    if (session.phase === "SilenceNotice") workspace.send({ type: "wakeReturn", timer }, "Host") catch () => undefined
    else if ((try Ref.get(readyWake)) !== session.generation) try failWake(session, wakeServiceUnavailable)
    else if ((try Ref.get(heardIn)) !== session.conversationVersion) workspace.send({ type: "wakeNoSpeech", timer }, "Host") catch () => undefined
  })))
  const changed = Stream.changes(Stream.map(workspace.changes, speechWanted))
  try fork.scoped Stream.runDrain(Stream.switchMap(changed, (wanted) => wanted ? Stream.fromEffect(effect {
    const captureReady = opening.withPermits(1)(Effect.void)
    try captureReady
    const current = try workspace.get()
    if (current.wake.phase === "AwaitingSpeech" && (try Ref.get(mic)) === null) return
    scoped(runSpeech(native, workspace, mic, () => activeMic, heardIn, readyWake, wake)) catch effect () => {
      if (current.wake.phase === "AwaitingSpeech") {
        try failWake(current.wake, wakeServiceUnavailable)
        return
      }
      const latest = try workspace.get()
      const token = latest.assistant.conversation.generation
      workspace.send({ type: "interact", input: { tag: "FinishSpeech", token, played: false } }, "Host") catch () => undefined
      try reportMic(false)
    }
  }) : Stream.empty))
  const listening = Stream.changes(Stream.map(workspace.changes, ({ assistant: { conversation }, wake }) =>
    wake.phase === "Dormant" && conversation.voice && conversation.turn === "Listening" ? conversation.generation : null))
  try fork.scoped Stream.runDrain(Stream.switchMap(listening, (token) => token === null ? Stream.empty : Stream.fromEffect(effect {
    try Effect.sleep(firstWordLimitMs)
    if ((try Ref.get(heardIn)) !== token) workspace.send({ type: "interact", input: { tag: "Silence", token } }, "Host") catch () => undefined
  })))
  const micStatus = Stream.changesWith(
    Stream.map(workspace.changes, (state) => ({ voice: state.assistant.conversation.voice, mayTalk: mayOfferTalk(state) })),
    (a, b) => a.voice === b.voice && a.mayTalk === b.mayTalk
  )
  try fork.scoped Stream.runForEach(micStatus, effect ({ voice, mayTalk }) => {
    if (voice && mayTalk) return
    if ((try Ref.get(mic)) === null) return
    try opening.withPermits(1)(effect {
      const current = try workspace.get()
      if (current.assistant.conversation.voice && mayOfferTalk(current)) return
      try closeMic()
      if (current.assistant.conversation.voice) try reportMic(false)
      try syncWake()
    })
  })
  try fork.scoped Stream.runForEach(Stream.fromEventListener(webView.document, "visibilitychange"), effect () => {
    if ((Effect.try(() => webView.hidden()) catch () => true)) {
      try closeMic()
      try reportMic(false)
    }
  })
  try addFinalizer(() => closeMic())
  effect function noticeFor(use: Exclude<VoiceUse, "wake">, scope: string | undefined, acknowledged?: VoiceNotice) {
    const key = scope === undefined ? undefined : "grace/voice-disclosure/" + scope + (use === "talk" ? "" : "/" + use)
    if (acknowledged !== undefined && (acknowledged.scope !== scope || acknowledged.use !== use)) return { scope, use }
    if (acknowledged === undefined) {
      const saved = key === undefined ? null : (Effect.try(() => webView.window.localStorage.getItem(key)) catch () => null)
      if (saved !== voiceDisclosure) return { scope, use }
    } else if (key !== undefined) {
      Effect.try(() => webView.window.localStorage.setItem(key, voiceDisclosure)) catch () => undefined
    }
    return undefined
  }
  effect function finishGuide(ticket: number | undefined, result: GuideMic) {
    if (ticket !== undefined) views.send({ type: "finishGuideMic", ticket, result }, "PasswordsHost") catch () => undefined
  }
  return {
    wakeStatus,
    setUpWake: (acknowledged) => effect {
      if (!wake || !(try SubscriptionRef.get(wakeStatus)).available) return undefined
      if (!(try wakeDisclosed())) {
        if (acknowledged?.use !== "wake") return { use: "wake", scope: undefined }
        const saved = Effect.try(() => { webView.window.localStorage.setItem(wakeDisclosureKey, voiceDisclosure); return true }) catch () => false
        if (!saved) return { use: "wake", scope: undefined }
      }
      const value = tryPromise(() => wake.requestPermission()) catch () => undefined
      try opening.withPermits(1)(effect {
        try updateWakeStatus(value)
        try syncWake()
      })
      return undefined
    },
    talk: (acknowledged) => opening.withPermits(1)(effect {
      const state = try workspace.get()
      if (!mayOfferTalk(state) || state.assistant.presentation === "Closed" || state.assistant.conversation.voice) return undefined
      const scope = try voiceNoticeScope(native, setup)
      const guide = localPasswordCommands(state.device)
      if (guide && !scope) {
        const pending = views.send({ type: "startGuideMic" }, "PasswordsPerson") catch () => undefined
        try finishGuide(pending?.guideMicEpoch, "GuideMicUnavailable")
        return undefined
      }
      const notice = try noticeFor(guide ? "command" : "talk", scope, acknowledged)
      if (notice) return notice
      const pending = guide ? (views.send({ type: "startGuideMic" }, "PasswordsPerson") catch () => undefined) : undefined
      if (guide && pending === undefined) return undefined
      if (!(try pauseWake())) return undefined
      const opened = tryPromise((signal) => openMicrophone(signal)) catch () => null
      if (opened === null) {
        try finishGuide(pending?.guideMicEpoch, "GuideMicUnavailable")
        try reportMic(false)
        try syncWake()
        return undefined
      }
      const current = try workspace.get()
      if (!mayOfferTalk(current) || localPasswordCommands(current.device) !== guide || current.device.contextVersion !== state.device.contextVersion || current.assistant.presentation === "Closed" || (try voiceNoticeScope(native, setup)) !== scope) {
        try finishGuide(pending?.guideMicEpoch, "GuideMicIdle")
        try Effect.ignore(tryPromise(() => opened.close()))
        try syncWake()
        return undefined
      }
      try reportMic(true)
      const accepted = (workspace.send({ type: "talk" }, "Person") |> Effect.as(%, true)) catch () => false
      if (accepted) try setMic({ microphone: opened, guide: scope && pending ? { person: scope, ticket: pending.guideMicEpoch } : undefined })
      else {
        try finishGuide(pending?.guideMicEpoch, "GuideMicUnavailable")
        try Effect.ignore(tryPromise(() => opened.close()))
        try syncWake()
      }
      return undefined
    })
  }
})
