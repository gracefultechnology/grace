// spec/app/conversation.md, "Story: Talk or type without losing the conversation"; spec/app/conversation.md, "Only Talk opens the microphone, so her voice is sent only in an exchange she started"; spec/app/conversation.md, "Listening waits eight seconds for her first word"
import { Machine as PasswordViews, type GuideMic } from "../gen/app.effect.vibe"
import { firstWordLimitMs, sendsHerVoice, voiceDisclosure } from "../gen/app__conversation.effect.vibe"
import { Machine as Setup } from "../gen/app__setup.effect.vibe"
import { Machine as Workspaces, localPasswordCommands, privateSurfaceActive, type Workspace } from "../gen/app__workspace.effect.vibe"
import { accountPlugin } from "./accountPlugin.ts"
import { gracePlayback, openMicrophone, openSpeechSocket, releaseSpeechSocket, speechFrame, type Microphone } from "./graceSpeechPlatform.ts"
import { Passwords } from "./passwords.vibe"
import { webView } from "./surfacePlugin.ts"

const route = "/api/v1/voice/speech"
const apiOrigin = import.meta.env.DEV ? "" : "https://api.graceforseniors.com"

schema Consent { consentNonce: string }
schema Lease { version: 1; sessionId: string; token: string; expiresAt: string; wsUrl: string }
schema Transcript { type: string; transcript?: string }
schema Ready { t: "ready"; version: 1; sampleRate: 16000; channels: 1 }
schema Input { t: "stt"; event: Transcript }
schema Complete { t: "complete"; id: string }
schema UnavailableEvent { t: "error"; code: string }

error SpeechUnavailable
type InputFrame = { kind: "context" } | { kind: "state"; workspace: Workspace } | { kind: "open" } | { kind: "closed" } |
  { kind: "received"; payload: unknown } | { kind: "drained"; token: number; played: boolean }

type VoiceCapture = { microphone: Microphone; guide?: { person: string; ticket: number } }
type VoiceUse = "talk" | "command"
export type VoiceNotice = { scope: string | undefined; use: VoiceUse }

export service SpeechActions {
  talk(acknowledged?: VoiceNotice): (VoiceNotice | undefined)!!
}

export function mayOfferTalk(state: Workspace) {
  return !privateSurfaceActive(state) && state.device.surface !== "Browser" && state.device.reasoningAvailable && state.device.connectivity === "Online"
}

function outputVolume(prefs: Workspace["preferences"]["session"]) {
  return prefs.voiceOutput && !prefs.muted ? prefs.volume / 100 : 0
}

effect function cloudPost(path: string, body: object) {
  const response = try timeout(tryPromise((signal) => webView.window.fetch(apiOrigin + path, {
    method: "POST", credentials: "include", cache: "no-store",
    headers: { "Content-Type": "application/json" }, body: JSON.stringify(body), signal
  })), "10 seconds")
  if (!response.ok) throw new SpeechUnavailable()
  return try tryPromise(() => response.json())
}

effect function mint(native: boolean) {
  if (native) {
    if (!accountPlugin) throw new SpeechUnavailable()
    const plugin = accountPlugin
    return try Schema.decodeUnknownEffect(Lease)(try timeout(tryPromise(() => plugin.startSpeech()), "20 seconds"))
  }
  const consent = try Schema.decodeUnknownEffect(Consent)(try cloudPost(route + "/consent", {}))
  return try Schema.decodeUnknownEffect(Lease)(try cloudPost(route + "/session", { consentNonce: consent.consentNonce }))
}

function revoke(native: boolean, lease: typeof Lease.Type) {
  if (native && accountPlugin) {
    const plugin = accountPlugin
    return Effect.ignore(timeout(tryPromise(() => plugin.stopSpeech({ sessionId: lease.sessionId })), "3 seconds"))
  }
  return Effect.ignore(timeout(cloudPost(route + "/session/" + encodeURIComponent(lease.sessionId) + "/revoke", {}), "3 seconds"))
}

effect function checkedLease(native: boolean) {
  const lease = try mint(native)
  const verified = effect {
    const url = try Effect.try(() => new URL(lease.wsUrl))
    const expected = try Effect.try(() => new URL(import.meta.env.DEV ? "http://localhost:8787" : apiOrigin))
    if (url.hostname !== expected.hostname || url.port !== expected.port || url.protocol !== (expected.protocol === "https:" ? "wss:" : "ws:") ||
      url.username || url.password || url.hash || url.pathname !== route + "/ws" ||
      url.searchParams.size !== 1 || url.searchParams.get("sessionId") !== lease.sessionId ||
      !/^[a-f0-9-]{36}$/i.test(lease.sessionId) || !/^[a-f0-9]{64}$/.test(lease.token) ||
      !(Date.parse(lease.expiresAt) > (try Clock.currentTimeMillis))) throw new SpeechUnavailable()
    return lease
  }
  return verified catch effect (failure) => {
    try revoke(native, lease)
    throw failure
  }
}

function speechWanted(workspace: Workspace) {
  const { assistant, device } = workspace
  return !privateSurfaceActive(workspace) && assistant.presentation !== "Closed" && device.reasoningAvailable && device.connectivity === "Online" &&
    ((assistant.conversation.voice && device.surface !== "Browser") || assistant.conversation.turn === "Speaking" || assistant.conversation.turn === "Paused")
}

effect function wire(socket: WebSocket, payload: object) {
  if (socket.readyState !== 1) throw new SpeechUnavailable()
  try Effect.try(() => socket.send(JSON.stringify(payload)))
}

function phrases(text: string) {
  const rest = text.trim().slice(0, 4096)
  const chunks: string[] = []
  let at = 0
  while (at < rest.length) {
    const maximum = Math.min(rest.length, at + 900)
    const split = maximum < rest.length ? rest.lastIndexOf(" ", maximum) : maximum
    const end = split > at ? split : maximum
    const phrase = rest.slice(at, end).trim()
    if (phrase) chunks.push(phrase)
    at = end
  }
  return chunks
}

function speechEvents(socket: WebSocket) {
  return Stream.callback<InputFrame>((queue) => acquireRelease(Effect.orDie(Effect.try(() => {
    const open = () => { Queue.offerUnsafe(queue, { kind: "open" }) }
    const end = () => { Queue.offerUnsafe(queue, { kind: "closed" }) }
    const message = (event: MessageEvent) => { Queue.offerUnsafe(queue, { kind: "received", payload: event.data }) }
    socket.addEventListener("open", open)
    socket.addEventListener("error", end)
    socket.addEventListener("close", end)
    socket.addEventListener("message", message)
    if (socket.readyState === 1) open()
    if (socket.readyState > 1) end()
    return () => {
      socket.removeEventListener("open", open)
      socket.removeEventListener("error", end)
      socket.removeEventListener("close", end)
      socket.removeEventListener("message", message)
    }
  })), (remove) => Effect.ignore(Effect.try(remove))))
}

effect function speechConnection(native: boolean) {
  const lease = try acquireRelease(checkedLease(native), (leased) => revoke(native, leased))
  const socket = try acquireRelease(Effect.try(() => openSpeechSocket(lease.wsUrl)),
    (connected) => Effect.ignore(timeout(tryPromise((signal) => releaseSpeechSocket(connected, signal)), "2 seconds")))
  return { lease, socket }
}

effect function runSpeech(native: boolean, workspace: Workspaces.Shape, mic: Ref.Ref<VoiceCapture | null>, heardIn: Ref.Ref<number | null>) {
  const passwords = try Passwords
  const view = try PasswordViews
  const setup = try Setup
  const current = try workspace.get()
  const card = localPasswordCommands(current.device)
  const capture = try Ref.get(mic)
  const person = capture?.guide?.person
  const initialView = try view.get()
  const passwordOwner = initialView.generation
  const ticket = initialView.guideMicEpoch
  if (card) try addFinalizer(() => Effect.ignore(view.send({ type: "finishGuideMic", ticket, result: "GuideMicIdle" }, "PasswordsHost")))
  const currentPerson = () => {
    const account = Effect.runSync(setup.get()).graceAccount
    return native ? Effect.runSync(view.get()).generation === passwordOwner :
      account.tag === "GraceSignedIn" && "web/" + account.accountId === person
  }
  const sameCard = (next: Workspace) => !privateSurfaceActive(next) && localPasswordCommands(next.device) === card &&
    (!card || next.device.contextVersion === current.device.contextVersion && currentPerson() && Effect.runSync(view.get()).guideMicEpoch === ticket)
  if (card && (!person || capture?.guide?.ticket !== ticket || (try voiceNoticeScope(native, setup)) !== person || !currentPerson())) throw new SpeechUnavailable()
  const { lease, socket } = try speechConnection(native)
  if (!speechWanted(try workspace.get()) || !sameCard(try workspace.get())) return
  const speaker = try acquireRelease(Effect.try(gracePlayback), (player) => Effect.ignore(tryPromise(() => player.close())))
  const notifications = try Queue.unbounded<InputFrame>()
  const fromSocket = speechEvents(socket)
  const frames = Stream.mergeAll([
    fromSocket, Stream.fromQueue(notifications),
    Stream.map(setup.changes, (): InputFrame => ({ kind: "context" })),
    Stream.map(view.changes, (): InputFrame => ({ kind: "context" })),
    Stream.map(workspace.changes, (state): InputFrame => ({ kind: "state", workspace: state })),
    Stream.filterMap(Stream.fromEventListener(webView.document, "visibilitychange"), () =>
      webView.hidden() ? Result.succeed({ kind: "closed" } as const) : Result.failVoid),
  ], { concurrency: "unbounded" })
  let ready = false
  let speaking: { token: number; receivedAudio: boolean } | null = null
  let paused = false
  let sending = false

  effect function stopPlayback() {
    if (speaking === null) return
    wire(socket, { t: "cancel", id: String(speaking.token) }) catch () => undefined
    speaking = null
    try Effect.try(() => speaker.cancel())
  }

  effect function update(state: Workspace) {
    if (!ready) return
    const { conversation } = state.assistant
    const prefs = state.preferences.session
    const volume = outputVolume(prefs)
    try Effect.try(() => speaker.volume(volume))
    sending = sendsHerVoice(conversation) && mayOfferTalk(state) && (conversation.turn !== "Speaking" || volume > 0)
    if (sending) {
      const device = try Ref.get(mic)
      if (device) try Effect.try(() => device.microphone.attach((pcm) => {
        const now = Effect.runSync(workspace.get())
        if (sending && sameCard(now) && sendsHerVoice(now.assistant.conversation) && now.assistant.conversation.generation === conversation.generation && !webView.hidden() && socket.readyState === 1 && socket.bufferedAmount < 128_000) socket.send(pcm)
      }))
    }
    if (card) return
    if (volume === 0) {
      try stopPlayback()
      workspace.send({ type: "interact", input: { tag: "FinishSpeech", token: conversation.generation, played: false } }, "Host") catch () => undefined
      return
    }
    if (conversation.turn !== "Speaking" && conversation.turn !== "Paused") {
      try stopPlayback()
      return
    }
    const shouldPause = conversation.turn === "Paused"
    if (shouldPause !== paused || speaking === null) {
      paused = shouldPause
      try timeout(tryPromise(() => speaker.paused(paused)), "2 seconds")
    }
    if (conversation.turn !== "Speaking" || speaking?.token === conversation.generation) return
    try stopPlayback()
    const last = conversation.messages.at(-1)
    if (last?.author !== "GraceMessage") return
    const output = phrases(last.text)
    if (output.length === 0) return
    speaking = { token: conversation.generation, receivedAudio: false }
    const id = String(speaking.token)
    try wire(socket, { t: "prepare", id })
    for (const text of output) try wire(socket, { t: "tts", id, text, flush: true })
    try wire(socket, { t: "finish", id })
  }

  try Stream.runForEach(frames, effect (frame) => {
    if (!sameCard(try workspace.get())) throw new SpeechUnavailable()
    if (frame.kind === "context") return
    if (frame.kind === "open") {
      try wire(socket, { t: "hello", token: lease.token, errorReasons: true })
      return
    }
    if (frame.kind === "closed") throw new SpeechUnavailable()
    if (frame.kind === "state") {
      try update(frame.workspace)
      return
    }
    const state = try workspace.get()
    const volume = outputVolume(state.preferences.session)
    if (frame.kind === "drained") {
      if (speaking?.token === frame.token) {
        speaking = null
        workspace.send({ type: "interact", input: { tag: "FinishSpeech", token: frame.token, played: frame.played && volume > 0 } }, "Host") catch () => undefined
      }
      return
    }
    const { conversation } = state.assistant
    const token = conversation.generation
    const received = frame.payload
    if (received instanceof ArrayBuffer) {
      const sample = try Effect.try(() => speechFrame(received))
      const prefs = state.preferences.session
      if (speaking && token === speaking.token && sample?.context === String(token) && volume > 0) {
        try Effect.try(() => speaker.play(sample.pcm, volume, prefs.pace === "Slower" ? 0.85 : prefs.pace === "Faster" ? 1.15 : 1))
        speaking.receivedAudio = true
      }
      return
    }
    if (typeof received !== "string" || received.length > 64_000) throw new SpeechUnavailable()
    const payload: unknown = try Effect.try(() => JSON.parse(received))
    if (Option.isSome(Schema.decodeUnknownOption(UnavailableEvent)(payload))) throw new SpeechUnavailable()
    if (!ready) {
      if (Option.isNone(Schema.decodeUnknownOption(Ready)(payload))) throw new SpeechUnavailable()
      ready = true
      try update(state)
      return
    }
    const completed = Schema.decodeUnknownOption(Complete)(payload)
    if (Option.isSome(completed) && speaking?.token === token && completed.value.id === String(token)) {
      const played = speaking.receivedAudio
      try Effect.try(() => speaker.whenDrained(() => { Queue.offerUnsafe(notifications, { kind: "drained", token, played }) }))
      return
    }
    const recognized = Schema.decodeUnknownOption(Input)(payload)
    if (Option.isNone(recognized) || !conversation.voice || !mayOfferTalk(state)) return
    const event = recognized.value.event
    if (event.type === "start-of-turn") try Ref.set(heardIn, token)
    if (event.type === "start-of-turn" && conversation.turn === "Speaking") {
      try stopPlayback()
      workspace.send({ type: "interact", input: { tag: "BargeIn", token, spoken: 0, owner: "HumanAudio" } }, "Host") catch () => undefined
    }
    if (event.type === "end-of-turn" && card) {
      const text = event.transcript?.trim() ?? ""
      const live = try view.get()
      if (live.guideMic !== "GuideMicListening" || live.guideMicEpoch !== ticket || (try voiceNoticeScope(native, setup)) !== person || !sameCard(try workspace.get())) return
      if (text.length > 0 && text.length <= 160 && (try Effect.uninterruptible(passwords.guideSpeech({ token, text, owner: "HumanAudio", complete: true })))) return
      view.send({ type: "finishGuideMic", ticket, result: "GuideMicNoMatch" }, "PasswordsHost") catch () => undefined
      workspace.send({ type: "interact", input: { tag: "StopVoice" } }, "Person") catch () => undefined
      return
    }
    if (event.type === "end-of-turn") {
      const text = event.transcript?.trim().slice(0, 8_192) ?? ""
      if (text) {
        try stopPlayback()
        const input = { tag: "Hear", token, text, owner: "HumanAudio" } as const
        if (try Effect.uninterruptible(passwords.guideSpeech({ ...input, complete: true }))) return
        workspace.send({ type: "interact", input }, "Host") catch () => undefined
      } else {
        workspace.send({ type: "interact", input: { tag: "UnusableSpeech", token, owner: "HumanAudio" } }, "Host") catch () => undefined
      }
    }
  })
}

effect function voiceNoticeScope(native: boolean, setup: Setup.Shape) {
  if (!native) {
    const { graceAccount } = try setup.get()
    return graceAccount.tag === "GraceSignedIn" ? "web/" + graceAccount.accountId : undefined
  }
  const plugin = accountPlugin
  if (!plugin) return undefined
  const status = tryPromise(() => plugin.status()) catch () => undefined
  return status?.kind === "signedIn" && typeof status.voiceDisclosureScope === "string" && /^[a-f0-9]{64}$/.test(status.voiceDisclosureScope)
    ? "device/" + status.voiceDisclosureScope : undefined
}

export const graceSpeech = (native: boolean) => Layer.effect(SpeechActions, effect {
  const workspace = try Workspaces
  const setup = try Setup
  const views = try PasswordViews
  const mic = try Ref.make<VoiceCapture | null>(null)
  const heardIn = try Ref.make<number | null>(null)
  const opening = try Semaphore.make(1)
  effect function closeMic() {
    const current = try Ref.getAndSet(mic, null)
    if (current) try Effect.ignore(tryPromise(() => current.microphone.close()))
  }
  effect function reportMic(allowed: boolean) {
    const { device } = try workspace.get()
    if (device.microphoneAllowed !== allowed) {
      const availability = { connection: device.connectivity, reasoning: device.reasoningAvailable, observation: device.observationAllowed, microphone: allowed }
      workspace.send({ type: "setAvailability", availability }, "Host") catch () => undefined
    }
  }
  const changed = Stream.changes(Stream.map(workspace.changes, speechWanted))
  try fork.scoped Stream.runDrain(Stream.switchMap(changed, (wanted) => wanted ? Stream.fromEffect(effect {
    const captureReady = opening.withPermits(1)(Effect.void)
    try captureReady
    scoped(runSpeech(native, workspace, mic, heardIn)) catch effect () => {
      const { assistant } = try workspace.get()
      const token = assistant.conversation.generation
      workspace.send({ type: "interact", input: { tag: "FinishSpeech", token, played: false } }, "Host") catch () => undefined
      try reportMic(false)
    }
  }) : Stream.empty))
  const listening = Stream.changes(Stream.map(workspace.changes, ({ assistant: { conversation } }) =>
    conversation.voice && conversation.turn === "Listening" ? conversation.generation : null))
  try fork.scoped Stream.runDrain(Stream.switchMap(listening, (token) => token === null ? Stream.empty : Stream.fromEffect(effect {
    try Effect.sleep(firstWordLimitMs)
    if ((try Ref.get(heardIn)) !== token) workspace.send({ type: "interact", input: { tag: "Silence", token } }, "Host") catch () => undefined
  })))
  try fork.scoped Stream.runForEach(workspace.changes, effect (state) => {
    if (!state.assistant.conversation.voice) try closeMic()
    else if (!mayOfferTalk(state)) {
      try closeMic()
      try reportMic(false)
    }
  })
  try fork.scoped Stream.runForEach(Stream.fromEventListener(webView.document, "visibilitychange"), effect () => {
    if ((Effect.try(() => webView.hidden()) catch () => true)) {
      try closeMic()
      try reportMic(false)
    }
  })
  try addFinalizer(() => closeMic())
  effect function noticeFor(use: VoiceUse, scope: string | undefined, acknowledged?: VoiceNotice) {
    const key = scope === undefined ? undefined : "grace/voice-disclosure/" + scope + (use === "talk" ? "" : "/" + use)
    if (acknowledged !== undefined && (acknowledged.scope !== scope || acknowledged.use !== use)) return { scope, use }
    if (acknowledged === undefined) {
      const saved = key === undefined ? null : (Effect.try(() => webView.window.localStorage.getItem(key)) catch () => null)
      if (saved !== voiceDisclosure) return { scope, use }
    } else if (key !== undefined) {
      Effect.try(() => webView.window.localStorage.setItem(key, voiceDisclosure)) catch () => undefined
    }
    return undefined
  }
  effect function finishGuide(ticket: number | undefined, result: GuideMic) {
    if (ticket !== undefined) views.send({ type: "finishGuideMic", ticket, result }, "PasswordsHost") catch () => undefined
  }
  return {
    talk: (acknowledged) => opening.withPermits(1)(effect {
      const state = try workspace.get()
      if (!mayOfferTalk(state) || state.assistant.presentation === "Closed" || state.assistant.conversation.voice) return undefined
      const scope = try voiceNoticeScope(native, setup)
      const guide = localPasswordCommands(state.device)
      if (guide && !scope) {
        const pending = views.send({ type: "startGuideMic" }, "PasswordsPerson") catch () => undefined
        try finishGuide(pending?.guideMicEpoch, "GuideMicUnavailable")
        return undefined
      }
      const notice = try noticeFor(guide ? "command" : "talk", scope, acknowledged)
      if (notice) return notice
      const pending = guide ? (views.send({ type: "startGuideMic" }, "PasswordsPerson") catch () => undefined) : undefined
      if (guide && pending === undefined) return undefined
      const opened = tryPromise((signal) => openMicrophone(signal)) catch () => null
      if (opened === null) {
        try finishGuide(pending?.guideMicEpoch, "GuideMicUnavailable")
        try reportMic(false)
        return undefined
      }
      const current = try workspace.get()
      if (!mayOfferTalk(current) || localPasswordCommands(current.device) !== guide || current.device.contextVersion !== state.device.contextVersion || current.assistant.presentation === "Closed" || (try voiceNoticeScope(native, setup)) !== scope) {
        try finishGuide(pending?.guideMicEpoch, "GuideMicIdle")
        try Effect.ignore(tryPromise(() => opened.close()))
        return undefined
      }
      try reportMic(true)
      const accepted = (workspace.send({ type: "talk" }, "Person") |> Effect.as(%, true)) catch () => false
      if (accepted) try Ref.set(mic, { microphone: opened, guide: scope && pending ? { person: scope, ticket: pending.guideMicEpoch } : undefined })
      else {
        try finishGuide(pending?.guideMicEpoch, "GuideMicUnavailable")
        try Effect.ignore(tryPromise(() => opened.close()))
      }
      return undefined
    })
  }
})
