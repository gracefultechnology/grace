// spec/app/workspace.md, "Story: Leave and return without hidden work"; spec/app/mailboxes.md, "Story: See all my email in one place"; spec/app/conversation.md, "Story: Talk or type without losing the conversation"; spec/app/surface.md, "Story: Use the website under Grace's controls"; spec/app/websiteRequests.md, "Story: Answer what a website asks of me"; spec/app/shell.md, "Story: Reach everyday tasks from Home"
// The application: the workspace as its one state, the page layer and what the page's website asks
// beside it on the host's side, the native page under both, and what the device reports.
import { machine as passwordViews } from "../gen/app.effect.vibe"
import { passwords, type PasswordVault } from "./passwords.vibe"
import type { Connectivity } from "../gen/app__shell.effect.vibe"
import { machine as setup } from "../gen/app__setup.effect.vibe"
import { applyDeviceChoices, persistPreferences, preferenceWorkspace } from "./preferences.vibe"
import { preferenceDevice, preferenceRecords, type PreferenceDevice, type PreferenceRecords } from "./preferencesPlugin.ts"
import { graceAccount } from "./graceAccount.vibe"
import { fileLibrary } from "./fileLibrary.vibe"
import { type FilesPort, filesPlugin } from "./filesPlugin.ts"
import { managedReads } from "./managedReads.vibe"
import { replyControls } from "./replyControls.vibe"
import { graceTurns } from "./graceTurns.vibe"
import { graceSpeech } from "./graceSpeech.vibe"
import type { EmbeddedAgent } from "./agentPlugin.ts"
import { machine as pageLayers } from "../gen/app__surface.effect.vibe"
import { machine as websiteRequests } from "../gen/app__websiteRequests.effect.vibe"
import { Machine as Workspaces } from "../gen/app__workspace.effect.vibe"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { accounts, signIns } from "./accounts.vibe"
import { calendarFeeds, calendars } from "./calendar.vibe"
import { agent } from "./actions.vibe"
import { browserGuide, type GuideDecision } from "./browserGuide.vibe"
import { connector, SignInPage } from "./connector.vibe"
import { type CloudLink, conversation } from "./conversation.vibe"
import { instances, reading } from "./instances.vibe"
import { mailing } from "./mail.vibe"
import { nativePage } from "./nativePage.vibe"
import { type SurfacePlugin, type WiFiPlugin, type PasswordBackupPlugin, webView } from "./surfacePlugin.ts"
import { pageHost } from "./page.vibe"
import { reminderPlugin, type ReminderPlugin } from "./accountPlugin.ts"
import { notices } from "./notices.vibe"

// spec/app/shell.md, "Startup distinguishes a usable shell from a recoverable startup failure": the interface is up.
const started = Layer.effectDiscard(effect {
  try Effect.orDie((try Workspaces).send({ type: "changeLifecycle", lifecycle: "StartupSucceeded" }, "Host"))
})

/** The OS keyboard over the interface: its height in CSS pixels, 0 while it is closed, starting with the current one. */
export service Keyboard { readonly height: Stream.Stream<number> }

/** The connection as the launcher's Wi-Fi plugin reads it, or as the WebView knows it where there is none, or the plugin fails. */
effect function readConnectivity(wifi: WiFiPlugin | undefined): Connectivity!! {
  const browser: Connectivity = (try webView.online) ? "Online" : "Offline"
  if (wifi === undefined) return browser
  const c = tryPromise(() => wifi.getConnectivity()) catch () => undefined
  return c === undefined ? browser : c.captivePortal ? "CaptivePortal" : c.online ? "Online" : "Offline"
}

/**
 * Reports the connection to the workspace when it changes. The WebView announces going online or offline,
 * and the interface coming back; a captive portal or a validation the WebView does not announce is read every half minute
 * while the interface is shown.
 */
const connectivity = (wifi: WiFiPlugin | undefined) => Layer.effectDiscard(effect {
  const workspace = try Workspaces
  const changes = Stream.mergeAll([
    Stream.filter(Stream.tick("30 seconds"), () => !webView.hidden()),
    Stream.fromEventListener(webView.window, "online"),
    Stream.fromEventListener(webView.window, "offline"),
    Stream.fromEventListener(webView.document, "visibilitychange")
  ], { concurrency: "unbounded" })
  // spec/app/workspace.md, "Story: Leave and return without hidden work": the host reports availability; what else it holds is unchanged.
  try fork.scoped Stream.runForEach(Stream.mapEffect(changes, () => readConnectivity(wifi)), effect (connection) => {
    const { device } = try workspace.get()
    const availability = { connection, reasoning: device.reasoningAvailable, microphone: device.microphoneAllowed, observation: device.observationAllowed }
    if (connection !== device.connectivity) workspace.send({ type: "setAvailability", availability }, "Host") catch () => undefined
  })
})

/** The keyboard as the native page plugin reports it; where there is none the browser resizes the interface itself. */
const keyboard = (plugin: SurfacePlugin | undefined) => Layer.effect(Keyboard, effect {
  const height = try SubscriptionRef.make(0)
  if (plugin !== undefined) try fork.scoped Stream.runForEach(
    Stream.callback<number>((queue) => acquireRelease(
      Effect.orDie(tryPromise(() => plugin.addListener("keyboardChanged", (e) => { Queue.offerUnsafe(queue, e.visible ? e.height : 0) }))),
      (handle) => promise(() => handle.remove())
    )),
    (h) => SubscriptionRef.set(height, h)
  )
  return { height: SubscriptionRef.changes(height) }
})

const signInPage = Layer.sync(SignInPage, () => {
  const opened = new Map<string, Window | null>()
  return {
    open: (url: string) => sync(() => {
      const page = webView.window.open(url, "_blank")
      if (page !== null) page.opener = null
      opened.set(url, page)
    }),
    close: (url: string) => sync(() => { opened.get(url)?.close(); opened.delete(url) })
  }
})

const untraced = Layer.succeed(HttpClient.TracerPropagationEnabled, false)

const linked = (cloud: CloudLink) => Layer.mergeAll(Layer.provide(connector(cloud), signInPage), untraced)

const services = (cloud: CloudLink | undefined) => cloud === undefined
  ? Layer.mergeAll(signIns, calendars(false))
  : Layer.provide(Layer.mergeAll(reading, signIns, mailing, Layer.provideMerge(calendarFeeds, calendars(true))), linked(cloud))

type TabletPlatform = { native: boolean; agent?: EmbeddedAgent; files?: FilesPort; preferences?: PreferenceRecords; display?: PreferenceDevice; reminders?: ReminderPlugin; vault?: PasswordVault; backup?: PasswordBackupPlugin }

export function application(plugin: SurfacePlugin | undefined, wifi?: WiFiPlugin, host: (TabletPlatform | CloudLink) & { guideDecision?: GuideDecision } = { native: false }, vault?: PasswordVault, backup?: PasswordBackupPlugin) {
  const platform = "native" in host ? host : { native: false }
  const cloud = "url" in host ? host : undefined
  const kept = Layer.orDie(Layer.provide(Layer.provideMerge(instances, accounts), KeyValueStore.layerStorage(() => webView.window.localStorage)))
  const records = platform.native ? platform.preferences ?? preferenceRecords : undefined
  const machines = Layer.mergeAll(preferenceWorkspace(records), pageLayers(), websiteRequests(), nativePage(plugin), kept, setup(), passwordViews())
  const guidance = Layer.provideMerge(agent, services(cloud))
  const voice = Layer.provideMerge(graceSpeech(platform.native), passwords(platform.vault ?? vault, platform.backup ?? backup))
  const shell = Layer.provideMerge(Layer.mergeAll(pageHost, started, persistPreferences(records), connectivity(wifi), keyboard(plugin), notices(wifi, platform.native ? platform.reminders ?? reminderPlugin : undefined), guidance, browserGuide(platform.native, host.guideDecision), graceAccount(platform.native), voice), machines)
  const managed = Layer.provideMerge(Layer.mergeAll(managedReads(platform.native), applyDeviceChoices(platform.native ? platform.display ?? preferenceDevice : undefined), fileLibrary(platform.native ? platform.files ?? filesPlugin : undefined)), shell)
  const controlled = Layer.provideMerge(Layer.mergeAll(replyControls(platform.native), conversation(cloud)), managed)
  return Layer.provideMerge(graceTurns(platform.agent), controlled)
}
