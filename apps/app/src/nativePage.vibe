// spec/app/surface.md, "Story: Use the website under Grace's controls"; spec/app/websiteRequests.md, "Story: Answer what a website asks of me"; spec/app/websiteRequests.md, "Allow asks Android, and a website gets a device only when Android allows it too"; spec/app/websiteRequests.md, "When the app or browser I confirmed does not open, I am told"; spec/app/websiteRequests.md, "Website sign-ins last across tabs and Close browser until browsing data is cleared after one confirmation"; spec/app/browser.md, "Load results must match the tab and request that produced them"; spec/app/websiteRequests.md, "A website's request is held only for the current page of the tab I am looking at"; spec/app/websiteRequests.md, "Looking away from a page ends what it asked, and never accepts it"
import type { Rect } from "../gen/app__surface.effect.vibe"
import type { Load } from "../gen/app__browser.effect.vibe"
import type { AndroidOutcome, Answer, AppHandoff, Ask, MessageKind } from "../gen/app__websiteRequests.effect.vibe"
import { type SurfacePlugin, identity } from "./surfacePlugin.ts"
import {
  DialogRequested, DownloadFinished, DownloadRequested, ExternalLinkRequested, FileChooserRequested, IdentityProviderRequested,
  NavigationChanged, PageStarted, type PageId, PermissionClosed, PurgeResult, RequestKey, SitePermissionAnswer, SitePermissionRequested,
  SitePermissionWithdrawn, SurfaceCrashed, type Url
} from "./nativePage.schema.ts"
import { webPage } from "./webPage.vibe"

export error PageFailed { cause: unknown }

export data PageEvent {
  Changed { id: PageId; url: Url | undefined; loading: boolean; result: Load }
  Crashed { id: PageId }
  Started { id: PageId; url: Url | undefined }
  Asked { id: PageId; key: RequestKey; ask: Ask; topFrame: boolean; said: string }
  Downloaded { id: PageId; key: RequestKey; saved: boolean }
  Withdrawn { id: PageId; key: RequestKey }
}

export type Corners = { topLeft: number; topRight: number; bottomRight: number; bottomLeft: number }

export type Reply = { id: PageId; key: RequestKey; ask: Ask; answer: Answer; text: string }

export service NativePage {
  claim(): void!PageFailed
  create(id: PageId, url: string): void!PageFailed
  place(id: PageId, page: Rect, corners: Corners): void!PageFailed
  route(id: PageId, rects: Rect[]): void!PageFailed
  present(id: PageId | null): void!PageFailed
  pause(id: PageId): void!PageFailed
  resume(id: PageId): void!PageFailed
  navigate(id: PageId, url: string): void!PageFailed
  back(id: PageId): void!PageFailed
  forward(id: PageId): void!PageFailed
  reload(id: PageId): void!PageFailed
  destroy(id: PageId): void!PageFailed
  reply(reply: Reply): void!PageFailed
  grant(id: PageId, key: RequestKey): AndroidOutcome!PageFailed
  purge(): boolean!PageFailed
  readonly events: Stream.Stream<PageEvent>
}

const messages: Record<typeof DialogRequested.Type["kind"], MessageKind> = { alert: "AlertMessage", confirm: "ConfirmMessage", prompt: "PromptMessage", beforeunload: "LeavePageMessage" }
const handoffs: Record<typeof ExternalLinkRequested.Type["handoff"], AppHandoff> = { "send-to": "SendToApp", dial: "DialApp", view: "ViewInApp", refuse: "RefusedLink" }
const providers: Record<typeof IdentityProviderRequested.Type["provider"], string> = { google: "Google", facebook: "Facebook" }
const outcomes: Record<typeof SitePermissionAnswer.Type["outcome"], AndroidOutcome> = { granted: "AndroidGranted", denied: "AndroidEnded", "android-refused": "AndroidRefused", ended: "AndroidEnded" }

type Surface = { owner: string; session: string; epoch: number; id: PageId }

function answerPage(p: SurfacePlugin, surface: Surface, { key, ask, answer, text }: Reply): Promise<unknown> {
  switch (ask.tag) {
    case "WebsiteMessage": return p.answerDialog({ ...surface, dialogId: key, accept: answer === "Ok", text })
    case "FileChoice": {
      const open = answer === "OpenFilePicker"
      return p.answerFileChooser({ ...surface, requestId: key, open }).catch((cause: unknown) =>
        open ? p.answerFileChooser({ ...surface, requestId: key, open: false }).then(() => Promise.reject(cause), (closing: unknown) => Promise.reject(new AggregateError([cause, closing]))) : Promise.reject(cause))
    }
    case "SitePermission": return key === "" ? Promise.resolve() : p.answerSitePermission({ ...surface, requestId: key, grant: answer === "Allowed" })
    case "DownloadOffer": return answer === "SaveDownload" ? p.saveDownload({ ...surface, requestId: key }) : Promise.resolve()
    case "OtherApp": return answer === "OpenOtherApp" ? p.openExternalLink({ ...surface, url: key }) : Promise.resolve()
    case "BlockedSignIn": return answer === "OpenSystemBrowser" ? p.openIdentityProvider({ ...surface, requestId: key }) : Promise.resolve()
  }
}

const profileKey = "grace"

type Owned = { owner?: string | null; session?: string | null; epoch?: number | null }
const mine = (e: Owned) => e.owner === identity.owner && e.session === identity.session && e.epoch === identity.epoch

type Heard = Result.Result<PageEvent | undefined, Schema.SchemaError>

function hear<S extends Schema.ConstraintDecoder<Owned>>(queue: Queue.Queue<Heard, Cause.Done>, schema: S, read: (event: S["Type"]) => PageEvent | undefined) {
  const decode = Schema.decodeUnknownResult(schema)
  return (raw: unknown) => {
    const heard = decode(raw)
    Queue.offerUnsafe(queue, Result.isSuccess(heard) && !mine(heard.success) ? Result.succeed(undefined) : Result.map(heard, read))
  }
}

effect function reported(heard: Heard) {
  if (Result.isFailure(heard)) try logWarning("native page event", heard.failure)
  return Result.isSuccess(heard) ? heard.success : undefined
}

function surfaceEvents(plugin: SurfacePlugin) {
  const heard = Stream.callback<Heard>((queue) => acquireRelease(
    Effect.orDie(tryPromise(() => Promise.all([
      plugin.addListener("navigationChanged", hear(queue, NavigationChanged, (e) => e.exists === false ? undefined : PageEvent.Changed({
        id: e.id, url: e.currentUrl ?? undefined, loading: e.progress !== undefined && e.progress < 100,
        result: e.securityBlocked === true ? "SecurityBlocked" : e.pageError ? "LoadFailed" : "Loaded"
      }))),
      plugin.addListener("surfaceCrashed", hear(queue, SurfaceCrashed, (e) => PageEvent.Crashed({ id: e.id }))),
      plugin.addListener("pageStarted", hear(queue, PageStarted, (e) => PageEvent.Started({ id: e.id, url: e.url }))),
      plugin.addListener("dialogRequested", hear(queue, DialogRequested, (e) =>
        PageEvent.Asked({ id: e.id, key: e.dialogId, ask: { tag: "WebsiteMessage", dialog: messages[e.kind] }, topFrame: true, said: e.message }))),
      plugin.addListener("downloadRequested", hear(queue, DownloadRequested, (e) =>
        PageEvent.Asked({ id: e.id, key: e.requestId, ask: { tag: "DownloadOffer", fileName: e.fileName }, topFrame: true, said: "" }))),
      plugin.addListener("downloadFinished", hear(queue, DownloadFinished, (e) => PageEvent.Downloaded({ id: e.id, key: e.requestId, saved: e.status === "saved" }))),
      plugin.addListener("fileChooserRequested", hear(queue, FileChooserRequested, (e) =>
        PageEvent.Asked({ id: e.id, key: e.requestId, ask: { tag: "FileChoice" }, topFrame: true, said: "" }))),
      plugin.addListener("sitePermissionRequested", hear(queue, SitePermissionRequested, (e) => PageEvent.Asked({
        id: e.id, key: e.requestId ?? RequestKey.make(""), topFrame: e.topFrame, said: "",
        ask: { tag: "SitePermission", origin: e.origin ?? "", kinds: { camera: e.kinds.includes("camera"), microphone: e.kinds.includes("microphone"), location: e.kinds.includes("location") } }
      }))),
      plugin.addListener("sitePermissionWithdrawn", hear(queue, SitePermissionWithdrawn, (e) => PageEvent.Withdrawn({ id: e.id, key: e.requestId }))),
      plugin.addListener("externalLinkRequested", hear(queue, ExternalLinkRequested, (e) =>
        PageEvent.Asked({ id: e.id, key: RequestKey.make(e.url), ask: { tag: "OtherApp", handoff: handoffs[e.handoff] }, topFrame: true, said: e.url }))),
      plugin.addListener("identityProviderRequested", hear(queue, IdentityProviderRequested, (e) =>
        PageEvent.Asked({ id: e.id, key: e.requestId, ask: { tag: "BlockedSignIn", provider: providers[e.provider] }, topFrame: true, said: "" })))
    ]))),
    (handles) => promise(() => Promise.all(handles.map((h) => h.remove())))
  ))
  return Stream.filter(Stream.mapEffect(heard, reported), (event) => event !== undefined)
}

function devicePage(plugin: SurfacePlugin) {
  const call = (run: (p: SurfacePlugin) => Promise<unknown>) => Effect.asVoid(tryPromise({ try: () => run(plugin), catch: (cause) => new PageFailed({ cause }) }))
  const ask = <S extends Schema.ConstraintDecoder<unknown>>(schema: S, run: (p: SurfacePlugin) => Promise<unknown>) =>
    Effect.flatMap(tryPromise({ try: () => run(plugin), catch: (cause) => new PageFailed({ cause }) }),
      (answer) => Effect.mapError(Schema.decodeUnknownEffect(schema)(answer), (cause) => new PageFailed({ cause })))
  const own = (id: PageId) => ({ ...identity, id })
  return Layer.succeed(NativePage, {
    claim: () => call((p) => p.reconcileOwner({ ...identity, desiredIds: [] })),
    create: (id, url) => call((p) => p.createSurface({ ...own(id), url, process: "isolated", storage: "isolated", profileKey, layer: "below-host", answersRequests: true })),
    place: (id, page, corners) => call((p) => p.setBounds({ ...own(id), ...page, outerClip: { ...page, cornerRadii: corners } })),
    route: (id, rects) => call((p) => p.setOcclusionRects({ ...own(id), rects: rects.map((r) => ({ ...r, cornerRadius: 0 })) })),
    present: (id) => call((p) => p.presentSurface({ ...identity, id })),
    pause: (id) => call((p) => p.pauseSurface(own(id))),
    resume: (id) => call((p) => p.resumeSurface(own(id))),
    navigate: (id, url) => call((p) => p.navigate({ ...own(id), url })),
    back: (id) => call((p) => p.goBack(own(id))),
    forward: (id) => call((p) => p.goForward(own(id))),
    reload: (id) => call((p) => p.reloadSurface(own(id))),
    destroy: (id) => call((p) => p.destroySurface(own(id))),
    reply: (reply) => call((p) => answerPage(p, own(reply.id), reply)),
    grant: (id, key) => Effect.catch(
      Effect.map(ask(SitePermissionAnswer, (p) => p.answerSitePermission({ ...own(id), requestId: key, grant: true })), (r) => outcomes[r.outcome]),
      (failed) => Schema.is(PermissionClosed)(failed.cause) ? Effect.succeed(outcomes.ended) : Effect.fail(failed)),
    purge: () => Effect.map(ask(PurgeResult, (p) => p.purgeProfiles({ ...identity, profileKey })), (r) => r.clean === true),
    events: surfaceEvents(plugin)
  })
}

export function nativePage(plugin: SurfacePlugin | undefined) {
  return plugin === undefined ? webPage() : devicePage(plugin)
}
