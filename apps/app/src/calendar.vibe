// spec/app/calendarView.md, "Story: Browse my calendar and open an exact occurrence"; spec/app/calendarView.md, "An account's calendar is bound by its store before Calendar opens"; spec/app/calendarView.md, "Navigation clears detail and only accepts a validated calendar interval"; spec/app/calendarView.md, "Saving a repeating event updates its whole series through the same form"; spec/app/calendarView.md, "Closing Calendar cancels unsubmitted edits and retains submitted writes"; spec/app/calendarView.md, "Story: Delete this occurrence or the whole repeating event"; spec/app/calendar.md, "Time only makes an enabled reminder eligible and never executes the task"; spec/app/calendars.md, "Story: See every calendar together and know where each appointment lives"; spec/app/calendars.md, "Her yes is applied as the exact question she was asked"; spec/app/calendars.md, "Grace is told what changed in a calendar, and being told authorizes nothing"; spec/app/proposal.md, "An agreed question stays exactly as agreed until the calendar answers"; spec/app/calendarView.md, "A shown reminder appears on Home or as a toast and See details opens its event"; spec/app/notices.md, "One toast shows at a time and the others wait their turn in order"; spec/app/notices.md, "A due reminder is a banner on Home, a toast elsewhere and an Android notification in the background"; spec/app/notices.md, "Only the calendar dismisses a reminder, and then it is gone everywhere"
import { Machine as Accounts, type Account, type Accounts as Registry } from "../gen/app__accounts.effect.vibe"
import { approveSave, create, initial as noEntry, save, type Calendar, type EntryDetails } from "../gen/app__calendar.effect.vibe"
import { type CalendarSource, type CalRow, changeOf, confirmationOf, deletionOf, shownReminders, told, type CalendarTold } from "../gen/app__calendars.effect.vibe"
import { type Machine as CalendarMachine, enabled, entryAt, hasEditing, step, seriesAt, type CalendarView, type DeleteScope, type Event as CalendarEvent, type Navigation, type NavigationReport, type SeriesReceipt, type ViewMode, type ViewWindow } from "../gen/app__calendarView.effect.vibe"
import { type Days, moved, planned, repetitions as repeatsOf, shifted, shown } from "./schedule.ts"
import { Machine as Proposal, targetOf, type Ask, type Pending } from "../gen/app__proposal.effect.vibe"
import { guidedSavePending, Machine as Workspaces, type GuidedCalendarApproval, type Workspace } from "../gen/app__workspace.effect.vibe"
import type { Watched } from "./accounts.vibe"
import { Connector, type DeletionReceipt, type Published, type StoreReceipt } from "./connector.vibe"
import { Instances, tablet, watchEach } from "./instances.vibe"
import { messageRecord } from "../gen/app__email.effect.vibe"
import { Machine as Notices } from "../gen/app__notices.effect.vibe"
import { NoticeHost } from "./notices.vibe"

export const day = 24 * 60 * 60 * 1000
export const hour = 60 * 60 * 1000
export const horizon = 60 * day

const utc = (n: number) => new Date(n * day)

export function dayOf(at: number) {
  const d = new Date(at)
  return Math.round(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / day)
}

export function instant(n: number, minutes: number) {
  const d = utc(n)
  return new Date(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), 0, minutes).getTime()
}

export const midnight = (n: number) => instant(n, 0)

const minutesOf = (at: number) => {
  const d = new Date(at)
  return d.getHours() * 60 + d.getMinutes()
}

export function shownDays(mode: ViewMode, anchor: number) {
  const { first, until } = shown(mode, anchor)
  return Array.from({ length: until - first }, (_, i) => first + i)
}

function windowOf(days: Days): ViewWindow {
  const { first, until } = shown(days.mode, days.anchorDay)
  return { ...days, fromTime: midnight(first), untilTime: midnight(until) }
}

function exact(w: ViewWindow) {
  const { first, until } = shown(w.mode, w.anchorDay)
  return w.fromTime < w.untilTime && dayOf(w.fromTime) === first && dayOf(w.untilTime) === until
}

export function navigation(w: ViewWindow, kind: Navigation, chosen: number): NavigationReport {
  const window = windowOf(moved(w, kind, chosen))
  return { window, kind, verified: exact(window) }
}

const opened = (w: ViewWindow) => w.untilTime - w.fromTime >= day

function reach(w: ViewWindow, today: number) {
  const shownNow = opened(w) ? w : windowOf({ mode: "WeekView", anchorDay: today, selectedDay: today })
  return { fromTime: Math.min(shownNow.fromTime, midnight(today)), untilTime: Math.max(shownNow.untilTime, midnight(shownNow.selectedDay + 15), midnight(today + horizon / day)) }
}

type Reach = ReturnType<typeof reach>
const within = (next: Reach, fetched: Reach) => next.fromTime >= fetched.fromTime && next.untilTime <= fetched.untilTime

const zone = () => Intl.DateTimeFormat().resolvedOptions().timeZone

function placeIn(seriesId: string, id: string) {
  if (id === seriesId) return 0
  const n = id.startsWith(`${seriesId}@`) ? Number(id.slice(seriesId.length + 1)) : Number.NaN
  return Number.isInteger(n) ? n : undefined
}

const generated = (seriesId: string, id: string) => seriesId !== "" && id.startsWith(`${seriesId}@`)

const provided = (v: CalendarView): CalendarView => ({ ...v, entries: v.entries.filter((m) => !generated(m.committed.seriesId, m.identity.occurrenceId)) })

export const anchorOf = (v: CalendarView, seriesId: string) =>
  v.entries.find((m) => m.hasSaved && m.phase === "Saved" && m.committed.seriesId === seriesId && m.committed.startAt === seriesAt(v, seriesId).details.startAt)

function placeOf(v: CalendarView, definition: EntryDetails) {
  const member = v.entries.find((m) => m.hasSaved && m.committed.seriesId === definition.seriesId && m.committed.startAt === definition.startAt)
  return member === undefined ? undefined : placeIn(definition.seriesId, member.identity.occurrenceId)
}

const draftPlace = (v: CalendarView, c: Calendar) => placeIn(c.draft.seriesId, c.identity.occurrenceId) ?? placeOf(v, seriesAt(v, c.draft.seriesId).details) ?? 0

const single = (c: Calendar) => c.committed.seriesId === "" && c.draft.seriesId === "" && c.draft.recurrence === "Once"

const repeatedOn = (d: EntryDetails, n: number) => {
  const startAt = instant(n, minutesOf(d.startAt))
  return { startAt, endAt: startAt + d.endAt - d.startAt }
}

function schedulesOf(v: CalendarView, c: Calendar) {
  const d = c.draft
  const members = v.entries.filter((m) => m.phase !== "Deleted" && (m.identity.occurrenceId === v.selectedId || (m.hasSaved && m.committed.seriesId === d.seriesId)))
  const plan = planned(members.map(({ identity: { occurrenceId: id } }) => {
    const place = placeIn(d.seriesId, id)
    return { id, placed: place !== undefined, place: place ?? 0 }
  }), c.identity.occurrenceId, draftPlace(v, c), d.recurrence, dayOf(d.startAt))
  const schedules = plan.map(({ id, include, moved: placed, day: n }, i) => {
    const { committed } = members[i]
    if (id === c.identity.occurrenceId) return { id, include, startAt: d.startAt, endAt: d.endAt }
    if (!include) return { id, include, startAt: committed.startAt, endAt: committed.endAt }
    return { id, include, ...placed ? repeatedOn(d, n) : { startAt: committed.startAt, endAt: committed.startAt + d.endAt - d.startAt } }
  })
  const verified = schedules.every((s, i) => !s.include || (s.endAt > s.startAt && (!plan[i].moved || dayOf(s.startAt) === plan[i].day)))
  return { schedules, verified }
}

const seriesReceipt = (v: CalendarView, c: Calendar, receipt: StoreReceipt): SeriesReceipt => ({
  occurrenceId: c.identity.occurrenceId, revision: receipt.revision, definitionVersion: seriesAt(v, c.draft.seriesId).version,
  ...schedulesOf(v, c), persisted: receipt.succeeded
})

function rootOf(v: CalendarView, seriesId: string) {
  const roots = v.entries.filter((m) => m.hasSaved && m.committed.seriesId === seriesId && !generated(seriesId, m.identity.occurrenceId)).map((m) => m.identity.occurrenceId)
  return roots.find((id) => id !== seriesId) ?? roots[0] ?? seriesId
}

const kept = (v: CalendarView, id: string) => v.entries.find((m) => m.identity.occurrenceId === id) ?? entryAt(v, id)

const idAt = (v: CalendarView, seriesId: string, place: number) => place === 0 ? rootOf(v, seriesId) : `${seriesId}@${place}`

const gone = (v: CalendarView, id: string) => v.cancelledIds.includes(id) || v.entries.some((m) => m.identity.occurrenceId === id && m.phase === "Deleted")

function liveFrom(v: CalendarView, seriesId: string, from: number) {
  const { details: d } = seriesAt(v, seriesId)
  const until = dayOf(d.startAt) + 31 * (from + v.entries.length + v.cancelledIds.length + 24)
  return repeatsOf(d.recurrence, dayOf(d.startAt), placeOf(v, d) ?? 0, until).find(({ place }) => place >= from && !gone(v, idAt(v, seriesId, place)))
}

function written(v: CalendarView, c: Calendar): Calendar {
  const d = c.draft
  if (!generated(d.seriesId, c.identity.occurrenceId)) return c
  const first = shifted(d.recurrence, dayOf(d.startAt), (liveFrom(v, d.seriesId, 0)?.place ?? 0) - draftPlace(v, c))
  return { ...c, identity: { ...c.identity, occurrenceId: rootOf(v, d.seriesId) }, hasSaved: true, draft: { ...d, ...first < 0 ? {} : repeatedOn(d, first) } }
}

type Removal =
  | { readonly tag: "Remove"; readonly id: string }
  | { readonly tag: "Forget" }
  | { readonly tag: "Move"; readonly entry: Calendar }
  | { readonly tag: "Unable" }

function removal(v: CalendarView): Removal {
  const chosen = entryAt(v, v.selectedId).committed
  const { seriesId, recurrence } = chosen
  if (v.scope === "EntireSeries" || recurrence === "Once") return { tag: "Remove", id: generated(seriesId, v.selectedId) ? rootOf(v, seriesId) : v.selectedId }
  const place = placeIn(seriesId, v.selectedId) ?? 0
  if (place !== liveFrom(v, seriesId, 0)?.place) return { tag: "Forget" }
  const next = liveFrom(v, seriesId, place + 1)
  if (next === undefined) return { tag: "Unable" }
  const root = kept(v, rootOf(v, seriesId))
  return { tag: "Move", entry: { ...root, hasSaved: true, draft: { ...chosen, ...repeatedOn(chosen, next.day) } } }
}

const savedEntry = (v: CalendarView, id: string, details: EntryDetails) => save(approveSave(create(noEntry, {
  owner: v.owner, calendarId: v.calendarId, occurrenceId: id, sourceRef: "", kind: "Appointment", billRef: "", billOrigin: "", billAccount: ""
}, details, "CalendarUser"), 1, "CalendarUser"), 1, true, "CalendarStore")

function repetitions(v: CalendarView, span: Reach): Published[] {
  return v.series.flatMap(({ version, details: d }) => {
    if (d.recurrence === "Once" || v.deletedSeries.includes(d.seriesId)) return []
    return repeatsOf(d.recurrence, dayOf(d.startAt), placeOf(v, d) ?? 0, dayOf(span.untilTime) + 1).flatMap(({ place, day: n }) => {
      const id = place === 0 ? d.seriesId : `${d.seriesId}@${place}`
      const { startAt, endAt } = repeatedOn(d, n)
      if (startAt >= span.untilTime || endAt <= span.fromTime || v.cancelledIds.includes(id) || v.entries.some((m) => m.identity.occurrenceId === id)) return []
      return [{ incoming: savedEntry(v, id, { ...d, startAt, endAt, important: false }), seriesVersion: version, scheduleVerified: dayOf(startAt) === n && endAt > startAt }]
    })
  })
}

type Store = {
  readonly write: (entry: Calendar, view: CalendarView) => StoreReceipt!!
  readonly remove: (identity: Calendar["identity"], scope: DeleteScope) => DeletionReceipt!!
}

const device: Store = {
  write: (entry) => Effect.succeed({ revision: entry.revision, succeeded: true, published: [] }),
  remove: (identity) => Effect.succeed({ succeeded: true, evidence: `tablet:${identity.occurrenceId}` })
}

export type CalendarReport = { readonly told: CalendarTold } | { readonly refused: Ask }
export type CalendarNote = { readonly id: number; readonly row: string }
export type Opening = "Occurrence" | "Reminder"

export service CalendarNews {
  readonly reports: Stream.Stream<CalendarReport>
  publish(report: CalendarReport): void!!
  verifySaved(key: number, view: CalendarView, occurrence: string, expected: EntryDetails): boolean!!
  readonly notes: Watched<CalendarNote | undefined>
  open(key: number, id: string, how: Opening): void!!
  edit(key: number, id: string): void!!
  add(day: number): void!!
}

const noteFor = "2600 millis"

export const say = (n: number, options: Intl.DateTimeFormatOptions) => new Date(midnight(n)).toLocaleDateString("en-US", options)
export const longDate = (n: number) => say(n, { weekday: "long", month: "long", day: "numeric" })

export function timeLabel(at: number) {
  const t = new Date(at)
  const h = t.getHours()
  const m = t.getMinutes()
  return `${h % 12 || 12}${m ? `:${String(m).padStart(2, "0")}` : ""} ${h < 12 ? "am" : "pm"}`
}

export function relative(n: number, today: number) {
  const ahead = n - today
  return ahead === 0 ? "Today" : ahead === 1 ? "Tomorrow" : ahead > 1 && ahead < 7 ? say(n, { weekday: "long" }) : longDate(n)
}

const reminderSubject = (d: EntryDetails, now: number) => `${d.title} ${relative(dayOf(d.startAt), dayOf(now)).toLowerCase()} at ${timeLabel(d.startAt)}`

export const opening = (v: CalendarView): CalendarEvent => ({ type: "openCalendar", owner: v.owner, calendarId: v.calendarId, timezone: v.timezone })

const opener = (how: Opening, id: string) => (v: CalendarView): CalendarEvent =>
  how === "Reminder" ? { type: "openReminder", id, owner: v.owner, calendarId: v.calendarId, timezone: v.timezone } : { type: "openOccurrence", id }

export type Planned = { readonly onLead: boolean; readonly event: CalendarEvent }

export function openingPlan(lead: CalendarView, box: CalendarView, same: boolean, day: number, how: Opening, id: string): readonly Planned[] | undefined {
  let leadNow = lead
  let boxNow = same ? lead : box
  const steps: Planned[] = []
  const take = (onLead: boolean, eventOf: (v: CalendarView) => CalendarEvent) => {
    const v = onLead ? leadNow : boxNow
    const event = eventOf(v)
    if (!enabled(v, event, "ViewUser")) return false
    const next = step(v, event, "ViewUser")
    if (onLead || same) leadNow = next
    if (!onLead || same) boxNow = next
    steps.push({ onLead, event })
    return true
  }
  if (!lead.opened && !take(true, opening)) return undefined
  if (!same && !box.opened && !take(false, opening)) return undefined
  if (!take(true, (v) => ({ type: "navigate", report: navigation(v.window, "SelectDay", day) }))) return undefined
  return take(false, opener(how, id)) ? steps : undefined
}

export function editingPlan(v: CalendarView, id: string) {
  const target = anchorOf(v, entryAt(v, id).committed.seriesId)?.identity.occurrenceId ?? id
  const open: CalendarEvent = { type: "openOccurrence", id: target }
  const first = target !== id && enabled(v, open, "ViewUser") ? [open] : []
  const begin: CalendarEvent = { type: "changeOccurrence", id: target, command: { tag: "BeginEditing" } }
  return enabled(first.length === 0 ? v : step(v, open, "ViewUser"), begin, "ViewUser") ? { target, events: [...first, begin] } : undefined
}

export function adding(v: CalendarView, n: number, id: string): CalendarEvent {
  const startAt = instant(n, 10 * 60)
  return {
    type: "createOccurrence",
    entry: {
      identity: { owner: v.owner, calendarId: v.calendarId, occurrenceId: id, sourceRef: "", kind: "Appointment", billRef: "", billOrigin: "", billAccount: "" },
      details: {
        title: "", location: "", participant: "", notes: "", startAt, endAt: startAt + hour, timezone: v.timezone, allDay: false,
        seriesId: "", recurrence: "Once", reminderEnabled: true, leadTime: hour, important: false
      }
    }
  }
}

effect function remind(box: CalendarMachine.Shape) {
  const now = try Clock.currentTimeMillis
  for (const c of (try box.get()).entries) {
    if (c.reminder !== "ReminderWaiting" || c.phase === "Deleted" || c.remindAt > now) continue
    const id = c.identity.occurrenceId
    box.send({ type: "changeOccurrence", id, command: { tag: "AdvanceClock", now } }, "ViewClock") catch () => undefined
    box.send({ type: "changeOccurrence", id, command: { tag: "ShowDueReminder" } }, "ViewClock") catch () => undefined
  }
}

function matchesGuidedApproval(key: number, c: Calendar, approval: GuidedCalendarApproval): boolean {
  const { identity, draft } = c
  return key === approval.account && identity.owner === approval.owner && identity.calendarId === approval.calendar &&
    identity.sourceRef === approval.sourceRef && draft.title === approval.title && draft.startAt === approval.starts &&
    draft.endAt === approval.ends && draft.timezone === approval.timezone && draft.location === approval.location && draft.notes === approval.notes
}

effect function keep(key: number, box: CalendarMachine.Shape, store: Store, publish: CalendarNews.Shape["publish"], span: Reach!!, workspace: Workspaces.Shape) {
  const sent = try Ref.make<ReadonlySet<string>>(new Set())
  const last = try Ref.make<CalendarView | undefined>(undefined)
  effect function first(mark: string) {
    return try Ref.modify(sent, (all) => [!all.has(mark), new Set(all).add(mark)] as const)
  }
  effect function stored(c: Calendar) {
    const v = try box.get()
    const receipt = try store.write(written(v, c), v)
    const event: CalendarEvent = single(c)
      ? { type: "changeOccurrence", id: c.identity.occurrenceId, command: { tag: "EntryStored", revision: receipt.revision, succeeded: receipt.succeeded } }
      : { type: "saveSeries", receipt: seriesReceipt(try box.get(), c, receipt) }
    box.send(event, "ViewStore") catch () => undefined
    for (const p of receipt.published) box.send({ type: "publishOccurrence", ...p }, "ViewStore") catch () => undefined
  }
  effect function observed(v: CalendarView) {
    const task = try workspace.get()
    const approval = task.plan.calendarApproval
    if (!guidedSavePending(task) || approval.task !== task.assistant.taskId) return
    const saved = v.entries.find((c) => c.phase === "Saved" && c.hasSaved && c.identity.occurrenceId !== approval.provisional && matchesGuidedApproval(key, c, approval))
    if (saved === undefined || !(try first(`guided@${approval.task}@${saved.identity.occurrenceId}`))) return
    workspace.send({ type: "observeGuidedCalendar", saved: { approval, occurrence: saved.identity.occurrenceId, evidence: "" } }, "Host") catch () => undefined
  }
  effect function removedBy(v: CalendarView, plan: Removal) {
    if (plan.tag === "Remove") return try store.remove(kept(v, plan.id).identity, "ThisOccurrence")
    if (plan.tag === "Forget") return try device.remove(entryAt(v, v.selectedId).identity, "ThisOccurrence")
    if (plan.tag === "Unable") return { succeeded: false, evidence: "no-later-repetition" }
    const receipt = try store.write(plan.entry, v)
    return { succeeded: receipt.succeeded, evidence: receipt.succeeded ? `moved:${plan.entry.identity.occurrenceId}` : "" }
  }
  effect function erased(v: CalendarView) {
    const result = try removedBy(v, removal(v))
    box.send({ type: "deletionResult", generation: v.generation, succeeded: result.succeeded, evidence: result.evidence === "" ? "unanswered" : result.evidence }, "ViewStore") catch () => undefined
  }
  try Stream.runForEach(box.changes, effect (v) => {
    const before = try Ref.getAndSet(last, v)
    if (before !== undefined) {
      const news = told(key, before, v)
      if (news.news !== "NoCalendarNews") try publish({ told: news })
    }
    for (const c of v.entries) {
      if (c.phase !== "Editing" || c.approvedRevision !== c.revision || !(try first(`${c.identity.occurrenceId}@${c.revision}`))) continue
      try Effect.uninterruptible(stored(c))
    }
    if (v.deletion === "DeletionPending" && (try first(`delete@${v.generation}`))) try Effect.uninterruptible(erased(v))
    try observed(v)
    try repeat(box, try span)
    try remind(box)
  })
}

effect function repeat(box: CalendarMachine.Shape, span: Reach) {
  for (const p of repetitions(try box.get(), span)) box.send({ type: "publishOccurrence", ...p }, "ViewStore") catch () => undefined
}

effect function spanOf(lead: CalendarMachine.Shape) {
  return reach((try lead.get()).window, dayOf(try Clock.currentTimeMillis))
}

export effect function settled(box: CalendarMachine.Shape, id: string) {
  return try Stream.runHead(Stream.filter(box.changes, (v) => entryAt(v, id).approvedRevision === -1))
}

const keysOf = (a: Registry) => [tablet, ...a.accounts.map((x) => x.id)]
const shownKeys = (a: Registry) => [tablet, ...a.accounts.filter((x) => x.use.calendar).map((x) => x.id)]

const consented = (p: Pending): CalendarEvent | undefined => match (p.ask) {
  when { tag: "AddAsk" }: { type: "confirmAppointment", request: confirmationOf(p) };
  when { tag: "ChangeAsk" }: { type: "confirmChange", changeRequest: changeOf(p) };
  when { tag: "DeleteAsk" }: { type: "confirmDeletion", deletionRequest: deletionOf(p) };
  when { tag: "NoAsk" }: undefined;
}

type Reminded = { readonly key: number; readonly id: string }

export const calendars = (linked: boolean) => Layer.effect(CalendarNews, effect {
  const connector = try Effect.serviceOption(Connector)
  const registry = try Accounts
  const shelf = try Instances
  const proposals = try Proposal
  const workspace = try Workspaces
  const host = try NoticeHost
  const notices = try Notices
  const hub = try PubSub.unbounded<CalendarReport>()
  const publish = (report: CalendarReport) => Effect.asVoid(PubSub.publish(hub, report))
  const lead = try Effect.orDie(shelf.calendar(tablet))

  if ((try lead.get()).owner === "") lead.send({ type: "bindCalendar", owner: "tablet", calendarId: "tablet", timezone: zone() }, "ViewStore") catch () => undefined
  try fork.scoped keep(tablet, lead, device, publish, spanOf(lead), workspace)

  effect function boxOf(key: number) {
    return shelf.calendar(key) catch () => undefined
  }

  effect function each(act: (box: CalendarMachine.Shape, v: CalendarView) => CalendarEvent | undefined, by: "ViewUser" | "ViewClock") {
    for (const key of keysOf(try registry.get())) {
      const box = try boxOf(key)
      if (box === undefined) continue
      const event = act(box, try box.get())
      if (event !== undefined) box.send(event, by) catch () => undefined
    }
  }

  effect function editing() {
    for (const key of keysOf(try registry.get())) {
      const box = try boxOf(key)
      if (box !== undefined && hasEditing(try box.get())) return true
    }
    return false
  }

  effect function selectDay(boxes: readonly CalendarMachine.Shape[], n: number) {
    if ((try workspace.get()).device.surface !== "Calendar" || (try editing())) return
    for (const box of new Set(boxes)) box.send({ type: "navigate", report: navigation((try box.get()).window, "SelectDay", n) }, "ViewUser") catch () => undefined
  }

  const visibility = Stream.changes(Stream.map(workspace.changes, (w) => w.device.surface === "Calendar"))
  try fork.scoped Stream.runForEach(visibility, effect (visible) => {
    const arrived = (try lead.get()).opened
    try each((_, v) => v.owner === "" || (visible && v.opened) ? undefined : visible ? opening(v) : { type: "closeCalendar" }, "ViewUser")
    if (visible && !arrived) lead.send({ type: "navigate", report: navigation((try lead.get()).window, "Today", dayOf(try Clock.currentTimeMillis)) }, "ViewUser") catch () => undefined
  })

  try fork.scoped Stream.runForEach(Stream.tick("30 seconds"), effect () => {
    for (const key of shownKeys(try registry.get())) {
      const box = try boxOf(key)
      if (box !== undefined) try remind(box)
    }
  })

  const listeners = new Set<() => void>()
  const board: { note: CalendarNote | undefined; next: number } = { note: undefined, next: 1 }

  effect function ring(row: string) {
    board.note = { id: board.next, row }
    board.next += 1
    listeners.forEach((listener) => listener())
    try sleep(noteFor)
    board.note = undefined
    listeners.forEach((listener) => listener())
  }

  effect function heard(report: CalendarReport) {
    if (!("told" in report) || report.told.news === "NoCalendarNews") return undefined
    const { news, key, id } = report.told
    const box = try boxOf(key)
    const entry = box === undefined ? undefined : (try box.get()).entries.find((c) => c.identity.occurrenceId === id)
    if (news === "DeletedAppointment") {
      if (entry !== undefined) host.raise({ source: "Calendar", offer: "NoOffer", subject: `Deleted ${entry.committed.title}` }) catch () => undefined
      return undefined
    }
    host.raise({ source: "Calendar", offer: "NoOffer", subject: "Saved to your calendar" }) catch () => undefined
    if (news === "AddedAppointment" && box !== undefined && entry !== undefined) try selectDay([lead, box], dayOf(entry.committed.startAt))
    return `${key}/${id}`
  }

  const rows = Stream.filter(Stream.mapEffect(Stream.fromPubSub(hub), heard), (row) => row !== undefined)
  try fork.scoped Stream.runDrain(Stream.switchMap(rows, (row) => Stream.fromEffect(ring(row))))

  const known = new Map<string, Reminded>()
  const reminding = try Semaphore.make(1)
  const noticeReminders = Effect.ignore(reminding.withPermits(1)(effect {
    const a = try registry.get()
    const sources: CalendarSource[] = []
    for (const key of keysOf(a)) {
      const box = try boxOf(key)
      if (box !== undefined) sources.push({ key, view: try box.get() })
    }
    const due = shownReminders(a, sources).sort((x, y) => x.details.startAt - y.details.startAt)
    const same = (r: CalRow, at: Reminded) => r.key === at.key && r.identity.occurrenceId === at.id
    for (const [subject, at] of [...known]) {
      if (due.some((r) => same(r, at))) continue
      notices.send({ type: "dismissReminder", subject }, "App") catch () => undefined
      known.delete(subject)
    }
    const now = try Clock.currentTimeMillis
    for (const r of due) {
      if ([...known.values()].some((at) => same(r, at))) continue
      const label = reminderSubject(r.details, now)
      const taken = (try notices.get()).reminders
      let subject = label
      for (let i = 2; known.has(subject) || taken.includes(subject); i++) subject = `${label} (${i})`
      const admitted = Effect.as(notices.send({ type: "remind", subject }, "App"), true) catch () => false
      if (admitted) known.set(subject, { key: r.key, id: r.identity.occurrenceId })
    }
  }))

  effect function follow(_: Account, box: CalendarMachine.Shape) {
    return try fork.scoped Stream.runForEach(box.changes, () => noticeReminders)
  }
  try fork.scoped watchEach(registry.changes, (a) => a.accounts, (id) => shelf.calendar(id), follow)
  try fork.scoped Stream.runForEach(Stream.merge(registry.changes, lead.changes), () => noticeReminders)

  effect function visitCalendar() {
    workspace.send({ type: "visit", destination: "Calendar" }, "Person") catch () => undefined
  }

  effect function open(key: number, id: string, how: Opening) {
    const box = try boxOf(key)
    if (box === undefined) return
    const plan = openingPlan(try lead.get(), try box.get(), key === tablet, dayOf(entryAt(try box.get(), id).committed.startAt), how, id)
    if (plan === undefined) return
    for (const { onLead, event } of plan) {
      const sent = Effect.as((onLead ? lead : box).send(event, "ViewUser"), true) catch () => false
      if (!sent) return
    }
    try visitCalendar()
  }

  effect function edit(key: number, id: string) {
    const box = try boxOf(key)
    if (box === undefined) return
    const plan = editingPlan(try box.get(), id)
    if (plan === undefined) return
    for (const event of plan.events) {
      const sent = Effect.as(box.send(event, "ViewUser"), true) catch () => false
      if (!sent) return
    }
    const { draft, committed } = entryAt(try box.get(), plan.target)
    if (draft.startAt === committed.startAt) return
    const details = { ...draft, startAt: committed.startAt, endAt: committed.startAt + draft.endAt - draft.startAt }
    box.send({ type: "changeOccurrence", id: plan.target, command: { tag: "ChangeDetails", details } }, "ViewUser") catch () => undefined
  }

  try fork.scoped Stream.runForEach(host.replies, (reply) => Effect.ignore(effect {
    if (reply._tag !== "SeeDetails" && reply._tag !== "Dismiss") return
    const at = known.get(reply.reminder)
    if (at === undefined) return
    if (reply._tag === "SeeDetails") return try open(at.key, at.id, "Reminder")
    const box = try boxOf(at.key)
    if (box !== undefined) try box.send({ type: "changeOccurrence", id: at.id, command: { tag: "DismissReminder" } }, "ViewUser")
  }))

  const asked = try Ref.make(-1)
  try fork.scoped Stream.runForEach(proposals.changes, effect () => {
    const p = try proposals.get()
    if (p.agreed === 0) {
      if (p.ask.tag === "AddAsk" && (try Ref.getAndSet(asked, p.revision)) !== p.revision) try selectDay([lead], dayOf(p.ask.review.entry.details.startAt))
      return
    }
    const event = consented(p)
    const target = targetOf(p.ask)
    const kept = target === tablet || (linked && shownKeys(try registry.get()).includes(target))
    const box = kept ? shelf.calendar(target) catch () => undefined : undefined
    if (box !== undefined && p.ask.tag === "AddAsk" && target !== tablet) {
      const w = try workspace.get()
      const source = w.plan.mail
      const mail = target === source.account ? shelf.mail(source.account) catch () => undefined : undefined
      const current = mail === undefined ? undefined : try mail.get()
      const storedMessage = current === undefined ? undefined : messageRecord(current, source.ref)
      const content = current === undefined ? undefined : shelf.content(source.account, source.ref)
      if (current !== undefined && current.connection === "Connected" && current.canRead && current.owner === source.owner &&
          current.account === source.address && storedMessage?.loaded && storedMessage.revision === source.revision && content?.version === source.version) {
        const { identity, details } = p.ask.review.entry
        const approval = {
          task: w.assistant.taskId, account: target, owner: identity.owner, calendar: identity.calendarId,
          sourceRef: identity.sourceRef, provisional: identity.occurrenceId, proposal: p.revision,
          title: details.title, starts: details.startAt, ends: details.endAt, timezone: details.timezone, location: details.location, notes: details.notes
        }
        workspace.send({ type: "expectGuidedCalendar", approval }, "Host") catch () => undefined
      }
    }
    const applied = box === undefined || event === undefined ? false : Effect.as(box.send(event, "ViewConsent"), true) catch () => false
    proposals.send({ type: "settleAsk", revision: p.revision }, "Host") catch () => undefined
    if (!applied) try publish({ refused: p.ask })
    try logInfo("Her yes to Grace's calendar question", { ask: p.ask.tag, applied })
  })

  return {
    reports: Stream.fromPubSub(hub), publish,
    verifySaved: effect (key, view, occurrence, expected) => {
      const account = (try registry.get()).accounts.find((candidate) => candidate.id === key && candidate.use.calendar && candidate.address === view.owner)
      if (!linked || account === undefined || Option.isNone(connector)) return false
      return connector.value.calendar(account).verifySaved(view, occurrence, expected) catch () => false
    },
    notes: {
      subscribe: (listener) => {
        listeners.add(listener)
        return () => { listeners.delete(listener) }
      },
      current: () => board.note
    },
    open,
    edit,
    add: effect (n) => {
      const id = `tablet-${(try Clock.currentTimeMillis).toString(36)}-${(try Random.nextInt).toString(36)}`
      lead.send(adding(try lead.get(), n, id), "ViewUser") catch () => undefined
    }
  }
})

export const calendarFeeds = Layer.effectDiscard(effect {
  const registry = try Accounts
  const shelf = try Instances
  const connector = try Connector
  const news = try CalendarNews
  const workspace = try Workspaces
  const lead = try Effect.orDie(shelf.calendar(tablet))

  effect function watch(account: Account, box: CalendarMachine.Shape) {
    if ((try box.get()).owner === "") box.send({ type: "bindCalendar", owner: account.address, calendarId: "primary", timezone: zone() }, "ViewStore") catch () => undefined
    const bound = try box.get()
    if ((try workspace.get()).device.surface === "Calendar" && !bound.opened) box.send({ type: "openCalendar", owner: bound.owner, calendarId: bound.calendarId, timezone: bound.timezone }, "ViewUser") catch () => undefined
    const link = connector.calendar({ provider: account.provider, address: account.address })
    const store: Store = {
      write: effect (entry, view) => link.write(entry, view) catch () => ({ revision: entry.revision, succeeded: false, published: [] }),
      remove: effect (identity, scope) => link.remove(identity, scope) catch () => ({ succeeded: false, evidence: "signedOut" })
    }
    const grown = Stream.changesWith(Stream.mapEffect(lead.changes, () => spanOf(lead)), within)
    const signedIn = Stream.filter(Stream.drop(Stream.changes(Stream.map(registry.changes, (a) => a.signIn.stage)), 1), (stage) => stage === "NotSigningIn")
    const arrives = (shows: (w: Workspace) => boolean) => Stream.filter(Stream.drop(Stream.changes(Stream.map(workspace.changes, shows)), 1), (now) => now)
    const reopened = arrives((w) => w.device.surface === "Calendar")
    const reconnected = arrives((w) => w.device.connectivity === "Online")
    const again = Stream.mapEffect(Stream.mergeAll([Stream.drop(Stream.tick("5 minutes"), 1), Stream.as(signedIn, undefined), Stream.as(reopened, undefined), Stream.as(reconnected, undefined)], { concurrency: "unbounded" }), () => spanOf(lead))
    const fill = Stream.runForEach(Stream.merge(grown, again), effect (span) => {
      const v = provided(try box.get())
      const feed = link.feed({ ...v, window: { ...v.window, ...span } })
      Stream.runForEach(feed, (p) => Effect.ignore(box.send({ type: "publishOccurrence", ...p }, "ViewStore"))) catch effect (cause) => try annotateLogs(logWarning("Calendar feed not fetched; asked again on sign-in, reconnection, opening Calendar or within 5 minutes", cause), { account: account.id })
      try repeat(box, span)
    })
    return try fork.scoped Effect.asVoid(Effect.all([keep(account.id, box, store, news.publish, spanOf(lead), workspace), fill], { concurrency: "unbounded" }))
  }

  try fork.scoped watchEach(registry.changes, (a) => a.accounts.filter((x) => x.use.calendar), (id) => shelf.calendar(id), watch)
})
