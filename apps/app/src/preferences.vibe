// spec/app/workspace.md, "Preference changes invalidate wake timers and use the same durable settings"; spec/app/preferences.md, "Only the current storage acknowledgement confirms persistence"; spec/app/preferences.md, "Restart restores confirmed preferences and invalidates pending acknowledgements"; spec/app/preferences.md, "Night dimming and sound samples use the current preference without rewriting it"; spec/app/preferences.md, "Undo restores the last setting choice without changing the microphone"
import { initial, machine, Machine as Workspaces, canSavePreferences } from "../gen/app__workspace.effect.vibe"
import { type DisplayPreferences, effectiveBrightness, muteChoice, restart, validSettings, volumeChoice } from "../gen/app__preferences.effect.vibe"
import type { PreferenceDevice, PreferenceRecords } from "./preferencesPlugin.ts"
import { NoticeHost } from "./notices.vibe"

const Revision = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const StoredOptions = Schema.Struct({ revision: Revision, value: Schema.optional(Schema.NullOr(Schema.String)) })
schema WrittenOptions { revision: Revision }
const Options = Schema.fromJsonString(Schema.Struct({
  voiceOutput: Schema.Boolean, pace: Schema.Literals(["Slower", "Normal", "Faster"]),
  textSize: Schema.Literals(["Smaller", "StandardText", "Larger", "Largest"]),
  volume: Schema.Int, muted: Schema.Boolean, brightness: Schema.Int,
  nightDimming: Schema.Boolean, wakeEnabled: Schema.Boolean,
}))

effect function record(port: PreferenceRecords) {
  return try Schema.decodeUnknownEffect(StoredOptions)(try timeout(tryPromise(() => port.read({ name: "preferences" })), "2 seconds"))
}

export const preferenceWorkspace = (port: PreferenceRecords | undefined) => port === undefined ? machine() : Layer.unwrap(effect {
  const start = effect {
    const { value } = try record(port)
    if (!value) return initial
    const saved: DisplayPreferences = try Schema.decodeUnknownEffect(Options)(value)
    if (!validSettings(saved)) return initial
    return { ...initial, preferences: restart({ ...initial.preferences, durable: saved }, "PreferenceStore") }
  } catch () => initial
  return machine(start)
})

export effect function retryPreferences() {
  const workspace = try Workspaces
  workspace.send({ type: "savePreferences" }, "Host") catch () => undefined
}

export const persistPreferences = (port: PreferenceRecords | undefined) => Layer.effectDiscard(effect {
  if (!port) return
  const workspace = try Workspaces
  const choices = Stream.changes(Stream.map(workspace.changes, ({ preferences }) => preferences))
  const requests = Stream.merge(Stream.map(choices, () => false), Stream.map(Stream.tick("1 minute"), () => true))
  try fork.scoped Stream.runForEach(requests, effect (retrying) => {
    const current = try workspace.get()
    const { saving, session, snapshot } = current.preferences
    if (saving !== "Saving" && (retrying || saving !== "SaveFailed" || session !== snapshot) && canSavePreferences(current, "Host")) try retryPreferences()
    const { preferences } = try workspace.get()
    if (preferences.saving !== "Saving") return
    const succeeded = effect {
      const { revision } = try record(port)
      const request = { name: "preferences" as const, revision, value: JSON.stringify(preferences.snapshot) }
      const receipt = try Schema.decodeUnknownEffect(WrittenOptions)(try timeout(tryPromise(() => port.write(request)), "4 seconds"))
      return receipt.revision === revision + 1
    } catch () => false
    workspace.send({ type: "preferencesSaved", saveToken: preferences.requestedRevision, succeeded }, "Store") catch () => undefined
  })
})

schema DeviceVolume { step: Schema.Int; min: Schema.Int; max: Schema.Int; muted: boolean }
schema DeviceBrightness { percent?: Schema.Int }
schema DeviceSettings { volume: DeviceVolume; brightness: DeviceBrightness }

type DeviceChoice = Pick<DisplayPreferences, "brightness" | "volume" | "muted" | "nightDimming">
const sameChoice = (a: DeviceChoice, b: DeviceChoice) =>
  a.brightness === b.brightness && a.volume === b.volume && a.muted === b.muted && a.nightDimming === b.nightDimming
const stepFor = (level: number, { min, max }: DeviceVolume) => min + Math.round(level / 100 * (max - min))

effect function deviceSettings(port: PreferenceDevice) {
  return try Schema.decodeUnknownEffect(DeviceSettings)(try timeout(tryPromise(() => port.getDevice()), "2 seconds"))
}

export const applyDeviceChoices = (port: PreferenceDevice | undefined) => Layer.effectDiscard(effect {
  if (!port) return
  const workspace = try Workspaces
  const notices = try NoticeHost
  const ready = Stream.filter(workspace.changes, ({ device }) => device.readiness === "Ready")
  const chosen = Stream.changesWith(Stream.map(ready, ({ preferences }) => preferences.session), sameChoice)
  const reports = Stream.callback<{ reported: true }>((queue) => acquireRelease(
    Effect.option(tryPromise(() => port.addListener?.("volume", () => { Queue.offerUnsafe(queue, { reported: true }) }) ?? Promise.reject())),
    (listener) => Option.isSome(listener) ? Effect.ignore(tryPromise(() => listener.value.remove())) : Effect.void,
  ))
  const requests = Stream.merge(Stream.merge(chosen, Stream.map(Stream.tick("1 minute"), () => undefined)), reports)
  let confirmed: DeviceChoice | undefined
  const follow = effect () => {
    const { device, preferences: { session, revision } } = try workspace.get()
    if (device.readiness !== "Ready" || confirmed === undefined || confirmed.volume !== session.volume || confirmed.muted !== session.muted) return
    const { volume } = try deviceSettings(port)
    const { step, min, max, muted } = volume
    if (min < 0 || max <= min || step < min || step > max ||
        (muted === session.muted && (muted || step === stepFor(session.volume, volume)))) return
    const settings = muted ? muteChoice(session, true) : volumeChoice(session, Math.round((step - min) / (max - min) * 100))
    if (settings.volume === session.volume && settings.muted === session.muted) return
    try workspace.send({ type: "changePreferences", settings }, "Person", (current) =>
      current.device.contextVersion === device.contextVersion && current.preferences.revision === revision)
    confirmed = { ...confirmed, volume: settings.volume, muted: settings.muted }
  }
  try fork.scoped Stream.runForEach(requests, effect (requested) => {
    if (requested !== undefined && "reported" in requested) {
      follow() catch () => (follow() catch () => undefined)
      return
    }
    const { device, preferences: { session: choice } } = try workspace.get()
    if (device.readiness !== "Ready" || (requested && !sameChoice(requested, choice))) return
    const target = { ...choice, brightness: effectiveBrightness(choice, new Date(try Clock.currentTimeMillis).getHours()) }
    if (confirmed !== undefined && sameChoice(confirmed, target)) return
    const applied = effect {
      const before = try deviceSettings(port)
      const watchBrightness = confirmed === undefined || confirmed.brightness !== target.brightness
      const watchVolume = confirmed === undefined || confirmed.volume !== target.volume || confirmed.muted !== target.muted
      if (!watchBrightness && !watchVolume) return target
      const { min, max } = before.volume
      if (min < 0 || max <= min || before.volume.step < min || before.volume.step > max) return undefined
      const step = stepFor(target.volume, before.volume)
      try all([
        watchBrightness && before.brightness.percent !== target.brightness
          ? timeout(tryPromise(() => port.setBrightness({ percent: target.brightness })), "2 seconds") : Effect.void,
        watchVolume && (before.volume.step !== step || before.volume.muted !== target.muted)
          ? timeout(tryPromise(() => port.setVolume({ step, muted: target.muted })), "2 seconds") : Effect.void,
      ], { concurrency: "unbounded" })
      const reported = try deviceSettings(port)
      const matches = (!watchBrightness || reported.brightness.percent === target.brightness) &&
        (!watchVolume || (reported.volume.muted === target.muted && (target.muted || reported.volume.step === step)))
      return matches ? target : undefined
    } catch () => undefined
    confirmed = applied
    if (!applied && requested && sameChoice((try workspace.get()).preferences.session, choice)) {
      notices.raise({ source: "Settings", offer: "NoOffer", subject: "The tablet couldn’t apply that setting." }) catch () => undefined
    }
  })
})
