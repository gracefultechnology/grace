// spec/app/deviceKeys.md, "Story: Answer a website before Grace goes on"; spec/app/workspace.md, "Story: Wait for my answer to a website"
import { decodeEvent as websiteEvent, initial as noRequests, machineOver as requestsOver, Machine as WebsiteRequests } from "../gen/app__websiteRequests.effect.vibe"
import { decodeEvent as workspaceEvent, enabled, heldByWebsite, step, Machine as Workspaces } from "../gen/app__workspace.effect.vibe"

export service WebsiteTask {
  readonly clear: boolean!!
  readonly released: void!!
  start<A, E>(current: boolean!!, issue: A!E): (Fiber.Fiber<A, E> | "Held" | "Stale")!!
}

export const websiteTask = Layer.unwrap(effect {
  const workspace = try Workspaces
  const lock = try Semaphore.make(1)
  const serial = lock.withPermits(1)
  const clear = Effect.map(workspace.get(), (w) => !heldByWebsite(w))
  const released = Effect.asVoid(Stream.runHead(Stream.filter(workspace.changes, (w) => !heldByWebsite(w))))
  const issue: WebsiteTask.Shape["start"] = (current, run) => serial(effect {
    if (!(try current)) return "Stale" as const
    if (!(try clear)) return "Held" as const
    return try Effect.forkChild(run, { startImmediately: true })
  })
  const send: Workspaces.Shape["send"] = effect (event, by, isCurrent) => {
    while (true) {
      const sent = try serial(effect {
        const state = try workspace.get()
        const answered = () => step(state, { type: "followWebsite", website: noRequests }, "Host").state
        if (enabled(state, event, by) || !heldByWebsite(state) || !enabled(answered(), event, by)) return { result: try workspace.send(event, by, isCurrent) }
        return undefined
      })
      if (sent !== undefined) return sent.result
      try Effect.interruptible(released)
    }
  }
  const requests = try requestsOver(() => Effect.map(workspace.get(), (w) => w.website), (website) => Effect.asVoid(Effect.orDie(workspace.send({ type: "followWebsite", website }, "Host"))))
  const answer: WebsiteRequests.Shape["send"] = (event, by, isCurrent) => serial(requests.send(event, by, isCurrent))
  return Layer.mergeAll(
    Layer.succeed(Workspaces, { ...workspace, send, receive: effect (input, by) => try send(try workspaceEvent(input), by) }),
    Layer.succeed(WebsiteRequests, { ...requests, send: answer, receive: effect (input, by) => try answer(try websiteEvent(input), by) }),
    Layer.succeed(WebsiteTask, { clear, released, start: issue })
  )
})
