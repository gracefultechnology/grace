// spec/app/deviceKeys.md, "Story: Answer a website before Grace goes on"
import { taskMayAdvance } from "../gen/app__deviceKeys.effect.vibe"
import { decodeEvent as websiteEvent, Machine as WebsiteRequests } from "../gen/app__websiteRequests.effect.vibe"
import { decodeEvent as workspaceEvent, enabled, step, Machine as Workspaces, Rejected, type Event } from "../gen/app__workspace.effect.vibe"

export service WebsiteTask {
  readonly clear: boolean!!
  readonly released: void!!
  start<A, E>(current: boolean!!, issue: A!E): (Fiber.Fiber<A, E> | "Held" | "Stale")!!
}

const progress = {
  observe: "Step", prepare: "Step", dispatch: "Step", verify: "Step", completeOrdinary: "Step",
  publishGuidance: "Step", setGuidedLink: "Step", offerReadReview: "Step", offerGuidedNameCorrection: "Step",
  confirmGuided: "Step", confirmGuidedNamedPage: "Step", confirmGuidedSearch: "Step",
  stageGuidedRecord: "Step", confirmGuidedRecord: "Step",
  confirmGuidedMail: "Step", rebindGuidedMail: "Step",
  expectGuidedCalendar: "Step", reconcileGuidedSave: "Step", reviewCommitment: "Step", readBackCommitment: "Step", submitCommitment: "Step",
  receiveProgress: "Step", journalCommitment: "Independent", observeCommitmentTap: "Step", observeGuidedCalendar: "Receipt",
  recordCommitment: "Evidence", reconcilePriorCommitment: "Evidence",
  setAvailability: "Independent", changeLifecycle: "Independent", setBrowserObservation: "Independent", closeGrace: "Independent",
  abandonTask: "Independent", purgePrivate: "Independent", visit: "Independent", returnToApplication: "Independent", closeBrowser: "Independent", openReleasedEmailLink: "Independent",
  openGrace: "Independent", stop: "Independent", talk: "Independent", newConversation: "Independent", requestReplacement: "Independent",
  keepTask: "Independent", replaceTask: "Independent", continueTask: "Independent", interact: "Independent", invalidateGuidance: "Independent",
  chooseHomePage: "Independent", chooseSettingsPage: "Independent", togglePopover: "Independent", dismissPopover: "Independent",
  wakeReturn: "Independent", detectWake: "Independent", wakeNoSpeech: "Independent", cancelWake: "Independent", savePreferences: "Independent",
  preferencesSaved: "Independent", samplePreferences: "Independent", changePreferences: "Independent", undoPreferences: "Independent",
  adjustPreferenceLevel: "Independent", begin: "Independent", stayOnPage: "Independent", receiveLoad: "Independent", changePage: "Independent",
  resume: "Independent", unexpectedPage: "Independent", unwatchedPage: "Independent", refuseOrigin: "Independent", leaveToPerson: "Independent",
  beginGuided: "Independent", discardGuidedRecovery: "Independent", restoreGuided: "Independent", startReadReview: "Independent",
  confirmGuidedNameCorrection: "Independent", bindCommitment: "Independent", approveSpokenCommitment: "Independent",
  retryCommitment: "Independent", saveCommitment: "Evidence"
} satisfies Record<Event["type"], "Step" | "Receipt" | "Evidence" | "Independent">

export const websiteTask = Layer.unwrap(effect {
  const workspace = try Workspaces
  const requests = try WebsiteRequests
  const lock = try Semaphore.make(1)
  const serial = lock.withPermits(1)
  const clear = Effect.map(requests.get(), (r) => taskMayAdvance(r, true))
  const released = Effect.asVoid(Stream.runHead(Stream.filter(requests.changes, (r) => taskMayAdvance(r, true))))
  const issue: WebsiteTask.Shape["start"] = (current, run) => serial(effect {
    if (!(try current)) return "Stale" as const
    if (!(try clear)) return "Held" as const
    return try Effect.forkChild(run, { startImmediately: true })
  })
  const send: Workspaces.Shape["send"] = effect (event, by, isCurrent) => {
    const kind = progress[event.type]
    if (kind === "Independent") return try serial(workspace.send(event, by, isCurrent))
    while (true) {
      const result = try serial(effect {
        const state = try workspace.get()
        const admitted = enabled(state, event, by)
        if (taskMayAdvance(try requests.get(), admitted)) return try workspace.send(event, by, isCurrent)
        if (admitted && kind === "Evidence") {
          const after = step(state, event, by).state.assistant
          if (after.activity === state.assistant.activity && after.workVersion === state.assistant.workVersion) return try workspace.send(event, by, isCurrent)
        }
        if (!admitted || kind === "Step" || (kind === "Evidence" && by !== "Store")) throw new Rejected({ state, event, by })
        return undefined
      })
      if (result !== undefined) return result
      try Effect.interruptible(released)
    }
  }
  const answer: WebsiteRequests.Shape["send"] = (event, by, isCurrent) => serial(requests.send(event, by, isCurrent))
  return Layer.mergeAll(
    Layer.succeed(Workspaces, { ...workspace, send, receive: effect (input, by) => try send(try workspaceEvent(input), by) }),
    Layer.succeed(WebsiteRequests, { ...requests, send: answer, receive: effect (input, by) => try answer(try websiteEvent(input), by) }),
    Layer.succeed(WebsiteTask, { clear, released, start: issue })
  )
})
