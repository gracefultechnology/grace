// spec/app/surface.md, "Story: Use the website under Grace's controls"; spec/app/browser.md, "Load results must match the tab and request that produced them"; spec/app/browser.md, "The padlock shows only on a page that loaded over a secure connection"
import { NativePage, PageEvent, PageFailed } from "./nativePage.vibe"
import { LoopbackPage, type PageId, Url } from "./nativePage.schema.ts"
import { webView } from "./surfacePlugin.ts"

type Frame = { element: HTMLIFrameElement; history: string[]; at: number; navigation: "Idle" | "Requested" | "Leaving" }

export const websites = webView.document.createElement("div")

export function webPage() {
  return Layer.effect(NativePage, effect {
    const document = webView.document
    const events = try Queue.unbounded<PageEvent>()
    const frames = new Map<PageId, Frame>()

    const go = (id: PageId, frame: Frame, url: string) => {
      const opens = Schema.is(LoopbackPage)(url)
      frame.navigation = opens ? "Requested" : "Idle"
      if (opens) frame.element.src = url
      Queue.offerUnsafe(events, PageEvent.Started({ id, url: Url.make(url) }))
      if (!opens) Queue.offerUnsafe(events, PageEvent.Changed({
        id, url: Url.make(url), loading: false, result: "LoadFailed", secure: false, back: frame.at > 0, forward: frame.at + 1 < frame.history.length
      }))
    }
    const loaded = (id: PageId, frame: Frame) => {
      const loadedDocument = frame.element.contentDocument
      const address = URL.parse(loadedDocument?.URL ?? "")
      const url = address?.protocol === "https:" || address?.protocol === "http:" ? Url.make(address.href) : undefined
      const navigation = frame.navigation
      const left = frame.history[frame.at]
      const followed = url !== undefined && navigation !== "Requested" && left !== url
      if (followed && navigation === "Leaving") Queue.offerUnsafe(events, PageEvent.Changed({
        id, url: Url.make(left), loading: false, result: "Loaded", secure: false, back: frame.at > 0, forward: frame.at + 1 < frame.history.length
      }))
      if (followed) {
        frame.history = [...frame.history.slice(0, frame.at + 1), url]
        frame.at = frame.history.length - 1
      } else if (url !== undefined) frame.history[frame.at] = url
      if (navigation === "Idle" || (followed && navigation === "Leaving")) Queue.offerUnsafe(events, PageEvent.Started({ id, url }))
      frame.navigation = "Idle"
      loadedDocument?.defaultView?.addEventListener("pagehide", () => {
        if (frame.navigation !== "Idle" || frames.get(id) !== frame) return
        frame.navigation = "Leaving"
        Queue.offerUnsafe(events, PageEvent.Started({ id, url: undefined }))
      }, { once: true })
      Queue.offerUnsafe(events, PageEvent.Changed({ id, url, loading: false, result: "Loaded",
        secure: address?.protocol === "https:" && loadedDocument?.defaultView?.isSecureContext === true,
        back: frame.at > 0, forward: frame.at + 1 < frame.history.length }))
    }
    const remove = (id: PageId) => {
      const frame = frames.get(id)
      frames.delete(id)
      frame?.element.remove()
    }
    effect function on(id: PageId, run: (frame: Frame) => void) {
      const frame = frames.get(id)
      if (frame === undefined) throw new PageFailed({ cause: `no page ${id}` })
      run(frame)
    }
    const step = (id: PageId, by: number) => on(id, (frame) => {
      const at = Math.min(Math.max(frame.at + by, 0), frame.history.length - 1)
      if (at === frame.at && by !== 0) return
      frame.at = at
      go(id, frame, frame.history[at])
    })
    const unasked = effect () => { throw new PageFailed({ cause: "a page in a frame asks Grace nothing" }) }

    try addFinalizer(() => sync(() => { for (const id of [...frames.keys()]) remove(id) }))
    return {
      privateSignIn: false,
      opensWebsites: false,
      readPrimaryHeading: () => Effect.fail(new PageFailed({ cause: "This browser cannot inspect another website." })),
      hasNavigationMenu: () => Effect.succeed(false),
      visibleMenuChild: () => Effect.succeed(false),
      observeLinks: () => Effect.fail(new PageFailed({ cause: "This browser cannot inspect another website." })),
      pointAt: () => Effect.fail(new PageFailed({ cause: "This browser cannot annotate another website." })),
      clearGuide: () => sync(() => undefined),
      claim: () => sync(() => { for (const left of document.querySelectorAll("iframe[data-page]")) left.remove() }),
      create: (id, url, manualSignIn) => manualSignIn
        ? Effect.fail(new PageFailed({ cause: "Private sign-in requires Android" }))
        : sync(() => {
          remove(id)
          const element = document.createElement("iframe")
          element.dataset.page = id
          element.title = "Website"
          element.sandbox.add("allow-scripts", "allow-same-origin", "allow-forms", "allow-popups")
          element.hidden = true
          Object.assign(element.style, { position: "fixed", border: "0", left: "0", top: "0", width: "0", height: "0", pointerEvents: "none" })
          const frame: Frame = { element, history: [url], at: 0, navigation: "Idle" }
          element.addEventListener("load", () => loaded(id, frame))
          frames.set(id, frame)
          go(id, frame, url)
          websites.append(element)
        }),
      place: (id, page, corners) => on(id, (frame) => {
        Object.assign(frame.element.style, {
          left: `${page.x}px`, top: `${page.y}px`, width: `${page.width}px`, height: `${page.height}px`,
          borderRadius: `${corners.topLeft}px ${corners.topRight}px ${corners.bottomRight}px ${corners.bottomLeft}px`
        })
      }),
      route: (id) => on(id, (frame) => { frame.element.style.pointerEvents = "auto" }),
      present: (id) => sync(() => { for (const [page, { element }] of frames) element.hidden = page !== id }),
      pause: (id) => on(id, () => undefined),
      resume: (id) => on(id, () => undefined),
      navigate: (id, url) => on(id, (frame) => {
        frame.history = [...frame.history.slice(0, frame.at + 1), url]
        frame.at = frame.history.length - 1
        go(id, frame, url)
      }),
      back: (id) => step(id, -1),
      forward: (id) => step(id, 1),
      reload: (id) => step(id, 0),
      stop: (id) => on(id, () => undefined),
      destroy: (id) => sync(() => remove(id)),
      reply: unasked,
      grant: unasked,
      purge: () => sync(() => {
        for (const id of [...frames.keys()]) remove(id)
        return false
      }),
      events: Stream.fromQueue(events)
    }
  })
}
