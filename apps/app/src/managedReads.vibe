// spec/app/setup.md, "Story: Read the Google mail and calendar I connected"
import type { Setup as SetupState } from "../gen/app__setup.effect.vibe"
import { guidedDetails, type GuidedStep } from "../gen/app__workspace.effect.vibe"
import type { Recurrence } from "../gen/app__calendar.effect.vibe"

type MailRow = { metadata?: { historyId?: string | null }; externalId: string; from: string; subject: string; receivedAt: string; isUnread: boolean }
type EventRow = { etag?: string | null; editable?: boolean; seriesId?: string | null; timezone?: string | null; externalId: string; title: string; description: string; location: string; startAt: string; endAt: string; isAllDay: boolean }
type MailBody = { accountId: string; message: MailRow; reply?: { recipient: string; subject: string } | null; bodyText: string; bodyTextAvailable: boolean }

export type ProposedWork = { accountId: string; grant: string } & (
  | { kind: "draft"; recipient: string; subject: string; text: string; replyTo?: string }
  | { kind: "appointment"; id?: string; version?: string; title: string; start: string; location: string; repeat: Recurrence }
  | { kind: "removeAppointment"; id: string; version: string; series: boolean }
  | { kind: "trash"; id: string; version: string }
)
type StagedWork = { number: number; proposal: ProposedWork }
export type ManagedSnapshot =
  | { kind: "closed" }
  | { proposed?: StagedWork; kind: "mail"; accountId: string; grant: string; rows: readonly MailRow[]; next: string | null; selected?: MailBody }
  | { proposed?: StagedWork; kind: "calendar"; accountId: string; grant: string; rows: readonly EventRow[]; next: string | null; from: string; until: string; selected?: EventRow; series?: EventRow }

type Command = { kind: "openHosted" | "dismissProposal" } | { kind: "open"; id: string }

export type GuidedManagedSelection = { kind: "legacy" } | { kind: "unavailable" } | (
  { accountId: string; googleEmail: string; grant: string; id: string; version: string } &
  ({ kind: "mail"; subject: string } | { kind: "calendar"; title: string; startAt: string })
)

export type GuidedAuthority = { device: string; connected: string | undefined }

export function guidedAuthority(setup: SetupState | undefined, _hash: string): GuidedAuthority {
  const account = setup?.graceAccount
  return { device: account?.tag === "GraceSignedIn" ? JSON.stringify(["grace", account.accountId]) : "tablet", connected: "tablet" }
}

export function guidedOwner(authority: GuidedAuthority, steps: readonly GuidedStep[]): string | undefined {
  return steps.some((step) => {
    const surface = guidedDetails(step).surface
    return surface === "Email" || surface === "Calendar"
  }) ? authority.connected : authority.device
}

export service ManagedReads {
  get(): ManagedSnapshot!!
  ownsSurfaces(): boolean!!
  guidedSelection(): GuidedManagedSelection!!
  send(command: Command): boolean!!
  stage(proposal: ProposedWork): boolean!!
}

export const managedReads = (_native: boolean) => Layer.succeed(ManagedReads, {
  get: () => Effect.succeed({ kind: "closed" } as const),
  ownsSurfaces: () => Effect.succeed(false),
  guidedSelection: () => Effect.succeed({ kind: "legacy" } as const),
  send: () => Effect.succeed(false),
  stage: () => Effect.succeed(false),
})
