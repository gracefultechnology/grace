// spec/app/setup.md, "Story: Read the Google mail and calendar I connected"; spec/app/email.md, "Story: Read an email and its original attachment"
import { type Setup as SetupState, Machine as Setup, isSelectedVersion, managedReadMatches, mayReadManaged, maySendManagedMail, mayChangeManaged } from "../gen/app__setup.effect.vibe"
import { guidedDetails, Machine as Workspaces, type GuidedStep, type ReleasedEmailLink } from "../gen/app__workspace.effect.vibe"
import { initial as initialCalendarView, type Navigation, type ViewWindow } from "../gen/app__calendarView.effect.vibe"
import { dayOf, midnight, navigation } from "./calendarWindow.vibe"
import type { Recurrence } from "../gen/app__calendar.effect.vibe"
import type { SavedFile } from "../gen/app__files.effect.vibe"
import { Library } from "./files.vibe"
import { accountPlugin, reminderPlugin } from "./accountPlugin.ts"
import { AccountActions, apiOrigin, currentManagedMailGrant } from "./graceAccount.vibe"
import { type GoogleChange, type GoogleRead, googleRoute } from "./cloudRequests.vibe"
import { messageLinkParts } from "./messageLinks.vibe"
import { webView } from "./surfacePlugin.ts"

export type ReadView = "Email" | "Calendar"
const fragments = { Email: "email", Calendar: "calendar" } as const
const retained = "grace-hosted-read"
const idField = Schema.NonEmptyString
const dateField = Schema.String.check(Schema.makeFilter((text) => Number.isFinite(Date.parse(text))))
schema Intent { view: "Email" | "Calendar"; returning: boolean; owner?: string; occurrence?: string }
const nullableText = Schema.NullOr(Schema.String)
schema MailMetadata { historyId?: nullableText }
export schema MailRow { metadata?: MailMetadata; labels?: readonly string[]; fromEmail?: nullableText; externalId: idField; from: string; subject: string; receivedAt: dateField; isUnread: boolean }
export schema EventRow { etag?: nullableText; editable?: boolean; seriesId?: nullableText; timezone?: nullableText; externalId: idField; title: string; description: string; location: string; startAt: dateField; endAt: dateField; isAllDay: boolean }
const Folder = Schema.Literals(["inbox", "sent", "drafts", "trash"])
export type ManagedFolder = typeof Folder.Type
const count = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const MailCounts = Schema.Struct({ inboxUnread: count, drafts: count })
const MailPage = Schema.Struct({ accountId: idField, folder: Schema.optionalKey(Folder), q: Schema.optionalKey(Schema.String), messages: Schema.Array(MailRow), nextPageToken: Schema.NullOr(Schema.String), counts: Schema.optionalKey(MailCounts) })
const CalendarPage = Schema.Struct({ accountId: idField, events: Schema.Array(EventRow), nextPageToken: Schema.NullOr(Schema.String) })
export schema MailReply { recipient: string; subject: string }
const attachmentLimit = 8 * 1024 * 1024
const textPreviewLimit = 65_536
const encodedAttachmentLimit = 4 * Math.ceil(attachmentLimit / 3)
const attachmentName = Schema.NonEmptyString.check(Schema.isMaxLength(120), Schema.makeFilter((name) =>
  name.trim() !== "" && name !== "." && name !== ".." && Array.from(name).every((character) => {
    const code = character.charCodeAt(0)
    return character !== "/" && character !== "\\" && code >= 32 && code !== 127
  })))
const partIdField = Schema.String.check(Schema.isPattern(/^[0-9.]{1,32}$/))
const historyField = Schema.String.check(Schema.isPattern(/^[0-9]{1,20}$/))
const supportedMedia = Schema.Literals(["application/pdf", "text/plain", "image/png", "image/jpeg", "image/webp"])
schema AttachmentDescriptor { partId: string; name: attachmentName; mimeType: idField; size: Schema.Int; supported: boolean }
const MailBody = Schema.Struct({ accountId: idField, message: MailRow, historyId: Schema.NullOr(historyField),
  attachments: Schema.Array(AttachmentDescriptor), reply: Schema.optional(Schema.NullOr(MailReply)), bodyText: Schema.String, bodyTextAvailable: Schema.Boolean })
export function actionableMailBody(selected: typeof MailBody.Type | undefined) {
  return selected?.bodyTextAvailable && selected.historyId && selected.message.labels &&
    (selected.message.metadata?.historyId === undefined || selected.message.metadata.historyId === selected.historyId) ? selected : undefined
}
const transferTicket = Schema.String.check(Schema.isPattern(/^(?:[0-9a-f]{2}){1,4096}$/))
const AttachmentReceipt = Schema.Struct({ version: Schema.Literal(1), accountId: idField, messageId: idField, historyId: historyField,
  partId: partIdField, name: attachmentName, mimeType: supportedMedia, size: Schema.Int, supported: Schema.Literal(true),
  grantId: Schema.optional(idField), organizationId: Schema.optional(idField), deviceTransfer: Schema.optional(transferTicket), dataBase64: Schema.String.check(Schema.isMaxLength(encodedAttachmentLimit), Schema.isPattern(/^[A-Za-z0-9+/]*={0,2}$/)),
  sha256: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/)) })
type OriginalAttachment = { name: string; mimeType: typeof supportedMedia.Type; url: string; file?: { part: string; digest: string; organization: string; saved: boolean }; deviceTransfer?: string; preview?: { text: string; truncated: boolean } }

export schema LocalMailDraft { recipient: string; subject: string; text: string; operationId?: string; grant?: string }
schema SentMail { accountId: idField; operationId: idField; messageId: idField }
const draftKey = (accountId: string, email: string, replyTo?: string) => "grace-managed-draft-" + JSON.stringify([accountId, email, ...(replyTo ? [replyTo] : [])])

export effect function localMailDraft(accountId: string, email: string, replyTo?: string): LocalMailDraft!! {
  const raw = Effect.try(() => webView.window.sessionStorage.getItem(draftKey(accountId, email, replyTo))) catch () => null
  const value = Schema.decodeUnknownOption(Schema.fromJsonString(LocalMailDraft))(raw)
  return Option.isSome(value) ? value.value : { recipient: "", subject: "", text: "" }
}

export effect function keepMailDraft(accountId: string, email: string, draft: LocalMailDraft | null, replyTo?: string) {
  return try Effect.try(() => {
    const key = draftKey(accountId, email, replyTo)
    if (draft === null) webView.window.sessionStorage.removeItem(key)
    else webView.window.sessionStorage.setItem(key, JSON.stringify(draft))
  })
}

export type AppointmentEdit = { title: string; startAt: string; endAt: string; location: string; allDay?: boolean }
export type ManagedWrite =
  | { kind: "trash"; id: string; version: string }
  | { kind: "undo"; id: string; version: string; prior: string }
  | { kind: "appointment"; action: "create"; event: AppointmentEdit & { repeat?: { frequency: Exclude<Recurrence, "Once">; timeZone: string } } }
  | { kind: "appointment"; action: "update"; id: string; version: string; seriesFor?: string; event: AppointmentEdit }
  | { kind: "appointment"; action: "delete"; id: string; version: string; seriesFor?: string }
export type ProposedWork = { accountId: string; grant: string } & (
  | { kind: "draft"; recipient: string; subject: string; text: string; replyTo?: string }
  | { kind: "appointment"; id?: string; version?: string; title: string; start: string; location: string; repeat: Recurrence }
  | { kind: "removeAppointment"; id: string; version: string; series: boolean }
  | { kind: "trash"; id: string; version: string }
)
type StagedWork = { number: number; proposal: ProposedWork }
schema Series { accountId: idField; occurrenceId: idField; event: EventRow }
schema ActionReceipt { accountId: idField; operationId: idField; itemId: idField; version?: string }
export type WriteReceipt = typeof ActionReceipt.Type
type WriteScope = { accountId: string; grant: string }

type Waiting = "native" | "checking" | "unavailable" | "signedOut" | "connect" | "connectorUnavailable" | "mismatch"
type Scope =
  | { kind: "closed" }
  | { kind: "waiting"; view: ReadView; reason: Waiting }
  | { kind: "ready"; view: ReadView; accountId: string; grant: string }
type ReadyScope = Extract<Scope, { kind: "ready" }>
type Mail = { linkReview?: ReleasedEmailLink; replying?: boolean; folder: ManagedFolder; search: string; counts?: typeof MailCounts.Type; proposed?: StagedWork; kind: "mail"; accountId: string; grant: string; rows: readonly MailRow[]; next: string | null; selected?: typeof MailBody.Type; photosSaved?: number; attachment?: OriginalAttachment }
export function inboxTrashVersion(mail: Mail) {
  const row = mail.selected?.message
  return mail.folder !== "trash" && row?.labels?.includes("INBOX") && !row.labels.includes("TRASH") ? row.metadata?.historyId : undefined
}
type Calendar = { window: ViewWindow; proposed?: StagedWork; kind: "calendar"; accountId: string; grant: string; rows: readonly EventRow[]; next: string | null; from: string; until: string; selected?: EventRow; series?: EventRow }
export type ManagedSnapshot =
  | { kind: "closed" }
  | { kind: "waiting"; view: ReadView; reason: Waiting }
  | { kind: "loading"; view: ReadView; accountId: string }
  | { kind: "failed"; view: ReadView; accountId: string }
  | Mail
  | Calendar

type HomeOccurrence = { accountId: string; grant: string; id: string; version: string | null }
type ReadIntent = Intent & { homeOccurrence?: HomeOccurrence }
type Command = (({ kind: "mailFolder"; folder: ManagedFolder; search: string } | { kind: "calendarWindow"; move: Navigation; day: number }) & WriteScope) | { kind: "homeOccurrence"; row: HomeOccurrence } | { kind: "reminder"; id: string; version: string; minutes: 0 | 60 | 1440 } | { kind: "refresh" | "more" | "back" | "account" | "openHosted" | "enableReminders" | "dismissProposal" } | { kind: "open"; id: string } | { kind: "openAttachment"; partId: string } | { kind: "closeAttachment" | "saveAttachment" | "savePhotos" }

export type GuidedManagedSelection = { kind: "legacy" } | { kind: "unavailable" } | (
  { accountId: string; googleEmail: string; grant: string; id: string; version: string } &
  ({ kind: "mail"; subject: string } | { kind: "calendar"; title: string; startAt: string })
)

export function usesManagedSurfaces(setup: Pick<SetupState, "graceAccount" | "googleLink"> | undefined, hash: string): boolean {
  const account = setup?.graceAccount
  return viewOf(hash) !== undefined || account?.tag === "GraceDeviceSignedIn" ||
    account?.tag === "GraceSignedIn" && setup?.googleLink.tag !== "GoogleLinkUnknown"
}

export type GuidedAuthority = { device: string; connected: string | undefined }

export function guidedAuthority(setup: SetupState | undefined, hash: string): GuidedAuthority {
  const account = setup?.graceAccount
  const link = setup?.googleLink
  const device = account?.tag === "GraceSignedIn" ? JSON.stringify(["grace", account.accountId]) : "tablet"
  const connected = !usesManagedSurfaces(setup, hash) ? "tablet" :
    account?.tag === "GraceSignedIn" && link?.tag === "GoogleLinkConnected" && link.email.trim() !== ""
      ? JSON.stringify(["google", account.accountId, link.email.trim().toLowerCase()]) : undefined
  return { device, connected }
}

export function guidedOwner(authority: GuidedAuthority, steps: readonly GuidedStep[]): string | undefined {
  return steps.some((step) => {
    const surface = guidedDetails(step).surface
    return surface === "Email" || surface === "Calendar"
  }) ? authority.connected : authority.device
}

export type HomeCards = { accountId: string; grant: string; mail: readonly MailRow[]; events: readonly EventRow[] }

export service ManagedReads {
  readonly state: Stream.Stream<ManagedSnapshot>
  readonly home: Stream.Stream<HomeCards | undefined>
  homeCards(): (HomeCards | undefined)!!
  get(): ManagedSnapshot!!
  ownsSurfaces(): boolean!!
  guidedSelection(): GuidedManagedSelection!!
  chooseLink(shown: Mail, link: string, choice: "open" | "confirm" | "cancel"): boolean!!
  replyVisibility(shown: Mail, opened: boolean): void!!
  send(command: Command): boolean!!
  stage(proposal: ProposedWork): boolean!!
  series(scope: WriteScope, occurrenceId: string): (EventRow | undefined)!!
  change(scope: WriteScope, action: ManagedWrite): (WriteReceipt | undefined)!!
  sendMail(input: { accountId: string; email: string; grant: string; draft: LocalMailDraft; checkOnly: boolean; replyTo?: string }): boolean!!
}

error ManagedReadFailed

function viewOf(hash: string): ReadView | undefined {
  if (hash === "#email") return "Email"
  if (hash === "#calendar") return "Calendar"
  return undefined
}

effect function intentOfPage() {
  const found = Effect.try(() => {
    const kept = webView.window.sessionStorage.getItem(retained)
    const previous = Schema.decodeUnknownOption(Schema.fromJsonString(Intent))(kept)
    const active = viewOf(webView.window.location.hash)
    if (active !== undefined) {
      const url = new URL(webView.window.location.href)
      const hint = url.searchParams.get("owner_hint")
      const owner = hint ?? (Option.isSome(previous) ? previous.value.owner : undefined)
      const occurrence = url.searchParams.get("occurrence") ?? undefined
      if (hint !== null || occurrence !== undefined) {
        url.searchParams.delete("owner_hint")
        url.searchParams.delete("occurrence")
        webView.window.history.replaceState(undefined, "", url)
      }
      return { view: active, owner, occurrence: active === "Calendar" && owner && occurrence && /^[a-zA-Z0-9_-]{1,255}$/.test(occurrence) ? occurrence : undefined, returning: false }
    }
    return Option.isSome(previous) ? previous.value : undefined
  }) catch () => undefined
  const result = Schema.decodeUnknownEffect(Intent)(found) catch () => undefined
  if (result?.owner !== undefined && !/^[a-f0-9]{64}$/.test(result.owner)) return { ...result, owner: "invalid" }
  return result
}

effect function ownerHash(owner: string) {
  const bytes = try tryPromise(() => webView.window.crypto.subtle.digest("SHA-256", new TextEncoder().encode(owner)))
  return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("")
}

const google = apiOrigin + googleRoute

effect function query<A>(route: GoogleRead, search: Record<string, string | undefined>, schema: Schema.Decoder<A>, authorization: AccountActions.Shape) {
  const params = new URLSearchParams(Object.entries(search).flatMap(([name, value]) => value ? [[name, value]] : []))
  const get = () => timeout(tryPromise((signal) => webView.window.fetch(google + route + "?" + params, {
    method: "GET", credentials: "include", cache: "no-store", headers: { Accept: "application/json" }, signal,
  })), "12 seconds")
  const first = try get()
  const response = first.status === 401 && (try authorization.run({ kind: "refresh" })) ? (try get()) : first
  if (!response.ok) throw new ManagedReadFailed()
  const input: unknown = route === "gmail/attachment" ? (try timeout(tryPromise(async (signal) => {
    const reader = response.body?.getReader()
    if (!reader) throw new Error("Missing attachment response")
    const decoder = new TextDecoder()
    let length = 0
    let contents = ""
    const stop = () => { void reader.cancel().catch(() => undefined) }
    signal.addEventListener("abort", stop, { once: true })
    try {
      for (;;) {
        const next = await reader.read()
        if (next.done) break
        length += next.value.byteLength
        if (length > encodedAttachmentLimit + 16_384) throw new Error("Attachment response is too large")
        contents += decoder.decode(next.value, { stream: true })
      }
      return JSON.parse(contents + decoder.decode())
    } finally {
      signal.removeEventListener("abort", stop)
      stop()
    }
  }), "12 seconds")) : (try tryPromise(() => response.json()))
  return try Schema.decodeUnknownEffect(schema)(input)
}

effect function postChange<A>(route: GoogleChange, payload: object, schema: Schema.Decoder<A>, authorization: AccountActions.Shape) {
  const post = () => timeout(tryPromise((signal) => webView.window.fetch(google + route, {
    method: "POST", credentials: "include", cache: "no-store", headers: { "Content-Type": "application/json" }, signal, body: JSON.stringify(payload),
  })), "32 seconds")
  const first = try post()
  const response = first.status === 401 && (try authorization.run({ kind: "refresh" })) ? (try post()) : first
  if (!response.ok) throw new ManagedReadFailed()
  return try Schema.decodeUnknownEffect(schema)(try tryPromise(() => response.json()))
}

function range(now: number) {
  return { from: new Date(now).toISOString(), until: new Date(now + 30 * 86400000).toISOString() }
}

effect function scopeOf(native: boolean, view: ReadView, account: SetupState, intent: Intent | undefined): Scope!! {
  if (native) return { kind: "waiting", view, reason: "native" }
  if (account.graceAccount.tag === "CheckingAccount") return { kind: "waiting", view, reason: "checking" }
  if (account.graceAccount.tag === "AccountUnavailable") return { kind: "waiting", view, reason: "unavailable" }
  if (account.graceAccount.tag !== "GraceSignedIn") return { kind: "waiting", view, reason: "signedOut" }
  const accountId = account.graceAccount.accountId
  if (intent?.owner !== undefined) {
    const hash = ownerHash(accountId) catch () => ""
    if (hash !== intent.owner) return { kind: "waiting", view, reason: "mismatch" }
  }
  if (account.googleLink.tag === "GoogleLinkUnavailable") return { kind: "waiting", view, reason: "connectorUnavailable" }
  if (!mayReadManaged(account.graceAccount, account.googleLink, view === "Email" ? "ManagedEmail" : "ManagedCalendar")) {
    return { kind: "waiting", view, reason: "connect" }
  }
  return { kind: "ready", view, accountId, grant: account.googleLink.tag === "GoogleLinkConnected" ? account.googleLink.grant : "" }
}

effect function fetchPage(authorization: AccountActions.Shape, scope: ReadyScope, prior?: Mail | Calendar, next?: string, home?: ReturnType<typeof range>) {
  const paging = { pageToken: next, grantId: scope.grant }
  if (scope.view === "Email") {
    const folder = prior?.kind === "mail" ? prior.folder : "inbox"
    const search = prior?.kind === "mail" ? prior.search : ""
    const loaded = try query("gmail/triage", { maxResults: "20", folder, q: search || undefined, counts: "1", ...paging }, MailPage, authorization)
    const sameListing = loaded.folder === undefined && loaded.q === undefined
      ? folder === "inbox" && search.trim() === "" : loaded.folder === folder && loaded.q === search.trim()
    if (!sameListing || !managedReadMatches(scope.accountId, loaded.accountId, "", "")) throw new ManagedReadFailed()
    const existing = next && prior?.kind === "mail" ? prior.rows : []
    const rows = [...new Map([...existing, ...loaded.messages].map((row) => [row.externalId, row])).values()]
    return { kind: "mail" as const, accountId: scope.accountId, grant: scope.grant, folder, search, counts: loaded.counts ?? (prior?.kind === "mail" ? prior.counts : undefined), rows, next: loaded.nextPageToken }
  }
  const window = prior?.kind === "calendar" ? prior.window : navigation(initialCalendarView.window, "Today", dayOf(try Clock.currentTimeMillis)).window
  const interval = next && prior?.kind === "calendar" ? prior : home
  const from = interval?.from ?? new Date(window.fromTime).toISOString()
  const until = interval?.until ?? new Date(window.mode === "MonthView" ? window.untilTime : Math.max(window.untilTime, midnight(window.selectedDay + 15))).toISOString()
  const loaded = try query("calendar/feed", { timeMin: from, timeMax: until, ...paging }, CalendarPage, authorization)
  if (!managedReadMatches(scope.accountId, loaded.accountId, "", "")) throw new ManagedReadFailed()
  const existing = next && prior?.kind === "calendar" ? prior.rows : []
  const rows = [...new Map([...existing, ...loaded.events].map((row) => [row.externalId, row])).values()]
  return { kind: "calendar" as const, accountId: scope.accountId, grant: scope.grant, rows, next: loaded.nextPageToken, from, until, window }
}

effect function watchHomeCards(native: boolean, pending: Ref.Ref<ReadIntent | undefined>) {
  const cards = try SubscriptionRef.make<HomeCards | undefined>(undefined)
  const authorization = try AccountActions
  const setup = try Setup
  const desk = try Workspaces
  if (!native) {
    const homeScopes = Stream.changesWith(Stream.mapEffect(Stream.zipLatest(desk.changes, setup.changes),
      effect ([workspace, account]) => {
        if (workspace.device.surface !== "Home" || workspace.device.readiness !== "Ready") return undefined
        const intent = try Ref.get(pending)
        return [try scopeOf(native, "Email", account, intent), try scopeOf(native, "Calendar", account, intent)]
          .filter((scope): scope is ReadyScope => scope.kind === "ready")
      }), (a, b) => JSON.stringify(a) === JSON.stringify(b))
    try fork.scoped Stream.runDrain(Stream.switchMap(homeScopes, (selected) => Stream.fromEffect(effect {
      try SubscriptionRef.set(cards, undefined)
      const one = selected?.[0]
      if (!one || !selected) return
      const loaded = try Effect.forEach(selected, effect (scope) => {
        return fetchPage(authorization, scope, undefined, undefined, range(try Clock.currentTimeMillis)) catch () => undefined
      }, { concurrency: 2 })
      const account = try setup.get()
      if (account.graceAccount.tag !== "GraceSignedIn" || account.graceAccount.accountId !== one.accountId ||
        account.googleLink.tag !== "GoogleLinkConnected" || account.googleLink.grant !== one.grant ||
        (try desk.get()).device.surface !== "Home") return
      try SubscriptionRef.set(cards, { accountId: one.accountId, grant: one.grant,
        mail: loaded.find((page) => page?.kind === "mail")?.rows ?? [],
        events: loaded.find((page) => page?.kind === "calendar")?.rows ?? [] })
    })))
  }
  return cards
}

effect function saveIntent(pending: Ref.Ref<ReadIntent | undefined>, intent: Intent | undefined) {
  try Ref.set(pending, intent)
  Effect.try(() => {
    if (intent === undefined) webView.window.sessionStorage.removeItem(retained)
    else webView.window.sessionStorage.setItem(retained, JSON.stringify(intent))
  }) catch () => undefined
}

function mailAttachments(authorization: AccountActions.Shape, files: Library.Shape,
  isCurrent: (scope: ReadyScope, shown: Mail) => boolean!!, publish: (snapshot: ManagedSnapshot) => void!!) {
  effect function verifiedAttachment(scope: ReadyScope, shown: Mail, partId: string) {
    const selected = shown.selected
    const matches = selected?.attachments.filter((entry) => entry.partId === partId)
    const attachment = matches?.length === 1 && matches[0]?.supported ? matches[0] : undefined
    if (!selected?.historyId || !attachment || attachment.size < 0 || attachment.size > attachmentLimit) return undefined
    const messageId = selected.message.externalId
    const original = try query("gmail/attachment", { grantId: scope.grant, messageId, historyId: selected.historyId, partId }, AttachmentReceipt, authorization)
    if (original.accountId !== scope.accountId || (original.grantId !== undefined && original.grantId !== scope.grant) || original.historyId !== selected.historyId || original.messageId !== messageId ||
        original.partId !== partId || original.name !== attachment.name || original.mimeType !== attachment.mimeType || original.size !== attachment.size) return undefined
    if (original.dataBase64.length % 4 !== 0) return undefined
    const decoded = try Effect.try(() => webView.window.atob(original.dataBase64))
    if (decoded.length !== attachment.size) return undefined
    const bytes = Uint8Array.from(decoded, (character) => character.charCodeAt(0))
    const hash = try tryPromise(() => webView.window.crypto.subtle.digest("SHA-256", bytes))
    if (Array.from(new Uint8Array(hash), (byte) => byte.toString(16).padStart(2, "0")).join("") !== original.sha256 ||
        !(try isCurrent(scope, shown))) return undefined
    return { original, bytes }
  }

  effect function openAttachment(scope: ReadyScope, shown: Mail, partId: string) {
    const receipt = try verifiedAttachment(scope, shown, partId)
    if (!receipt) return false
    const { original, bytes } = receipt
    const url = webView.window.URL.createObjectURL(new webView.window.Blob([bytes], { type: original.mimeType }))
    const preview = original.mimeType === "text/plain"
      ? { text: new TextDecoder().decode(bytes.subarray(0, textPreviewLimit)), truncated: bytes.length > textPreviewLimit }
      : undefined
    const organization = original.mimeType !== "text/plain" && original.grantId === scope.grant ? original.organizationId : undefined
    const file = organization && original.size > 0 && original.size <= 5 * 1024 * 1024
      ? { part: partId, digest: original.sha256, organization, saved: false } : undefined
    try publish({ ...shown, attachment: { name: original.name, mimeType: original.mimeType, url, preview, file, deviceTransfer: organization ? original.deviceTransfer : undefined } })
    return true
  }

  effect function importablePart(scope: ReadyScope, shown: Mail, part: string) {
    const receipt = try verifiedAttachment(scope, shown, part)
    if (!receipt || !shown.selected || receipt.original.grantId !== scope.grant || !receipt.original.organizationId) throw new ManagedReadFailed()
    const { original, bytes } = receipt
    const extensions = { "image/jpeg": ".jpg", "image/png": ".png", "image/webp": ".webp", "application/pdf": ".pdf" }
    if (original.size < 1 || original.size > 5 * 1024 * 1024 || original.mimeType === "text/plain") throw new ManagedReadFailed()
    const extension = extensions[original.mimeType]
    const lowerName = original.name.toLowerCase()
    const name = lowerName.endsWith(extension) || (extension === ".jpg" && lowerName.endsWith(".jpeg")) ? original.name : original.name + extension
    const pdf = original.mimeType === "application/pdf"
    const pages = pdf ? (try tryPromise(async () => (await (await import("pdf-lib")).PDFDocument.load(bytes)).getPageCount())) : 0
    if (pdf && (pages < 1 || pages > 1000)) throw new ManagedReadFailed()
    if (!pdf) {
      const bitmap = try tryPromise(() => webView.window.createImageBitmap(new webView.window.Blob([bytes], { type: original.mimeType })))
      try Effect.try(() => bitmap.close())
    }
    const id = try ownerHash(JSON.stringify(["gmail-original", scope.accountId, original.organizationId, scope.grant, original.messageId, part]))
    const file: SavedFile = { id, kind: pdf ? "Pdf" : "Photo", name, origin: "gmail", account: scope.accountId,
      container: scope.grant, sourceRef: id, contentRef: original.sha256, group: original.messageId, savedAt: Date.parse(shown.selected.message.receivedAt), pages }
    return { file, organization: original.organizationId, data: original.dataBase64, mimeType: original.mimeType }
  }

  effect function saveAttachment(scope: ReadyScope, shown: Mail, allPhotos: boolean) {
    const selected = shown.selected
    if (!selected?.historyId) return false
    const reference = shown.attachment?.file
    const parts = allPhotos ? selected.attachments.filter((part) => part.mimeType.startsWith("image/")).map((part) => part.partId)
      : reference ? [reference.part] : []
    if (!parts.length) return false
    const available = try Effect.forEach(parts, (part) => importablePart(scope, shown, part))
    const first = available[0]
    if (!first || available.some((part) => part.organization !== first.organization) ||
        (!allPhotos && (reference?.organization !== first.organization || reference?.digest !== first.file.contentRef))) return false
    const owner = try ownerHash(JSON.stringify(["grace/files/owner", scope.accountId, first.organization]))
    const content = new Map(available.map((part) => [part.file.id, part]))
    const outcome = try files.save(available.map((part) => part.file), effect (file) => {
      const part = content.get(file.id)
      if (!part || !(try isCurrent(scope, shown))) throw new ManagedReadFailed()
      return { data: part.data, mimeType: part.mimeType }
    }, JSON.stringify(parts), selected.historyId, { from: "", subject: "" }, owner)
    if (outcome !== "FilesSaved" || !(try isCurrent(scope, shown))) return false
    if (allPhotos) try publish({ ...shown, photosSaved: available.length })
    else if (shown.attachment && reference) try publish({ ...shown, attachment: { ...shown.attachment, file: { ...reference, saved: true } } })
    return true
  }

  return { openAttachment, saveAttachment }
}

effect function managedWrites({ setup, authorization, latest, activeScope, still, publish, refresh }: {
  setup: Setup.Shape; authorization: AccountActions.Shape; latest: SubscriptionRef.SubscriptionRef<ManagedSnapshot>
  activeScope: () => Scope!!; still: (scope: ReadyScope) => boolean!!
  publish: (snapshot: ManagedSnapshot) => void!!; refresh: (scope: Scope) => void!!
}) {
  const desk = try Workspaces
  const proposedNumber = try Ref.make(0)

  effect function publishReview(scope: ReadyScope, shown: Mail | Calendar, next: Mail | Calendar) {
    if (!(try still(scope))) return false
    return try SubscriptionRef.modifySome(latest, (current) =>
      current === shown ? [true, Option.some(next)] : [false, Option.none()])
  }

  effect function readSeries(scope: ReadyScope, shown: Calendar, occurrenceId: string) {
    const selected = shown.selected
    if (shown.accountId !== scope.accountId || shown.grant !== scope.grant || selected?.externalId !== occurrenceId || !selected.seriesId) return undefined
    const found = try query("calendar/series", { grantId: scope.grant, occurrenceId }, Series, authorization)
    return managedReadMatches(scope.accountId, found.accountId, occurrenceId, found.occurrenceId) &&
      found.event.externalId === selected.seriesId ? found.event : undefined
  }

  effect function stage(proposal: ProposedWork) {
    const scope = try activeScope()
    const { accountId, grant } = proposal
    const mail = proposal.kind === "draft" || proposal.kind === "trash"
    if (scope.kind !== "ready" || scope.accountId !== accountId || scope.grant !== grant ||
      scope.view !== (mail ? "Email" : "Calendar")) return false
    const account = try setup.get()
    const shown = try SubscriptionRef.get(latest)
    if ((shown.kind !== "mail" && shown.kind !== "calendar") || shown.accountId !== accountId || shown.grant !== grant) return false
    let reviewed = shown
    if (proposal.kind === "draft") {
      if (shown.kind !== "mail" || account.googleLink.tag !== "GoogleLinkConnected" ||
        !maySendManagedMail(account.graceAccount, account.googleLink, accountId, grant)) return false
      if (proposal.replyTo ? shown.selected?.message.externalId !== proposal.replyTo ||
        shown.selected.reply?.recipient !== proposal.recipient || shown.selected.reply.subject !== proposal.subject : shown.selected !== undefined) return false
      const email = account.googleLink.email
      const saved = try localMailDraft(accountId, email, proposal.replyTo)
      if (saved.operationId || saved.recipient || saved.subject || saved.text) return false
      try keepMailDraft(accountId, email, { recipient: proposal.recipient, subject: proposal.subject, text: proposal.text }, proposal.replyTo)
    } else if (proposal.kind === "trash") {
      if (shown.kind !== "mail" || !shown.selected || !isSelectedVersion(shown.selected.message.externalId, inboxTrashVersion(shown) ?? "", proposal.id, proposal.version) ||
        !mayChangeManaged(account.graceAccount, account.googleLink, accountId, grant, "ManagedTrash")) return false
    } else {
      if (shown.kind !== "calendar" || !mayChangeManaged(account.graceAccount, account.googleLink, accountId, grant, "ManagedAppointmentChange")) return false
      if ((proposal.id !== undefined || proposal.version !== undefined) && (!shown.selected ||
        !isSelectedVersion(shown.selected.externalId, shown.selected.etag ?? "", proposal.id ?? "", proposal.version ?? ""))) return false
      if (proposal.kind === "removeAppointment" && proposal.series) {
        const event = try readSeries(scope, shown, proposal.id)
        if (!event) return false
        reviewed = { ...shown, series: event }
      }
    }
    const number = try Ref.updateAndGet(proposedNumber, (prior) => prior + 1)
    return try publishReview(scope, shown, { ...reviewed, proposed: { number, proposal } })
  }

  effect function series({ accountId, grant }: WriteScope, occurrenceId: string) {
    const scope = try activeScope()
    const account = try setup.get()
    if (scope.kind !== "ready" || scope.view !== "Calendar" || scope.accountId !== accountId || scope.grant !== grant ||
      !mayChangeManaged(account.graceAccount, account.googleLink, accountId, grant, "ManagedAppointmentChange")) return undefined
    const shown = try SubscriptionRef.get(latest)
    if (shown.kind !== "calendar") return undefined
    const event = try readSeries(scope, shown, occurrenceId)
    if (!event || !(try publishReview(scope, shown, { ...shown, series: event }))) return undefined
    return event
  }

  effect function change({ accountId, grant }: WriteScope, action: ManagedWrite) {
    const scope = try activeScope()
    const kind = action.kind === "appointment" ? "ManagedAppointmentChange" : "ManagedTrash"
    const view = action.kind === "appointment" ? "Calendar" : "Email"
    const account = try setup.get()
    if (scope.kind !== "ready" || scope.view !== view || scope.accountId !== accountId ||
      !mayChangeManaged(account.graceAccount, account.googleLink, accountId, grant, kind)) return undefined
    const shown = try SubscriptionRef.get(latest)
    if ((shown.kind !== "mail" && shown.kind !== "calendar") || shown.grant !== grant || shown.accountId !== accountId) return undefined
    if (action.kind === "trash" && (shown.kind !== "mail" || !shown.selected ||
      !isSelectedVersion(shown.selected.message.externalId, inboxTrashVersion(shown) ?? "", action.id, action.version))) return undefined
    if (action.kind === "appointment" && action.action !== "create") {
      if (shown.kind !== "calendar") return undefined
      const target = action.seriesFor === undefined ? shown.selected
        : shown.selected?.externalId === action.seriesFor && shown.selected.seriesId === action.id ? shown.series : undefined
      if (!target || !isSelectedVersion(target.externalId, target.etag ?? "", action.id, action.version)) return undefined
    }
    const operationId = try Effect.try(() => webView.window.crypto.randomUUID())
    const common = { accountId, grantId: grant, operationId }
    const payload = action.kind === "appointment"
      ? action.action === "create" ? { ...common, action: action.action, event: action.event }
        : { ...common, action: action.action, id: action.id, version: action.version, seriesFor: action.seriesFor, event: action.action === "update" ? action.event : undefined }
      : { ...common, messageId: action.id, version: action.version, undoOf: action.kind === "undo" ? action.prior : undefined }
    const receipt = try postChange(action.kind === "appointment" ? "calendar/change" : "gmail/trash", payload, ActionReceipt, authorization)
    const expected = "id" in action ? action.id : operationId.replaceAll("-", "")
    if (!managedReadMatches(accountId, receipt.accountId, expected, receipt.itemId) || receipt.operationId !== operationId ||
      !(try still(scope))) return undefined
    if (action.kind === "trash" && shown.kind === "mail") {
      const remaining = { ...shown, counts: undefined, rows: shown.rows.filter((row) => row.externalId !== action.id), selected: undefined, attachment: undefined, proposed: undefined }
      try publish(remaining)
      if (shown.counts !== undefined) {
        const refreshed = fetchPage(authorization, scope, remaining) catch () => undefined
        if (refreshed?.kind === "mail" && refreshed.counts !== undefined) try publishReview(scope, remaining, { ...remaining, counts: refreshed.counts })
      }
    }
    if (action.kind === "undo" || action.kind === "appointment") try refresh(scope)
    return receipt
  }

  effect function sendMail({ accountId, email, grant, draft, checkOnly, replyTo }: { accountId: string; email: string; grant: string; draft: LocalMailDraft; checkOnly: boolean; replyTo?: string }) {
    const scope = try activeScope()
    if (scope.kind !== "ready" || scope.view !== "Email" || scope.accountId !== accountId) return false
    const account = try setup.get()
    if (!maySendManagedMail(account.graceAccount, account.googleLink, accountId, grant) ||
      account.googleLink.tag !== "GoogleLinkConnected" || account.googleLink.email !== email) return false
    const operationId = draft.operationId
    if (!operationId || draft.grant !== grant) return false
    if (replyTo && !checkOnly) {
      const current = try SubscriptionRef.get(latest)
      if (current.kind !== "mail" || current.grant !== grant || current.selected?.message.externalId !== replyTo ||
        current.selected.reply?.recipient !== draft.recipient || current.selected.reply.subject !== draft.subject) return false
    }
    try keepMailDraft(accountId, email, draft, replyTo)
    const payload = { accountId, grantId: grant, operationId, recipient: draft.recipient, subject: draft.subject, text: draft.text, replyTo }
    const receipt = checkOnly
      ? (try query("gmail/send/status", { grantId: grant, operationId }, SentMail, authorization))
      : (try postChange("gmail/send", payload, SentMail, authorization))
    if (!managedReadMatches(accountId, receipt.accountId, operationId, receipt.operationId)) return false
    try keepMailDraft(accountId, email, null, replyTo)
    return try still(scope)
  }

  effect function chooseLink(shown: Mail, link: string, choice: "open" | "confirm" | "cancel") {
    const selected = actionableMailBody(shown.selected)
    if (!selected || (try SubscriptionRef.get(latest)) !== shown || shown.attachment || shown.proposed || shown.replying) return false
    const held = shown.linkReview
    if (choice === "open" ? held !== undefined : held?.link !== link) return false
    const reading = held ? { ...shown, linkReview: undefined } : shown
    if (held) {
      const claimed = try SubscriptionRef.modifySome(latest, (current) => current === shown ? [true, Option.some(reading)] : [false, Option.none()])
      if (!claimed || choice === "cancel") return claimed
    }
    if (!messageLinkParts(selected.bodyText).some((part) => typeof part !== "string" && part.href === link)) return false
    const scope = try activeScope()
    if (scope.kind !== "ready" || scope.view !== "Email" || scope.accountId !== shown.accountId || scope.grant !== shown.grant) return false
    const google = (try setup.get()).googleLink
    if (google.tag !== "GoogleLinkConnected" || (try localMailDraft(shown.accountId, google.email, selected.message.externalId)).operationId) return false
    const before = try desk.get()
    const release = held ?? { link, deviceVersion: before.device.contextVersion, browserRevision: before.browser.revision }
    const messageId = selected.message.externalId
    const fresh = try query("gmail/read", { grantId: scope.grant, messageId }, MailBody, authorization)
    const warned = selected.message.labels?.includes("SPAM") === true
    if (!managedReadMatches(scope.accountId, fresh.accountId, messageId, fresh.message.externalId) ||
      !actionableMailBody(fresh) || fresh.historyId !== selected.historyId || fresh.bodyText !== selected.bodyText ||
      fresh.message.from !== selected.message.from || fresh.message.fromEmail !== selected.message.fromEmail ||
      fresh.message.subject !== selected.message.subject || fresh.message.labels?.includes("SPAM") !== warned ||
      !(try currentManagedMailGrant(scope.accountId, scope.grant)) || !(try still(scope)) || (try SubscriptionRef.get(latest)) !== reading) return false
    if (warned && choice === "open") {
      return try SubscriptionRef.modifySome(latest, (current) => current === shown ? [true, Option.some({ ...shown, linkReview: release })] : [false, Option.none()])
    }
    try desk.send({ type: "openReleasedEmailLink", release }, "Host", () => {
      const account = Effect.runSync(setup.get())
      return Effect.runSync(SubscriptionRef.get(latest)) === reading && account.graceAccount.tag === "GraceSignedIn" &&
        account.graceAccount.accountId === scope.accountId && account.googleLink.tag === "GoogleLinkConnected" &&
        account.googleLink.grant === scope.grant && mayReadManaged(account.graceAccount, account.googleLink, "ManagedEmail")
    })
    return true
  }

  effect function replyVisibility(shown: Mail, opened: boolean) {
    const current = try SubscriptionRef.get(latest)
    if (current.kind === "mail" && current.selected === shown.selected && current.accountId === shown.accountId && current.grant === shown.grant)
      try publish({ ...current, replying: opened })
  }

  return { stage, series, change, sendMail, chooseLink, replyVisibility }
}

export const managedReads = (native: boolean) => Layer.effect(ManagedReads, effect {
  const desk = try Workspaces
  const setup = try Setup
  const authorization = try AccountActions
  const files = try Library
  const pending = try Ref.make<ReadIntent | undefined>(native ? undefined : (try intentOfPage()))
  const latest = try SubscriptionRef.make<ManagedSnapshot>({ kind: "closed" })
  const cards = try watchHomeCards(native, pending)
  const gate = try Semaphore.make(1)

  effect function publish(snapshot: ManagedSnapshot) {
    const previous = try SubscriptionRef.get(latest)
    const url = previous.kind === "mail" ? previous.attachment?.url : undefined
    if (url && (snapshot.kind !== "mail" || snapshot.attachment?.url !== url)) webView.window.URL.revokeObjectURL(url)
    try SubscriptionRef.set(latest, snapshot.kind === "mail" && snapshot.linkReview ? { ...snapshot, linkReview: undefined } : snapshot)
  }

  try addFinalizer(() => publish({ kind: "closed" }))

  effect function activeScope(): Scope!! {
    const surface = (try desk.get()).device.surface
    if (surface !== "Email" && surface !== "Calendar") return { kind: "closed" }
    return try scopeOf(native, surface, try setup.get(), try Ref.get(pending))
  }

  effect function still(scope: ReadyScope): boolean!! {
    const current = try activeScope()
    return current.kind === "ready" && current.view === scope.view && current.accountId === scope.accountId && current.grant === scope.grant
  }

  effect function ownsSurfaces(): boolean!! {
    return usesManagedSurfaces(try setup.get(), webView.window.location.hash)
  }

  effect function guidedSelection(): GuidedManagedSelection!! {
    const account = try setup.get()
    if (!usesManagedSurfaces(account, webView.window.location.hash)) return { kind: "legacy" }
    const scope = try activeScope()
    const shown = try SubscriptionRef.get(latest)
    if (scope.kind !== "ready" || account.graceAccount.tag !== "GraceSignedIn" ||
        account.googleLink.tag !== "GoogleLinkConnected" || account.graceAccount.accountId !== scope.accountId ||
        account.googleLink.grant !== scope.grant ||
        (shown.kind !== "mail" && shown.kind !== "calendar") || shown.accountId !== scope.accountId || shown.grant !== scope.grant ||
        (shown.kind === "mail") !== (scope.view === "Email")) return { kind: "unavailable" }
    const googleEmail = account.googleLink.email.trim().toLowerCase()
    if (googleEmail === "" || scope.grant === "") return { kind: "unavailable" }
    const ownership = { accountId: scope.accountId, grant: scope.grant, googleEmail }
    if (shown.kind === "mail") {
      const selected = shown.selected
      const version = selected?.message.metadata?.historyId
      if (!selected || !version || selected.accountId !== scope.accountId) return { kind: "unavailable" }
      return { ...ownership, kind: "mail", id: selected.message.externalId, version, subject: selected.message.subject }
    }
    const selected = shown.selected
    if (!selected?.etag) return { kind: "unavailable" }
    return { ...ownership, kind: "calendar", id: selected.externalId, version: selected.etag, title: selected.title, startAt: selected.startAt }
  }

  effect function refresh(scope: Scope) {
    const home = try Ref.modify(pending, (intent) => {
      if (!intent?.homeOccurrence) return [undefined, intent] as const
      const { homeOccurrence, ...next } = intent
      return [homeOccurrence, next] as const
    })
    if (scope.kind !== "ready") return try publish(scope)
    const previous = try SubscriptionRef.get(latest)
    const prior = !home && (previous.kind === "mail" || previous.kind === "calendar") && previous.accountId === scope.accountId && previous.grant === scope.grant ? previous : undefined
    try publish({ kind: "loading", view: scope.view, accountId: scope.accountId })
    const result = fetchPage(authorization, scope, prior, undefined, home ? range(try Clock.currentTimeMillis) : undefined) catch () => ({ kind: "failed", view: scope.view, accountId: scope.accountId } as const)
    if (home && result.kind === "calendar" && scope.accountId === home.accountId && scope.grant === home.grant && (try still(scope))) {
      const selected = result.rows.find((row) => row.externalId === home.id && (row.etag ?? null) === home.version)
      return try publish({ ...result, selected })
    }
    const intent = try Ref.get(pending)
    if (result.kind === "calendar" && intent?.occurrence !== undefined && intent.owner !== undefined) {
      const occurrence = intent.occurrence
      const selected = query("calendar/reminder/event", { occurrenceId: occurrence, grantId: scope.grant },
        Schema.Struct({ accountId: idField, event: EventRow }), authorization) catch () => undefined
      if (try still(scope)) {
        try saveIntent(pending, { ...intent, occurrence: undefined })
        if (selected && managedReadMatches(scope.accountId, selected.accountId, intent.occurrence, selected.event.externalId))
          return try publish({ ...result, selected: selected.event })
      }
    }
    if (try still(scope)) try publish(result)
  }

  const { openAttachment, saveAttachment } = mailAttachments(authorization, files,
    effect (scope, shown) => (try still(scope)) && (try SubscriptionRef.get(latest)) === shown, publish)
  const { stage, series, change, sendMail, chooseLink, replyVisibility } = try managedWrites({ setup, authorization, latest, activeScope, still, publish, refresh })

  effect function send(command: Command) {
    if (command.kind === "homeOccurrence") {
      const { row } = command
      const home = try SubscriptionRef.get(cards)
      const before = try Ref.get(pending)
      const scope = try scopeOf(native, "Calendar", try setup.get(), before)
      if ((try desk.get()).device.surface !== "Home" || scope.kind !== "ready" ||
        scope.accountId !== row.accountId || scope.grant !== row.grant ||
        home?.accountId !== row.accountId || home.grant !== row.grant ||
        !home.events.some((event) => event.externalId === row.id && (event.etag ?? null) === row.version)) return false
      try Ref.set(pending, { ...before, view: "Calendar", returning: false, occurrence: undefined, homeOccurrence: row })
      const visited = desk.send({ type: "visit", destination: "Calendar" }, "Person") catch () => undefined
      if (visited === undefined) try Ref.set(pending, before)
      return visited !== undefined
    }
    const scope = try activeScope()
    if (scope.kind === "closed") return false
    if (command.kind === "enableReminders") {
      const host = reminderPlugin
      if (!native || scope.view !== "Calendar" || host === undefined) return false
      try tryPromise(() => host.enableManagedReminders())
      return true
    }
    if (command.kind === "openHosted") {
      const host = accountPlugin
      if (!native || host === undefined) return false
      try tryPromise(() => host.openHostedView({ view: fragments[scope.view] }))
      return true
    }
    if (command.kind === "account") {
      if (scope.kind !== "waiting" || !["signedOut", "connect", "mismatch"].includes(scope.reason)) return false
      const kept = try Ref.get(pending)
      try saveIntent(pending, { view: scope.view, owner: kept?.owner, occurrence: kept?.occurrence, returning: true })
      try desk.send({ type: "chooseSettingsPage", page: "AccountSettings" }, "Person")
      return true
    }
    if (command.kind === "refresh") {
      try authorization.run({ kind: "refresh" })
      try refresh(try activeScope())
      return true
    }
    if (scope.kind !== "ready") return false
    const shown = try SubscriptionRef.get(latest)
    if ((shown.kind !== "mail" && shown.kind !== "calendar") || shown.accountId !== scope.accountId || shown.grant !== scope.grant ||
      (shown.kind === "mail") !== (scope.view === "Email")) return false
    if (command.kind === "openAttachment") return shown.kind === "mail" && (try openAttachment(scope, shown, command.partId))
    if (command.kind === "saveAttachment" || command.kind === "savePhotos") return shown.kind === "mail" && (try saveAttachment(scope, shown, command.kind === "savePhotos"))
    if (command.kind === "closeAttachment") {
      if (shown.kind !== "mail") return false
      try publish({ ...shown, attachment: undefined })
      return true
    }
    if (command.kind === "reminder") {
      if (shown.kind !== "calendar" || shown.selected?.externalId !== command.id ||
          shown.selected.etag !== command.version || shown.selected.isAllDay || !shown.selected.editable) return false
      const receipt = try postChange("calendar/reminder", { accountId: scope.accountId, grantId: scope.grant,
        occurrenceId: command.id, version: command.version, minutes: command.minutes },
        Schema.Struct({ accountId: idField, grantId: idField, occurrenceId: idField, version: idField,
          status: Schema.Literals(["saved", "cancelled"]), minutes: Schema.optional(Schema.Int), fireAt: Schema.optional(Schema.Int) }), authorization)
      return (try still(scope)) && receipt.accountId === scope.accountId && receipt.grantId === scope.grant &&
        receipt.occurrenceId === command.id && receipt.version === command.version &&
        (command.minutes === 0 ? receipt.status === "cancelled" : receipt.status === "saved" &&
          receipt.minutes === command.minutes && receipt.fireAt === Date.parse(shown.selected.startAt) - command.minutes * 60_000)
    }
    if (command.kind === "dismissProposal") {
      try publish({ ...shown, proposed: undefined })
      return true
    }
    if (command.kind === "back") {
      try publish(shown.kind === "calendar" ? { ...shown, selected: undefined, series: undefined, proposed: undefined } : { ...shown, selected: undefined, attachment: undefined, proposed: undefined })
      return true
    }
    if (command.kind === "mailFolder" || command.kind === "calendarWindow") {
      if (command.accountId !== scope.accountId || command.grant !== scope.grant) return false
      const prior = command.kind === "mailFolder" && shown.kind === "mail" ? { ...shown, folder: command.folder, search: command.search }
        : command.kind === "calendarWindow" && shown.kind === "calendar" ? { ...shown, window: navigation(shown.window, command.move, command.day).window } : undefined
      if (prior === undefined) return false
      const page = try fetchPage(authorization, scope, prior)
      if (!(try still(scope)) || (try SubscriptionRef.get(latest)) !== shown) return false
      try publish(page)
      return true
    }
    if (command.kind === "more") {
      if (shown.next === null) return false
      const page = try fetchPage(authorization, scope, shown, shown.next)
      if (!(try still(scope)) || (try SubscriptionRef.get(latest)) !== shown) return false
      try publish(page)
      return true
    }
    if (command.kind !== "open" || !shown.rows.some((row) => row.externalId === command.id)) return false
    if (shown.kind === "calendar") {
      try publish({ ...shown, selected: shown.rows.find((row) => row.externalId === command.id), series: undefined, proposed: undefined })
      return true
    }
    const preview = try query("gmail/read", { messageId: command.id, grantId: scope.grant }, MailBody, authorization)
    if (!managedReadMatches(scope.accountId, preview.accountId, command.id, preview.message.externalId) ||
        !(try still(scope)) || (try SubscriptionRef.get(latest)) !== shown) return false
    try publish({ ...shown, selected: preview, replying: false, photosSaved: undefined, attachment: undefined, proposed: undefined })
    return true
  }

  if (!native) {
    const onOpening = try Ref.get(pending)
    if (onOpening !== undefined && viewOf(webView.window.location.hash) !== undefined) {
      try saveIntent(pending, onOpening)
      try fork.scoped effect {
        try Stream.runHead(Stream.filter(desk.changes, (w) => w.device.readiness === "Ready"))
        desk.send({ type: "visit", destination: onOpening.view }, "Person") catch () => undefined
      }
    }
    try fork.scoped Stream.runForEach(Stream.zipLatest(desk.changes, setup.changes), effect ([workspace, account]) => {
      const next = try Ref.get(pending)
      if (next?.returning && workspace.device.surface === "DeviceSettings" && workspace.device.settingsPage === "AccountSettings") {
        const scope = try scopeOf(native, next.view, account, next)
        if (scope.kind !== "ready" && (scope.kind !== "waiting" || scope.reason !== "connectorUnavailable")) return
        const opened = desk.send({ type: "visit", destination: next.view }, "Person") catch () => undefined
        if (opened !== undefined) try saveIntent(pending, { ...next, returning: false })
      }
    })
  }
  const scopes = Stream.changesWith(
    Stream.mapEffect(Stream.zipLatest(desk.changes, setup.changes), () => activeScope()),
    (left, right) => JSON.stringify(left) === JSON.stringify(right),
  )
  try fork.scoped Stream.runDrain(Stream.switchMap(scopes, (scope) => Stream.fromEffect(refresh(scope))))
  return {
    state: SubscriptionRef.changes(latest),
    home: SubscriptionRef.changes(cards),
    homeCards: () => SubscriptionRef.get(cards),
    get: () => SubscriptionRef.get(latest),
    ownsSurfaces,
    guidedSelection,
    chooseLink: effect (shown, link, choice) => chooseLink(shown, link, choice) catch () => false,
    replyVisibility,
    send: effect (command) => gate.withPermit(send(command)) catch () => false,
    stage: effect (proposal) => gate.withPermit(stage(proposal)) catch () => false,
    series: effect (scope, occurrenceId) => gate.withPermit(series(scope, occurrenceId)) catch () => undefined,
    change: effect (scope, action) => gate.withPermit(change(scope, action)) catch () => undefined,
    sendMail: effect (input) => gate.withPermit(sendMail(input)) catch () => false,
  }
})
