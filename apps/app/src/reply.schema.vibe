// spec/app/conversation.md, "Responses have a written equivalent and only current callbacks change the turn"; spec/app/conversation.md, "A tapped answer preserves whether the microphone was active"
import { Schema, SchemaGetter } from "effect"

const Words = Schema.Trimmed.check(Schema.isMinLength(1))
const Percent = (minimum: number) => Schema.Int.check(Schema.isBetween({ minimum, maximum: 100 }))
const Day = Schema.String.check(Schema.isPattern(/^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/))
const Clock = Schema.String.check(Schema.isPattern(/^([01]\d|2[0-3]):[0-5]\d$/))
const action = <const Kind extends string, const Fields extends Schema.Struct.Fields>(kind: Kind, fields: Fields) =>
  Schema.Struct({ kind: Schema.Literal(kind), ...fields })

export const Action = Schema.Union([
  action("open", { surface: Schema.Literals(["Home", "Calendar", "Email", "Browser", "Files", "DeviceSettings"]) }),
  action("showSetting", { page: Schema.Literals(["TextSizeSettings", "BrightnessSettings", "VoiceSettings", "NetworkSettings", "AboutSettings"]) }),
  action("setTextSize", { size: Schema.Literals(["Smaller", "StandardText", "Larger", "Largest"]) }),
  action("setPace", { pace: Schema.Literals(["Slower", "Normal", "Faster"]) }),
  action("setVolume", { volume: Percent(0) }),
  action("setMuted", { muted: Schema.Boolean }),
  action("setBrightness", { brightness: Percent(20) }),
  action("setVoiceOutput", { on: Schema.Boolean }),
  action("undoSetting", {}),
  action("visit", { url: Words }),
  action("browse", { control: Schema.Literals(["Back", "Forward", "Reload"]) }),
  action("guide", { target: Words, emphasis: Schema.Literals(["point", "instruction", "confirm"]), title: Words, detail: Schema.optionalKey(Words) }),
  action("proposeAppointment", { entry: Schema.optionalKey(Words), title: Words, day: Day, time: Clock, place: Schema.String, repeat: Schema.Literals(["Once", "Weekly", "Monthly"]) }),
  action("confirmAppointment", {}),
  action("deleteAppointment", { entry: Words, scope: Schema.Literals(["ThisOccurrence", "EntireSeries"]) }),
  action("searchMail", { query: Words }),
  action("openMessage", { message: Words }),
  action("chooseFolder", { folder: Schema.Literals(["InboxFolder", "SentFolder", "DraftsFolder", "TrashFolder"]) }),
  action("draftReply", { body: Words }),
  action("draftMessage", { to: Words, subject: Schema.String, body: Words }),
  action("trashMessage", {}),
  action("findFile", { tab: Schema.Literals(["Photos", "Documents"]), query: Words }),
  action("beginTask", { task: Schema.Literals(["PayBill", "BookAppointment"]) }),
  action("fill", {}),
])
export type Action = typeof Action.Type

const Said = { text: Words, actions: Schema.Array(Action) }
const Statement = Schema.Struct({ ...Said, isQuestion: Schema.Literal(false), answers: Schema.Tuple([]) })
const Question = Schema.Struct({
  ...Said,
  isQuestion: Schema.Literal(true),
  answers: Schema.Union([Schema.Tuple([]), Schema.Array(Words).check(Schema.isBetweenLength(2, 3))]),
})

const Spoken = Schema.Struct({
  text: Schema.String,
  isQuestion: Schema.optionalKey(Schema.Boolean),
  answers: Schema.optionalKey(Schema.Array(Schema.String)),
  actions: Schema.optionalKey(Schema.Array(Action)),
})

export const Reply = Spoken.pipe(Schema.decodeTo(Schema.Union([Statement, Question]), {
  decode: SchemaGetter.transform((said: typeof Spoken.Type) => {
    const answers = (said.answers ?? []).map((answer) => answer.trim()).filter((answer) => answer !== "")
    const reply = { text: said.text.trim(), actions: said.actions ?? [] }
    return said.isQuestion
      ? { ...reply, isQuestion: true as const, answers: answers.length >= 2 && answers.length <= 3 ? answers : [] }
      : { ...reply, isQuestion: false as const, answers: [] as const }
  }),
  encode: SchemaGetter.transform((reply) => reply),
}))
export type Reply = typeof Reply.Type
