// spec/app/browserControls.md, "Story: Ask Grace to start a private sign-in for my bill"
import { activeTab, tabUrl } from "../gen/app__browser.effect.vibe"
import { directSignInRequest } from "../gen/app__browserControls.effect.vibe"
import { Machine as Workspaces } from "../gen/app__workspace.effect.vibe"
import { NativePage } from "./nativePage.vibe"

export effect function requestedPrivateSignIn(words: string, tab: number, revision: number): boolean!! {
  if (!directSignInRequest(words.trim().toLowerCase().replace(/[.!?]+$/, ""))) return false
  const native = try NativePage
  if (!native.privateSignIn) return false
  const workspace = try Workspaces
  const now = try workspace.get()
  if (now.device.surface !== "Browser" || now.browser.selected !== tab || now.browser.revision !== revision) return false
  const parsed = URL.parse(tabUrl(activeTab(now.browser)))
  if (parsed === null || parsed.protocol !== "https:" || parsed.username !== "" || parsed.password !== "") return false
  const browserInput = { tag: "RequestPrivateSignIn" as const, id: tab, revision, origin: parsed.origin }
  return Effect.as(workspace.send({ type: "changePage", browserInput }, "Person"), true) catch () => false
}
