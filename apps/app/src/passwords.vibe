// spec/app/index.md, "Story: Manage my saved passwords privately"
import { type Event, Machine, type VaultIssue, type VaultNotice, type PasswordGuide, passwordGuide } from "../gen/app.effect.vibe"
import { directSignInRequest } from "../gen/app__browserControls.effect.vibe"
import { NativePage } from "./nativePage.vibe"
import { requestedPrivateSignIn } from "./requestedPrivateSignIn.vibe"
import { canHear, type AudioOwner } from "../gen/app__conversation.effect.vibe"
import { Machine as Workspaces, privateSurfaceActive } from "../gen/app__workspace.effect.vibe"
import { type PasswordsClient, PasswordsClientError } from "@elizaos/os/bridges/passwords"
import { passwordBackupPlugin, type PasswordBackupPlugin, privateViewPlugin, webView } from "./surfacePlugin.ts"

export type PasswordVault = Pick<PasswordsClient, "status" | "unlock" | "lock" | "list" | "openEditor" | "remove" | "reveal" | "copy" | "openAutofillSettings">

export type PasswordAction =
  | { kind: "Unlock" | "Add" | "Autofill" | "Backup" }
  | { kind: "Edit" | "Show" | "Copy" | "Delete"; id: string; revision: number }

export service Passwords {
  act(action: PasswordAction): void!!
  guideTyped(revision: number): boolean!!
  guideSpeech(input: { token: number; complete: boolean; owner: AudioOwner; text: string }): boolean!!
  finishGuide(): void!!
}

function issue(code: string): VaultIssue | undefined {
  if (code === "legacy-authorization-required") return "LegacyAuthorization"
  if (code === "key-invalidated" || code === "legacy-key-unavailable") return "LostVaultKey"
  if (code === "not-admitted") return "VaultClosed"
  if (code === "unavailable") return "UnsupportedVault"
  return undefined
}

export function passwordDirection(text: string) {
  const words = text.trim().toLowerCase().replace(/[.!?]+$/, "")
  return directSignInRequest(words) ? "FillPasswordGuide" : passwordGuide(words)
}

const hidden = sync(() => webView.hidden())

effect function passwordGuidance(host: (event: Event) => void!!) {
  const workspace = try Workspaces
  const native = try NativePage
  effect function guideTo(guide: PasswordGuide) {
    if (guide === "NoPasswordGuide" || privateSurfaceActive(try workspace.get()) || (try hidden)) return false
    try host({ type: "setPasswordGuide", guide })
    const destination = guide === "FillPasswordGuide" ? "Browser" : "Passwords"
    const now = try workspace.get()
    if (now.device.surface === destination) return true
    const visit = workspace.send({ type: "visit", destination }, "Person") catch () => undefined
    return visit !== undefined
  }

  effect function guideSpeech(input: { token: number; complete: boolean; owner: AudioOwner; text: string }) {
    const now = try workspace.get()
    const { assistant } = now
    if (!input.complete || input.owner !== "HumanAudio" || assistant.presentation === "Closed" || privateSurfaceActive(now) ||
      !canHear(assistant.conversation, input.token, input.text, input.owner, "ConversationRuntime")) return false
    const guide = passwordDirection(input.text)
    if (guide === "NoPasswordGuide") return false
    workspace.send({ type: "closeGrace" }, "Person") catch () => undefined
    if (try requestedPrivateSignIn(input.text, now.browser.selected, now.browser.revision, workspace, native)) {
      try host({ type: "setPasswordGuide", guide: "NoPasswordGuide" })
      return true
    }
    return try guideTo(guide)
  }

  return {
    guideTyped: (revision: number) => effect {
      const now = try workspace.get()
      const { assistant } = now
      const { draft, draftRevision, voice } = assistant.conversation
      if (revision !== draftRevision || voice || assistant.presentation === "Closed" || privateSurfaceActive(now)) return false
      const guide = passwordDirection(draft)
      if (guide === "NoPasswordGuide") return false
      const cleared = workspace.send({ type: "interact", input: { tag: "EditDraft", text: "" } }, "Person") catch () => undefined
      if (cleared === undefined) return false
      workspace.send({ type: "closeGrace" }, "Person") catch () => undefined
      if (try requestedPrivateSignIn(draft, now.browser.selected, now.browser.revision, workspace, native)) {
        try host({ type: "setPasswordGuide", guide: "NoPasswordGuide" })
        return true
      }
      return try guideTo(guide)
    },
    guideSpeech,
    finishGuide: () => host({ type: "setPasswordGuide", guide: "NoPasswordGuide" })
  }
}

export const passwords = (client: PasswordVault | undefined, backup: PasswordBackupPlugin | undefined = passwordBackupPlugin) => Layer.effect(Passwords, effect {
  const privacy = privateViewPlugin
  const view = try Machine
  const workspace = try Workspaces
  const scope = try Scope.Scope
  const commands = try Semaphore.make(1)
  const host = (event: Event) => effect { view.send(event, "PasswordsHost") catch () => undefined }
  const guidance = try passwordGuidance(host)
  const lockNative = () => effect {
    if (client !== undefined) tryPromise(() => client.lock()) catch () => undefined
  }
  const privateView = effect () => {
    const { device } = try workspace.get()
    return device.surface === "Passwords" && device.readiness === "Ready"
  }
  const clear = (event: Event) => effect {
    try host(event)
    try lockNative()
  }
  effect function reportBackup(generation: number) {
    if (backup === undefined) return
    const status = tryPromise(() => backup.passwordBackupStatus()) catch () => undefined
    if ((try privateView()) && !(try hidden)) {
      try host({ type: "reportBackupReady", generation, ready: status?.ready === true })
    }
  }
  effect function report(generation: number, notice: VaultNotice) {
    if ((try view.get()).generation !== generation || !(try privateView()) || (try hidden)) return
    if (privacy !== undefined) {
      const protectedWindow = Effect.as(tryPromise(() => privacy.protect({ view: "vault", active: true })), true) catch () => false
      if (!protectedWindow) {
        try host({ type: "reportUnavailable", generation, reason: "UnsupportedVault" })
        return
      }
    }
    if (client === undefined) {
      try host({ type: "reportUnavailable", generation, reason: "UnsupportedVault" })
      return
    }
    const status = try tryPromise(() => client.status())
    if ((try view.get()).generation !== generation || !(try privateView()) || (try hidden)) return
    const reason = issue(status.reason ?? "")
    if (status.reason === "device-locked") {
      try host({ type: "lockPasswords" })
      return
    }
    if (!status.available || reason !== undefined) {
      try host({ type: "reportUnavailable", generation, reason: reason ?? "UnsupportedVault" })
      return
    }
    if (status.locked) {
      try host({ type: "lockPasswords" })
      return
    }
    const expires = status.unlockRemainingMs === null ? null : (try Clock.currentTimeMillis) + status.unlockRemainingMs
    const rows = try tryPromise(() => client.list())
    if ((try view.get()).generation !== generation) return
    const remaining = expires === null ? null : expires - (try Clock.currentTimeMillis)
    if ((remaining !== null && remaining <= 0) || !(try privateView()) || (try hidden)) {
      try clear({ type: "lockPasswords" })
      return
    }
    const entries = rows.map(({ id, label, username, bindings, revision }) => ({ id, label, username, bindings, revision }))
    try host({ type: "reportLogins", generation, entries, notice })
    if (remaining === null) return
    try fork.in(scope) effect {
      try sleep(remaining)
      if ((try view.get()).generation === generation) try clear({ type: "lockPasswords" })
    }
  }
  effect function recover(generation: number, failure: { readonly cause?: unknown }) {
    const code = failure.cause instanceof PasswordsClientError ? failure.cause.code : "unavailable"
    const reason = issue(code)
    if (reason !== undefined) {
      try host({ type: "reportUnavailable", generation, reason })
      return
    }
    if ((try view.get()).generation !== generation) return
    if (code === "conflict") {
      report(generation, "ChangedLogin") catch () => undefined
      return
    }
    if (code === "locked" || code === "cancelled") {
      report(generation, "QuietVault") catch effect () => { try host({ type: "reportUnavailable", generation, reason: "UnsupportedVault" }) }
      if (code === "cancelled") try host({ type: "reportVaultNotice", generation, notice: "CancelledVaultAction" })
      return
    }
    if ((try view.get()).vault.tag === "CheckingVault") try host({ type: "lockPasswords" })
    try host({ type: "reportVaultNotice", generation: (try view.get()).generation, notice: "FailedVaultAction" })
  }
  try fork.scoped Stream.runForEach(workspace.changes, effect () => {
    const current = try view.get()
    if (try privateView()) {
      if (current.vault.tag !== "ClosedPasswords") return
      try host({ type: "openPasswords" })
      const { generation } = try view.get()
      if (try hidden) {
        try clear({ type: "lockPasswords" })
        return
      }
      report(generation, "QuietVault") catch effect (failure) => { try recover(generation, failure) }
      try fork.in(scope) reportBackup((try view.get()).generation)
    } else if (current.vault.tag !== "ClosedPasswords") {
      try clear({ type: "closePasswords" })
      const dismiss = backup?.dismissPasswordRecovery
      if (dismiss !== undefined) tryPromise(dismiss) catch () => undefined
      if (privacy !== undefined) tryPromise(() => privacy.protect({ view: "vault", active: false })) catch () => undefined
    }
  })
  try fork.scoped Stream.runForEach(Stream.merge(
    Stream.fromEventListener(webView.document, "visibilitychange"),
    Stream.fromEventListener(webView.window, "focus")
  ), effect () => {
    const { vault, generation } = try view.get()
    if (try hidden) {
      try host({ type: "reportBackupReady", generation, ready: false })
      if (vault.tag !== "ClosedPasswords" && vault.tag !== "LockedVault") try clear({ type: "lockPasswords" })
    } else if (try privateView()) {
      if (vault.tag === "ClosedPasswords") return
      if (vault.tag === "LockedVault" || vault.tag === "UnavailableVault") try host({ type: "openPasswords" })
      const current = (try view.get()).generation
      report(current, "QuietVault") catch effect (failure) => { try recover(current, failure) }
      try fork.in(scope) reportBackup(current)
    }
  })

  if (backup !== undefined) try fork.scoped Stream.runForEach(
    Stream.callback<void>((events) => acquireRelease(
      tryPromise(() => backup.addListener("passwordOwnerChanged", () => { Queue.offerUnsafe(events, undefined) })),
      (handle) => Effect.ignore(tryPromise(() => handle.remove()))
    ).pipe(Effect.ignore)),
    effect () => {
      try clear({ type: "passwordOwnerChanged" })
      if ((try privateView()) && !(try hidden)) {
        const { generation } = try view.get()
        report(generation, "QuietVault") catch effect (failure) => { try recover(generation, failure) }
        try fork.in(scope) reportBackup((try view.get()).generation)
      }
    }
  )

  const act = (action: PasswordAction) => effect {
    if (client === undefined || !(try privateView()) || (try hidden)) return
    const api = client
    try commands.withPermitsIfAvailable(1)(effect {
      const current = try view.get()
      effect function perform() {
        if (action.kind === "Unlock") {
          const opened = view.send({ type: "unlockPasswords" }, "PasswordsPerson") catch () => undefined
          if (opened === undefined) return
          const generation = opened.generation
          effect {
            try tryPromise(() => api.unlock())
            try report(generation, "QuietVault")
            try fork.in(scope) reportBackup((try view.get()).generation)
          } catch effect (failure) => { try recover(generation, failure) }
          return
        }
        if (action.kind === "Backup") {
          if (backup === undefined || !current.backupReady) return
          try clear({ type: "lockPasswords" })
          const opened = tryPromise(() => backup.openBackupRecovery()) catch () => undefined
          if (opened?.status !== "opened" && (try privateView()) && !(try hidden)) {
            try host({ type: "openPasswords" })
            try report((try view.get()).generation, "BackupUnavailable")
          }
          return
        }
        if (action.kind === "Autofill") {
          try tryPromise(() => api.openAutofillSettings())
          return
        }
        const { vault } = current
        if (vault.tag !== "OpenVault") return
        if (action.kind === "Add") {
          const result = try tryPromise(() => api.openEditor())
          if (result.status === "saved") try report(current.generation, "SavedLogin")
          return
        }
        if ("id" in action && vault.selected === action.id) {
          const selected = vault.entries.find((row) => row.id === action.id && row.revision === action.revision)
          if (selected === undefined) {
            try host({ type: "reportVaultNotice", generation: current.generation, notice: "ChangedLogin" })
            return
          }
          if (action.kind === "Edit") {
            const result = try tryPromise(() => api.openEditor({ entryId: selected.id, expectedRevision: selected.revision }))
            if (result.status === "saved") try report(current.generation, "SavedLogin")
          } else if (action.kind === "Show") {
            try tryPromise(() => api.reveal(selected.id, selected.revision))
          } else if (action.kind === "Copy") {
            try tryPromise(() => api.copy(selected.id, selected.revision))
          } else if (action.kind === "Delete") {
            try tryPromise(() => api.remove(selected.id, selected.revision))
            try report(current.generation, "DeletedLogin")
          }
        }
      }
      perform() catch effect (failure) => { try recover(current.generation, failure) }
    })
  }
  return {
    ...guidance,
    act
  }
})
