// spec/app/setup.md, "Story: Sign in to Grace and manage my subscription"; spec/app/setup.md, "An enrolled tablet offers one sign-in to update mail and calendar access"; spec/app/setup.md, "Google sign-in stays with the surface that started it"; spec/app/setup.md, "A supported email code can sign in on the tablet"
import {
  type GoogleLink, type GraceAccount, accountDetails, accountDetailsShown, type GracePlan, type MailLeaseUpgradePhase, type TabletAccountDetails, type TabletMailAuthority, hasActiveSubscription, isTheRequestsOwnReturn, Machine as Setup, mayBeginMailLeaseUpgrade, mayCancelMailLeaseUpgrade, mayCleanupLegacySignIn, mayOfferGoogleLink, mayOpenBillingPortal, mayRedeemMembershipCode, mayStartCheckout, mayStartGoogleSignIn, mayUseTabletEmailCode, tabletAccount, tabletSignInConfirmed
} from "../gen/app__setup.effect.vibe"
import { Machine as Workspaces } from "../gen/app__workspace.effect.vibe"
import { checkoutFromResponse, normalizeSubscriptionCode, redeemResultFromResponse, snapshotFromResponse, type BillingSnapshot } from "@elizaos/cloud"
import { accountPlugin, accountReadResponse, type AccountBridge, type TabletAccountRequest } from "./accountPlugin.ts"
import type { AccountRequest, accountRequests, TabletGoogleRead } from "./cloudRequests.vibe"
import { privateViewPlugin, webView } from "./surfacePlugin.ts"

const filesScope = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/))
const Session = Schema.Struct({ account: Schema.NullOr(Schema.Struct({ id: Schema.NonEmptyString, email: Schema.NullOr(Schema.String) })) })
const DeviceAccountStatus = Schema.Struct({
  kind: Schema.Literals(["signedIn", "signedOut"]),
  legacySignInNeedsCleanup: Schema.optional(Schema.Literal(true)),
  mailLease: Schema.optional(Schema.Struct({ accountId: Schema.NonEmptyString, leaseVersion: Schema.NonEmptyString })),
  mailLeaseUpgrade: Schema.optional(Schema.Literals(["required", "signInPending", "acknowledgmentPending"])),
})
const upgradePhase = {
  required: { tag: "LeaseUpgradeRequired" },
  signInPending: { tag: "LeaseUpgradeSignInPending" },
  acknowledgmentPending: { tag: "LeaseUpgradeAcknowledgmentPending" },
} as const satisfies Record<string, MailLeaseUpgradePhase>
schema Providers { google: boolean; email: boolean; sms: boolean }
const gracePlus = "plus_monthly"
const PlanCatalog = Schema.Struct({ plans: Schema.Array(Schema.Struct({ key: Schema.String })) })
const TabletProfile = Schema.Struct({ success: Schema.Literal(true), data: Schema.Struct({ id: Schema.NonEmptyString, email: Schema.optional(Schema.String) }) })
const DeviceResponse = Schema.Struct({ status: Schema.Int.check(Schema.isBetween({ minimum: 200, maximum: 599 })), body: Schema.String })
const TabletConsent = Schema.Struct({ kind: Schema.Literals(["connected", "cancelled"]) })
const TabletSignInMethods = Schema.Struct({ emailCode: Schema.Boolean })
const TabletCodeSent = Schema.Struct({ kind: Schema.Literal("sent") })
const TabletCodeVerified = Schema.Struct({ kind: Schema.Literals(["signedIn", "additionalVerification"]) })
schema Destination { url: string }
schema DeviceApproval { redirectUrl: string }
schema DeviceAttempt { challenge: string; state: string }
const GoogleStatus = Schema.Struct({
  accountId: Schema.NonEmptyString,
  provider: Schema.Literal("google"),
  side: Schema.Literal("owner"),
  mode: Schema.Literal("cloud_managed"),
  configured: Schema.Boolean,
  connected: Schema.Boolean,
  grantedCapabilities: Schema.Array(Schema.String),
  connectionId: Schema.optional(Schema.NullOr(Schema.String)),
  identity: Schema.NullOr(Schema.Struct({ email: Schema.NonEmptyString })),
})
schema GoogleAuthorization { authorizeUrl: string }

export const apiOrigin = import.meta.env.VITE_GRACE_CLOUD_API_ORIGIN || (import.meta.env.DEV ? "" : "https://api.graceforseniors.com")
export const webOrigin = import.meta.env.VITE_GRACE_CLOUD_WEB_ORIGIN || "https://app.graceforseniors.com"
const deviceAttemptKey = "grace-device-sign-in"
const deviceChallenge = /^[A-Za-z0-9_-]{43}$/
const deviceState = /^[A-Za-z0-9_-]{43,128}$/
const deviceCode = /^[a-f0-9]{64}$/

effect function pendingDevice() {
  const candidate = Effect.try(() => {
    const storage = webView.window.sessionStorage
    const url = new URL(webView.window.location.href)
    const params = url.searchParams
    if (!params.has("device_challenge") && !params.has("device_state")) {
      const saved = storage.getItem(deviceAttemptKey)
      return saved === null ? undefined : JSON.parse(saved)
    }
    const pending = { challenge: params.get("device_challenge"), state: params.get("device_state") }
    storage.removeItem(deviceAttemptKey)
    params.delete("device_challenge")
    params.delete("device_state")
    url.hash = "account"
    webView.window.history.replaceState(undefined, "", url)
    return pending
  }) catch () => undefined
  const parsed = Schema.decodeUnknownEffect(DeviceAttempt)(candidate) catch () => undefined
  if (parsed === undefined || !deviceChallenge.test(parsed.challenge) || !deviceState.test(parsed.state)) return undefined
  Effect.try(() => webView.window.sessionStorage.setItem(deviceAttemptKey, JSON.stringify(parsed))) catch () => undefined
  return parsed
}

const clearDevice = () => Effect.try(() => webView.window.sessionStorage.removeItem(deviceAttemptKey))

export type CodeProvider = "email" | "sms"
type UpgradeOperation = { kind: "beginLeaseUpgrade" } | { kind: "cancelLeaseUpgrade" }
type AccountOperation =
  | { kind: "refresh" | "signIn" | "signOut" | "cleanupLegacySignIn" | "checkout" | "portal" | "cancelDevice" | "disconnectGoogle" | "cancelSignInCode" }
  | { kind: "authorizeDevice"; expectedAccountId: string }
  | { kind: "sendCode"; provider: CodeProvider; address: string }
  | { kind: "redeemMembershipCode"; code: string }
  | { kind: "connectGoogle"; mail: boolean; calendar: boolean; sendMail: boolean; trashMail: boolean; writeCalendar: boolean; expectedEmail: string }
  | { kind: "verifyCode"; provider: CodeProvider; address: string; code: string }
export type Operation = AccountOperation | UpgradeOperation
type Transport = {
  request<P extends AccountRequest>(path: P, method: typeof accountRequests[P], body?: Record<string, string | boolean>): Response!unknown
  begin(): void!unknown
  openExternal(url: URL): void!unknown
}

export service AccountActions {
  run(operation: Operation): boolean!!
  readTabletGoogle(owner: TabletMailAuthority, route: TabletGoogleRead, query: Record<string, string>): Response!unknown
}

export function accountFetch(input: RequestInfo | URL, init?: RequestInit) {
  return webView.window.fetch(input, { ...init, credentials: "include", cache: "no-store", redirect: "error" })
}

const webTransport: Transport = {
  request: (path, method, body) => tryPromise((signal) => accountFetch(
    apiOrigin + path,
    {
      method, signal,
      headers: body === undefined ? { Accept: "application/json" } : { Accept: "application/json", "Content-Type": "application/json" },
      body: body === undefined ? undefined : JSON.stringify(body),
    },
  )),
  begin: () => Effect.try(() => webView.window.location.assign(
    apiOrigin + "/api/auth/google/start",
  )),
  openExternal: (url) => Effect.try(() => webView.window.location.assign(url)),
}

error AccountRequestFailed

effect function accepted<P extends AccountRequest>(transport: Transport, path: P, method: typeof accountRequests[P], body?: Record<string, string | boolean>) {
  const response = try timeout(transport.request(path, method, body), "10 seconds")
  if (!response.ok) throw new AccountRequestFailed()
  return response
}

effect function decode<A>(response: Response, decoder: Schema.Decoder<A>) {
  const input: unknown = try tryPromise(() => response.json())
  return try Schema.decodeUnknownEffect(decoder)(input)
}

function planFrom(snapshot: BillingSnapshot, checkoutOffered: boolean): GracePlan {
  const status = snapshot.subscription?.status
  const canManage = checkoutOffered && status !== undefined
  if (snapshot.plan.source !== "free") return canManage ? "PlanActiveManaged" : "PlanActive"
  const canCheckout = checkoutOffered && (status === undefined || status === "canceled" || status === "incomplete_expired")
  if (canManage) return canCheckout ? "PlanInactiveManagedCheckout" : "PlanInactiveManaged"
  return canCheckout ? "PlanInactive" : "PlanInactiveBlocked"
}

export type CodeSignIn = Extract<Operation, { kind: "sendCode" | "verifyCode" }>

export effect function browserSignInProviders() {
  return try decode(try accepted(webTransport, "/api/auth/providers", "GET"), Providers)
}

export effect function browserCodeSignIn(operation: CodeSignIn) {
  const address: Record<string, string> = operation.provider === "email" ? { email: operation.address } : { phone: operation.address }
  const phase = operation.kind === "sendCode" ? "send" : "verify"
  const body = operation.kind === "sendCode" ? address : { ...address, code: operation.code }
  try accepted(webTransport, `/api/auth/${operation.provider}/${phase}`, "POST", body)
}

effect function session(transport: Transport) {
  const first = try decode(try accepted(transport, "/api/auth/session", "GET"), Session)
  const registry = webView.window.navigator.locks
  if (first.account !== null || registry === undefined) return first
  return try tryPromise((signal) => registry.request("grace-browser-session", { signal }, () => runPromise(effect {
    const latest = try decode(try accepted(transport, "/api/auth/session", "GET"), Session)
    if (latest.account !== null) return latest
    const renewed = try timeout(transport.request("/api/auth/refresh", "POST"), "10 seconds")
    if (renewed.status === 401) return latest
    if (!renewed.ok) throw new AccountRequestFailed()
    return try decode(renewed, Session)
  })))
}

export effect function browserSessionScope() {
  const path = "/api/product/files/scope"
  let response = try timeout(webTransport.request(path, "GET"), "10 seconds")
  if (response.status === 401) {
    if ((try session(webTransport)).account === null) return undefined
    response = try accepted(webTransport, path, "GET")
  }
  if (!response.ok) throw new AccountRequestFailed()
  return try decode(response, Schema.Struct({ accountId: Schema.NonEmptyString, owner: filesScope, session: filesScope }))
}

const BrowserGuideLease = Schema.Struct({ id: Schema.NullOr(Schema.NonEmptyString) })

export effect function nativeBrowserGuideLease() {
  const bridge = accountPlugin
  if (bridge === undefined) return undefined
  const response = try tryPromise(() => bridge.browserGuideLease())
  return (try Schema.decodeUnknownEffect(BrowserGuideLease)(response)).id ?? undefined
}

effect function readAccount(transport: Transport): GraceAccount!unknown {
  const { account } = try session(transport)
  if (account === null) {
    const providers = try decode(try accepted(transport, "/api/auth/providers", "GET"), Providers)
    return { tag: "GraceSignedOut", google: providers.google, emailCode: providers.email, smsCode: providers.sms }
  }
  const plan = try readPlan(accepted(transport, "/api/v1/billing/limits", "GET"), accepted(transport, "/api/v1/subscriptions/plans", "GET"))
  return { tag: "GraceSignedIn", accountId: account.id, email: account.email ?? "", plan }
}

effect function readPlan(billing: Response!unknown, plans: Response!unknown): GracePlan!! {
  effect function readSnapshot() {
    const response = try billing
    return try snapshotFromResponse(try tryPromise(() => response.json()))
  }
  effect function readOffer() {
    const response = try plans
    const catalog = try decode(response, PlanCatalog)
    return catalog.plans.some(({ key }) => key === gracePlus)
  }
  return effect {
    const [snapshot, checkoutOffered] = try.all [readSnapshot(), Effect.orElseSucceed(readOffer(), () => false)]
    return planFrom(snapshot, checkoutOffered)
  } catch () => "PlanUnknown"
}

effect function googleLink(response: Response, accountId: string): GoogleLink!unknown {
  if (!response.ok) throw new AccountRequestFailed()
  const status = try decode(response, GoogleStatus)
  if (status.accountId !== accountId) throw new AccountRequestFailed()
  if (!status.configured) return { tag: "GoogleLinkUnavailable" }
  if (!status.connected) return { tag: "GoogleLinkReady" }
  if (status.identity === null) throw new AccountRequestFailed()
  return { tag: "GoogleLinkConnected", email: status.identity.email,
    grant: status.connectionId ?? "",
    trashMail: status.grantedCapabilities.includes("google.gmail.trash"),
    writeCalendar: status.grantedCapabilities.includes("google.calendar.write"),
    sendMail: status.grantedCapabilities.includes("google.gmail.send"),
    mail: status.grantedCapabilities.includes("google.gmail.triage"),
    calendar: status.grantedCapabilities.includes("google.calendar.read"),
  }
}

export effect function currentManagedMailGrant(scope: { accountId: string; grant: string; leaseVersion?: string }, authorization: AccountActions.Shape) {
  const { accountId, grant, leaseVersion } = scope
  const response = leaseVersion === undefined
    ? (try accepted(webTransport, "/api/v1/eliza/google/status", "GET"))
    : (try timeout(authorization.readTabletGoogle({ accountId, leaseVersion }, "status", {}), "10 seconds"))
  const link = try googleLink(response, accountId)
  return link.tag === "GoogleLinkConnected" && link.mail && link.grant === grant
}

effect function connectGoogle(transport: Transport, operation: Extract<Operation, { kind: "connectGoogle" }>) {
  const response = try accepted(transport, "/api/v1/eliza/google/connect/initiate", "POST", {
    mail: operation.mail, calendar: operation.calendar, sendMail: operation.sendMail, trashMail: operation.trashMail, writeCalendar: operation.writeCalendar, expectedEmail: operation.expectedEmail,
  })
  const { authorizeUrl } = try decode(response, GoogleAuthorization)
  const url = try Effect.try(() => new URL(authorizeUrl))
  if (url.origin !== "https://accounts.google.com" || url.pathname !== "/o/oauth2/v2/auth" || url.username !== "" || url.password !== "") throw new AccountRequestFailed()
  try transport.openExternal(url)
}

effect function openBilling(transport: Transport, operation: "checkout" | "portal") {
  const url = operation === "portal"
    ? (try decode(try accepted(transport, "/api/v1/subscriptions/portal", "POST"), Destination)).url
    : (try checkoutUrl(transport))
  const destination = try Effect.try(() => new URL(url))
  const origin = operation === "checkout" ? "https://checkout.stripe.com" : "https://billing.stripe.com"
  if (destination.origin !== origin || destination.username !== "" || destination.password !== "") throw new AccountRequestFailed()
  try transport.openExternal(destination)
}

effect function checkoutUrl(transport: Transport) {
  const idempotencyKey = try Effect.try(() => webView.window.crypto.randomUUID())
  const response = try accepted(transport, "/api/v1/subscriptions/checkout", "POST", { planKey: gracePlus, idempotencyKey, presentation: "shared" })
  const checkout = try checkoutFromResponse(try tryPromise(() => response.json()))
  if (checkout.status !== "open" || !("checkoutUrl" in checkout)) throw new AccountRequestFailed()
  return checkout.checkoutUrl
}

effect function redeemMembershipCode(request: (body: { code: string; idempotencyKey: string }) => Response!unknown, typedCode: string) {
  const code = normalizeSubscriptionCode(typedCode)
  if (code === null) return false
  const idempotencyKey = try Effect.try(() => webView.window.crypto.randomUUID())
  const response = try request({ code, idempotencyKey })
  const now = try Clock.currentTimeMillis
  const result = try redeemResultFromResponse(try tryPromise(() => response.json()), now)
  return result.kind === "redeemed"
}

export const graceAccount = (native: boolean, hasLocalConnector: boolean, plugin: AccountBridge | undefined = accountPlugin) => Layer.effect(AccountActions, effect {
  const setup = try Setup
  const workspace = try Workspaces
  const gate = try Semaphore.make(1)
  const tabletHandoff = try Semaphore.make(1)
  const attempt = try Ref.make(native ? undefined : (try pendingDevice()))
  if ((try Ref.get(attempt)) !== undefined) {
    setup.send({ type: "reportTabletSignIn", waiting: true }) catch () => undefined
  }
  effect function dismissDevice() {
    try Ref.set(attempt, undefined)
    clearDevice() catch () => undefined
    setup.send({ type: "reportTabletSignIn", waiting: false }) catch () => undefined
  }

  effect function readTabletGoogle(owner: TabletMailAuthority, route: TabletGoogleRead, query: Record<string, string>) {
    const read = native ? plugin?.readGoogle?.bind(plugin) : undefined
    if (read === undefined) throw new AccountRequestFailed()
    const { status, body } = try Schema.decodeUnknownEffect(DeviceResponse)(try tryPromise(() => read({ ...owner, route, query })))
    return try Effect.try(() => accountReadResponse(status, body))
  }

  effect function tabletAccountRequest(request: TabletAccountRequest): Response!unknown {
    const send = plugin?.accountRequest?.bind(plugin)
    if (send === undefined) throw new AccountRequestFailed()
    const reply = try timeout(tryPromise(() => send(request)), "10 seconds")
    const { status, body } = try Schema.decodeUnknownEffect(DeviceResponse)(reply)
    if (status < 200 || status >= 300) throw new AccountRequestFailed()
    return try Effect.try(() => accountReadResponse(status, body))
  }

  effect function tabletDetails(lease: MailLeaseUpgradePhase): TabletAccountDetails!! {
    return effect {
      const { data } = try decode(try tabletAccountRequest({ action: "profile" }), TabletProfile)
      if (lease.tag === "LeaseMailReady" && lease.accountId !== data.id) throw new AccountRequestFailed()
      const plan = try readPlan(tabletAccountRequest({ action: "billing", accountId: data.id }), tabletAccountRequest({ action: "plans", accountId: data.id }))
      return { tag: "TabletAccountKnown", accountId: data.id, email: data.email ?? "", plan } as const
    } catch () => ({ tag: "TabletAccountUnavailable" })
  }

  effect function refresh() {
    const account: GraceAccount = native ? (readDevice() catch () => ({ tag: "AccountUnavailable" } as const)) :
      (readAccount(webTransport) catch () => ({ tag: "AccountUnavailable" } as const))
    const previous = try setup.get()
    const fallback: GoogleLink = hasLocalConnector && previous.googleLink.tag === "GoogleLinkUnknown" ? { tag: "GoogleLinkUnknown" } : { tag: "GoogleLinkUnavailable" }
    const link: GoogleLink = effect {
      if (account.tag === "GraceSignedIn")
        return try googleLink(try accepted(webTransport, "/api/v1/eliza/google/status", "GET"), account.accountId)
      if (account.tag === "GraceDeviceSignedIn" && account.mailLeaseUpgrade.tag === "LeaseMailReady") {
        const { accountId, leaseVersion } = account.mailLeaseUpgrade
        const response = try timeout(readTabletGoogle({ accountId, leaseVersion }, "status", {}), "10 seconds")
        return try googleLink(response, accountId)
      }
      return { tag: "GoogleLinkUnknown" }
    } catch () => fallback
    const held = setup.send({ type: native ? "reportGraceAccount" : "reportGraceService", report: account, link }) catch () => undefined
    return held?.state.graceAccount ?? ({ tag: "AccountUnavailable" } as const)
  }

  effect function readDevice(): GraceAccount!unknown {
    if (plugin === undefined) throw new AccountRequestFailed()
    const status: unknown = try tryPromise(() => plugin.status())
    const result = try Schema.decodeUnknownEffect(DeviceAccountStatus)(status)
    if (result.mailLease !== undefined) {
      if (result.kind !== "signedIn" || result.legacySignInNeedsCleanup === true || result.mailLeaseUpgrade !== undefined) throw new AccountRequestFailed()
      const lease = { tag: "LeaseMailReady", ...result.mailLease } as const
      return tabletAccount(lease, try tabletDetails(lease))
    }
    if (result.mailLeaseUpgrade !== undefined) {
      if (result.kind !== "signedIn" || result.legacySignInNeedsCleanup === true) throw new AccountRequestFailed()
      const lease = upgradePhase[result.mailLeaseUpgrade]
      return tabletAccount(lease, try tabletDetails(lease))
    }
    if (result.legacySignInNeedsCleanup === true) {
      if (result.kind !== "signedOut") throw new AccountRequestFailed()
      return { tag: "GraceDeviceSignInNeedsCleanup" }
    }
    if (result.kind === "signedOut") {
      const methods = plugin.signInMethods?.bind(plugin)
      const emailCode = methods === undefined ? false : (effect {
        const response = try timeout(tryPromise(methods), "5 seconds")
        return (try Schema.decodeUnknownEffect(TabletSignInMethods)(response)).emailCode
      } catch () => false)
      return { tag: "GraceDeviceSignedOut", emailCode }
    }
    return tabletAccount({ tag: "LeaseUpgradeNotRequired" }, try tabletDetails({ tag: "LeaseUpgradeNotRequired" }))
  }

  effect function perform(operation: AccountOperation) {
    if (operation.kind === "refresh") return (try refresh()).tag !== "AccountUnavailable"
    if (operation.kind === "cleanupLegacySignIn") {
      if (!native || plugin === undefined || !mayCleanupLegacySignIn(try refresh())) return false
      try tryPromise(() => plugin.cleanupLegacySignIn())
      return (try refresh()).tag === "GraceDeviceSignedOut"
    }
    if (native) {
      if (plugin === undefined) return false
      if (operation.kind === "cancelSignInCode") {
        const cancel = plugin.cancelSignInCode?.bind(plugin)
        if (cancel === undefined) return false
        try tryPromise(cancel)
        return true
      }
      const current = try refresh()
      if (operation.kind === "signIn" && mayStartGoogleSignIn("TabletGoogleEntry", "AndroidGooglePicker", current)) return Effect.as(tryPromise(() => plugin.beginSignIn()), true) catch effect () => {
        try refresh()
        return false
      }
      if (operation.kind === "sendCode" || operation.kind === "verifyCode") {
        if (operation.provider !== "email" || !mayUseTabletEmailCode(current)) return false
        if (operation.kind === "sendCode") {
          const send = plugin.sendSignInCode?.bind(plugin)
          if (send === undefined) return false
          try Schema.decodeUnknownEffect(TabletCodeSent)(try tryPromise(() => send({ address: operation.address })))
          return true
        }
        const verify = plugin.verifySignInCode?.bind(plugin)
        if (verify === undefined) return false
        const reply = try tryPromise(() => verify({ address: operation.address, code: operation.code }))
        const verified = try Schema.decodeUnknownEffect(TabletCodeVerified)(reply)
        return verified.kind === "signedIn" && (try refresh()).tag === "GraceDeviceSignedIn"
      }
      if (current.tag !== "GraceDeviceSignedIn") return false
      if (operation.kind === "connectGoogle" || operation.kind === "disconnectGoogle") {
        const member = accountDetails(current)
        const link = (try setup.get()).googleLink
        if (member.tag !== "TabletAccountKnown" || !mayOfferGoogleLink(current, link)) return false
        const { accountId } = member
        if (operation.kind === "connectGoogle") {
          const connect = plugin.connectGoogle?.bind(plugin)
          const { mail, calendar, sendMail, trashMail, writeCalendar } = operation
          if (connect === undefined || (!mail && !calendar)) return false
          const reply = try tryPromise(() => connect({ accountId, mail, calendar, sendMail: mail && sendMail, trashMail: mail && trashMail, writeCalendar: calendar && writeCalendar }))
          const consent = try Schema.decodeUnknownEffect(TabletConsent)(reply)
          if (consent.kind === "cancelled") return true
        } else {
          const disconnect = plugin.disconnectGoogle?.bind(plugin)
          if (disconnect === undefined || link.tag !== "GoogleLinkConnected") return false
          try tryPromise(() => disconnect({ accountId }))
        }
        const refreshed = accountDetails(try refresh())
        if (refreshed.tag !== "TabletAccountKnown" || refreshed.accountId !== accountId) return false
        const observed = (try setup.get()).googleLink
        return operation.kind === "connectGoogle" ? observed.tag === "GoogleLinkConnected" : observed.tag === "GoogleLinkReady"
      }
      if (operation.kind === "redeemMembershipCode" && mayRedeemMembershipCode(current)) {
        const member = accountDetails(current)
        if (member.tag !== "TabletAccountKnown") return false
        const { accountId } = member
        const redeemed = redeemMembershipCode((body) => tabletAccountRequest({ action: "redeem", accountId, ...body }), operation.code) catch () => false
        const refreshed = try refresh()
        const details = accountDetails(refreshed)
        return redeemed && details.tag === "TabletAccountKnown" && details.accountId === accountId && hasActiveSubscription(refreshed)
      }
      if (operation.kind === "signOut") {
        try tryPromise(() => plugin.signOut())
        return (try refresh()).tag === "GraceDeviceSignedOut"
      }
      return false
    }
    const transport = webTransport
    if (operation.kind === "cancelSignInCode") return true
    if (operation.kind === "cancelDevice") {
      try dismissDevice()
      return true
    }
    if (operation.kind === "authorizeDevice") {
      const device = try Ref.get(attempt)
      if (device === undefined) return false
      const confirmed = setup.send({ type: "confirmTabletSignIn", accountId: operation.expectedAccountId }) catch () => undefined
      if (confirmed === undefined) return false
      const stillConfirmed = effect () => (try Ref.get(attempt)) === device && tabletSignInConfirmed(try setup.get())
      try refresh()
      if (!(try tabletHandoff.withPermit(stillConfirmed()))) return false
      const { redirectUrl } = try decode(try accepted(transport, "/api/auth/device/authorize", "POST", { ...device, expectedAccountId: operation.expectedAccountId }), DeviceApproval)
      const destination = try Effect.try(() => new URL(redirectUrl))
      const states = destination.searchParams.getAll("state")
      const codes = destination.searchParams.getAll("code")
      if (!isTheRequestsOwnReturn(
        destination.origin === webOrigin && destination.pathname === "/android/auth/callback" && destination.username === "" && destination.password === "" && !destination.href.includes("#"),
        states[0] === device.state, states.length, codes.length, deviceCode.test(codes[0] ?? ""),
      )) return false
      return try tabletHandoff.withPermit(effect {
        if (!(try stillConfirmed())) return false
        try transport.openExternal(destination)
        try dismissDevice()
        return true
      })
    }
    const original = (try setup.get()).graceAccount
    if (operation.kind === "signIn") {
      if (!mayStartGoogleSignIn("WebGoogleEntry", "BrowserGoogleFlow", original)) return false
      try transport.begin()
      return true
    }
    if (operation.kind === "sendCode" || operation.kind === "verifyCode") {
      if (original.tag !== "GraceSignedOut" || !(operation.provider === "email" ? original.emailCode : original.smsCode)) return false
      try browserCodeSignIn(operation)
      return operation.kind === "sendCode" || (try refresh()).tag === "GraceSignedIn"
    }
    const account = try refresh()
    if (original.tag !== "GraceSignedIn" || account.tag !== "GraceSignedIn" || account.accountId !== original.accountId) return false
    if (operation.kind === "redeemMembershipCode") {
      if (!mayRedeemMembershipCode(account)) return false
      const redeemed = redeemMembershipCode((body) => accepted(transport, "/api/v1/subscription/redeem", "POST", body), operation.code) catch () => false
      const refreshed = try refresh()
      return redeemed && refreshed.tag === "GraceSignedIn" && refreshed.accountId === account.accountId && hasActiveSubscription(refreshed)
    }
    if (operation.kind === "connectGoogle") {
      if (!mayOfferGoogleLink(account, (try setup.get()).googleLink) || (!operation.mail && !operation.calendar)) return false
      if (account.email === "" && operation.expectedEmail === "") return false
      try connectGoogle(transport, operation)
      return true
    }
    if (operation.kind === "disconnectGoogle") {
      if ((try setup.get()).googleLink.tag !== "GoogleLinkConnected") return false
      try accepted(transport, "/api/v1/eliza/google/disconnect", "POST")
      try refresh()
      return true
    }
    if (operation.kind === "signOut") {
      try accepted(transport, "/api/auth/logout", "POST")
      try refresh()
      return true
    }
    if (operation.kind === "checkout" ? !mayStartCheckout(account) : !mayOpenBillingPortal(account)) return false
    try openBilling(transport, operation.kind)
    return true
  }

  try fork.scoped gate.withPermit(refresh())
  const privacy = privateViewPlugin
  if (privacy !== undefined) {
    try fork.scoped Stream.runForEach(Stream.changes(Stream.map(workspace.changes, (w) => accountDetailsShown(w.device))),
      effect (active: boolean) => { tryPromise(() => privacy.protect({ view: "account", active })) catch effect (cause) => try logWarning(active ? "Account page shown with captures allowed" : "Captures still blocked after leaving the Account page", cause) })
  }
  if (webView.window.location.hash === "#account") {
    try fork.scoped effect {
      try Stream.runHead(Stream.filter(workspace.changes, (w) => w.device.readiness === "Ready"))
      workspace.send({ type: "chooseSettingsPage", page: "AccountSettings" }, "Person") catch () => undefined
    }
  }
  if (!native) {
    const visible = Stream.filter(Stream.fromEventListener(webView.document, "visibilitychange"), () => !webView.hidden())
    try fork.scoped Stream.runForEach(visible, () => gate.withPermit(refresh()))
  }
  if (native && plugin !== undefined) {
    try fork.scoped Stream.runForEach(
      Stream.callback<void>((queue) => acquireRelease(
        promise(() => plugin.addListener("sessionChanged", () => { Queue.offerUnsafe(queue, undefined) })),
        (handle) => promise(() => handle.remove()),
      )),
      () => gate.withPermit(refresh()),
    )
  }
  effect function upgrade(kind: "beginLeaseUpgrade" | "cancelLeaseUpgrade") {
    if (!native || plugin === undefined) return false
    const current = try gate.withPermit(refresh())
    const allowed = kind === "beginLeaseUpgrade" ? mayBeginMailLeaseUpgrade(current) : mayCancelMailLeaseUpgrade(current)
    const method = plugin[kind]?.bind(plugin)
    if (!allowed || method === undefined) return false
    try tryPromise(method)
    return (try gate.withPermit(refresh())).tag === "GraceDeviceSignedIn"
  }

  return { readTabletGoogle, run: effect (operation) => {
    if (operation.kind === "beginLeaseUpgrade" || operation.kind === "cancelLeaseUpgrade") return upgrade(operation.kind) catch () => false
    return (operation.kind === "cancelDevice" && !native ? tabletHandoff : gate).withPermit(perform(operation)) catch () => false
  } }
})
