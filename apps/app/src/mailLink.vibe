// spec/app/email.md, "A scam warning needs current evidence and holds that message's links"; spec/app/handoffs.md, "A link Email released opens in a new Browser tab, and no other link does"
import { linkDestination, messageLinkParts } from "./messageLinks.vibe"
import { Machine as Accounts } from "../gen/app__accounts.effect.vibe"
import { apply as applyMail, type Event as MailEvent, selectedMessageIsCurrent } from "../gen/app__email.effect.vibe"
import { openEmailLink } from "../gen/app__handoffs.effect.vibe"
import { openSource, showsMail } from "../gen/app__mailboxes.effect.vibe"
import { Machine as Workspaces, type ReleasedEmailLink } from "../gen/app__workspace.effect.vibe"
import { Instances } from "./instances.vibe"
import { ManagedReads } from "./managedReads.vibe"

type LinkSelection = ReleasedEmailLink & { account: number; ref: string; generation: number; version?: string }
export type LinkChoice = "open" | "confirm" | "cancel"
export effect function chooseMailLink(selection: LinkSelection, choice: LinkChoice) {
  const accounts = try Accounts
  const managed = try ManagedReads
  const shelf = try Instances
  const workspace = try Workspaces
  const { account, ref, generation, version, link } = selection
  const destination = linkDestination(link)
  if (destination === undefined) return false
  const startingVersion = shelf.content(account, ref)?.version
  const box = try shelf.mail(account)

  const selected = effect {
    if (try managed.ownsSurfaces()) return undefined
    const registry = try accounts.get()
    const visible = try Effect.forEach(registry.accounts.filter((a) => showsMail(registry, a.id)), effect (a) =>
      ({ account: a.id, mailbox: try (try shelf.mail(a.id)).get() }))
    const reader = visible.find((view) => view.account === account)?.mailbox
    if (openSource(registry, visible) !== account || visible.some((view) => view.mailbox.composeVisible) ||
      reader?.view !== "Message" || reader.messageRef !== ref || reader.generation !== generation) return undefined
    if (choice === "cancel") return reader
    const held = shelf.held(account, ref)
    return reader.connection === "Connected" && reader.canRead && reader.readStatus === "ReadIdle" &&
      selectedMessageIsCurrent(reader) && held?.read?.generation === generation &&
      held.read.version === version && held.read.evidence === reader.warning.evidence && held.content.version === startingVersion &&
      messageLinkParts(held.content.body).some((part) => typeof part !== "string" && part.href === destination) ? reader : undefined
  }

  const current = try workspace.get()
  if (current.device.surface !== "Email" || current.device.contextVersion !== selection.deviceVersion ||
    current.browser.revision !== selection.browserRevision) return false
  const reader = try selected
  if (!reader || (choice !== "open" && reader.link.link !== destination)) return false
  if (choice === "cancel") {
    try box.send({ type: "cancelLink" }, "MailUser")
    return true
  }
  const event: MailEvent = choice === "open" ? { type: "openLink", link: destination } : { type: "confirmLink", link: destination, confirmed: true }
  const released = try applyMail(reader, event, "MailUser")
  if (released.link.status === "LinkHeld") {
    try box.send(event, "MailUser")
    return true
  }
  if (openEmailLink(current.device, released, current.browser, destination).tag !== "OpenedLink") return false
  const publication = { link: destination, deviceVersion: selection.deviceVersion, browserRevision: selection.browserRevision }
  const opened = Effect.as(workspace.send({ type: "openReleasedEmailLink", release: publication }, "Host"), true) catch () => false
  if (!opened) return false
  const latest = try selected
  if (latest && latest.link.status === reader.link.status && latest.link.link === reader.link.link) {
    const marked = box.send(event, "MailUser") catch () => undefined
    if (marked?.link.status === "LinkReleased" && marked.generation === generation && marked.messageRef === ref) {
      box.send({ type: "linkOpened", link: destination }, "MailHost") catch () => undefined
    }
  }
  return true
}
