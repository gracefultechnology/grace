// spec/app/workspace.md, "Story: Follow one reviewed plan across apps"; spec/app/surface.md, "Story: Use the website under Grace's controls"
import { Machine as Setup } from "../gen/app__setup.effect.vibe"
import { activeTab, tabUrl } from "../gen/app__browser.effect.vibe"
import { Machine as Workspaces, canConfirmGuidedNameCorrection, mayGuideReadLink, nextOutcome, publicGuidedLink, type GuidedNameCorrection, type Workspace } from "../gen/app__workspace.effect.vibe"
import { CLEF_DECISION_LIMITS, clefUnavailability, createClefDecisionsClient, decodeClefResult, type ClefDecisionRequest, type ClefDecisionResponse } from "@elizaos/cloud/clef-decisions"
import { accountFetch, apiOrigin, browserSessionScope, nativeBrowserGuideLease } from "./graceAccount.vibe"
import { accountPlugin } from "./accountPlugin.ts"
import { supportsPointerHover, webView } from "./surfacePlugin.ts"
import { guidedAuthority, guidedOwner, type GuidedAuthority } from "./managedReads.vibe"
import { NativePage, guidedPageState, privateFormRecovery } from "./nativePage.vibe"
import { type LinkObservation, PageId } from "./nativePage.schema.ts"
import { withhold } from "./private.ts"

export type BrowserGuidance = { kind: "Link"; words: string } | { kind: "Menu" | "Unavailable"; words: string; alternateHref?: string }

export service BrowserGuide {
  point(onMenu: (guidance: BrowserGuidance) => void): BrowserGuidance!!
  confirmName(correction: GuidedNameCorrection): boolean!!
}

function unavailableBecause(words: string): BrowserGuidance { return { kind: "Unavailable", words } }
const unavailable = unavailableBecause("I couldn't find a link to point to on this page.")
const unobservable = unavailableBecause("I couldn’t read this page. Wait for it to finish loading or open the page again, then try again.")
const privateForm = unavailableBecause(privateFormRecovery)
const changed = unavailableBecause("The page or task changed. Ask me again on the page you want.")
const namedPageContext = " Prefer an exact page label. If it is absent, choose a navigation section that leads there. Keep the requested kind of page, such as a category or an individual item."
const choiceContext = " Compare the meaning of the links rather than requiring exact words. If the request is for a collection, prefer the parent section over an individual item."

function context(w: Workspace, authority: GuidedAuthority) {
  if (!mayGuideReadLink(w) || w.plan.owner !== guidedOwner(authority, w.plan.steps)) return undefined
  const tab = activeTab(w.browser)
  const address = tabUrl(tab)
  if (!URL.canParse(address)) return undefined
  const url = new URL(address)
  if (url.protocol !== "https:" || url.username || url.password) return undefined
  const step = { task: w.assistant.taskId, version: w.assistant.workVersion, generation: w.assistant.conversation.generation,
    stepIndex: w.plan.receipts.length, deviceVersion: w.device.contextVersion, browserRevision: w.browser.revision }
  const key = JSON.stringify([w.plan.owner, step, tab.id, tab.loadVersion])
  const outcome = nextOutcome(w.plan)
  const approvedHref = w.plan.nameOverride.stepIndex === step.stepIndex ? w.plan.linkUrl : undefined
  return { key, step, owner: w.plan.owner, approvedHref, loadVersion: tab.loadVersion, id: PageId.make(`tab-${tab.id}`), url,
    goal: w.plan.originalAsk, target: outcome.tag === "ReachNamedPage" ? outcome.subject : "" }
}

function publicWords(text: string): string {
  const plain = text.normalize("NFC").replace(/[\p{Cc}\p{Cf}]/gu, " ").replace(/\s+/gu, " ").trim()
  return withhold({ text: plain.replace(/https?:\/\/\S+|[\w.+-]+@[\w.-]+\.[\w-]+/giu, "…"), passwords: [] })
}

function links(snapshot: LinkObservation, page: URL, target: string, publicOnly: boolean) {
  const { result } = snapshot
  const destinations = new Map<string, { id: string; label: string; labels: Set<string>; rank: number; path: string; menuItem: boolean; expanded?: boolean; selector?: string | null; samePage: boolean }>()
  for (const item of result.elements) {
    if (item.tag !== "a" || item.disabled || item.sensitive || !item.label || !item.href || !URL.canParse(item.href)) continue
    const address = new URL(item.href)
    if (publicOnly && !publicGuidedLink(item.form === null, address.search !== "" || address.hash !== "" || address.username !== "" || address.password !== "")) continue
    const menuItem = item.role === "menuitem"
    const samePage = address.pathname === page.pathname && address.search === page.search
    if (address.origin !== page.origin || address.username || address.password || (samePage && (target === "" || !menuItem))) continue
    const label = publicWords(item.label)
    if (!label || label.includes("*") || label.length > CLEF_DECISION_LIMITS.candidateLabel) continue
    const bounds = item.bounds
    const viewport = result.viewport
    let rank = item.inViewport ? 2 : 1
    if (item.inViewport && bounds !== undefined && viewport !== undefined && viewport.scale > 0) {
      const contained = bounds.x >= viewport.offsetLeft && bounds.y >= viewport.offsetTop &&
        bounds.x + bounds.width <= viewport.offsetLeft + viewport.width / viewport.scale &&
        bounds.y + bounds.height <= viewport.offsetTop + viewport.height / viewport.scale
      if (!contained) rank = 0
    }
    const existing = destinations.get(address.href)
    if (existing === undefined) {
      destinations.set(address.href, { id: item.id, label, labels: new Set([label]), rank, path: address.pathname, menuItem, expanded: item.expanded, selector: item.targetSelector, samePage })
    } else {
      existing.labels.add(label)
      if (rank > existing.rank) {
        existing.id = item.id
        existing.label = label
        existing.rank = rank
        existing.menuItem = menuItem
        existing.expanded = item.expanded
        existing.selector = item.targetSelector
      }
    }
  }
  return [...destinations].map(([href, link]) => {
    const aliases = [...link.labels]
    const description = aliases.join(" / ")
    if (target !== "") {
      const control = link.expanded === false ? " (collapsed menu)" : link.expanded === true ? " (expanded menu)" : link.menuItem ? " (menu item)" : ""
      return { id: link.id, label: link.label, description: (description + control).slice(0, CLEF_DECISION_LIMITS.candidateLabel),
        href, menuItem: link.menuItem, selector: link.selector, samePage: link.samePage, exact: aliases.some((label) => label.toLowerCase() === target.toLowerCase()), pointable: link.rank === 2 }
    }
    const prefix = link.path.replace(/\/+$/u, "") + "/"
    const children = [...destinations.values()].filter(other => other.path !== link.path && other.path.startsWith(prefix))
    const section = children.length ? " (section with links including " + children.slice(0, 3).map(child => child.label).join(", ") + ")" : ""
    return { id: link.id, label: link.label, description: (description + section).slice(0, CLEF_DECISION_LIMITS.candidateLabel), href,
      menuItem: false, selector: undefined, samePage: false, exact: false, pointable: link.rank === 2 }
  })
}

function hasPublicName(snapshot: LinkObservation, url: URL, label: string, href: string): boolean {
  if (!label || label.length > 128 || label.includes("…") || url.search || url.hash) return false
  const matches = links(snapshot, url, label, true).filter((link) => link.exact && link.pointable)
  return matches.length === 1 && matches[0]?.label === label && matches[0].href === href && !matches[0].samePage
}

type ChoiceRequest = Extract<ClefDecisionRequest, { kind: "choice" }>
export type GuideDecision = (request: ChoiceRequest, signal?: AbortSignal) => Promise<ClefDecisionResponse>
type DecisionSession = {
  accountId?: string
  choose: GuideDecision
  current(): Promise<boolean>
}

effect function decisionSession(native: boolean, fixture?: GuideDecision): (DecisionSession | undefined)!unknown {
  if (fixture !== undefined) return { choose: fixture, current: () => Promise.resolve(true) }
  if (native) {
    const bridge = accountPlugin
    if (bridge === undefined) return undefined
    const id = try nativeBrowserGuideLease()
    if (id === undefined) return undefined
    return {
      current: async () => (await runPromise(nativeBrowserGuideLease())) === id,
      choose: async (request, signal) => {
        signal?.throwIfAborted()
        const reply = await bridge.chooseBrowserLink({ lease: id, goal: request.goal, candidates: request.candidates })
        signal?.throwIfAborted()
        return decodeClefResult(request, reply) ?? { status: "unavailable", reason: clefUnavailability(reply) }
      },
    }
  }
  const scope = try browserSessionScope()
  if (scope === undefined) return undefined
  const choose = try Effect.try(() => createClefDecisionsClient({
    baseUrl: apiOrigin || webView.window.location.origin,
    headers: () => ({ "X-Eliza-Account": scope.accountId }),
    fetch: accountFetch,
  }))
  return { accountId: scope.accountId, choose: async (request, signal) => await choose(request, signal), current: async () => (await runPromise(browserSessionScope()))?.session === scope.session }
}

export const browserGuide = (native: boolean, fixture?: GuideDecision) => Layer.effect(BrowserGuide, effect {
  const workspace = try Workspaces
  const page = try NativePage
  const setup = try Setup
  const authority = effect () => guidedAuthority(try setup.get(), webView.window.location.hash)
  const currentContext = effect () => context(try workspace.get(), try authority())
  let active: { id: PageId; key: string; account: DecisionSession; alternateHref?: string } | undefined
  try fork.scoped Stream.runForEach(workspace.changes, effect (state) => {
    const old = active
    if (old !== undefined && context(state, try authority())?.key !== old.key) {
      active = undefined
      page.clearGuide(old.id) catch () => undefined
    }
  })
  if (fixture === undefined) try fork.scoped Stream.runForEach(setup.changes, effect () => {
    const shown = active
    if (shown === undefined) return
    const current = (tryPromise(() => shown.account.current()) catch () => false) && (try currentContext())?.key === shown.key
    if (!current && active === shown) {
      active = undefined
      page.clearGuide(shown.id) catch () => undefined
    }
  })
  try addFinalizer(() => active === undefined ? Effect.void : Effect.ignore(page.clearGuide(active.id)))
  return {
    confirmName: effect (correction) => {
      const shown = active
      const start = try currentContext()
      if (!shown || !start || shown.key !== start.key || shown.alternateHref !== correction.href ||
          !canConfirmGuidedNameCorrection(try workspace.get(), correction, "Person")) return false
      const observesOfferedName = effect () => {
        const sameAccount = tryPromise(() => shown.account.current()) catch () => false
        if (!sameAccount || active !== shown || (try currentContext())?.key !== shown.key ||
            !canConfirmGuidedNameCorrection(try workspace.get(), correction, "Person")) return false
        const fresh = page.observeLinks(shown.id) catch () => undefined
        const state = guidedPageState(fresh, start.url.href, "GuidePublicLinks")
        return fresh !== undefined && fresh.documentId === correction.documentId &&
          (state === "Ordinary" || state === "PublicOnly") && hasPublicName(fresh, start.url, correction.label, correction.href)
      }
      const witnessed = (try observesOfferedName()) && (try observesOfferedName())
      const sameAccount = witnessed && (tryPromise(() => shown.account.current()) catch () => false)
      if (active !== shown) return false
      if (sameAccount && (try currentContext())?.key === start.key) {
        const accepted = workspace.send({ type: "confirmGuidedNameCorrection", correction }, "Person") catch () => undefined
        if (accepted !== undefined) return true
      }
      if (active === shown) {
        active = undefined
        page.clearGuide(shown.id) catch () => undefined
      }
      return false
    },
    point: effect (onMenu) => {
      const previous = active
      active = undefined
      if (previous !== undefined) page.clearGuide(previous.id) catch () => undefined
      const start = (try currentContext())
      if (start === undefined) return changed
      const account = decisionSession(native, fixture) catch () => null
      if ((try currentContext())?.key !== start.key) return changed
      const initial = page.observeLinks(start.id) catch () => undefined
      const initialState = guidedPageState(initial, start.url.href, "GuidePublicLinks")
      const sameSession = account === null || account === undefined || (tryPromise(() => account.current()) catch () => false)
      if (!sameSession || (try currentContext())?.key !== start.key) return changed
      if (initialState !== "Ordinary" && initialState !== "PublicOnly") return initialState === "PrivateForm" ? privateForm : unobservable
      if (account === null) return unavailableBecause("I couldn’t reach Grace to verify your sign-in.")
      if (account === undefined) return unavailableBecause("Sign in to Grace to get help choosing a link.")
      const signedIn = (try setup.get()).graceAccount
      if ((account.accountId !== undefined && signedIn.tag === "GraceSignedIn" && account.accountId !== signedIn.accountId) ||
          (try currentContext())?.key !== start.key) return changed
      const request = publicWords(start.goal)
      const target = publicWords(start.target)
      if (!request || (start.target !== "" && (!target || target.includes("*")))) return unavailable
      const instruction = target === "" ? choiceContext : " Find the named page: " + target + "." + namedPageContext
      if (request.length > CLEF_DECISION_LIMITS.goal || (target !== "" && request.length + instruction.length > CLEF_DECISION_LIMITS.goal)) return unavailable
      const goal = request.length + instruction.length <= CLEF_DECISION_LIMITS.goal ? request + instruction : request
      let disclosed: LinkObservation | undefined
      let retries = 0
      while (retries < 2) {
        if ((try currentContext())?.key !== start.key) return changed
        const snapshot: LinkObservation | undefined = disclosed ?? (retries === 0 ? initial : (page.observeLinks(start.id) catch () => undefined))
        if (snapshot === undefined) return unobservable
        const availability = guidedPageState(snapshot, start.url.href, "GuidePublicLinks")
        if (availability !== "Ordinary" && availability !== "PublicOnly") return availability === "PrivateForm" ? privateForm : unobservable
        const observed = links(snapshot, start.url, target, availability === "PublicOnly" || start.approvedHref !== undefined)
          .filter((link) => start.approvedHref === undefined || (link.href === start.approvedHref && link.exact))
        const exact = observed.filter((link) => link.exact)
        if (disclosed !== undefined && exact.length === 0) return changed
        if (exact.length > 1) return unavailableBecause(`More than one link is named “${target}”. Open the one you mean.`)
        if (exact.length === 1 && !exact[0]?.pointable) return unavailableBecause(`Scroll until “${target}” is visible, then ask again.`)
        const choices = target === "" ? observed : exact.length === 1 ? exact : observed.filter((link) => link.pointable)
        if (!choices.length) return unavailable
        if ((try currentContext())?.key !== start.key) return changed
        const decision = Effect.tryPromise(async (signal) => {
          let round = choices
          do {
            const selected: typeof choices = []
            for (let index = 0; index < round.length; index += CLEF_DECISION_LIMITS.candidates) {
              const candidates = round.slice(index, index + CLEF_DECISION_LIMITS.candidates)
              const options = candidates.map(({ description }, index) => ({ id: String(index + 1), label: description }))
              if ((await runPromise(currentContext()))?.key !== start.key) return { retry: false, stopped: changed }
              const fresh = await runPromise(Effect.option(page.observeLinks(start.id)))
              if (Option.isNone(fresh) || fresh.value.documentId !== snapshot.documentId ||
                  !(await account.current()) || (await runPromise(currentContext()))?.key !== start.key) return { retry: false, stopped: changed }
              const state = guidedPageState(fresh.value, start.url.href, "GuidePublicLinks")
              if (state !== "Ordinary" && state !== "PublicOnly") return { retry: false, stopped: state === "PrivateForm" ? privateForm : unobservable }
              const currentLinks = links(fresh.value, start.url, target, state === "PublicOnly" || start.approvedHref !== undefined)
              if (!candidates.every(candidate => currentLinks.some(current =>
                current.href === candidate.href && current.description === candidate.description &&
                current.pointable === candidate.pointable && current.selector === candidate.selector)))
                return { retry: false, stopped: changed }
              signal.throwIfAborted()
              const answer = await account.choose({ kind: "choice", goal, candidates: options }, signal)
              if (answer.status === "unavailable") return { retry: answer.reason === "provider_error" }
              if (answer.status !== "ok" || answer.kind !== "choice") return { retry: false }
              const choice = candidates[options.findIndex(option => option.id === answer.choice)]
              if (choice !== undefined) selected.push(choice)
            }
            round = selected
          } while (round.length > 1)
          return { retry: false, winner: round[0] }
        }) catch () => ({ retry: false, winner: undefined, stopped: undefined })
        if ((try currentContext())?.key !== start.key) return changed
        if (decision.retry) { retries++; continue }
        if (decision.stopped !== undefined) return decision.stopped
        const winner = decision.winner
        if (winner === undefined) return unavailable
        const current = page.observeLinks(start.id) catch () => undefined
        if (current === undefined || current.documentId !== snapshot.documentId) return changed
        const state = guidedPageState(current, start.url.href, "GuidePublicLinks")
        if (state !== "Ordinary" && state !== "PublicOnly") return state === "PrivateForm" ? privateForm : unobservable
        const matches = links(current, start.url, target, state === "PublicOnly" || start.approvedHref !== undefined).filter((link) =>
          disclosed !== undefined ? link.exact && link.pointable : link.href === winner.href && link.selector === winner.selector)
        const node = matches.length === 1 ? matches[0] : undefined
        if (!node || node.href !== winner.href || (try currentContext())?.key !== start.key) return changed
        const opensMenu = target !== "" && !node.exact && node.menuItem && node.selector !== null && node.selector !== undefined &&
          (try page.hasNavigationMenu(start.id, node.selector, start.url.href))
        if (node.samePage && !opensMenu) return unavailable
        const sameAccount = tryPromise(() => account.current()) catch () => false
        if (!sameAccount || (try currentContext())?.key !== start.key) return changed
        const expiresAt = (try Clock.currentTimeMillis) + (opensMenu ? 45000 : 20000)
        const accepted = page.pointAt(start.id, current.documentId, {
          kind: "show", id: current.result.snapshotId, snapshotId: current.result.snapshotId,
          nodeId: node.id, origin: start.url.origin, expiresAt, text: node.label, assistantName: "Grace"
        }) catch () => false
        if (!accepted) return changed
        const currentAccount = tryPromise(() => account.current()) catch () => false
        if (!currentAccount || (try currentContext())?.key !== start.key) {
          page.clearGuide(start.id) catch () => undefined
          return changed
        }
        if (opensMenu) {
          const correction: GuidedNameCorrection = { ...start.step, owner: start.owner, loadVersion: start.loadVersion,
            documentId: current.documentId, url: start.url.href, href: node.href, original: start.target, label: node.label }
          const offered = hasPublicName(current, start.url, node.label, node.href)
            ? (workspace.send({ type: "offerGuidedNameCorrection", correction }, "Host") catch () => undefined) : undefined
          const alternateHref = offered === undefined ? undefined : node.href
          const menuGuide = { id: start.id, key: start.key, account, alternateHref }
          active = menuGuide
          const hover = Effect.try(supportsPointerHover) catch () => false
          const words = hover
            ? `Move the pointer over “${winner.label}” and keep it there while I highlight the next link.`
            : `Open the website’s “${winner.label}” menu and leave it open while I highlight the next link.`
          try Effect.sync(() => onMenu({ kind: "Menu", words, alternateHref }))
          const selector = `:is(${winner.selector}):is(:hover,:focus-within,[aria-expanded="true"])`
          while ((try Clock.currentTimeMillis) < expiresAt) {
            try Effect.sleep("500 millis")
            if (active !== menuGuide || (try currentContext())?.key !== start.key) return changed
            if (!(try page.hasNavigationMenu(start.id, selector, start.url.href))) continue
            const opened = page.observeLinks(start.id) catch () => undefined
            if (!opened || opened.documentId !== snapshot.documentId) return changed
            const state = guidedPageState(opened, start.url.href, "GuidePublicLinks")
            if (state !== "Ordinary" && state !== "PublicOnly") {
              page.clearGuide(start.id) catch () => undefined
              return state === "PrivateForm" ? privateForm : unobservable
            }
            const visible = links(opened, start.url, target, state === "PublicOnly").filter((link) => link.exact && link.pointable)
            if (visible.length > 1) return unavailableBecause(`More than one link is named “${target}”. Open the one you mean.`)
            if (visible.length === 1) { disclosed = opened; break }
          }
          if (disclosed === undefined) {
            if (active !== menuGuide || (try currentContext())?.key !== start.key) return changed
            page.clearGuide(start.id) catch () => undefined
            return { kind: "Unavailable", words: `I couldn’t see “${target}” in the open menu. You can try another menu.`, alternateHref }
          }
          continue
        }
        const recorded = workspace.send({ type: "setGuidedLink", link: { ...start.step, url: winner.href } }, "Host") catch () => undefined
        if (recorded === undefined || (try currentContext())?.key !== start.key) {
          page.clearGuide(start.id) catch () => undefined
          return changed
        }
        active = { id: start.id, key: start.key, account }
        return { kind: "Link", words: `Look for “${winner.label}” on ${start.url.hostname}.` }
      }
      return unavailable
    }
  }
})
