// spec/app/workspace.md, "Story: Follow one reviewed plan across apps"; spec/app/surface.md, "Story: Use the website under Grace's controls"
import { Machine as WebsiteRequests } from "../gen/app__websiteRequests.effect.vibe"
import { WebsiteTask } from "./websiteTask.vibe"
import { Machine as Setup } from "../gen/app__setup.effect.vibe"
import { activeTab, tabUrl } from "../gen/app__browser.effect.vibe"
import { Machine as Workspaces, canConfirmGuidedNameCorrection, guidedRecordReceipt, mayAssist, mayGuideReadLink, uniqueLatestRecordIndex, nextOutcome, publicGuidedLink, type GuidedNameCorrection, type GuidedStep, type Workspace } from "../gen/app__workspace.effect.vibe"
import { CLEF_DECISION_LIMITS, clefUnavailability, createClefDecisionsClient, decodeClefResult, type ClefDecisionRequest, type ClefDecisionResponse } from "@elizaos/cloud/clef-decisions"
import { accountFetch, apiOrigin, browserSessionScope, nativeBrowserGuideLease } from "./graceAccount.vibe"
import { accountPlugin } from "./accountPlugin.ts"
import { supportsPointerHover, webView } from "./surfacePlugin.ts"
import { GuidedRecovery } from "./guidedRecovery.vibe"
import { guidedAuthority, guidedOwner, type GuidedAuthority } from "./managedReads.vibe"
import { comparableName, NativePage, guidedPageState, privateFormRecovery } from "./nativePage.vibe"
import { type LinkObservation, PageId } from "./nativePage.schema.ts"
import { collectionLabels, comparableStatus, observeRecordCollection, sameCollectionAddress, sameCollectionPage, sameRecordAccount, verifyRecordDetail, type CollectionObservation, type ObservedRecord, type RecordCollection, type RecordLink, type RecordSiteScope } from "./browserRecords.vibe"
import { withhold } from "./private.ts"

export type BrowserGuidance = { kind: "Link" | "RecordUnavailable"; words: string } | { kind: "Menu" | "Unavailable"; words: string; alternateHref?: string; tryAnotherMenu?: boolean }

export service BrowserGuide {
  point(onMenu: (guidance: BrowserGuidance) => void): BrowserGuidance!!
  confirmName(correction: GuidedNameCorrection): boolean!!
  checkLatestRecord(): ("Confirmed" | "NotFound" | "PrivateForm" | "Refused")!!
}

function unavailableBecause(words: string): BrowserGuidance { return { kind: "Unavailable", words } }
const unavailable = unavailableBecause("I couldn't find a link to point to on this page.")
const unobservable = unavailableBecause("I couldn’t read this page. Wait for it to finish loading or open the page again, then try again.")
const privateForm = unavailableBecause(privateFormRecovery)
const changed = unavailableBecause("The page or task changed. Ask me again on the page you want.")
const namedPageContext = " Prefer an exact page label. If it is absent, choose a navigation section that leads there. Keep the requested kind of page, such as a category or an individual item."
const choiceContext = " Compare the meaning of the links rather than requiring exact words. For an index or collection, choose the link whose scope covers the whole subject. A general customer-information or resources section can be a help index even without Help or FAQ in its name. Prefer it over a link to one topic, article, contact method or search result. A link with query parameters may lead to a filtered view. Use the visible link labels and section clues to distinguish them."
const statementContext = " Prefer a page that shows the bill, statement or account activity. Avoid a link that only starts a payment, such as Make a payment."

function context(w: Workspace, authority: GuidedAuthority) {
  if (nextOutcome(w.plan).tag === "ReadLatestRecord" || !mayGuideReadLink(w) ||
      w.plan.owner !== guidedOwner(authority, w.plan.steps)) return undefined
  const tab = activeTab(w.browser)
  const address = tabUrl(tab)
  if (!URL.canParse(address)) return undefined
  const url = new URL(address)
  if (url.protocol !== "https:" || url.username || url.password) return undefined
  const step = { task: w.assistant.taskId, version: w.assistant.workVersion, generation: w.assistant.conversation.generation,
    stepIndex: w.plan.receipts.length, deviceVersion: w.device.contextVersion, browserRevision: w.browser.revision }
  const key = JSON.stringify([w.plan.owner, step, tab.id, tab.loadVersion])
  const outcome = nextOutcome(w.plan)
  const approvedHref = w.plan.nameOverride.stepIndex === step.stepIndex ? w.plan.linkUrl : undefined
  return { key, step, owner: w.plan.owner, approvedHref, loadVersion: tab.loadVersion, id: PageId.make(`tab-${tab.id}`), url,
    goal: w.plan.originalAsk, target: outcome.tag === "ReachNamedPage" ? outcome.subject : "",
    instruction: outcome.tag === "ReadStatement" ? choiceContext + statementContext : choiceContext }
}

type RecordContext = {
  scope: string
  activity: Workspace["assistant"]["activity"]
  step: { owner: string; task: string; version: number; generation: number; deviceVersion: number; stepIndex: number; tabId: number }
  outcome: Extract<GuidedStep, { tag: "ReadLatestRecord" }>
  url: URL; cursor: number; history: readonly string[]; id: PageId; loadVersion: number; loaded: boolean; browserRevision: number
}

function recordContext(w: Workspace, authority: GuidedAuthority): RecordContext | undefined {
  const outcome = nextOutcome(w.plan)
  const tab = activeTab(w.browser)
  const url = URL.parse(tabUrl(tab))
  if (outcome.tag !== "ReadLatestRecord" || !mayAssist(w) || w.device.surface !== "Browser" ||
      w.plan.owner !== guidedOwner(authority, w.plan.steps) || tab.manualSignIn || !url ||
      url.protocol !== "https:" || url.username || url.password) return undefined
  const step = {
    owner: w.plan.owner, task: w.assistant.taskId, version: w.assistant.workVersion,
    generation: w.assistant.conversation.generation, deviceVersion: w.device.contextVersion,
    stepIndex: w.plan.receipts.length, tabId: tab.id
  }
  return {
    scope: JSON.stringify(step), activity: w.assistant.activity, step, outcome, url, cursor: tab.cursor, history: tab.history,
    id: PageId.make(`tab-${tab.id}`), loadVersion: tab.loadVersion, loaded: tab.load === "Loaded" && tab.secure,
    browserRevision: w.browser.revision
  }
}

type PendingRecordVisit = { from: RecordContext; href: string }
type RecordScan = {
  visit: PendingRecordVisit; total: number; first: number; last: number; account: RecordSiteScope
  records: readonly ObservedRecord[]; selected?: ObservedRecord
}
type RecordSelection = { visit: PendingRecordVisit; key: string; identity: string; documentId: string; account: RecordSiteScope }

function directRecordVisit(visit: PendingRecordVisit, current: RecordContext): boolean {
  const { from } = visit
  if (current.loadVersion === from.loadVersion) {
    return current.scope === from.scope && current.browserRevision === from.browserRevision && current.url.href === from.url.href
  }
  const { version, generation, ...visitStep } = from.step
  const { version: currentVersion, generation: currentGeneration, ...currentStep } = current.step
  const afterPause = current.activity === "Paused" && currentVersion === version + 1
  const afterResume = current.activity === "Rechecking" && currentVersion === version + 2
  return (afterPause || afterResume) && currentGeneration === generation + 1 &&
    JSON.stringify(currentStep) === JSON.stringify(visitStep) &&
    current.url.href === visit.href && current.loadVersion === from.browserRevision + 1 &&
    current.browserRevision === from.browserRevision + (current.loaded ? 2 : 1) &&
    current.cursor === from.cursor + 1 &&
    from.history.slice(0, from.cursor + 1).every((url, index) => current.history[index] === url)
}

const insufficientRecords = unavailableBecause("I can’t verify the newest match. In the website’s record history, open records with the requested status and compare their full dates.")
function recordUnavailable(words: string): BrowserGuidance { return { kind: "RecordUnavailable", words } }
const recordCoverage = recordUnavailable("I can’t verify that I’ve checked the whole list. Start on the first page, or review all pages on the website yourself.")
const recordDates = recordUnavailable("I can’t tell which matching record is newest from the dates shown. Open the matching records and compare their full dates on the website.")
const compareAllRecords = "Look for the next page of records. Ask me to show the link again there."
const compareEarlierRecords = "Go back one page in this list. Ask me to show the link again there."

function publicWords(text: string): string {
  const plain = text.normalize("NFC").replace(/[\p{Cc}\p{Cf}]/gu, " ").replace(/\s+/gu, " ").trim()
  return withhold({ text: plain.replace(/https?:\/\/\S+|[\w.+-]+@[\w.-]+\.[\w-]+/giu, "…"), passwords: [] })
}

function links(snapshot: LinkObservation, page: URL, target: string, publicOnly: boolean) {
  const { result } = snapshot
  const destinations = new Map<string, { id: string; label: string; labels: Set<string>; rank: number; path: string; menuItem: boolean; expanded?: boolean; selector?: string | null; samePage: boolean }>()
  for (const item of result.elements) {
    if (item.tag !== "a" || item.disabled || item.sensitive || !item.label || !item.href || !URL.canParse(item.href)) continue
    const address = new URL(item.href)
    if (publicOnly && !publicGuidedLink(item.form === null, address.search !== "" || address.hash !== "" || address.username !== "" || address.password !== "")) continue
    const menuItem = item.role === "menuitem"
    const samePage = address.pathname === page.pathname && address.search === page.search
    if (address.origin !== page.origin || address.username || address.password || (samePage && (target === "" || !menuItem))) continue
    const label = publicWords(item.label)
    if (!label || label.includes("*") || label.length > CLEF_DECISION_LIMITS.candidateLabel) continue
    const bounds = item.bounds
    const viewport = result.viewport
    let rank = item.inViewport ? 2 : 1
    if (item.inViewport && bounds !== undefined && viewport !== undefined && viewport.scale > 0) {
      const contained = bounds.x >= viewport.offsetLeft && bounds.y >= viewport.offsetTop &&
        bounds.x + bounds.width <= viewport.offsetLeft + viewport.width / viewport.scale &&
        bounds.y + bounds.height <= viewport.offsetTop + viewport.height / viewport.scale
      if (!contained) rank = 0
    }
    const existing = destinations.get(address.href)
    if (existing === undefined) {
      destinations.set(address.href, { id: item.id, label, labels: new Set([label]), rank, path: address.pathname, menuItem, expanded: item.expanded, selector: item.targetSelector, samePage })
    } else {
      existing.labels.add(label)
      if (rank > existing.rank) {
        existing.id = item.id
        existing.label = label
        existing.rank = rank
        existing.menuItem = menuItem
        existing.expanded = item.expanded
        existing.selector = item.targetSelector
      }
    }
  }
  return [...destinations].map(([href, link]) => {
    const aliases = [...link.labels]
    const description = aliases.join(" / ")
    if (target !== "") {
      const control = link.expanded === false ? " (collapsed menu)" : link.expanded === true ? " (expanded menu)" : link.menuItem ? " (menu item)" : ""
      return { id: link.id, label: link.label, description: (description + control).slice(0, CLEF_DECISION_LIMITS.candidateLabel),
        href, menuItem: link.menuItem, selector: link.selector, samePage: link.samePage, exact: aliases.some((label) => comparableName(label) === comparableName(target)), pointable: link.rank === 2 }
    }
    const prefix = link.path.replace(/\/+$/u, "") + "/"
    const children = [...destinations.values()].filter(other => other.path !== link.path && other.path.startsWith(prefix))
    const section = children.length ? " (section with links including " + children.slice(0, 3).map(child => child.label).join(", ") + ")" : ""
    const query = URL.parse(href)?.search ? " (address has query parameters)" : ""
    return { id: link.id, label: link.label, description: (description + query + section).slice(0, CLEF_DECISION_LIMITS.candidateLabel), href,
      menuItem: false, selector: undefined, samePage: false, exact: false, pointable: link.rank === 2 }
  })
}

type PublicMenu = { selector: string; label: string }
type PublicLink = ReturnType<typeof links>[number]

function hasPublicName(snapshot: LinkObservation, url: URL, label: string, href: string): boolean {
  if (!label || label.length > 128 || label.includes("…") || url.search || url.hash) return false
  const matches = links(snapshot, url, label, true).filter((link) => link.exact && link.pointable)
  return matches.length === 1 && matches[0]?.label === label && matches[0].href === href && !matches[0].samePage
}

type ChoiceRequest = Extract<ClefDecisionRequest, { kind: "choice" }>
export type GuideDecision = (request: ChoiceRequest, signal?: AbortSignal) => Promise<ClefDecisionResponse>
type DecisionSession = {
  accountId?: string
  choose: GuideDecision
  current(): Promise<boolean>
}

effect function decisionSession(native: boolean, fixture?: GuideDecision): (DecisionSession | undefined)!unknown {
  if (fixture !== undefined) return { choose: fixture, current: () => Promise.resolve(true) }
  if (native) {
    const bridge = accountPlugin
    if (bridge === undefined) return undefined
    const id = try nativeBrowserGuideLease()
    if (id === undefined) return undefined
    return {
      current: async () => (await runPromise(nativeBrowserGuideLease())) === id,
      choose: async (request, signal) => {
        signal?.throwIfAborted()
        const reply = await bridge.chooseBrowserLink({ lease: id, goal: request.goal, candidates: request.candidates })
        signal?.throwIfAborted()
        return decodeClefResult(request, reply) ?? { status: "unavailable", reason: clefUnavailability(reply) }
      },
    }
  }
  const scope = try browserSessionScope()
  if (scope === undefined) return undefined
  const choose = try Effect.try(() => createClefDecisionsClient({
    baseUrl: apiOrigin || webView.window.location.origin,
    headers: () => ({ "X-Eliza-Account": scope.accountId }),
    fetch: accountFetch,
  }))
  return { accountId: scope.accountId, choose: async (request, signal) => await choose(request, signal), current: async () => (await runPromise(browserSessionScope()))?.session === scope.session }
}

effect function inBranch(page: NativePage.Shape, id: PageId, url: string, branch: readonly PublicMenu[], selector: string | null | undefined) {
  if (branch.length === 0) return true
  if (!selector) return false
  for (const [index, menu] of branch.entries()) {
    if (!(try page.visibleMenuChild(id, menu.selector, branch[index + 1]?.selector ?? selector, url))) return false
  }
  return true
}

const menuChoices = (page: NativePage.Shape, guided: NonNullable<ReturnType<typeof context>>, target: string,
  branch: readonly PublicMenu[], skipped: readonly PublicMenu[]) => effect (snapshot: LinkObservation, publicOnly: boolean) => {
  const allLinks = links(snapshot, guided.url, target, publicOnly || branch.length > 0 || guided.approvedHref !== undefined)
    .filter((link) => guided.approvedHref === undefined || (link.href === guided.approvedHref && link.exact))
  if (branch.length === 0 && skipped.length === 0) return allLinks
  const children: PublicLink[] = []
  for (const link of allLinks) {
    if (!link.pointable || branch.some((menu) => menu.selector === link.selector)) continue
    let excluded = false
    for (const menu of skipped) {
      if (link.selector === menu.selector || (try inBranch(page, guided.id, guided.url.href, [menu], link.selector))) {
        excluded = true
        break
      }
    }
    if (!excluded && (try inBranch(page, guided.id, guided.url.href, branch, link.selector))) children.push(link)
  }
  return children
}

function linkGuidance({ native, fixture, page, website, workspace, setup, recovery, currentContext }: {
  native: boolean
  fixture?: GuideDecision
  page: NativePage.Shape
  website: WebsiteTask.Shape
  workspace: Workspaces.Shape
  setup: Setup.Shape
  recovery: GuidedRecovery.Shape
  currentContext: () => ReturnType<typeof context>!!
}) {
  let triedMenus: { key: string; documentId: string; menus: PublicMenu[] } | undefined
  let active: { id: PageId; key: string; account: DecisionSession; alternateHref?: string; branch?: readonly PublicMenu[] } | undefined
  return {
    shownPage: () => active?.id,
    clear: effect () => {
      const previous = active
      active = undefined
      if (previous !== undefined) page.clearGuide(previous.id) catch () => undefined
    },
    pageChanged: effect () => {
      const old = active
      if (old !== undefined && (try currentContext())?.key !== old.key && active === old) {
        active = undefined
        page.clearGuide(old.id) catch () => undefined
      }
    },
    accountChanged: effect () => {
      const shown = active
      if (shown === undefined) return
      const current = (tryPromise(() => shown.account.current()) catch () => false) && (try currentContext())?.key === shown.key
      if (!current && active === shown) {
        active = undefined
        page.clearGuide(shown.id) catch () => undefined
      }
    },
    confirmName: effect (correction: GuidedNameCorrection) => {
      const shown = active
      if (!(try recovery.canAccess(try workspace.get()))) return false
      const start = try currentContext()
      if (!shown || !start || shown.key !== start.key || shown.alternateHref !== correction.href ||
          !canConfirmGuidedNameCorrection(try workspace.get(), correction, "Person")) return false
      const observesOfferedName = effect () => {
        const sameAccount = tryPromise(() => shown.account.current()) catch () => false
        if (!sameAccount || active !== shown || (try currentContext())?.key !== shown.key ||
            !canConfirmGuidedNameCorrection(try workspace.get(), correction, "Person")) return false
        const fresh = page.observeLinks(shown.id) catch () => undefined
        const state = guidedPageState(fresh, start.url.href, "GuidePublicLinks")
        const candidate = fresh && links(fresh, start.url, correction.label, true).find((link) => link.href === correction.href && link.exact && link.pointable)
        return fresh !== undefined && candidate !== undefined && (try inBranch(page, start.id, start.url.href, shown.branch ?? [], candidate.selector)) &&
          fresh.documentId === correction.documentId &&
          (state === "Ordinary" || state === "PublicOnly") && hasPublicName(fresh, start.url, correction.label, correction.href)
      }
      const witnessed = (try observesOfferedName()) && (try observesOfferedName())
      const sameAccount = witnessed && (tryPromise(() => shown.account.current()) catch () => false)
      if (active !== shown) return false
      if (sameAccount && (try currentContext())?.key === start.key) {
        const accepted = workspace.send({ type: "confirmGuidedNameCorrection", correction }, "Person") catch () => undefined
        if (accepted !== undefined) {
          try recovery.keepProgress()
          return true
        }
      }
      if (active === shown) {
        active = undefined
        page.clearGuide(shown.id) catch () => undefined
      }
      return false
    },
    point: effect (onMenu: (guidance: BrowserGuidance) => void): BrowserGuidance!! => {
      const start = try currentContext()
      if (start === undefined) return changed
      const account = decisionSession(native, fixture) catch () => null
      if ((try currentContext())?.key !== start.key) return changed
      const initial = page.observeLinks(start.id) catch () => undefined
      const initialState = guidedPageState(initial, start.url.href, "GuidePublicLinks")
      const sameSession = account === null || account === undefined || (tryPromise(() => account.current()) catch () => false)
      if (!sameSession || (try currentContext())?.key !== start.key) return changed
      if (initialState !== "Ordinary" && initialState !== "PublicOnly") return initialState === "PrivateForm" ? privateForm : unobservable
      if (account === null) return unavailableBecause("I couldn’t reach Grace to verify your sign-in.")
      if (account === undefined) return unavailableBecause("Sign in to Grace to get help choosing a link.")
      const signedIn = (try setup.get()).graceAccount
      if ((account.accountId !== undefined && signedIn.tag === "GraceSignedIn" && account.accountId !== signedIn.accountId) ||
          (try currentContext())?.key !== start.key) return changed
      if (initial === undefined) return unobservable
      const request = publicWords(start.goal)
      const target = publicWords(start.target)
      if (!request || (start.target !== "" && (!target || target.includes("*")))) return unavailable
      const instruction = target === "" ? start.instruction : " Find the named page: " + target + "." + namedPageContext
      if (request.length > CLEF_DECISION_LIMITS.goal || (target !== "" && request.length + instruction.length > CLEF_DECISION_LIMITS.goal)) return unavailable
      const goal = request.length + instruction.length <= CLEF_DECISION_LIMITS.goal ? request + instruction : request
      const guided = start
      const branch: PublicMenu[] = []
      const skipped = start.approvedHref === undefined && triedMenus?.key === start.key && triedMenus.documentId === initial.documentId ? triedMenus.menus : []
      triedMenus = undefined
      function offerAnotherMenu(words: string, documentId: string, alternateHref?: string): BrowserGuidance {
        const first = branch[0]
        if (!first) return unavailableBecause(words)
        triedMenus = { key: guided.key, documentId, menus: [...skipped, first] }
        return { kind: "Unavailable", words, tryAnotherMenu: true, alternateHref }
      }
      let disclosed: LinkObservation | undefined
      const visibleChoices = menuChoices(page, guided, target, branch, skipped)
      let retries = 0
      while (retries < 2) {
        if ((try currentContext())?.key !== start.key) return changed
        const snapshot: LinkObservation | undefined = disclosed ?? (retries === 0 ? initial : (page.observeLinks(start.id) catch () => undefined))
        if (snapshot === undefined) return unobservable
        const availability = guidedPageState(snapshot, start.url.href, "GuidePublicLinks")
        if (availability !== "Ordinary" && availability !== "PublicOnly") return availability === "PrivateForm" ? privateForm : unobservable
        const observed = try visibleChoices(snapshot, availability === "PublicOnly")
        const exact = observed.filter((link) => link.exact)
        if (exact.length > 1) return unavailableBecause(`More than one link is named “${target}”. Open the one you mean.`)
        if (exact.length === 1 && !exact[0]?.pointable) return unavailableBecause(`Scroll until “${target}” is visible, then ask again.`)
        const choices = target === "" ? observed : exact.length === 1 ? exact : observed.filter((link) => link.pointable)
        if (!choices.length) return unavailable
        if ((try currentContext())?.key !== start.key) return changed
        const decision = Effect.tryPromise(async (signal) => {
          const path = branch.map((menu) => menu.label).join(" › ")
          const decisionGoal = path ? (goal + " Choose within the open menu: " + path).slice(0, CLEF_DECISION_LIMITS.goal) : goal
          let round = choices
          do {
            const selected: typeof choices = []
            for (let index = 0; index < round.length; index += CLEF_DECISION_LIMITS.candidates) {
              const candidates = round.slice(index, index + CLEF_DECISION_LIMITS.candidates)
              const options = candidates.map(({ description }, index) => ({ id: String(index + 1), label: description }))
              if ((await runPromise(currentContext()))?.key !== start.key) return { retry: false, stopped: changed }
              const fresh = await runPromise(Effect.option(page.observeLinks(start.id)))
              if (Option.isNone(fresh) || fresh.value.documentId !== snapshot.documentId ||
                  !(await account.current()) || (await runPromise(currentContext()))?.key !== start.key) return { retry: false, stopped: changed }
              const state = guidedPageState(fresh.value, start.url.href, "GuidePublicLinks")
              if (state !== "Ordinary" && state !== "PublicOnly") return { retry: false, stopped: state === "PrivateForm" ? privateForm : unobservable }
              const currentLinks = links(fresh.value, start.url, target, state === "PublicOnly" || start.approvedHref !== undefined)
              if (!candidates.every(candidate => currentLinks.some(current =>
                current.href === candidate.href && current.description === candidate.description &&
                current.pointable === candidate.pointable && current.selector === candidate.selector)))
                return { retry: false, stopped: changed }
              for (const candidate of candidates) {
                if (!(await runPromise(inBranch(page, start.id, start.url.href, branch, candidate.selector)))) return { retry: false, stopped: changed }
              }
              signal.throwIfAborted()
              const answer = await account.choose({ kind: "choice", goal: decisionGoal, candidates: options }, signal)
              if (answer.status === "unavailable") return { retry: answer.reason === "provider_error" }
              if (answer.status !== "ok" || answer.kind !== "choice") return { retry: false }
              const choice = candidates[options.findIndex(option => option.id === answer.choice)]
              if (choice !== undefined) selected.push(choice)
            }
            round = selected
          } while (round.length > 1)
          return { retry: false, winner: round[0] }
        }) catch () => ({ retry: false, winner: undefined, stopped: undefined })
        if ((try currentContext())?.key !== start.key) return changed
        if (decision.retry) { retries++; continue }
        if (decision.stopped !== undefined) return decision.stopped
        const winner = decision.winner
        if (winner === undefined) {
          if ("winner" in decision && branch.length && active?.key === guided.key)
            return offerAnotherMenu(`I couldn’t find “${target}” in the “${branch[branch.length - 1]?.label}” menu.`, snapshot.documentId)
          return unavailable
        }
        const current = page.observeLinks(start.id) catch () => undefined
        if (current === undefined || current.documentId !== snapshot.documentId) return changed
        const state = guidedPageState(current, start.url.href, "GuidePublicLinks")
        if (state !== "Ordinary" && state !== "PublicOnly") return state === "PrivateForm" ? privateForm : unobservable
        const matches = links(current, start.url, target, state === "PublicOnly" || branch.length > 0 || start.approvedHref !== undefined)
          .filter((link) => link.href === winner.href && link.selector === winner.selector && (branch.length === 0 || link.pointable))
        const node = matches.length === 1 ? matches[0] : undefined
        if (!node || !(try inBranch(page, start.id, start.url.href, branch, node.selector)) || (try currentContext())?.key !== start.key) return changed
        const opensMenu = target !== "" && !node.exact && node.menuItem && node.selector !== null && node.selector !== undefined &&
          (try page.hasNavigationMenu(start.id, node.selector, start.url.href))
        if (node.samePage && !opensMenu) return unavailable
        const sameAccount = tryPromise(() => account.current()) catch () => false
        if (!sameAccount || (try currentContext())?.key !== start.key) return changed
        const expiresAt = (try Clock.currentTimeMillis) + (opensMenu ? 45000 : 20000)
        let pointed = false
        for (let attempt = 0; attempt < 2 && !pointed; attempt++) {
          const fresh = attempt === 0 ? current : (page.observeLinks(start.id) catch () => undefined)
          if (fresh === undefined || fresh.documentId !== snapshot.documentId || (try currentContext())?.key !== start.key) return changed
          const freshState = guidedPageState(fresh, start.url.href, "GuidePublicLinks")
          if (freshState !== "Ordinary" && freshState !== "PublicOnly") return freshState === "PrivateForm" ? privateForm : unobservable
          const shown = links(fresh, start.url, target, freshState === "PublicOnly" || start.approvedHref !== undefined).find((link) => link.href === node.href && link.selector === node.selector)
          if (shown === undefined) return changed
          const pointing = try website.start(Effect.map(currentContext(), (live) => live?.key === start.key), page.pointAt(start.id, fresh.documentId, {
            kind: "show", id: fresh.result.snapshotId, snapshotId: fresh.result.snapshotId,
            nodeId: shown.id, origin: start.url.origin, expiresAt, text: shown.label, assistantName: "Grace"
          }))
          if (typeof pointing === "string") return changed
          pointed = Fiber.join(pointing) catch () => false
        }
        if (!pointed) return changed
        const currentAccount = tryPromise(() => account.current()) catch () => false
        if (!currentAccount || (try currentContext())?.key !== start.key) {
          page.clearGuide(start.id) catch () => undefined
          return changed
        }
        if (opensMenu || (branch.length > 0 && !node.exact)) {
          const correction: GuidedNameCorrection = { ...start.step, owner: start.owner, loadVersion: start.loadVersion,
            documentId: current.documentId, url: start.url.href, href: node.href, original: start.target, label: node.label }
          const offered = hasPublicName(current, start.url, node.label, node.href)
            ? (workspace.send({ type: "offerGuidedNameCorrection", correction }, "Host") catch () => undefined) : undefined
          const alternateHref = offered === undefined ? undefined : node.href
          const menuGuide = { id: start.id, key: start.key, account, alternateHref, branch: [...branch] }
          active = menuGuide
          if (!opensMenu || !node.selector) {
            return offerAnotherMenu(`The open menu ${branch.map((menu) => "“" + menu.label + "”").join(" › ")} calls this link “${node.label}”.`, current.documentId, alternateHref)
          }
          branch.push({ selector: node.selector, label: node.label })
          disclosed = undefined
          const hover = Effect.try(supportsPointerHover) catch () => false
          const words = hover
            ? `Move the pointer over “${winner.label}” and keep it there while I highlight the next link.`
            : `Open the website’s “${winner.label}” menu and leave it open while I highlight the next link.`
          try Effect.sync(() => onMenu({ kind: "Menu", words, alternateHref }))
          const selector = `:is(${winner.selector}):is(:hover,:focus-within,[aria-expanded="true"])`
          while ((try Clock.currentTimeMillis) < expiresAt) {
            try Effect.sleep("500 millis")
            if (active !== menuGuide || (try currentContext())?.key !== start.key) return changed
            if (!(try page.hasNavigationMenu(start.id, selector, start.url.href))) continue
            const opened = page.observeLinks(start.id) catch () => undefined
            if (!opened || opened.documentId !== snapshot.documentId) return changed
            const state = guidedPageState(opened, start.url.href, "GuidePublicLinks")
            if (state !== "Ordinary" && state !== "PublicOnly") {
              page.clearGuide(start.id) catch () => undefined
              return state === "PrivateForm" ? privateForm : unobservable
            }
            if ((try visibleChoices(opened, state === "PublicOnly")).length > 0) { disclosed = opened; break }
          }
          if (disclosed === undefined) {
            if (active !== menuGuide || (try currentContext())?.key !== start.key) return changed
            page.clearGuide(start.id) catch () => undefined
            return { kind: "Unavailable", words: `I couldn’t see “${target}” in the open menu. You can try another menu.`, alternateHref }
          }
          continue
        }
        const recorded = workspace.send({ type: "setGuidedLink", link: { ...start.step, url: winner.href } }, "Host") catch () => undefined
        if (recorded === undefined || (try currentContext())?.key !== start.key) {
          page.clearGuide(start.id) catch () => undefined
          return changed
        }
        active = { id: start.id, key: start.key, account }
        return { kind: "Link", words: `Look for “${winner.label}” on ${start.url.hostname}.` }
      }
      return unavailable
    }
  }
}

export const browserGuide = (native: boolean, fixture?: GuideDecision) => Layer.effect(BrowserGuide, effect {
  const website = try WebsiteTask
  const requests = try WebsiteRequests
  const workspace = try Workspaces
  const page = try NativePage
  const setup = try Setup
  const recovery = try GuidedRecovery
  const authority = effect () => guidedAuthority(try setup.get(), webView.window.location.hash)
  const clear: boolean!! = website.clear
  const currentContext = effect () => (try clear) ? context(try workspace.get(), try authority()) : undefined
  const currentRecord = effect (): (RecordContext | undefined)!! => (try clear) ? recordContext(try workspace.get(), try authority()) : undefined
  let scan: RecordScan | undefined
  let selectedRecord: RecordSelection | undefined
  let recordRing: { id: PageId; scope: string; loadVersion: number } | undefined
  let recordAttempt: symbol | undefined
  const pointRecord = effect (start: RecordContext) => {
    const attempt = Symbol()
    recordAttempt = attempt
    const prior = recordRing
    recordRing = undefined
    selectedRecord = undefined
    if (prior !== undefined) page.clearGuide(prior.id) catch () => undefined
    const stillHere = effect () => {
      const live = try currentRecord()
      return recordAttempt === attempt && live?.scope === start.scope && live.loaded &&
        live.loadVersion === start.loadVersion && live.browserRevision === start.browserRevision && live.url.href === start.url.href
    }
    const showRecord = effect (snapshot: { documentId: string; snapshotId: string }, link: RecordLink, text: string) => {
      const expiresAt = (try Clock.currentTimeMillis) + 20000
      const pointing = try website.start(stillHere(), page.pointAt(start.id, snapshot.documentId, {
        kind: "show", id: snapshot.snapshotId, snapshotId: snapshot.snapshotId, nodeId: link.id,
        origin: start.url.origin, expiresAt, text, assistantName: "Grace"
      }))
      if (typeof pointing === "string") return false
      const shown = Fiber.join(pointing) catch () => false
      if (!shown || !(try stillHere())) return false
      recordRing = { id: start.id, scope: start.scope, loadVersion: start.loadVersion }
      return true
    }
    const collection: CollectionObservation = try observeRecordCollection(page, start.id, start.url, start.outcome.collection, stillHere())
    if (!(try stillHere())) return changed
    if (collection.kind === "NoCollection") {
      scan = undefined
      const observed: LinkObservation | undefined = page.observeLinks(start.id) catch () => undefined
      if (!observed || !["Ordinary", "PublicOnly"].includes(guidedPageState(observed, start.url.href, "GuidePublicLinks"))) return unobservable
      const publicLabels = collectionLabels(start.outcome.collection)
      const safeNavigation: PublicLink[] = links(observed, start.url, start.outcome.collection, true)
      const allowed: PublicLink[] = safeNavigation.filter((link): boolean => !link.samePage && link.pointable && Boolean(link.selector) &&
        (publicLabels.includes(comparableName(link.label)) || /^(?:my account|account)$/u.test(comparableName(link.label))))
      const target: PublicLink[] = allowed.filter((link): boolean => publicLabels.includes(comparableName(link.label)))
      const candidate = target.length === 1 ? target[0] : target.length === 0 && allowed.length === 1 ? allowed[0] : undefined
      if (!candidate?.selector) return unavailableBecause("Open the website’s record history, then ask me to show the link again.")
      const nav = page.readRecordText(start.id, `:is(${candidate.selector}):not(table *, [role="row"] *, form *)`) catch () => undefined
      const fresh: LinkObservation | undefined = page.observeLinks(start.id) catch () => undefined
      if (nav?.url !== start.url.href || !fresh || fresh.documentId !== observed.documentId ||
          fresh.result.domRevision !== observed.result.domRevision || !(try stillHere())) return changed
      const link = links(fresh, start.url, start.outcome.collection, true).find((item) =>
        item.pointable && item.href === candidate.href && item.selector === candidate.selector)
      if (!link || !(try showRecord({ documentId: fresh.documentId, snapshotId: fresh.result.snapshotId }, link, "Open the record history"))) return changed
      return { kind: "Link" as const, words: "Open the highlighted section, then ask me again." }
    }
    if (collection.kind !== "Collection") {
      scan = undefined
      switch (collection.kind) {
        case "PrivateForm": return recordUnavailable(privateFormRecovery)
        case "PublicOnly": return recordUnavailable(`I can only read public links here. Check every page for “${start.outcome.status}”, then open the matching records to compare their full dates.`)
        case "NeedsScope": return recordUnavailable("I can’t verify which website account these records belong to. Confirm the account on the website and check its records there.")
        case "NeedsCoverage": return recordCoverage
        case "NeedsDate": return recordDates
        case "Unverifiable": return insufficientRecords
      }
    }
    const current: RecordCollection = collection.page
    const walking: RecordScan | undefined = scan && directRecordVisit(scan.visit, start) && start.url.href === scan.visit.href ? scan : undefined
    scan = undefined
    if (walking && (!sameRecordAccount(walking.account, current.account) || current.total !== walking.total ||
        !sameCollectionAddress(walking.visit.from.url, start.url)))
      return unavailableBecause("The website account or record list changed. Open the first page to check it again.")
    let records: readonly ObservedRecord[] = current.records
    if (walking?.selected !== undefined) {
      const witnessedRows: readonly ObservedRecord[] = walking.records.slice(current.first - 1, current.last)
      const compared = new Map<string, ObservedRecord>(witnessedRows.map((record): [string, ObservedRecord] => [record.identity, record]))
      const samePage = start.loadVersion === walking.visit.from.loadVersion
      const expectedPage = samePage ? current.first === walking.first && current.last === walking.last :
        current.last + 1 === walking.first && current.next !== undefined && sameCollectionPage(new URL(current.next.href), walking.visit.from.url)
      if (!expectedPage || compared.size !== current.records.length ||
          !current.records.every((record): boolean => {
            const prior = compared.get(record.identity)
            return prior !== undefined && prior.date === record.date &&
              prior.status === record.status && prior.link.href === record.link.href
          })) return unavailableBecause("The record list changed. Open the first page to check it again.")
      records = walking.records
    } else {
      if (walking ? current.first !== walking.last + 1 || !current.previous ||
          !sameCollectionPage(new URL(current.previous.href), walking.visit.from.url) : current.first !== 1) return recordCoverage
      records = walking ? [...walking.records, ...records] : records
      if (new Set(records.map((record) => record.identity)).size !== records.length) return recordCoverage
      if (current.next) {
        if (!(try showRecord(current, current.next, "Next page"))) return changed
        scan = { visit: { from: start, href: current.next.href }, first: current.first, last: current.last,
          total: current.total, records, account: current.account }
        return { kind: "Link" as const, words: compareAllRecords }
      }
      if (records.length !== current.total) return recordCoverage
    }
    const matching = records.filter((record) => record.status === comparableStatus(start.outcome.status))
    const chosen = walking?.selected ?? matching[uniqueLatestRecordIndex(matching.map((record) => record.date))]
    if (!chosen) return matching.length === 0
      ? recordUnavailable("I didn’t find that status in the list. Check the website for any filters or archived records.")
      : recordDates
    const onPage = current.records.find((record) => record.identity === chosen.identity)
    if (!onPage) {
      if (!current.previous || !(try showRecord(current, current.previous, "Previous page"))) return insufficientRecords
      scan = { visit: { from: start, href: current.previous.href }, first: current.first, last: current.last,
        total: current.total, records, selected: chosen, account: current.account }
      return { kind: "Link" as const, words: compareEarlierRecords }
    }
    if (onPage.date !== chosen.date || onPage.status !== chosen.status || onPage.link.href !== chosen.link.href) return insufficientRecords
    if (!(try showRecord(current, onPage.link, "Latest matching record"))) {
      if (!(try stillHere())) return changed
      scan = { visit: { from: start, href: start.url.href }, first: current.first, last: current.last,
        total: current.total, records, selected: chosen, account: current.account }
      return unavailableBecause("Make sure the record’s detail links are visible, then ask me to show the link again.")
    }
    const nonce = Effect.try(() => webView.window.crypto.randomUUID()) catch () => undefined
    if (!nonce || !(try stillHere())) {
      if (recordAttempt === attempt) page.clearGuide(start.id) catch () => undefined
      return changed
    }
    const recorded = workspace.send({ type: "stageGuidedRecord", selection: {
      ...start.step, browserRevision: start.browserRevision, loadVersion: start.loadVersion, documentId: current.documentId,
      domRevision: current.domRevision, key: nonce, coverage: { observed: records.length, total: current.total }, matches: 1
    } }, "Host") catch () => undefined
    if (recorded === undefined || !(try stillHere())) {
      page.clearGuide(start.id) catch () => undefined
      return changed
    }
    selectedRecord = { visit: { from: start, href: onPage.link.href }, key: nonce, identity: onPage.identity, documentId: current.documentId, account: current.account }
    return { kind: "Link" as const, words: "Open the highlighted record. Choose Resume, then Check page." }
  }
  const publicLinks = linkGuidance({ native, fixture, page, website, workspace, setup, recovery, currentContext })
  const changes = Stream.merge(Stream.as(workspace.changes, undefined), Stream.as(requests.changes, undefined))
  try fork.scoped Stream.runForEach(changes, effect () => {
    const observed = try workspace.get()
    const live = (try clear) ? recordContext(observed, try authority()) : undefined
    if (scan && observed.browser.revision >= scan.visit.from.browserRevision && (!live || !directRecordVisit(scan.visit, live))) scan = undefined
    if (selectedRecord && observed.browser.revision >= selectedRecord.visit.from.browserRevision &&
        (!live || !directRecordVisit(selectedRecord.visit, live))) selectedRecord = undefined
    const ring = recordRing
    if (ring && observed.browser.revision >= ring.loadVersion && (!live || ring.scope !== live.scope || ring.loadVersion !== live.loadVersion)) {
      recordRing = undefined
      if (!live || live.id !== ring.id || live.loadVersion === ring.loadVersion)
        page.clearGuide(ring.id) catch () => undefined
    }
    try publicLinks.pageChanged()
  })
  if (fixture === undefined) try fork.scoped Stream.runForEach(setup.changes, publicLinks.accountChanged)
  try addFinalizer(() => {
    const id = publicLinks.shownPage() ?? recordRing?.id
    return id === undefined ? Effect.void : Effect.ignore(page.clearGuide(id))
  })
  return {
    checkLatestRecord: effect () => {
      const picked = selectedRecord
      const current = try currentRecord()
      if (!(try recovery.canAccess(try workspace.get()))) return "Refused"
      if (!picked || !current || !current.loaded || current.url.href !== picked.visit.href ||
          !directRecordVisit(picked.visit, current) || current.loadVersion === picked.visit.from.loadVersion) return "NotFound"
      const samePage = effect () => {
        const live = try currentRecord()
        return picked === selectedRecord && live?.scope === current.scope && live.loadVersion === current.loadVersion &&
          live.browserRevision === current.browserRevision && live.url.href === current.url.href
      }
      const detail = try verifyRecordDetail(page, current.id, current.url, picked.identity, picked.account, current.outcome.collection, samePage())
      if (detail === "PrivateForm") return detail
      if (!detail || detail.documentId === picked.documentId) return "NotFound"
      const w = try workspace.get()
      if (!(try recovery.canAccess(w)) || !(try samePage())) return "Refused"
      const receipt = guidedRecordReceipt(w)
      const recorded = workspace.send({ type: "confirmGuidedRecord", recordCheck: {
        report: { owner: current.step.owner, task: current.step.task, version: current.step.version,
          deviceVersion: current.step.deviceVersion, browserRevision: current.browserRevision, step: current.outcome, ...receipt },
        key: picked.key, tabId: current.step.tabId, documentId: detail.documentId, loadVersion: current.loadVersion
      } }, "Host") catch () => undefined
      if (recorded === undefined) return "Refused"
      selectedRecord = undefined
      try recovery.keepProgress()
      return "Confirmed"
    },
    confirmName: publicLinks.confirmName,
    point: effect (onMenu) => {
      try publicLinks.clear()
      const w = try workspace.get()
      if (!(try recovery.canAccess(w))) return changed
      if (nextOutcome(w.plan).tag === "ReadLatestRecord") {
        const record = try currentRecord()
        return record?.loaded && mayGuideReadLink(try workspace.get()) ? (try pointRecord(record)) : changed
      }
      return try publicLinks.point(onMenu)
    }
  }
})
