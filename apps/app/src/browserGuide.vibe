// spec/app/workspace.md, "Story: Follow one reviewed plan across apps"; spec/app/surface.md, "Story: Use the website under Grace's controls"
import { Machine as Setup } from "../gen/app__setup.effect.vibe"
import { activeTab, tabUrl } from "../gen/app__browser.effect.vibe"
import { guidedReadKind, Machine as Workspaces, mayGuideReadLink, nextOutcome, type Workspace } from "../gen/app__workspace.effect.vibe"
import { CLEF_DECISION_LIMITS, clefUnavailability, createClefDecisionsClient, decodeClefResult, type ClefDecisionRequest, type ClefDecisionResponse } from "@elizaos/cloud/clef-decisions"
import { accountFetch, apiOrigin, browserAccountId } from "./graceAccount.vibe"
import { accountPlugin } from "./accountPlugin.ts"
import { supportsPointerHover, webView } from "./surfacePlugin.ts"
import { NativePage } from "./nativePage.vibe"
import { type LinkObservation, PageId } from "./nativePage.schema.ts"
import { withhold } from "./private.ts"

export type BrowserGuidance = { kind: "Link" | "Menu" | "Unavailable"; words: string }

export service BrowserGuide {
  point(): BrowserGuidance!!
}

function unavailableBecause(words: string): BrowserGuidance { return { kind: "Unavailable", words } }
const unavailable = unavailableBecause("I couldn't find a link to point to on this page.")
const changed = unavailableBecause("The page or task changed. Ask me again on the page you want.")
const namedPageContext = " Prefer an exact page label. If it is absent, choose a navigation section that leads there. Keep the requested kind of page, such as a category or an individual item."
const choiceContext = " Compare the meaning of the links rather than requiring exact words. If the request is for a collection, prefer the parent section over an individual item."

function context(w: Workspace) {
  if (!mayGuideReadLink(w)) return undefined
  const tab = activeTab(w.browser)
  const address = tabUrl(tab)
  if (!URL.canParse(address)) return undefined
  const url = new URL(address)
  if (url.protocol !== "https:" || url.username || url.password) return undefined
  const step = { task: w.assistant.taskId, version: w.assistant.workVersion, generation: w.assistant.conversation.generation,
    stepIndex: w.plan.receipts.length, deviceVersion: w.device.contextVersion, browserRevision: w.browser.revision }
  const key = JSON.stringify([w.plan.owner, step, tab.id, tab.loadVersion])
  const outcome = nextOutcome(w.plan)
  const namedPage = guidedReadKind(outcome) === "ReachNamedPage"
  return { key, step, id: PageId.make(`tab-${tab.id}`), url, goal: w.plan.originalAsk, target: namedPage ? outcome.subject : "" }
}

function publicWords(text: string): string {
  const plain = text.normalize("NFC").replace(/[\p{Cc}\p{Cf}]/gu, " ").replace(/\s+/gu, " ").trim()
  return withhold({ text: plain.replace(/https?:\/\/\S+|[\w.+-]+@[\w.-]+\.[\w-]+/giu, "…"), passwords: [] })
}

function links(snapshot: LinkObservation, page: URL, target: string) {
  const { result } = snapshot
  if (result.url !== page.href || result.readyState !== "complete" ||
      result.blockers.some(blocker => blocker.covers !== "partial")) return []
  const destinations = new Map<string, { id: string; label: string; labels: Set<string>; rank: number; path: string; menuItem: boolean; expanded?: boolean; selector?: string | null; samePage: boolean }>()
  for (const item of result.elements) {
    if (item.tag !== "a" || item.disabled || item.sensitive || !item.label || !item.href || !URL.canParse(item.href)) continue
    const address = new URL(item.href)
    const menuItem = item.role === "menuitem"
    const samePage = address.pathname === page.pathname && address.search === page.search
    if (address.origin !== page.origin || address.username || address.password || (samePage && (target === "" || !menuItem))) continue
    const label = publicWords(item.label)
    if (!label || label.includes("*") || label.length > CLEF_DECISION_LIMITS.candidateLabel) continue
    const bounds = item.bounds
    const viewport = result.viewport
    let rank = item.inViewport ? 2 : 1
    if (item.inViewport && bounds !== undefined && viewport !== undefined && viewport.scale > 0) {
      const contained = bounds.x >= viewport.offsetLeft && bounds.y >= viewport.offsetTop &&
        bounds.x + bounds.width <= viewport.offsetLeft + viewport.width / viewport.scale &&
        bounds.y + bounds.height <= viewport.offsetTop + viewport.height / viewport.scale
      if (!contained) rank = 0
    }
    const existing = destinations.get(address.href)
    if (existing === undefined) {
      destinations.set(address.href, { id: item.id, label, labels: new Set([label]), rank, path: address.pathname, menuItem, expanded: item.expanded, selector: item.targetSelector, samePage })
    } else {
      existing.labels.add(label)
      if (rank > existing.rank) {
        existing.id = item.id
        existing.label = label
        existing.rank = rank
        existing.menuItem = menuItem
        existing.expanded = item.expanded
        existing.selector = item.targetSelector
      }
    }
  }
  return [...destinations].map(([href, link]) => {
    const aliases = [...link.labels]
    const description = aliases.join(" / ")
    if (target !== "") {
      const control = link.expanded === false ? " (collapsed menu)" : link.expanded === true ? " (expanded menu)" : link.menuItem ? " (menu item)" : ""
      return { id: link.id, label: link.label, description: (description + control).slice(0, CLEF_DECISION_LIMITS.candidateLabel),
        href, menuItem: link.menuItem, selector: link.selector, samePage: link.samePage, exact: aliases.some((label) => label.toLowerCase() === target.toLowerCase()), pointable: link.rank === 2 }
    }
    const prefix = link.path.replace(/\/+$/u, "") + "/"
    const children = [...destinations.values()].filter(other => other.path !== link.path && other.path.startsWith(prefix))
    const section = children.length ? " (section with links including " + children.slice(0, 3).map(child => child.label).join(", ") + ")" : ""
    return { id: link.id, label: link.label, description: (description + section).slice(0, CLEF_DECISION_LIMITS.candidateLabel), href,
      menuItem: false, selector: undefined, samePage: false, exact: false, pointable: link.rank === 2 }
  })
}

const decodeGuideLease = Schema.decodeUnknownSync(Schema.Struct({ id: Schema.NullOr(Schema.NonEmptyString) }))

type ChoiceRequest = Extract<ClefDecisionRequest, { kind: "choice" }>
export type GuideDecision = (request: ChoiceRequest, signal?: AbortSignal) => Promise<ClefDecisionResponse>
type DecisionSession = {
  choose: GuideDecision
  current(): Promise<boolean>
}

effect function decisionSession(native: boolean, fixture?: GuideDecision): (DecisionSession | undefined)!unknown {
  if (fixture !== undefined) return { choose: fixture, current: () => Promise.resolve(true) }
  if (native) {
    const bridge = accountPlugin
    if (bridge === undefined) return undefined
    const lease = try tryPromise(async () => decodeGuideLease(await bridge.browserGuideLease()))
    if (lease.id === null) return undefined
    const id = lease.id
    return {
      current: async () => decodeGuideLease(await bridge.browserGuideLease()).id === id,
      choose: async (request, signal) => {
        signal?.throwIfAborted()
        const reply = await bridge.chooseBrowserLink({ lease: id, goal: request.goal, candidates: request.candidates })
        signal?.throwIfAborted()
        return decodeClefResult(request, reply) ?? { status: "unavailable", reason: clefUnavailability(reply) }
      },
    }
  }
  const owner = try browserAccountId()
  if (owner === undefined) return undefined
  const choose = try Effect.try(() => createClefDecisionsClient({
    baseUrl: apiOrigin || webView.window.location.origin,
    headers: () => ({ "X-Eliza-Account": owner }),
    fetch: accountFetch,
    timeoutMs: 20000,
  }))
  return { choose: async (request, signal) => await choose(request, signal), current: async () => (await runPromise(browserAccountId())) === owner }
}

export const browserGuide = (native: boolean, fixture?: GuideDecision) => Layer.effect(BrowserGuide, effect {
  const workspace = try Workspaces
  const page = try NativePage
  const setup = try Setup
  let active: { id: PageId; key: string; account: DecisionSession } | undefined
  try fork.scoped Stream.runForEach(workspace.changes, effect (state) => {
    const old = active
    if (old !== undefined && context(state)?.key !== old.key) {
      active = undefined
      page.clearGuide(old.id) catch () => undefined
    }
  })
  if (fixture === undefined) try fork.scoped Stream.runForEach(setup.changes, effect () => {
    const shown = active
    if (shown === undefined) return
    const current = tryPromise(() => shown.account.current()) catch () => false
    if (!current && active === shown) {
      active = undefined
      page.clearGuide(shown.id) catch () => undefined
    }
  })
  try addFinalizer(() => active === undefined ? Effect.void : Effect.ignore(page.clearGuide(active.id)))
  return {
    point: effect () => {
      const start = context(try workspace.get())
      if (start === undefined) return changed
      const account = decisionSession(native, fixture) catch () => null
      if (account === null) return unavailableBecause("I couldn’t reach Grace to verify your sign-in.")
      if (account === undefined) return unavailableBecause("Sign in to Grace to get help choosing a link.")
      const request = publicWords(start.goal)
      const target = publicWords(start.target)
      if (!request || (start.target !== "" && (!target || target.includes("*")))) return unavailable
      const instruction = target === "" ? choiceContext : " Find the named page: " + target + "." + namedPageContext
      if (request.length > CLEF_DECISION_LIMITS.goal || (target !== "" && request.length + instruction.length > CLEF_DECISION_LIMITS.goal)) return unavailable
      const goal = request.length + instruction.length <= CLEF_DECISION_LIMITS.goal ? request + instruction : request
      for (let attempt = 0; attempt < 2; attempt++) {
        if (context(try workspace.get())?.key !== start.key) return changed
        const snapshot = page.observeLinks(start.id) catch () => undefined
        if (snapshot === undefined) return unavailableBecause("I can't read the links in this browser right now.")
        const observed = links(snapshot, start.url, target)
        const exact = observed.filter((link) => link.exact)
        if (exact.length > 1) return unavailableBecause(`More than one link is named “${target}”. Open the one you mean.`)
        if (exact.length === 1 && !exact[0]?.pointable) return unavailableBecause(`Scroll until “${target}” is visible, then ask again.`)
        const choices = target === "" ? observed : exact.length === 1 ? exact : observed.filter((link) => link.pointable)
        if (!choices.length) return unavailable
        if (context(try workspace.get())?.key !== start.key) return changed
        const decision = Effect.tryPromise(async (signal) => {
          let round = choices
          do {
            const selected: typeof choices = []
            for (let index = 0; index < round.length; index += CLEF_DECISION_LIMITS.candidates) {
              const candidates = round.slice(index, index + CLEF_DECISION_LIMITS.candidates)
              const options = candidates.map(({ description }, index) => ({ id: String(index + 1), label: description }))
              if (!(await account.current()) || context(await runPromise(workspace.get()))?.key !== start.key) return { retry: false }
              signal.throwIfAborted()
              const answer = await account.choose({ kind: "choice", goal, candidates: options }, signal)
              if (answer.status === "unavailable") return { retry: answer.reason === "provider_error" }
              if (answer.status !== "ok" || answer.kind !== "choice") return { retry: false }
              const choice = candidates[options.findIndex(option => option.id === answer.choice)]
              if (choice !== undefined) selected.push(choice)
            }
            round = selected
          } while (round.length > 1)
          return { retry: false, winner: round[0] }
        }) catch () => ({ retry: false, winner: undefined })
        if (context(try workspace.get())?.key !== start.key) return changed
        if (decision.retry) continue
        const winner = decision.winner
        if (winner === undefined) return unavailable
        const opensMenu = target !== "" && !winner.exact && winner.menuItem && winner.selector !== null && winner.selector !== undefined &&
          (try page.hasNavigationMenu(start.id, winner.selector, start.url.href))
        if (context(try workspace.get())?.key !== start.key) return changed
        if (winner.samePage && !opensMenu) return unavailable
        const sameAccount = tryPromise(() => account.current()) catch () => false
        if (!sameAccount || context(try workspace.get())?.key !== start.key) return changed
        const expiresAt = (try Clock.currentTimeMillis) + 20000
        const accepted = page.pointAt(start.id, snapshot.documentId, {
          kind: "show", id: snapshot.result.snapshotId, snapshotId: snapshot.result.snapshotId,
          nodeId: winner.id, origin: start.url.origin, expiresAt, text: winner.label, assistantName: "Grace"
        }) catch () => false
        if (!accepted) return changed
        const currentAccount = tryPromise(() => account.current()) catch () => false
        if (!currentAccount || context(try workspace.get())?.key !== start.key) {
          page.clearGuide(start.id) catch () => undefined
          return changed
        }
        if (opensMenu) {
          active = { id: start.id, key: start.key, account }
          const hover = Effect.try(supportsPointerHover) catch () => false
          const words = hover
            ? `Move the pointer over “${winner.label}” to open its submenu, then choose Show me the link again.`
            : `Open the website’s “${winner.label}” menu, then choose Show me the link again.`
          return { kind: "Menu", words }
        }
        const recorded = workspace.send({ type: "setGuidedLink", link: { ...start.step, url: winner.href } }, "Host") catch () => undefined
        if (recorded === undefined || context(try workspace.get())?.key !== start.key) {
          page.clearGuide(start.id) catch () => undefined
          return changed
        }
        active = { id: start.id, key: start.key, account }
        return { kind: "Link", words: `Look for “${winner.label}” on ${start.url.hostname}.` }
      }
      return unavailable
    }
  }
})
