// spec/app/files.md, "Story: Find and open something I saved"; spec/app/files.md, "Story: Save, share and remove the chosen file"; spec/app/files.md, "Sharing a photo opens a draft without sending it"
import { type Files, type FileActor, type Event, enabled, fileAt, initial, step } from "../gen/app__files.effect.vibe"
import { enabled as deskEnabled, Machine as Workspaces } from "../gen/app__workspace.effect.vibe"
import { Machine as Setup } from "../gen/app__setup.effect.vibe"
import { Mail } from "./mail.vibe"
import { FileCatalog as Catalog, FileEntry as Entry, fileId, FileLease as Lease, FileStorage, filesAccount, accountRefreshes, Preview, savedFile } from "./files.vibe"

schema Completion { id: fileId }

type Closed = { kind: "out" | "signedOut" | "opening" | "unavailable" | "unsupported" }
type Ready = {
  kind: "ready"; owner: string; canImport: boolean; lease: string; model: Files; thumbs: Readonly<Record<string, string>>
  senders: Readonly<Record<string, string>>; image?: string; busy: boolean; issue: boolean
}
export type FileSnapshot = Closed | Ready
export type FileHome = { photos: { src: string; alt: string }[]; document?: { name: string } }
type Command =
  | { kind: "open"; id: string }
  | { kind: "deletePhoto"; id: string; lease: string; generation: number }
  | { kind: "sharePhoto"; id: string; lease: string; generation: number }
  | { kind: "tab"; tab: "Photos" | "Documents" }
  | { kind: "photo" | "page"; direction: -1 | 1 }
  | { kind: "search"; query: string }
  | { kind: "pick"; file: "photo" | "pdf" }
  | { kind: "retry" | "back" | "capture" | "account" }

export service FileLibrary {
  readonly changes: Stream.Stream<FileSnapshot>
  readonly home: Stream.Stream<FileHome | undefined>
  get(): FileSnapshot!!
  getHome(): (FileHome | undefined)!!
  run(command: Command): boolean!!
}

error FilesRejected

export const fileLibrary = Layer.effect(FileLibrary, effect {
  const { port } = try FileStorage
  const desk = try Workspaces
  const setup = try Setup
  const mail = try Effect.serviceOption(Mail)
  const latest = try SubscriptionRef.make<FileSnapshot>({ kind: "out" })
  const home = try SubscriptionRef.make<FileHome | undefined>(undefined)
  const serial = try Semaphore.make(1)

  effect function admitted() {
    const w = try desk.get()
    return w.device.readiness === "Ready" && w.device.surface === "Files" ? filesAccount((try setup.get()).graceAccount) : undefined
  }

  effect function keep(ready: Ready) {
    const current = try SubscriptionRef.get(latest)
    if (current.kind !== "ready" || current.lease !== ready.lease || (try admitted()) !== ready.owner) throw new FilesRejected()
    try SubscriptionRef.set(latest, ready)
  }

  effect function advance(ready: Ready, event: Event, actor: FileActor) {
    if (!enabled(ready.model, event, actor)) throw new FilesRejected()
    const result = step(ready.model, event, actor)
    const next = { ...ready, model: result.state }
    try keep(next)
    return { ready: next, out: result.out }
  }

  effect function image(lease: string, id: string, page: number, small: boolean) {
    if (!port) throw new FilesRejected()
    const preview = try Schema.decodeUnknownEffect(Preview)(try tryPromise(() => port.preview({ lease, id, page, small })))
    if (preview.id !== id || preview.page !== page) throw new FilesRejected()
    return preview.image
  }

  effect function exposeCatalog(ready: Ready) {
    const photos = ready.model.entries.filter((entry) => entry.kind === "Photo")
    const document = ready.model.entries.find((entry) => entry.kind === "Pdf")
    const thumbnails = try Effect.forEach(photos.slice(0, 40), effect (entry) => {
      const preview = image(ready.lease, entry.id, 0, true) catch () => undefined
      return [entry.id, preview] as const
    }, { concurrency: 3 })
    const thumbs = Object.fromEntries(thumbnails.flatMap(([id, preview]) => preview ? [[id, preview]] : []))
    const projected = photos.slice(0, 3).flatMap((entry) => thumbs[entry.id] ? [{ src: thumbs[entry.id], alt: entry.name }] : [])
    try keep({ ...ready, thumbs })
    try SubscriptionRef.set(home, { photos: projected, document: document ? { name: document.name } : undefined })
  }

  effect function load(ready: Ready) {
    if (!port) throw new FilesRejected()
    const loading = (try advance(ready, { type: "openFiles", owner: ready.lease }, "FileUser")).ready
    if (loading.model.pending !== "ReadingCatalog") return
    const catalog = Schema.decodeUnknownEffect(Catalog)(try tryPromise(() => port.list({ lease: ready.lease }))) catch () => undefined
    const listed = catalog?.entries.slice(0, 250) ?? []
    const entries = listed.map((entry) => savedFile(entry, ready.owner, ready.lease))
    const senders = Object.fromEntries(listed.flatMap((entry) => entry.from ? [[entry.id, entry.from]] : []))
    const { ready: loaded } = try advance({ ...loading, senders }, { type: "loadCatalog", catalogReport: {
      owner: ready.lease, generation: loading.model.generation, entries, succeeded: catalog !== undefined, evidence: "device-library",
    } }, "FileStore")
    if (loaded.model.loaded) try exposeCatalog(loaded)
  }

  effect function openLibrary() {
    const owner = try admitted()
    if (!port || !owner) return
    try SubscriptionRef.set(latest, { kind: "opening" })
    const opened = Schema.decodeUnknownEffect(Lease)(try tryPromise(() => port.open())) catch () => undefined
    if (!opened) {
      if (try admitted()) try SubscriptionRef.set(latest, { kind: "unavailable" })
      return
    }
    if ((try admitted()) !== owner) {
      tryPromise(() => port.close(opened)) catch () => undefined
      return
    }
    const ready: Ready = { kind: "ready", owner, canImport: Boolean(port.pick && port.capture && port.commit), lease: opened.lease, model: initial, thumbs: {}, senders: {}, busy: false, issue: false }
    try SubscriptionRef.set(latest, ready)
    load(ready) catch effect () => {
      if (try admitted()) try SubscriptionRef.set(latest, { kind: "unavailable" })
      tryPromise(() => port.close(opened)) catch () => undefined
    }
  }

  effect function readSelected(ready: Ready) {
    const { model } = ready
    if (!model.selected) return false
    const result = image(ready.lease, model.selected, model.page, false) catch () => undefined
    const current = { ...ready, image: result, issue: !result }
    if (model.pending === "ReadingFile") {
      try advance(current, { type: "contentResult", fileReceipt: {
        owner: ready.lease, generation: model.generation, id: model.selected, succeeded: result !== undefined, evidence: "device-preview",
      } }, "FileHost")
    } else try keep(current)
    return result !== undefined
  }

  effect function importOwner(ready: Ready, command: Extract<Command, { kind: "pick" }> | { kind: "capture" }) {
    if (!port?.pick || !port.capture || !port.commit || !ready.model.loaded || ready.model.pending !== "NoFileOperation" || ready.model.selected !== "") return false
    const { capture, pick, commit } = port
    const input = { lease: ready.lease }
    try keep({ ...ready, busy: true, issue: false })
    const entry = Schema.decodeUnknownEffect(Entry)(try tryPromise(() =>
      command.kind === "capture" ? capture(input) : pick({ ...input, kind: command.file }))) catch () => undefined
    if (!entry) {
      try keep({ ...ready, busy: false })
      return false
    }
    const file = savedFile(entry, ready.owner, ready.lease)
    const { ready: storing } = try advance(ready, { type: "saveFiles", fileImport: {
      owner: ready.lease, generation: ready.model.generation, entries: [file], authorization: ready.lease,
    } }, "FileHost")
    const stored = Schema.decodeUnknownEffect(Completion)(try tryPromise(() => commit({ ...input, id: entry.id }))) catch () => undefined
    const success = stored?.id === entry.id
    const { ready: after } = try advance(storing, { type: "writeResult", fileReceipt: {
      owner: ready.lease, generation: storing.model.generation, id: "", succeeded: success, evidence: "device-save",
    } }, "FileStore")
    if (success) try exposeCatalog(after)
    return success
  }

  effect function deletePhoto(ready: Ready, command: Extract<Command, { kind: "deletePhoto" }>) {
    if (!port || ready.lease !== command.lease || !ready.model.contentReady) return false
    const { id, generation } = command
    const { ready: removing } = try advance({ ...ready, busy: true }, { type: "deletePhoto", id, generation }, "FileUser")
    const succeeded = effect {
      try tryPromise(() => port.remove({ lease: ready.lease, id }))
      return true
    } catch () => false
    const { ready: after } = try advance({ ...removing, busy: false, image: succeeded ? undefined : ready.image }, { type: "writeResult", fileReceipt: {
      owner: ready.lease, generation: removing.model.generation, id, succeeded, evidence: "device-removal",
    } }, "FileStore")
    if (succeeded) try exposeCatalog(after)
    return succeeded
  }

  effect function sharePhoto(ready: Ready, command: Extract<Command, { kind: "sharePhoto" }>) {
    const { id, generation } = command
    const event: Event = { type: "sharePhoto", id, generation }
    if (ready.lease !== command.lease || !enabled(ready.model, event, "FileUser") || !deskEnabled(try desk.get(), { type: "visit", destination: "Email" }, "Person")) return false
    const accepted = Option.isSome(mail) && (try mail.value.share(fileAt(ready.model, id)))
    if (!accepted) return false
    try advance({ ...ready, image: undefined, issue: false }, event, "FileUser")
    try desk.send({ type: "visit", destination: "Email" }, "Person")
    return true
  }

  effect function run(command: Command) {
    if (command.kind === "account") {
      try desk.send({ type: "chooseSettingsPage", page: "AccountSettings" }, "Person")
      return true
    }
    if (!(try admitted())) return false
    const current = try SubscriptionRef.get(latest)
    if (command.kind === "retry" && current.kind === "unavailable") {
      try openLibrary()
      return true
    }
    if (current.kind !== "ready" || current.busy) return false
    switch (command.kind) {
      case "retry":
        if (current.model.selected) {
          if (fileAt(current.model, current.model.selected).kind === "Pdf" && current.model.contentReady) return try readSelected(current)
          const loading = (try advance({ ...current, image: undefined, issue: false }, { type: "openFile", id: current.model.selected }, "FileUser")).ready
          return try readSelected(loading)
        }
        try load(current)
        return true
      case "deletePhoto": return try deletePhoto(current, command)
      case "sharePhoto": return try sharePhoto(current, command)
      case "capture": return try importOwner(current, { kind: "capture" })
      case "pick": return try importOwner(current, command)
      case "tab":
        try advance(current, { type: "chooseTab", tab: command.tab }, "FileUser")
        return true
      case "back":
        try advance({ ...current, image: undefined, issue: false }, { type: "backToFiles" }, "FileUser")
        return true
      case "open":
      case "photo":
      case "page": {
        const event: Event = command.kind === "open" ? { type: "openFile", id: command.id } :
          command.kind === "photo" ? { type: "movePhoto", direction: command.direction } : { type: "movePage", direction: command.direction }
        const target = (try advance({ ...current, image: undefined, issue: false }, event, "FileUser")).ready
        return try readSelected(target)
      }
      case "search": {
        const query = command.query.trim()
        if (!query || query.length > 120) return false
        const { ready: finding } = try advance({ ...current, image: undefined, issue: false },
          { type: "findFiles", owner: current.lease, query }, "FileUser")
        if (finding.model.pending !== "Locating") return false
        try advance(finding, { type: "locate", locateReport: {
          owner: current.lease, generation: finding.model.generation, query,
          ids: finding.model.entries.filter((entry) => entry.name.toLowerCase().includes(query.toLowerCase())).map((entry) => entry.id),
        } }, "FileHost")
        return true
      }
    }
    return false
  }

  const contexts = Stream.changes(Stream.map(Stream.zipLatest(desk.changes, setup.changes), ([w, account]) =>
    JSON.stringify([filesAccount(account.graceAccount) ?? "", w.device.surface === "Files" && w.device.readiness === "Ready"])))
  let lastOwner: string | undefined
  try fork.scoped Stream.runForEach(Stream.merge(Stream.map(contexts, () => false), Stream.map(accountRefreshes(), () => true)), effect (renew) => {
    const w = try desk.get()
    const owner = filesAccount((try setup.get()).graceAccount)
    const visible = w.device.surface === "Files" && w.device.readiness === "Ready"
    const prior = try SubscriptionRef.get(latest)
    if (renew || owner !== lastOwner || !owner) try SubscriptionRef.set(home, undefined)
    lastOwner = owner
    if (prior.kind === "ready" && port) tryPromise(() => port.close({ lease: prior.lease })) catch () => undefined
    try SubscriptionRef.set(latest, { kind: !visible ? "out" : !owner ? "signedOut" : !port ? "unsupported" : "opening" })
    if (visible && owner && port) try fork.scoped serial.withPermit(openLibrary())
  })
  return {
    changes: SubscriptionRef.changes(latest),
    home: SubscriptionRef.changes(home),
    get: () => SubscriptionRef.get(latest),
    getHome: () => SubscriptionRef.get(home),
    run: effect (command) => serial.withPermit(run(command)) catch () => false,
  }
})
