// spec/app/notices.md, "Story: See one message at a time, in the order things happened"; spec/app/notices.md, "Story: Never have a decision covered"; spec/app/notices.md, "No notice shows over a commitment review or a website's question"; spec/app/notices.md, "Story: See what needs me on Home"; spec/app/notices.md, "A toast stays its whole lifetime unless the person closes it or acts"; spec/app/notices.md, "Coming back online is told once, in a toast"; spec/app/notices.md, "Home shows one banner, for the first cause: no Wi-Fi, a signed-out account, no email, then a reminder"; spec/app/mailboxes.md, "The Home Email card says No email added yet, Last updated only while it can’t update, or how many are new"; spec/app/notices.md, "Only reminders reach Android, and a new one only while Grace is in the background"
import { type Event, type Notice, type Place, Machine as Notices, type Rejected, initial, lifetimeMs, machine, queued } from "../gen/app__notices.effect.vibe"
import { Machine as Proposals, asking } from "../gen/app__proposal.effect.vibe"
import { Machine as WebsiteRequests, presented } from "../gen/app__websiteRequests.effect.vibe"
import { Machine as Setup } from "../gen/app__setup.effect.vibe"
import type { ReminderPlugin } from "./accountPlugin.ts"
import { Machine as Workspaces } from "../gen/app__workspace.effect.vibe"
import { Machine as Accounts, type Accounts as Registry } from "../gen/app__accounts.effect.vibe"
import { homeSignIn, type MailSource, showsConnect } from "../gen/app__mailboxes.effect.vibe"
import { Instances } from "./instances.vibe"
import { surfaceOwner } from "./managedReads.vibe"
import { type WiFiPlugin, webView } from "./surfacePlugin.ts"

export data Reply {
  Undo { notice: Notice }
  SeeDetails { reminder: string }
  Dismiss { reminder: string }
  Closed { notice: Notice }
}

export service NoticeHost {
  raise(notice: Omit<Notice, "id">): (number | undefined)!Rejected
  act(id: number): void!!
  close(id: number): void!!
  reply(reply: Reply): void!!
  readonly replies: Stream.Stream<Reply>
}

export type NoticeServices = Notices | NoticeHost

const ReminderId = Schema.String.check(Schema.isPattern(/^owned-calendar-[a-f0-9]{24}-[a-f0-9]{48}$/))
schema DueReminder { id: ReminderId; title: Schema.NonEmptyString; eventAt: Schema.Int }
schema DueReminders { reminders: DueReminder[] }
schema DismissedReminder { id: ReminderId }
const dateTime = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" })
const reminderLabel = (reminder: DueReminder) => reminder.title + " · " + dateTime.format(new Date(reminder.eventAt))

const host = (wifi: WiFiPlugin | undefined, reminderPort?: ReminderPlugin) => Layer.effect(NoticeHost, effect {
  const notices = try Notices
  const workspace = try Workspaces
  const requests = try WebsiteRequests
  const proposals = try Proposals
  const accounts = try Accounts
  const shelf = try Instances
  const setups = try Setup
  const replies = try PubSub.unbounded<Reply>()
  const lock = try Semaphore.make(1)
  const serial = lock.withPermits(1)

  effect function report(left: readonly Notice[]) {
    try Effect.forEach(left, (notice) => PubSub.publish(replies, Reply.Closed({ notice })))
  }

  effect function follow() {
    const { device, assistant } = try workspace.get()
    const n = try notices.get()
    const place: Place = (try sync(webView.hidden)) || device.readiness === "Sleeping" ? "Background" : device.surface === "Home" ? "Home" : "OtherScreen"
    const expanded = assistant.presentation === "Expanded"
    const question = try proposals.get()
    const blocked = presented(try requests.get()).id !== 0 || (asking(question) && question.agreed === 0)
    if (place !== n.place) try Effect.orDie(notices.send({ type: "move", place }, "Host"))
    if (place === "Background" && n.place !== "Background") try report(queued(n))
    if (expanded !== n.expanded) try Effect.orDie(notices.send({ type: "expand", expanded }, "Host"))
    if (blocked !== n.blocked) try Effect.orDie(notices.send({ type: "cover", blocked }, "App"))
  }

  effect function expireAfter(notice: Notice) {
    const elapsed = lifetimeMs(notice.offer)
    try sleep(elapsed)
    uninterruptible {
      const sent = serial(notices.send({ type: "expire", id: notice.id, elapsed }, "Host")) catch () => undefined
      if (sent !== undefined) try report([notice])
    }
  }

  effect function ended(event: Extract<Event, { type: "act" | "closeToast" }>) {
    const notice = (try notices.get()).shown.find((x) => x.id === event.id)
    const sent = notices.send(event, "Person") catch () => undefined
    return sent === undefined ? undefined : notice
  }

  const connection = Stream.changes(Stream.concat(Stream.fromEffect(connected(wifi)), Stream.drop(Stream.changes(Stream.map(workspace.changes, (w) => w.device.connectivity === "Online")), 1)))
  try fork.scoped Stream.runForEach(connection, (online) => Effect.orDie(notices.send({ type: "observeConnection", online }, "Host")))
  effect function causesOf(registry: Registry) {
    const watched: Stream.Stream<MailSource>[] = []
    for (const account of registry.accounts) {
      if (!account.use.mail) continue
      const box = shelf.mail(account.id) catch () => undefined
      if (box !== undefined) watched.push(Stream.map(box.changes, (mailbox) => ({ account: account.id, mailbox })))
    }
    const sources: Stream.Stream<readonly MailSource[]> = watched.length === 0 ? Stream.make([]) : Stream.zipLatestAll(...watched)
    return Stream.map(sources, (current) => {
      const named = registry.accounts.find((a) => a.id === homeSignIn(registry, [...current]))
      return { signIn: named === undefined ? "" : named.name || named.address, noEmail: showsConnect(registry) }
    })
  }
  const ours = Stream.changes(Stream.map(setups.changes, (s) => surfaceOwner(s, webView.window.location.hash) === "Ours"))
  const tablet = Stream.switchMap(accounts.changes, (registry) => Stream.unwrap(causesOf(registry)))
  const causes = Stream.changesWith(Stream.switchMap(ours, (mine) => mine ? tablet : Stream.make({ signIn: "", noEmail: false })), (a, b) => a.signIn === b.signIn && a.noEmail === b.noEmail)
  try fork.scoped Stream.runForEach(causes, ({ signIn, noEmail }) => Effect.orDie(notices.send({ type: "observeAccounts", signIn, noEmail }, "Host")))
  const workspaceView = Stream.changesWith(
    Stream.map(workspace.changes, ({ device, assistant }) => ({ surface: device.surface, readiness: device.readiness, expanded: assistant.presentation === "Expanded" })),
    (a, b) => a.surface === b.surface && a.readiness === b.readiness && a.expanded === b.expanded
  )
  const requestBlocked = Stream.changes(Stream.map(requests.changes, (r) => presented(r).id !== 0))
  const proposalBlocked = Stream.changes(Stream.map(proposals.changes, (q) => asking(q) && q.agreed === 0))
  const scene = Stream.mergeAll([
    Stream.as(workspaceView, undefined),
    Stream.as(requestBlocked, undefined),
    Stream.as(proposalBlocked, undefined),
    Stream.as(Stream.fromEventListener(webView.document, "visibilitychange"), undefined)
  ], { concurrency: "unbounded" })
  try fork.scoped Stream.runForEach(scene, () => serial(follow()))
  const showing = Stream.changesWith(Stream.map(notices.changes, (n) => n.shown.at(0)), (a, b) => a?.id === b?.id)
  try fork.scoped Stream.runDrain(Stream.switchMap(showing, (x) => x === undefined ? Stream.empty : Stream.fromEffect(expireAfter(x))))

  if (reminderPort !== undefined) {
    const port = reminderPort
    const setup = setups
    const known = new Map<string, string>()
    const listen = Stream.callback<void>((queue) => acquireRelease(
      Effect.option(tryPromise(() => port.addListener("managedDueChanged", () => { Queue.offerUnsafe(queue, undefined) }))),
      (listener) => Option.isSome(listener) ? Effect.ignore(tryPromise(() => listener.value.remove())) : Effect.void,
    ))
    effect function remove(subject: string) {
      notices.send({ type: "dismissReminder", subject }, "App") catch () => undefined
      known.delete(subject)
    }
    const refresh = Effect.ignore(serial(effect {
      const owner = (try setup.get()).graceAccount.tag
      if (owner !== "GraceDeviceSignedIn") {
        for (const subject of known.keys()) try remove(subject)
        return
      }
      try follow()
      if ((try notices.get()).place === "Background") return
      const received = Schema.decodeUnknownEffect(DueReminders)(try tryPromise(() => port.managedDue())) catch () => undefined
      if (!received || (try setup.get()).graceAccount.tag !== "GraceDeviceSignedIn") return
      const current = new Set(received.reminders.map((reminder) => reminder.id))
      for (const [subject, id] of known) if (!current.has(id)) try remove(subject)
      for (const reminder of received.reminders) {
        if ([...known.values()].includes(reminder.id)) continue
        const label = reminderLabel(reminder)
        let subject = label
        for (let i = 2; known.has(subject); i++) subject = label + " (" + i + ")"
        const admitted = notices.send({ type: "remind", subject }, "App") catch () => undefined
        if (admitted !== undefined) known.set(subject, reminder.id)
      }
    }))
    const accountChanges = Stream.changes(Stream.map(setup.changes, ({ graceAccount }) => graceAccount.tag))
    try fork.scoped Stream.runForEach(Stream.mergeAll(
      [listen, accountChanges, Stream.fromEventListener(webView.document, "visibilitychange")], { concurrency: "unbounded" }), () => refresh)
    try fork.scoped Stream.runForEach(Stream.fromPubSub(replies), (reply) => Effect.ignore(serial(effect {
      if (reply._tag !== "Dismiss" && reply._tag !== "SeeDetails") return
      const id = known.get(reply.reminder)
      if (id === undefined || (try setup.get()).graceAccount.tag !== "GraceDeviceSignedIn") return
      if (reply._tag === "SeeDetails") {
        try tryPromise(() => port.openManagedDue({ id }))
      } else {
        const receipt = try Schema.decodeUnknownEffect(DismissedReminder)(try tryPromise(() => port.dismissManagedDue({ id })))
        if (receipt.id === id) try remove(reply.reminder)
      }
    })))
  }

  return {
    effect raise(notice: Omit<Notice, "id">) {
      return queued(try serial(notices.send({ type: "raise", ...notice }, "App"))).at(-1)?.id
    },
    effect act(id: number) {
      const notice = try serial(ended({ type: "act", id }))
      if (notice !== undefined) try PubSub.publish(replies, notice.offer === "Undo" ? Reply.Undo({ notice }) : Reply.SeeDetails({ reminder: notice.subject }))
    },
    effect close(id: number) {
      const notice = try serial(ended({ type: "closeToast", id }))
      if (notice?.offer === "SeeDetails") try PubSub.publish(replies, Reply.Dismiss({ reminder: notice.subject }))
      else if (notice !== undefined) try report([notice])
    },
    effect reply(reply: Reply) {
      try PubSub.publish(replies, reply)
    },
    replies: Stream.fromPubSub(replies)
  }
})

effect function connected(wifi: WiFiPlugin | undefined): boolean!! {
  if (wifi === undefined) return try webView.online
  const c = tryPromise(() => wifi.getConnectivity()) catch () => undefined
  return c === undefined ? try webView.online : c.online && !c.captivePortal
}

export const notices = (wifi: WiFiPlugin | undefined, reminders?: ReminderPlugin) => Layer.provideMerge(host(wifi, reminders), machine(initial))
