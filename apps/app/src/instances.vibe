// spec/app/mailboxes.md, "Story: See all my email in one place"; spec/app/mailboxes.md, "Each account’s state is read from its own mailbox and never stored twice"; spec/app/accounts.md, "Story: Choose what each email brings and take it off the tablet"; spec/app/email.md, "Each search or content read needs current access and the user's choice"; spec/app/email.md, "Selected-message changes update the same canonical record and invalidate stale actions"; spec/app/email.md, "Sending or discarding retires the completed draft revision without hiding newer work"; spec/app/email.md, "Drafts shows the provider's count of saved drafts, whichever folder is open"; spec/app/mailboxes.md, "The Home Email card says No email added yet, Last updated only while it can’t update, or how many are new"
import { Machine as Accounts, type Account, type Accounts as Registry } from "../gen/app__accounts.effect.vibe"
import { machine as calendarMachine, Machine as CalendarMachine, parseState as parseCalendar, stored as storedCalendar } from "../gen/app__calendarView.effect.vibe"
import { type Event as MailEvent, hasMessage, initial as initialMail, listingScope, machine as mailMachine, Machine as MailMachine, messageRecord, parseState as parseMail, retainedOnly, stored as storedMail, type Mailbox, type ReadReceipt } from "../gen/app__email.effect.vibe"
import type { ChangeReceipt } from "../gen/app__emailItem.effect.vibe"
import type { SavedFile } from "../gen/app__files.effect.vibe"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Attached, Connector, type MailConnection, MailContent, NeedsSignIn, pruneCalendarJournals } from "./connector.vibe"

export error NotAnAccount { id: number }

export schema HeldFile {
  readonly id: string; readonly kind: "Photo" | "Pdf"; readonly name: string; readonly origin: string; readonly account: string
  readonly container: string; readonly sourceRef: string; readonly contentRef: string; readonly group: string
  readonly savedAt: number; readonly pages: number
}
schema HeldReply { readonly address: string; readonly subject: string; readonly verified: boolean }
schema ReviewedRead { readonly generation: number; readonly version: string; readonly evidence: string }
type ObservedRead = { kind: "opened" | "refreshed"; receipt: ReadReceipt }
const heldContent = MailContent
export schema Held { readonly content: heldContent; readonly assets?: readonly HeldFile[]; readonly reply?: HeldReply; readonly read?: ReviewedRead }

export type MailRuntime = ManagedRuntime.ManagedRuntime<MailMachine, NotAnAccount>
export type CalendarRuntime = ManagedRuntime.ManagedRuntime<CalendarMachine, NotAnAccount>

export effect function followAccounts<R>(selections: Stream.Stream<readonly Account[]>, start: (account: Account) => Fiber.Fiber<void>!NotAnAccount!R) {
  const active = new Map<number, Fiber.Fiber<void>>()
  try Stream.runForEach(selections, effect (wanted) => {
    for (const account of wanted) {
      if (active.has(account.id)) continue
      const fiber = start(account) catch () => undefined
      if (fiber !== undefined) active.set(account.id, fiber)
    }
    for (const [id, fiber] of active) {
      if (wanted.some((account) => account.id === id)) continue
      try Fiber.interrupt(fiber)
      active.delete(id)
    }
  })
}

export service Instances {
  mail(id: number): MailMachine.Shape!NotAnAccount
  calendar(key: number): CalendarMachine.Shape!NotAnAccount
  attach(id: number, work: void!!): void!NotAnAccount
  keep(id: number, refs: ReadonlySet<string>): void!!
  readonly mailRuntime: (id: number) => MailRuntime
  readonly calendarRuntime: (key: number) => CalendarRuntime
  readonly content: (id: number, ref: string) => MailContent | undefined
  readonly held: (id: number, ref: string) => Held | undefined
  readonly remember: (id: number, held: Held, observed?: ObservedRead) => void
  readonly file: (id: number, asset: SavedFile) => Attached | undefined
  readonly hold: (id: number, asset: SavedFile, file: Attached) => void
  readonly updated: (kind: Updated, id: number) => number | undefined
  stamp(kind: Updated, id: number): void!!
}

export type Updated = "mail" | "calendar"

export const tablet = 0
const owner = "tablet"
const mailKey = (id: number) => `mail/${id}`
const calendarKey = (key: number) => `calendar/${key}`
const heldKey = (id: number) => `held/${id}`
const updatedKey = (kind: Updated, id: number) => `${kind}-updated/${id}`
const contentKey = (id: number, ref: string) => `${id}/${ref}`
const keyPattern = /^(?:mail|calendar|held|mail-updated|calendar-updated)\/(\d+)$/
const decodeHeld = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Array(Held)))
const decodeMailRecord = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Record(Schema.String, Schema.Unknown)))

function currentMailRecord(text: string) {
  const box = Option.getOrUndefined(decodeMailRecord(text))
  if (box === undefined) return undefined
  const current = { ...initialMail, ...box }
  if (typeof box.bill === "object" && box.bill !== null && !("sourceRef" in box.bill)) {
    const historical = parseMail({ ...current, bill: { ...box.bill, sourceRef: box.messageRef } })
    return historical === undefined ? undefined : JSON.stringify({ ...historical, bill: initialMail.bill })
  }
  if (parseMail(current) === undefined) return undefined
  return Object.keys(initialMail).some((key) => !(key in box)) ? JSON.stringify(current) : text
}

function upgradedCalendar(text: string, account: number) {
  let changed = false
  try {
    const parsed: unknown = JSON.parse(text, (key: string, value: unknown): unknown => {
      if (key === "" && typeof value === "object" && value !== null && "entries" in value) {
        if ("picker" in value && "feedNeedsSignIn" in value) return value
        changed = true
        return { picker: "NoPicker", feedNeedsSignIn: false, ...value }
      }
      if (typeof value === "object" && value !== null && "approvedRevision" in value && !("version" in value)) {
        changed = true
        return { ...value, version: "" }
      }
      if (key !== "identity" || typeof value !== "object" || value === null || !("occurrenceId" in value) ||
          !("kind" in value) || !("sourceRef" in value) || "sourceAccount" in value) return value
      const sourceAccount = value.kind === "Appointment" && typeof value.sourceRef === "string" && value.sourceRef !== "" ? account : 0
      changed = true
      return { ...value, sourceAccount }
    })
    if (parseCalendar(parsed) === undefined) return undefined
    return changed ? JSON.stringify(parsed) : text
  } catch {
    return undefined
  }
}

function reviewedRead(known: Held | undefined, content: MailContent, observed: ObservedRead | undefined) {
  const prior = known?.content
  const sameHeader = prior && prior.from === content.from && prior.fromAddress === content.fromAddress &&
    prior.subject === content.subject && prior.receivedAt === content.receivedAt
  if (!observed) return sameHeader && prior.version === content.version && (!content.body || prior.body === content.body) ? known.read : undefined
  const { generation, succeeded, suspicion } = observed.receipt
  if (!succeeded) return undefined
  if (observed.kind === "opened") return { generation, version: content.version, evidence: suspicion }
  return sameHeader && prior.body === content.body && known.read?.generation === generation &&
    known.read.evidence === suspicion ? known.read : undefined
}

export function compatibleStore<E>(store: KeyValueStore.KeyValueStore, key: string, upgrade: (raw: string) => (string | undefined)!E) {
  let last: { raw: string; compatible: string | undefined } | undefined
  let fallback: { value: string | undefined } | undefined
  return Layer.succeed(KeyValueStore.KeyValueStore, {
    ...store,
    get: effect (name: string) => {
      if (name !== key) return try store.get(name)
      if (fallback !== undefined) return fallback.value
      const raw = store.get(name) catch () => undefined
      if (raw === undefined) return undefined
      if (last?.raw !== raw) last = { raw, compatible: upgrade(raw) catch () => undefined }
      return last.compatible
    },
    set: effect (name: string, value: string | Uint8Array) => {
      if (name !== key || typeof value !== "string") return try store.set(name, value)
      const saved = Effect.as(store.set(name, value), true) catch () => false
      fallback = saved ? undefined : { value }
    },
    remove: effect (name: string) => {
      if (name !== key) return try store.remove(name)
      fallback = undefined
      last = undefined
      store.remove(name) catch () => undefined
    }
  })
}

export const instances = Layer.effect(Instances, effect {
  const registry = try Accounts
  const store = try KeyValueStore.KeyValueStore
  const mails = try SynchronizedRef.make(new Map<number, MailMachine.Shape>())
  const calendars = try SynchronizedRef.make(new Map<number, CalendarMachine.Shape>())
  const attached = try SynchronizedRef.make(new Map<number, Scope.Closeable>())
  const mailRuntimes = new Map<number, MailRuntime>()
  const calendarRuntimes = new Map<number, CalendarRuntime>()
  const contents = new Map<string, Held>()
  const files = new Map<string, Attached>()
  const updates = new Map<string, number>()
  try Effect.addFinalizer(() => effect {
    for (const scope of (try SynchronizedRef.get(attached)).values()) try Scope.close(scope, Exit.void)
    for (const runtime of [...mailRuntimes.values(), ...calendarRuntimes.values()]) try runtime.disposeEffect
  })

  effect function listed(id: number) {
    if (id !== tablet && !(try registry.get()).accounts.some((a) => a.id === id)) throw new NotAnAccount({ id })
  }

  effect function ensure<S>(all: SynchronizedRef.SynchronizedRef<Map<number, S>>, id: number, open: S!!) {
    try listed(id)
    return try SynchronizedRef.modifyEffect(all, effect (known: Map<number, S>) => {
      const found = known.get(id)
      if (found !== undefined) return [found, known] as const
      const made = try open
      return [made, new Map(known).set(id, made)] as const
    })
  }

  const openMail = (id: number) => effect {
    const key = mailKey(id)
    const compatible = compatibleStore(store, key, (raw) => Effect.succeed(currentMailRecord(raw)))
    const box = (Effect.provide(effect { return try MailMachine }, Layer.provide(storedMail(key), compatible)) catch () => undefined)
      ?? (try Effect.provide(effect { return try MailMachine }, mailMachine()))
    box.send({ type: "restartMailbox" }, "MailHost") catch () => undefined
    return box
  }
  const openCalendar = (account: number) => effect {
    const key = calendarKey(account)
    const compatible = compatibleStore(store, key, (text) => Effect.succeed(upgradedCalendar(text, account)))
    return (Effect.provide(effect { return try CalendarMachine }, Layer.provide(storedCalendar(key), compatible)) catch () => undefined)
      ?? (try Effect.provide(effect { return try CalendarMachine }, calendarMachine()))
  }
  const mail = (id: number) => id === tablet ? Effect.fail(new NotAnAccount({ id })) : ensure(mails, id, openMail(id))
  const calendar = (key: number) => ensure(calendars, key, openCalendar(key))
  const heldOf = (id: number) => [...contents].filter(([key]) => key.startsWith(contentKey(id, "")))

  effect function persistHeld(id: number) {
    const items = heldOf(id).map(([, held]) => held)
    effect function save(list: readonly Held[]) {
      return Effect.as(store.set(heldKey(id), JSON.stringify(list)), true) catch () => false
    }
    if (try save(items)) return
    const newestFirst = items.toSorted((a, b) => b.content.receivedAt - a.content.receivedAt)
    const stripBody = (h: Held): Held => h.content.body === "" ? h : { ...h, content: { ...h.content, body: "" } }
    for (const keepBodies of [Math.floor(newestFirst.length / 2), 0]) {
      if (try save(newestFirst.map((h, i) => i < keepBodies ? h : stripBody(h)))) return
    }
    const headersOnly = newestFirst.map(stripBody)
    for (let limit = Math.floor(headersOnly.length / 2); limit > 0; limit = Math.floor(limit / 2)) {
      if (try save(headersOnly.slice(0, limit))) return
    }
  }

  effect function forget(id: number) {
    try SynchronizedRef.updateEffect(attached, effect (all: Map<number, Scope.Closeable>) => {
      const scope = all.get(id)
      if (scope !== undefined) try Scope.close(scope, Exit.void)
      try SynchronizedRef.update(mails, (known) => new Map([...known].filter(([k]) => k !== id)))
      try SynchronizedRef.update(calendars, (known) => new Map([...known].filter(([k]) => k !== id)))
      const runtimes = [mailRuntimes.get(id), calendarRuntimes.get(id)]
      mailRuntimes.delete(id)
      calendarRuntimes.delete(id)
      for (const runtime of runtimes) if (runtime !== undefined) try runtime.disposeEffect
      for (const [key] of heldOf(id)) contents.delete(key)
      for (const key of [...files.keys()].filter((k) => k.startsWith(contentKey(id, "")))) files.delete(key)
      for (const key of [updatedKey("mail", id), updatedKey("calendar", id)]) updates.delete(key)
      for (const key of [mailKey(id), calendarKey(id), heldKey(id), updatedKey("mail", id), updatedKey("calendar", id)]) store.remove(key) catch () => undefined
      return new Map([...all].filter(([k]) => k !== id))
    })
  }

  effect function follow(a: Registry) {
    const ids = new Set(a.accounts.map((x) => x.id))
    for (const id of ids) {
      mail(id) catch () => undefined
      calendar(id) catch () => undefined
    }
    const opened = new Set([...(try SynchronizedRef.get(mails)).keys(), ...(try SynchronizedRef.get(calendars)).keys()])
    let removed = false
    for (const id of opened) if (id !== tablet && !ids.has(id)) {
      try forget(id)
      removed = true
    }
    if (removed) try pruneCalendarJournals(store, a.accounts)
  }

  const initialAccounts = (try registry.get()).accounts
  const present = new Set(initialAccounts.map((x) => x.id))
  const storedKeys = store.keys catch () => [] as readonly string[]
  for (const key of storedKeys) {
    const id = Number(keyPattern.exec(key)?.[1] ?? tablet)
    if (id !== tablet && !present.has(id)) try forget(id)
  }
  try pruneCalendarJournals(store, initialAccounts)
  for (const id of present) {
    for (const key of [updatedKey("mail", id), updatedKey("calendar", id)]) {
      const at = Number(store.get(key) catch () => undefined)
      if (Number.isSafeInteger(at) && at > 0) updates.set(key, at)
    }
    const text = store.get(heldKey(id)) catch () => undefined
    const found = text === undefined ? [] : decodeHeld(text) catch () => []
    for (const held of found) contents.set(contentKey(id, held.content.ref), held)
  }
  calendar(tablet) catch () => undefined
  try fork.scoped Stream.runForEach(registry.changes, follow)

  function cached<R>(all: Map<number, R>, id: number, make: () => R) {
    const found = all.get(id)
    if (found !== undefined) return found
    const made = make()
    all.set(id, made)
    return made
  }

  return {
    mail,
    calendar,
    attach: effect (id, work) => {
      try SynchronizedRef.updateEffect(attached, effect (all: Map<number, Scope.Closeable>) => {
        if (all.has(id)) return all
        try listed(id)
        const scope = try Scope.make()
        try fork.in(scope) work
        return new Map(all).set(id, scope)
      })
    },
    keep: effect (id, refs) => {
      for (const [key, held] of heldOf(id)) if (!refs.has(held.content.ref)) contents.delete(key)
      for (const key of [...files.keys()].filter((k) => k.startsWith(contentKey(id, "")) && !refs.has(k.slice(contentKey(id, "").length).split("/")[0]))) files.delete(key)
      try persistHeld(id)
    },
    mailRuntime: (id) => cached(mailRuntimes, id, () => ManagedRuntime.make(Layer.effect(MailMachine, mail(id)))),
    calendarRuntime: (key) => cached(calendarRuntimes, key, () => ManagedRuntime.make(Layer.effect(CalendarMachine, calendar(key)))),
    content: (id, ref) => contents.get(contentKey(id, ref))?.content,
    held: (id, ref) => contents.get(contentKey(id, ref)),
    remember: (id, held, observed) => {
      const known = contents.get(contentKey(id, held.content.ref))
      contents.set(contentKey(id, held.content.ref), {
        content: known === undefined ? held.content : { ...held.content, body: observed ? held.content.body : held.content.body || known.content.body, replied: held.content.replied || known.content.replied },
        assets: held.assets ?? known?.assets,
        reply: held.reply ?? known?.reply,
        read: reviewedRead(known, held.content, observed)
      })
    },
    file: (id, asset) => files.get(contentKey(id, asset.sourceRef)),
    hold: (id, asset, file) => { files.set(contentKey(id, asset.sourceRef), file) },
    updated: (kind, id) => updates.get(updatedKey(kind, id)),
    stamp: effect (kind, id) => {
      const at = try Clock.currentTimeMillis
      updates.set(updatedKey(kind, id), at)
      store.set(updatedKey(kind, id), String(at)) catch () => undefined
    }
  }
})

const unread = (generation: number): ReadReceipt => ({ generation, succeeded: false, assets: [], suspicion: "" })
const read = (generation: number, assets: ReadReceipt["assets"] = []): ReadReceipt => ({ generation, succeeded: true, assets, suspicion: "" })

export const reading = Layer.effectDiscard(effect {
  const registry = try Accounts
  const shelf = try Instances
  const connector = try Connector

  effect function begin(account: Account, box: MailMachine.Shape) {
    effect {
      try box.send({ type: "connect", owner, provider: account.provider, account: account.address }, "MailUser")
      const { generation } = try box.get()
      try box.send({ type: "authorize", generation, verified: true, readGranted: account.use.mail, sendGranted: account.use.mail }, "MailConnector")
      try box.send({ type: "readMail", kind: "Search", ref: "", approved: true }, "MailUser")
    } catch () => undefined
  }

  effect function signedOut(box: MailMachine.Shape, m: Mailbox) {
    box.send({ type: "endConnection", resultStatus: "Expired" }, "MailConnector") catch () => undefined
    const again: MailEvent | undefined = match (m.readKind) {
      when "Search": { type: "readMail", kind: "Search", ref: m.query, approved: true };
      when "OpenMessage": { type: "readMail", kind: "OpenMessage", ref: m.requestedRef, approved: true };
      when "OpenAttachment": undefined;
    }
    if (again !== undefined) box.send(again, "MailUser") catch () => undefined
  }

  effect function fromTablet(id: number, box: MailMachine.Shape, m: Mailbox) {
    const answered = match (m.readKind) {
      when "Search": effect {
        const words = m.query.toLowerCase().split(/\s+/).filter((w) => w !== "")
        const scope = listingScope(m)
        for (const record of m.messages) {
          const c = shelf.content(id, record.identity.ref)
          const text = c === undefined ? "" : [c.from, c.fromAddress, c.subject, c.snippet, c.body].join(" ").toLowerCase()
          if (record.folder !== m.folder || !words.every((w) => text.includes(w))) continue
          const seed = { identity: record.identity, folder: record.folder, unread: record.unread, answered: record.answered }
          box.send({ type: "receiveMessage", scope, listing: { seed, revision: record.revision, evidence: "tablet" } }, "MailConnector") catch () => undefined
        }
        return read(m.generation)
      };
      when "OpenMessage": effect {
        const assets = shelf.held(id, m.requestedRef)?.assets
        return assets === undefined ? unread(m.generation) : read(m.generation, [...assets])
      };
      when "OpenAttachment": effect {
        const file = m.assets.find((a) => a.sourceRef === m.requestedRef)
        return file === undefined || shelf.file(id, file) === undefined ? unread(m.generation) : read(m.generation)
      };
    }
    return try answered
  }

  effect function fromProvider(id: number, mail: MailConnection, box: MailMachine.Shape, m: Mailbox) {
    const answered = match (m.readKind) {
      when "Search": effect {
        const scope = listingScope(m)
        const revisionOf = (ref: string) => hasMessage(m, ref) ? messageRecord(m, ref).revision : -1
        try Stream.runForEach(mail.list(scope, revisionOf), effect (found) => {
          const accepted = Effect.as(box.send({ type: "receiveMessage", scope, listing: found.receipt }, "MailConnector"), true) catch () => false
          if (accepted) shelf.remember(id, { content: found.content })
        })
        try shelf.stamp("mail", id)
        return read(m.generation)
      };
      when "OpenMessage": effect {
        const opened = try mail.read(m.requestedRef, m.generation)
        shelf.remember(id, { content: opened.content, assets: opened.receipt.succeeded ? opened.receipt.assets : undefined }, { kind: "opened", receipt: opened.receipt })
        const missing = opened.receipt.assets.filter((file) => file.kind === "Photo" && shelf.file(id, file) === undefined)
        try Effect.forEach(missing, effect (file) => {
          const got = mail.attachment(file, opened.content.version) catch () => undefined
          if (got !== undefined) shelf.hold(id, file, got)
        }, { concurrency: "unbounded", discard: true })
        return opened.receipt
      };
      when "OpenAttachment": effect {
        const file = m.assets.find((a) => a.sourceRef === m.requestedRef)
        if (file === undefined) return unread(m.generation)
        if (shelf.file(id, file) === undefined) shelf.hold(id, file, try mail.attachment(file, shelf.content(id, m.messageRef)?.version ?? ""))
        return read(m.generation)
      };
    }
    const receipt: ReadReceipt | undefined = answered catch (e) => match (e) {
      when NeedsSignIn: undefined;
      default: unread(m.generation);
    }
    return receipt
  }

  effect function answer(id: number, mail: MailConnection, box: MailMachine.Shape, m: Mailbox) {
    const receipt = retainedOnly(m) ? try fromTablet(id, box, m) : try fromProvider(id, mail, box, m)
    if (receipt === undefined) return try signedOut(box, m)
    const taken = Effect.as(box.send({ type: "readResult", readReceipt: receipt }, "MailConnector"), true) catch () => false
    if (!taken && receipt.succeeded) box.send({ type: "readResult", readReceipt: unread(receipt.generation) }, "MailConnector") catch () => undefined
    try shelf.keep(id, new Set((try box.get()).messages.map((r) => r.identity.ref)))
  }

  effect function settle(id: number, mail: MailConnection, box: MailMachine.Shape, m: Mailbox, sent: Ref.Ref<ReadonlySet<string>>) {
    if (m.connection !== "Connected") return
    const release = (key: string) => Ref.update(sent, (all) => {
      const next = new Set(all)
      next.delete(key)
      return next
    })
    for (const record of m.messages) {
      const key = `${record.identity.ref}@${record.revision}`
      if (record.status !== "ChangePending" || record.pending === "NoMessageChange" || (try Ref.get(sent)).has(key)) continue
      try Ref.update(sent, (all) => new Set(all).add(key))
      const op = { identity: record.identity, change: record.pending, revision: record.revision, version: shelf.content(id, record.identity.ref)?.version ?? "" }
      let completed = false
      const expired = try ensuring(effect {
        const receipt: ChangeReceipt | undefined = mail.change(op) catch (e) => match (e) {
          when NeedsSignIn: undefined;
        }
        if (receipt === undefined) {
          box.send({ type: "endConnection", resultStatus: "Expired" }, "MailConnector") catch () => undefined
          return true
        }
        box.send({ type: "completeMessageChange", messageReceipt: receipt }, "MailConnector") catch () => undefined
        completed = true
        return false
      }, effect {
        if (!completed) try release(key)
      })
      if (expired) return
    }
  }

  effect function watch(account: Account, box: MailMachine.Shape) {
    const mail = connector.mail({ provider: account.provider, address: account.address })
    const sent = try Ref.make<ReadonlySet<string>>(new Set())
    const reads = box.changes.pipe(
      Stream.filter((m: Mailbox) => m.readStatus === "Reading"),
      Stream.changesWith((a: Mailbox, b: Mailbox) => a.generation === b.generation),
      Stream.switchMap((m: Mailbox) => Stream.fromEffect(answer(account.id, mail, box, m)))
    )
    const counts = Stream.zipWithPrevious(box.changes).pipe(
      Stream.filter(([previous, m]) => {
        const before = Option.getOrUndefined(previous)
        return m.connection === "Connected" && m.canRead && (
          (m.readKind === "Search" && m.readStatus === "Reading" && before?.generation !== m.generation) ||
          (before?.draftStorage === "DraftSaving" && m.draftStorage === "DraftSaved") ||
          (before?.draftStorage === "DraftDeleting" && m.draftStorage === "DraftUnstored")
        )
      }),
      Stream.switchMap(([, { generation }]) => Stream.fromEffect(effect {
        const total = mail.draftCount() catch () => undefined
        if (total !== undefined) box.send({ type: "countDrafts", generation, total }, "MailConnector") catch () => undefined
      }))
    )
    try.all [Stream.runDrain(reads), Stream.runDrain(counts), Stream.runForEach(box.changes, effect (m) => { try settle(account.id, mail, box, m, sent) })]
  }

  effect function follow(a: Registry) {
    for (const account of a.accounts) {
      const box = shelf.mail(account.id) catch () => undefined
      if (box === undefined) continue
      shelf.attach(account.id, Effect.asVoid(watch(account, box))) catch () => undefined
      if (account.use.mail && (try box.get()).connection === "Disconnected") try begin(account, box)
    }
  }

  try fork.scoped Stream.runForEach(registry.changes, follow)
})
