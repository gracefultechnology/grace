// spec/app/conversation.md, "Story: Talk or type without losing the conversation"; spec/app/mailboxes.md, "Grace is told what Margaret did with her email, and being told authorizes nothing"; spec/app/calendars.md, "Grace is told what changed in a calendar, and being told authorizes nothing"; spec/app/accounts.md, "Grace is told what happened to the accounts, never what was typed"; spec/app/request.md, "Only a current request from the person's own turn may ask for an action on any surface"; spec/app/conversation.md, "Responses have a written equivalent and only current callbacks change the turn"; spec/app/conversation.md, "A current speech or response failure leaves a usable typed fallback"; spec/app/conversation.md, "Detected private content is removed before the conversation continues"
import character from "../agent/character.json" with { type: "json" }
import { Machine as Accounts, type Accounts as Registry } from "../gen/app__accounts.effect.vibe"
import type { Interaction } from "../gen/app__interaction.effect.vibe"
import { showsMail, told as mailTold } from "../gen/app__mailboxes.effect.vibe"
import type { Origin } from "../gen/app__request.effect.vibe"
import { Machine as Workspaces } from "../gen/app__workspace.effect.vibe"
import { Agent, type Applied } from "./agent.vibe"
import { CalendarNews } from "./calendar.vibe"
import { type Help, helpWith, looker, render, toldOfAccounts, toldOfCalendar, toldOfMail, vocabulary } from "./context.vibe"
import { Instances } from "./instances.vibe"
import { withhold } from "./private.ts"
import { Reply } from "./reply.schema.ts"

export type CloudLink = { readonly url: string; readonly key: string }
export type PersonTurn = Extract<Interaction, { tag: "SendDraft" | "ChooseAnswer" }>

export service Conversation {
  say(input: PersonTurn): boolean!!
  help(need: Help): void!!
}

const origins: Record<PersonTurn["tag"], Origin> = { SendDraft: "Typed", ChooseAnswer: "Tapped" }
const apology = "Sorry, I didn’t catch that. Could you say it again?"
const remembered = 12

schema Delta { content?: string }
schema Choice { delta: Delta }
schema Chunk { choices: Choice[] }

error Unanswered { status: number }

const client = Layer.mergeAll(FetchHttpClient.layer, Layer.succeed(HttpClient.TracerPropagationEnabled, false))
effect function ask(link: CloudLink, messages: readonly { role: string; content: string }[]) {
  const request = HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`${link.url}/api/v1/chat/completions`), { messages, stream: true })
  const response = try HttpClient.execute(HttpClientRequest.bearerToken(request, link.key))
  if (response.status !== 200) throw new Unanswered({ status: response.status })
  const lines = Stream.filter(Stream.splitLines(Stream.decodeText(response.stream)), (line) => line.startsWith("data: ") && line !== "data: [DONE]")
  const chunks = Stream.mapEffect(lines, (line) => Schema.decodeUnknownEffect(Schema.fromJsonString(Chunk))(line.slice("data: ".length)))
  return try Stream.runFold(chunks, () => "", (said, chunk) => said + chunk.choices.map((c) => c.delta.content ?? "").join(""))
}

export const conversation = (link: CloudLink | undefined) => Layer.effect(Conversation, effect {
  const workspace = try Workspaces
  const agent = try Agent
  const asked = try Ref.make<{ readonly generation: number; readonly origin: Origin }>({ generation: -1, origin: "FromDevice" })
  const notDone = try Ref.make<readonly Applied[]>([])
  const told = try Ref.make<readonly string[]>([])
  const look = try looker()
  const registry = try Accounts
  const shelf = try Instances
  const news = try CalendarNews
  const scope = try Scope.Scope

  effect function tell(words: string) {
    if (words !== "") try Ref.update(told, (all) => [...all, words])
  }

  effect function following<S>(changes: Stream.Stream<S>, words: (before: S, after: S) => string!!) {
    const last = try Ref.make<S | undefined>(undefined)
    try fork.in(scope) Stream.runForEach(changes, effect (after) => {
      const before = try Ref.getAndSet(last, after)
      if (before !== undefined) try tell(try words(before, after))
    })
  }

  const watched = new Set<number>()
  try fork.in(scope) Stream.runForEach(registry.changes, effect (now: Registry) => {
    for (const { id } of now.accounts) {
      const box = watched.has(id) ? undefined : shelf.mail(id) catch () => undefined
      if (box === undefined) continue
      watched.add(id)
      try following(box.changes, effect (was, after) => {
        const s = try look()
        return showsMail(s.registry, id) ? toldOfMail(s, mailTold(id, was, after)) : ""
      })
    }
  })
  try following(registry.changes, effect (before: Registry, after: Registry) => toldOfAccounts(before, after))
  try fork.scoped Stream.runForEach(news.reports, effect (report) => tell(toldOfCalendar(try look(), report)))

  effect function fail(token: number) {
    workspace.send({ type: "interact", input: { tag: "ServiceFailure", token, text: apology } }, "Host") catch () => undefined
  }

  effect function decoded(said: string | undefined) {
    return said === undefined ? undefined : Schema.decodeUnknownEffect(Reply)(said) catch () => undefined
  }

  effect function answer(link: CloudLink, token: number) {
    const scene = try look()
    const w = scene.workspace
    const { messages } = w.assistant.conversation
    const latest = messages.length - 1
    const outgoing = try Effect.orDie(Effect.try(() => messages.slice(-remembered).map(({ author, text }) => ({ role: author === "HumanMessage" ? "user" : "assistant", content: withhold({ text, passwords: [] }) }))))
    if (outgoing.at(-1)?.content !== messages[latest]?.text) {
      workspace.send({ type: "purgePrivate", token, messageIndex: latest, purgeDraft: false }, "Host") catch () => undefined
      return
    }
    const news = try Ref.get(told)
    const system = { role: "system", content: `${character.system}\n\n${vocabulary}\n\n${render(scene, try Clock.currentTimeMillis, try Ref.get(notDone), news).text}` }
    const said = ask(link, [system, ...outgoing]) catch () => undefined
    const reply = try decoded(said)
    if (reply === undefined) return try fail(token)
    try Ref.update(told, (all) => all.slice(news.length))
    try Effect.uninterruptible(respond(token, w.assistant.workVersion, reply))
  }

  effect function respond(token: number, workVersion: number, { text, isQuestion, answers, actions }: typeof Reply.Type) {
    const responded = workspace.send({ type: "interact", input: { tag: "Respond", token, text, isQuestion, answers: [...answers], audible: false } }, "Host") catch () => undefined
    if (responded === undefined) return
    const last = try Ref.get(asked)
    const applied = try agent.apply(actions, { generation: token, workVersion, origin: last.generation === token ? last.origin : "FromDevice" })
    try Ref.set(notDone, applied.filter((a) => a.outcome !== "Applied"))
  }

  effect function take(input: PersonTurn, origin: Origin) {
    const taken = workspace.send({ type: "interact", input }, "Person") catch () => undefined
    if (taken === undefined) return false
    try Ref.set(asked, { generation: taken.state.assistant.conversation.generation, origin })
    return true
  }

  if (link !== undefined) {
    const { device } = try workspace.get()
    const availability = { connection: device.connectivity, reasoning: true, microphone: device.microphoneAllowed, observation: device.observationAllowed }
    workspace.send({ type: "setAvailability", availability }, "Host") catch () => undefined
    const thinking = Stream.changes(Stream.map(workspace.changes, ({ assistant: { conversation: c } }) => c.turn === "Thinking" ? c.generation : -1))
    try fork.scoped Stream.runDrain(Stream.switchMap(thinking, (token) => token < 0 ? Stream.empty : Stream.fromEffect(answer(link, token))))
  }

  return {
    say: (input) => take(input, origins[input.tag]),
    help: effect (need) => { try tell(helpWith(need, try registry.get())) }
  }
}).pipe(Layer.provide(client))
