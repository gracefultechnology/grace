export type CloudLink = { readonly url: string; readonly key: string }
export type GuidedCheck = "Confirmed" | "NotFound" | "CollectionNeedsReview" | "Several" | "Past" | "Changed" | "Covered" | "Used" | "PrivateForm" | "Refused"
export type PersonTurn = Extract<Interaction, { tag: "SendDraft" | "ChooseAnswer" }>

type TurnSource = { readonly origin: Exclude<Origin, "AskedForHelp"> } | { readonly origin: "AskedForHelp"; readonly context: string }

export service Conversation {
  say(input: PersonTurn): boolean!!
  turnSource(generation: number): TurnSource!!
  checkGuidedRead(): GuidedCheck!!
  help(need: Help): void!!
  startReadReview(revision: number): boolean!!
  resumeReadPlan(): boolean!!
}

const origins: Record<PersonTurn["tag"], "Typed" | "Tapped"> = { SendDraft: "Typed", ChooseAnswer: "Tapped" }
const apology = "Sorry, I didn’t catch that. Could you say it again?"
const noControls = "This conversation shows no controls under your reply. Never offer {kind:\"privateSignIn\"}. If the person asks to sign in, direct them to the website’s own sign-in form."
const hostStarted = "(The person has not spoken: the tablet started this turn. Answer what it just told you happened.)"
export const helpAsked = "(The person tapped Ask Grace: what they want help with is what the tablet just told you.)"
const askedForHelp = { tag: "HostTurn", turnOrigin: "AskedForHelp" } as const

schema Delta { content?: string }
schema Choice { delta: Delta }
schema Chunk { choices: Choice[] }

error Unanswered { status: number }

const client = Layer.mergeAll(FetchHttpClient.layer, Layer.succeed(HttpClient.TracerPropagationEnabled, false))
function screened(text: string, answers: readonly string[], actions: readonly GraceAction[]) {
  const safe = (words: string) => withhold({ text: words, passwords: [] })
  return {
    text: safe(text),
    answers: answers.every((answer) => safe(answer) === answer) ? [...answers] : [],
    actions: actions.map((action): GraceAction => action.kind === "guide" ? { ...action, title: safe(action.title) } : action)
  }
}

effect function ask(link: CloudLink, messages: readonly { role: string; content: string }[]) {
  const request = HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`${link.url}/api/v1/chat/completions`), { model: policy.model, messages, stream: true, response_format: { type: "json_object" } })
  const response = try HttpClient.execute(HttpClientRequest.bearerToken(request, link.key))
  if (response.status !== 200) throw new Unanswered({ status: response.status })
  const lines = Stream.filter(Stream.splitLines(Stream.decodeText(response.stream)), (line) => line.startsWith("data: ") && line !== "data: [DONE]")
  const chunks = Stream.mapEffect(lines, (line) => Schema.decodeUnknownEffect(Schema.fromJsonString(Chunk))(line.slice("data: ".length)))
  return try Stream.runFold(chunks, () => "", (said, chunk) => said + chunk.choices.map((c) => c.delta.content ?? "").join(""))
}

type GuidedReadSource =
  | { tag: "ManagedMail" | "ManagedAppointment"; grant: string; version: string }
  | ({ tag: "CurrentMessage" } & GuidedMail)
  | { tag: "CurrentDocument"; tab: number; loadVersion: number; documentId: string }
  | { tag: "PublicCollectionDocument"; tabId: number; loadVersion: number; documentId: string; domRevision: number; url: string; origin: string; subject: string; entries: number }
  | { tag: "PublicSortDocument"; tabId: number; loadVersion: number; documentId: string; domRevision: number; url: string; origin: string; category: string; direction: "PriceAscending" | "PriceDescending" }
  | { tag: "NamedDocument"; tab: number; loadVersion: number; documentId: string; url: string; heading: string }
  | { tag: "SearchDocument"; loadVersion: number; documentId: string; url: string; origin: string; query: string; heading: string }
  | { tag: "CurrentStatement"; tab: number; loadVersion: number; document: string }
  | { tag: "CurrentAppointment"; key: number; owner: string; calendarId: string; occurrence: string; generation: number; revision: number }
type GuidedReadReceipt = { source: GuidedReadSource; identity: readonly string[]; text: string }
type GuidedMiss = Exclude<GuidedCheck, "Confirmed">

function normalizedHeading(value: string | null | undefined): string {
  return value && value.length <= 200 ? value.normalize("NFC").trim().replace(/\s+/gu, " ") : ""
}

function collectionHeading(subject: string, heading: string): boolean {
  const requested = comparableName(subject).replace(/\s+(?:index|topics|list)$/u, "")
  const actual = comparableName(heading).replace(/ & /gu, " and ")
  if (actual === requested) return true
  const help = /^(?:help|help center|frequently asked questions|faqs?|support)$/u
  return help.test(requested) && /^(?:[\p{L}\p{N}-]+ ){0,2}(?:help|help center|help and support|support(?: center)?|faqs?|frequently asked questions)$/u.test(actual)
}

effect function visibleCollectionEntries(native: NativePage.Shape, id: PageId, url: URL, snapshot: LinkObservation, subject: string): number!! {
  const main = ':is(main,[role="main"]):not(:is(main,[role="main"]) *)'
  const top = ':is(h1,[role="heading"][aria-level="1"])'
  const topic = ':is(h2,[role="heading"][aria-level="2"])'
  const excluded = ':not(:is(nav,header,footer,aside,article,form,[role="navigation"],[role="complementary"],[role="article"],[aria-hidden="true"],[inert]) *)'
  const region = ':is(section,div):not([role],[aria-label],[aria-labelledby])'
  const directHeading = `${main} > ${top}${excluded}`
  const wrappedHeading = `${main} > ${region}:first-child > ${top}:first-child${excluded}`
  const headingSelector = `:is(${directHeading}, ${wrappedHeading})`
  const heading = native.readRecordText(id, headingSelector) catch () => undefined
  if (!heading || heading.url !== url.href || !collectionHeading(subject, normalizedHeading(heading.text))) return 0
  const competing = native.readRecordText(id, `:is(${directHeading} ~ ${top}, ${wrappedHeading} ~ ${top}, ${main}:has(> ${top}) > ${region}:first-child > ${top})${excluded}`) catch () => undefined
  if (competing?.url === url.href) return 0
  const candidates: { address: string; selector: string; label: string }[] = []
  for (const item of snapshot.result.elements) {
    if (item.tag !== "a" || !item.inViewport || item.disabled || item.sensitive || item.form !== null || item.frame !== undefined || item.inShadowRoot ||
        !item.label || !item.href || !item.targetSelector) continue
    const destination = URL.parse(item.href)
    if (!destination || destination.origin !== url.origin || destination.username || destination.password ||
        destination.search || destination.hash || destination.pathname === url.pathname) continue
    candidates.push({ address: destination.href, selector: item.targetSelector, label: comparableName(item.label) })
    if (candidates.length >= 32) break
  }
  if (new Set(candidates.map(({ address }) => address)).size < 2) return 0
  const list = ':is(ul,ol,[role="list"])'
  const titleBlock = `${main} > ${region}:first-child:has(> ${top}:only-child)${excluded}`
  const anchor = `:is(${headingSelector}, ${titleBlock})`
  const search = 'form[role="search"][method="get" i]'
  const spine = `:is(${anchor}, ${anchor} + ${search})`
  const withIntro = `:is(${anchor} + p, ${anchor} + p + ${search})`
  const afterSearch = `:is(${topic}:first-child, ${search}:first-child + ${topic})`
  const afterIntro = `:is(p:first-child + ${topic}, p:first-child + ${search} + ${topic})`
  const plainTopic = `:is(${spine} + ${topic}, ${spine} + ${region} > ${afterSearch}):has(+ ${list})${excluded}`
  const introTopic = `:is(${withIntro} + ${region} > ${afterSearch}, ${spine} + ${region} > ${afterIntro}):has(+ ${list})${excluded}`
  const indexStart = `:is(${spine}, ${withIntro})`
  const direct = `:is(${spine} + ${list}, ${indexStart} + ${region} > ${list}:only-child)`
  const observedTopic = native.readRecordText(id, plainTopic) catch () => undefined
  const observedIntroTopic = native.readRecordText(id, introTopic) catch () => undefined
  const topicText = observedTopic?.url === url.href ? normalizedHeading(observedTopic.text) : ""
  const introText = observedIntroTopic?.url === url.href ? normalizedHeading(observedIntroTopic.text) : ""
  if (topicText && introText) return 0
  if (topicText && !collectionHeading(subject, topicText)) return 0
  if (introText && (!/^(?:all|browse)\s+/iu.test(introText) ||
      !collectionHeading(subject, introText.replace(/^(?:all|browse)\s+/iu, "")))) return 0
  const selected = topicText ? plainTopic : introText ? introTopic : undefined
  let collection = selected === undefined ? `${direct}${excluded}` : `${selected} + ${list}${excluded}`
  if (selected === undefined) {
    const group = `section:not([role],[aria-label],[aria-labelledby]):has(> ${topic}:first-child + ${list}:last-child)`
    const groups = `${indexStart} + ${region}:has(> ${group}:first-child + ${group})`
    const firstTopic = native.readRecordText(id, `${groups} > ${group}:first-child > ${topic}${excluded}`) catch () => undefined
    const nextTopic = native.readRecordText(id, `${groups} > ${group}:first-child + ${group} > ${topic}${excluded}`) catch () => undefined
    const labels = [firstTopic, nextTopic].map((read) => read?.url === url.href ? comparableName(normalizedHeading(read.text)) : "")
    if (labels[0] !== labels[1] && labels.every((label) => label && !/^(?:related|recommended|more like|you may also)\b/u.test(label))) {
      collection = `${groups} > ${group} > ${list}${excluded}`
    }
  }
  const listed = (shown: typeof candidates) => {
    const links = `:is(${shown.map(({ selector }) => selector).join(",")})${excluded}`
    return `${collection} > :is(li,[role="listitem"]) ${links}`
  }
  const first = native.readRecordText(id, listed(candidates)) catch () => undefined
  if (first?.url !== url.href) return 0
  const firstLabel = comparableName(first.text)
  const named = candidates.filter(({ label }) => label === firstLabel)
  if (named.length === 0) return 0
  const exact = native.readRecordText(id, listed(named)) catch () => undefined
  if (exact?.url !== url.href || comparableName(exact.text) !== firstLabel) return 0
  const represented = new Set(named.map(({ address }) => address))
  const others = candidates.filter(({ address }) => !represented.has(address))
  if (others.length === 0) return 0
  const second = native.readRecordText(id, listed(others)) catch () => undefined
  return second?.url === url.href && comparableName(second.text) !== firstLabel ? 2 : 0
}

function sortCategory(value: string): string {
  return comparableName(value).replace(/ & /gu, " and ")
}

function priceToolbar(snapshot: LinkObservation) {
  const controls = snapshot.result.elements.filter((control) => control.inViewport && control.disabled === false &&
    control.sensitive === null && control.form === null && control.frame === undefined && !control.inShadowRoot && control.targetSelector)
  const sortBy = controls.filter((control) => control.tag === "select" && comparableName(control.label ?? "") === "sort by")
  const sorter = sortBy[0]
  if (sortBy.length !== 1 || !sorter?.targetSelector) return undefined
  const selected = sorter.options?.filter((option) => option.selected)
  if (selected?.length !== 1 || selected[0]?.disabled || comparableName(selected[0]?.label ?? "") !== "price") return undefined
  const observed = controls.flatMap((control) => {
    if (control.tag !== "button" && control.tag !== "a" && control.role !== "button") return []
    const matches = [control.label, control.title].flatMap((text) => {
      const label = comparableName(text ?? "")
      if (label === "set descending direction" || label === "switch to descending") return ["PriceAscending" as const]
      if (label === "set ascending direction" || label === "switch to ascending") return ["PriceDescending" as const]
      return []
    })
    return matches.length === 0 ? [] : [{ directions: new Set(matches), selector: control.targetSelector }]
  })
  if (observed.length !== 1 || !observed[0]?.selector || observed[0].directions.size !== 1) return undefined
  const [direction] = observed[0].directions
  if (!direction) return undefined
  const excluded = ':not(:is(header,footer,aside,nav,article,form,[role="navigation"],[aria-hidden="true"],[inert]) *)'
  const group = ':is(div,fieldset,[role="group"])'
  const selector = `:is(main,[role="main"]) ${group}${excluded}:has(> :is(${sorter.targetSelector})):has(> :is(${observed[0].selector}))`
  return { selector, direction }
}

function routeOf(url: URL): string {
  return /^#!?\//u.test(url.hash) ? url.hash : ""
}

function itemAddress(address: string): string | undefined {
  if (!URL.canParse(address)) return undefined
  const url = new URL(address)
  return url.origin + url.pathname + url.search + routeOf(url)
}

function pageMiss(observation: LinkObservation | undefined, url: string, use?: GuidedEvidenceUse): GuidedMiss | undefined {
  const state = guidedPageState(observation, url, use)
  if (state === "Ordinary" || state === "PublicOnly") return undefined
  if (state === "PrivateForm") return state
  return observation?.result.blockers.some((item) => item.covers !== "partial") ? "Covered" : "Changed"
}

function browserReadScope(w: Scene["workspace"]): string {
  const { assistant, browser, plan } = w
  const tab = activeTab(browser)
  return JSON.stringify([plan.owner, assistant.taskId, assistant.workVersion, plan.receipts.length,
    nextOutcome(plan), plan.linkStep, plan.linkUrl, tab.id, tab.loadVersion, tabUrl(tab)])
}

effect function guidedReceipt(scene: Scene, step: GuidedStep, native: NativePage.Shape, managed: ManagedReads.Shape, expectedDocument?: string): (GuidedReadReceipt | GuidedMiss | undefined)!! {
  const { registry, workspace } = scene
  if (privateSurfaceActive(workspace)) return undefined
  function receipt(source: GuidedReadSource, identity: readonly string[], text: string): GuidedReadReceipt { return { source, identity, text } }
  const read = step.tag
  if (read === "ReadMail" || read === "ReadCalendar" || read === "SaveMailAppointment") {
    const selected = try managed.guidedSelection()
    if (selected.kind !== "legacy") {
      if ((selected.kind !== "mail" && selected.kind !== "calendar") || workspace.plan.steps.some((step) => step.tag === "SaveMailAppointment")) return undefined
      const identity = [selected.accountId, selected.googleEmail, selected.id]
      const { grant, version } = selected
      if (read === "ReadMail" && selected.kind === "mail")
        return receipt({ tag: "ManagedMail", grant, version }, identity,
          selected.subjectForGrace === "" ? "The open message has no subject." : "Open message: " + selected.subjectForGrace)
      if (read === "ReadCalendar" && selected.kind === "calendar") {
        const time = try Effect.option(Effect.try(() => new Date(selected.startAt).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" })))
        if (Option.isSome(time)) return receipt({ tag: "ManagedAppointment", grant, version }, identity, selected.title + " · " + time.value)
      }
      return undefined
    }
  }
  switch (read) {
    case "ReadMail": {
      const account = openSource(registry, scene.mail)
      const connection = registry.accounts.find((source) => source.id === account && source.use.mail)
      const box = scene.mail.find((source) => source.account === account)?.mailbox
      if (connection === undefined || box === undefined || box.connection !== "Connected" || box.readStatus !== "ReadIdle" ||
          box.view !== "Message" || !box.canRead || box.account !== connection.address || box.provider !== connection.provider) return undefined
      const { identity, revision, loaded } = messageRecord(box, box.messageRef)
      const content = scene.content(account, box.messageRef)
      if (!loaded || identity.owner !== box.owner || identity.account !== box.account || identity.provider !== box.provider ||
          identity.ref !== box.messageRef || content === undefined || confidentialMail(content)) return undefined
      return receipt({ tag: "CurrentMessage", account, owner: identity.owner, address: identity.account,
        ref: identity.ref, generation: box.generation, revision, version: content.version },
        [identity.provider, identity.owner, identity.account, identity.ref], content.subject === "" ? "The open message has no subject." : "Open message: " + content.subject)
    }
    case "ReadStatement": {
      const tab = activeTab(workspace.browser)
      const address = itemAddress(tabUrl(tab))
      if (!mayGuideReadLink(workspace) || address === undefined) return "Refused"
      const snapshot = native.observeLinks(PageId.make(`tab-${tab.id}`)) catch () => undefined
      if (snapshot === undefined) return "Changed"
      if (guidedPageState(snapshot, tabUrl(tab)) === "PrivateForm") return "PrivateForm"
      const statement = statementRead(snapshot, tabUrl(tab))
      if (statement.tag === "Unread") return statement.reason
      return receipt({ tag: "CurrentStatement", tab: tab.id, loadVersion: tab.loadVersion, document: statement.document }, [address], statement.text)
    }
    case "ReadLatestRecord": return undefined
    case "SearchPublicSite": {
      const tab = activeTab(workspace.browser)
      if (!workspace.device.observationAllowed || workspace.device.surface !== "Browser" ||
          tab.id !== step.tabId || tab.load !== "Loaded" || !tab.secure || tab.loadVersion <= workspace.plan.openingBrowser) return undefined
      const url = tabUrl(tab)
      const address = URL.parse(url)
      if (address?.origin !== step.origin || address.username || address.password || address.hash) return undefined
      const id = PageId.make(`tab-${tab.id}`)
      const before = native.observeLinks(id) catch () => undefined
      if (!before || (expectedDocument !== undefined && before.documentId !== expectedDocument)) return "Changed"
      const miss = pageMiss(before, url, "CheckPublicSearchResult")
      if (miss !== undefined) return miss
      const heading = native.readPrimaryHeading(id, true) catch () => undefined
      if (!heading) return undefined
      if (heading.url !== url) return "Changed"
      const headingText = heading.text.trim()
      const named = /^(?:search )?results for(?:\s*:\s*|\s+)(?:"(.*)"|'(.*)'|“(.*)”|‘(.*)’|([^"'“‘].*))$/iu.exec(headingText)
      if ((named?.[1] ?? named?.[2] ?? named?.[3] ?? named?.[4] ?? named?.[5]) !== step.query) return undefined
      const after = native.observeLinks(id) catch () => undefined
      if (!after || after.documentId !== before.documentId) return "Changed"
      const afterMiss = pageMiss(after, url, "CheckPublicSearchResult")
      if (afterMiss !== undefined) return afterMiss
      return receipt({ tag: "SearchDocument", loadVersion: tab.loadVersion, documentId: after.documentId,
        url, origin: address.origin, query: step.query, heading: headingText }, [step.origin, step.query], "Search results for “" + step.query + "”.")
    }
    case "ReachPublicCollection": {
      const tab = activeTab(workspace.browser)
      const url = URL.parse(tabUrl(tab))
      if (!url || url.origin !== step.origin || url.username || url.password || url.hash || tab.id !== step.tabId || !tab.secure ||
          tab.load !== "Loaded" || tab.loadVersion <= workspace.plan.openingBrowser || !guidedLinkObserved(workspace)) return undefined
      const id = PageId.make(`tab-${tab.id}`)
      const before = native.observeLinks(id) catch () => undefined
      if (!before || before.result.domRevision === undefined ||
          (expectedDocument !== undefined && before.documentId !== expectedDocument)) return "Changed"
      const miss = pageMiss(before, url.href, "ReadGuidedContent")
      if (miss !== undefined) return miss
      const entries = try visibleCollectionEntries(native, id, url, before, step.subject)
      const followedLink = workspace.plan.linkStep === workspace.plan.receipts.length && workspace.plan.linkUrl === url.href
      const heading = entries < 2 && !followedLink
        ? (native.readPrimaryHeading(id, true) catch () => undefined)
        : undefined
      const after = native.observeLinks(id) catch () => undefined
      if (!after || after.documentId !== before.documentId || after.result.domRevision !== before.result.domRevision) return "Changed"
      const afterMiss = pageMiss(after, url.href, "ReadGuidedContent")
      if (afterMiss !== undefined) return afterMiss
      if (entries < 2) {
        return followedLink || (heading?.url === url.href && collectionHeading(step.subject, normalizedHeading(heading.text)))
          ? "CollectionNeedsReview" : undefined
      }
      return receipt({ tag: "PublicCollectionDocument", tabId: tab.id, loadVersion: tab.loadVersion, documentId: before.documentId,
        domRevision: before.result.domRevision, url: url.href, origin: step.origin, subject: step.subject, entries }, [before.documentId, url.href], "Found the collection for " + step.subject + ".")
    }
    case "SortPublicListing": {
      const tab = activeTab(workspace.browser)
      const url = URL.parse(tabUrl(tab))
      if (!url || url.origin !== step.origin || url.username || url.password || url.hash || tab.id !== step.tabId ||
          !tab.secure || tab.load !== "Loaded" || tab.loadVersion <= workspace.plan.openingBrowser) return undefined
      const id = PageId.make(`tab-${tab.id}`)
      const before = native.observeLinks(id) catch () => undefined
      if (!before || before.result.domRevision === undefined ||
          (expectedDocument !== undefined && before.documentId !== expectedDocument)) return "Changed"
      const miss = pageMiss(before, url.href, "CheckPublicSort")
      if (miss !== undefined) return miss
      const heading = native.readPrimaryHeading(id, true) catch () => undefined
      if (heading?.url !== url.href || sortCategory(normalizedHeading(heading.text)) !== sortCategory(step.subject)) return undefined
      const toolbar = priceToolbar(before)
      if (toolbar?.direction !== step.direction) return undefined
      const text = native.readRecordText(id, toolbar.selector) catch () => undefined
      if (text?.url !== url.href) return undefined
      const { direction } = toolbar
      const after = native.observeLinks(id) catch () => undefined
      if (!after || after.documentId !== before.documentId || after.result.domRevision !== before.result.domRevision) return "Changed"
      const currentToolbar = priceToolbar(after)
      if (currentToolbar?.direction !== direction || currentToolbar.selector !== toolbar.selector) return "Changed"
      const afterMiss = pageMiss(after, url.href, "CheckPublicSort")
      if (afterMiss !== undefined) return afterMiss
      const order = direction === "PriceAscending" ? "ascending" : "descending"
      return receipt({ tag: "PublicSortDocument", tabId: tab.id, loadVersion: tab.loadVersion, documentId: before.documentId,
        domRevision: before.result.domRevision, url: url.href, origin: step.origin, category: step.subject, direction },
      [before.documentId, step.subject, direction], step.subject + " sorted by " + order + " price.")
    }
    case "ReachNamedPage": {
      const tab = activeTab(workspace.browser)
      if (!workspace.device.observationAllowed || workspace.device.surface !== "Browser" ||
          tab.load !== "Loaded" || !guidedLinkObserved(workspace)) return undefined
      const url = tabUrl(tab)
      const address = itemAddress(url)
      const id = PageId.make(`tab-${tab.id}`)
      const before = native.observeLinks(id) catch () => undefined
      if (!before || address === undefined || (expectedDocument !== undefined && before.documentId !== expectedDocument)) return "Changed"
      const miss = pageMiss(before, url, "CheckPublicDocument")
      if (miss !== undefined) return miss
      if (tab.loadVersion <= workspace.plan.openingBrowser) return undefined
      const primary = native.readPrimaryHeading(id) catch () => undefined
      if (primary !== undefined && primary.url !== url) return "Changed"
      const observed = normalizedHeading(primary?.text)
      if (observed === "" || comparableName(observed) !== comparableName(step.subject)) return undefined
      const after = native.observeLinks(id) catch () => undefined
      if (!after || after.documentId !== before.documentId) return "Changed"
      const afterMiss = pageMiss(after, url, "CheckPublicDocument")
      if (afterMiss !== undefined) return afterMiss
      return receipt({ tag: "NamedDocument", tab: tab.id, loadVersion: tab.loadVersion, documentId: after.documentId, url, heading: step.subject },
        [address], "Open page: " + observed)
    }
    case "ReadBrowser":
    case "ReadChangedBrowser": {
      const tab = activeTab(workspace.browser)
      if (tab.load !== "Loaded") return undefined
      const address = itemAddress(tabUrl(tab))
      if (address === undefined) return undefined
      const url = new URL(tabUrl(tab))
      if (url.protocol !== "https:" && url.protocol !== "http:") return undefined
      const snapshot = native.observeLinks(PageId.make(`tab-${tab.id}`)) catch () => undefined
      const miss = pageMiss(snapshot, url.href, "CheckPublicDocument")
      if (miss !== undefined) return miss
      if (snapshot === undefined || (read === "ReadChangedBrowser" && tab.loadVersion <= workspace.plan.openingBrowser)) return undefined
      return receipt({ tag: "CurrentDocument", tab: tab.id, loadVersion: tab.loadVersion, documentId: snapshot.documentId },
        [snapshot.documentId, address], "Open page: " + url.origin + url.pathname + routeOf(url))
    }
    case "ReadCalendar": {
      const key = openSelected(registry, scene.calendars)
      const view = sourceAt(scene.calendars, key).view
      const account = key === tablet ? "tablet" : registry.accounts.find((source) => source.id === key && source.use.calendar)?.address
      const { committed, identity, revision, hasSaved, phase } = entryAt(view, view.selectedId)
      if (account === undefined || !view.opened || !hasSaved || phase !== "Saved" || identity.kind !== "Appointment" ||
          identity.owner !== account || view.owner !== account || identity.calendarId !== view.calendarId ||
          identity.occurrenceId !== view.selectedId) return undefined
      const time = try Effect.option(Effect.try(() => new Date(committed.startAt).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" })))
      if (Option.isNone(time)) return undefined
      return receipt({ tag: "CurrentAppointment", key, owner: identity.owner, calendarId: identity.calendarId,
        occurrence: identity.occurrenceId, generation: view.generation, revision }, [read, identity.owner, identity.calendarId, identity.occurrenceId], committed.title + " · " + time.value)
    }
    case "SaveMailAppointment": {
      const { calendarApproval, savedOccurrence, saveRecovery } = workspace.plan
      if (saveRecovery.tag === "GuidedSaveReconcile") {
        const { owner, calendar, occurrence, mailDigest } = saveRecovery
        const key = openSelected(registry, scene.calendars)
        const account = registry.accounts.find((source) => source.id === key && source.address === owner && source.use.calendar && source.use.mail)
        const view = sourceAt(scene.calendars, key).view
        const { committed, identity, revision, hasSaved, phase } = entryAt(view, view.selectedId)
        if (!account || occurrence === "" || view.selectedId !== occurrence || mailDigest !== priorGuidedMail(workspace.plan).digest ||
            !view.opened || view.owner !== owner || view.calendarId !== calendar || !hasSaved || phase !== "Saved" ||
            identity.kind !== "Appointment" || identity.owner !== owner || identity.calendarId !== calendar ||
            identity.occurrenceId !== occurrence) return undefined
        return receipt({ tag: "CurrentAppointment", key, owner, calendarId: calendar, occurrence, generation: view.generation, revision },
          [read, owner, calendar, occurrence], "Saved appointment: " + committed.title)
      }
      const account = registry.accounts.find((source) => source.id === calendarApproval.account && source.use.calendar && source.use.mail)
      if (account === undefined || account.address !== calendarApproval.owner || savedOccurrence === "") return undefined
      const view = sourceAt(scene.calendars, account.id).view
      const { committed, identity, revision, hasSaved, phase } = entryAt(view, savedOccurrence)
      if (!view.opened || !hasSaved || phase !== "Saved" || identity.kind !== "Appointment" || identity.owner !== account.address ||
          view.owner !== account.address || identity.calendarId !== calendarApproval.calendar || identity.calendarId !== view.calendarId ||
          identity.occurrenceId !== savedOccurrence || identity.sourceAccount !== calendarApproval.account || identity.sourceRef !== calendarApproval.sourceRef ||
          committed.title !== calendarApproval.title || committed.startAt !== calendarApproval.starts || committed.endAt !== calendarApproval.ends ||
          committed.timezone !== calendarApproval.timezone || committed.location !== calendarApproval.location || committed.notes !== calendarApproval.notes) return undefined
      return receipt({ tag: "CurrentAppointment", key: account.id, owner: identity.owner, calendarId: identity.calendarId,
        occurrence: identity.occurrenceId, generation: view.generation, revision }, [read, identity.owner, identity.calendarId, identity.occurrenceId], "Saved appointment: " + committed.title)
    }
    case "SurfaceOutcome": return undefined
  }
}

effect function decoded(said: string | undefined) {
  return said === undefined ? undefined : Schema.decodeUnknownEffect(Reply)(said) catch () => undefined
}

function distinctReadConfirmation(source: GuidedReadSource, report: GuidedObservation, rebind: boolean): Event | undefined {
  if (source.tag === "PublicCollectionDocument") {
    const { tabId, loadVersion, documentId, url, origin, subject, entries } = source
    return { type: "confirmGuidedCollection", check: { report, tabId, loadVersion, documentId, url, origin, subject, entries } }
  }
  if (source.tag === "PublicSortDocument") {
    const { tabId, loadVersion, documentId, url, origin, category, direction } = source
    return { type: "confirmGuidedPublicSort", sortCheck: { report, tabId, loadVersion, documentId, url, origin, category, direction } }
  }
  if (source.tag === "NamedDocument") {
    const { documentId, loadVersion, url, heading } = source
    return { type: "confirmGuidedNamedPage", pageCheck: { report, documentId, loadVersion, url, heading } }
  }
  if (source.tag === "SearchDocument") {
    const { documentId, loadVersion, url, origin, query } = source
    return { type: "confirmGuidedSearch", searchCheck: { report, documentId, loadVersion, url, origin, query } }
  }
  if (source.tag !== "CurrentMessage") return undefined
  const { account, owner, address, ref, generation, revision, version } = source
  const mailCheck = { report, mail: { account, owner, address, ref, generation, revision, version } }
  return rebind ? { type: "rebindGuidedMail", mailCheck } : { type: "confirmGuidedMail", mailCheck }
}

export const conversation = (link: CloudLink | undefined) => Layer.effect(Conversation, effect {
  const website = try WebsiteTask
  const workspace = try Workspaces
  const agent = try Agent
  const native = try NativePage
  const guide = try BrowserGuide
  const managed = try ManagedReads
  const accepting = try Semaphore.make(1)
  const asked = try Ref.make<{ generation: number; source: TurnSource } | undefined>(undefined)
  const last = try Ref.make<Last>({ notDone: [], unread: [] })
  const told = try Ref.make<readonly string[]>([])
  const look = try looker()
  const registry = try Accounts
  const shelf = try Instances
  const news = try CalendarNews
  const scope = try Scope.Scope
  const digest = try Digest.Digest
  const setup = try Setup
  const recovery = try GuidedRecovery

  effect function browserReadAccount() {
    const { graceAccount } = try setup.get()
    if (graceAccount.tag === "GraceDeviceSignedIn") {
      const lease = nativeBrowserGuideLease() catch () => undefined
      return lease !== undefined && (try setup.get()).graceAccount.tag === graceAccount.tag ? JSON.stringify([graceAccount.tag, lease]) : undefined
    }
    if (graceAccount.tag === "GraceSignedIn") {
      const scope = browserSessionScope() catch () => undefined
      const active = (try setup.get()).graceAccount
      return scope !== undefined && active.tag === "GraceSignedIn" && active.accountId === graceAccount.accountId &&
        scope.accountId === active.accountId ? JSON.stringify([active.tag, scope.session]) : undefined
    }
    return graceAccount.tag
  }

  effect function tell(words: string) {
    if (words !== "" && link !== undefined) try Ref.update(told, (all) => [...all, words])
  }

  effect function following<S>(changes: Stream.Stream<S>, words: (before: S, after: S) => string!!) {
    const last = try Ref.make<S | undefined>(undefined)
    try fork.in(scope) Stream.runForEach(changes, effect (after) => {
      const before = try Ref.getAndSet(last, after)
      if (before !== undefined) try tell(try words(before, after))
    })
  }

  const watched = new Set<number>()
  try fork.in(scope) Stream.runForEach(registry.changes, effect (now: Registry) => {
    for (const { id } of now.accounts) {
      const box = watched.has(id) ? undefined : shelf.mail(id) catch () => undefined
      if (box === undefined) continue
      watched.add(id)
      try following(box.changes, effect (was, after) => {
        const s = try look()
        return showsMail(s.registry, id) ? toldOfMail(s, mailTold(id, was, after)) : ""
      })
    }
  })
  try following(registry.changes, effect (before: Registry, after: Registry) => toldOfAccounts(before, after))
  try fork.scoped Stream.runForEach(news.reports, effect (report) => tell(toldOfCalendar(try look(), report)))

  effect function turnSource(generation: number): TurnSource!! {
    const turn = try accepting.withPermit(Ref.get(asked))
    return turn?.generation === generation ? turn.source : { origin: "FromDevice" }
  }

  effect function request(token: number, workVersion: number) {
    return { generation: token, workVersion, origin: (try turnSource(token)).origin } as const
  }

  effect function fail(token: number, workVersion: number) {
    try agent.apply([], try request(token, workVersion))
    workspace.send({ type: "interact", input: { tag: "ServiceFailure", token, text: apology } }, "Host") catch () => undefined
  }

  effect function answer(link: CloudLink, token: number) {
    const scene = try look()
    const w = scene.workspace
    if (privateSurfaceActive(w)) return
    const outgoing = try Effect.orDie(Effect.try(() => sendable(w.assistant.conversation)))
    if (outgoing === undefined) {
      workspace.send({ type: "purgePrivate", token, messageIndex: w.assistant.conversation.messages.length - 1, purgeDraft: false }, "Host") catch () => undefined
      return
    }
    const authority = guidedAuthority(try setup.get(), webView.window.location.hash)
    const news = try Ref.get(told)
    const source = try turnSource(token)
    const help = source.origin === "AskedForHelp" ? "\n" + source.context : ""
    const system = { role: "system", content: `${character.system}\n\n${noControls}\n\n${vocabulary}\n\n${render(scene, try Clock.currentTimeMillis, try Ref.get(last), news, try managed.guidedSelection()).text}${help}` }
    const { origin } = w.assistant.conversation
    const started = origin === "HerRequest" ? [] : [{ role: "user", content: origin === "AskedForHelp" ? helpAsked : hostStarted }]
    if (privateSurfaceActive(try workspace.get())) return
    const said = ask(link, [system, ...outgoing, ...started]) catch () => undefined
    const reply = try decoded(said)
    if (said === undefined || reply === undefined) return try fail(token, w.assistant.workVersion)
    const unread = try Effect.orDie(Effect.try(() => unreadable(said)))
    try Effect.uninterruptible(respond(token, w.assistant.workVersion, reply, unread, news.length, authority))
  }

  effect function respond(token: number, workVersion: number, reply: typeof Reply.Type, unread: readonly string[], seen: number, authority: GuidedAuthority) {
    const { text, answers, actions } = try Effect.orDie(Effect.try(() => screened(reply.text, reply.answers, reply.actions)))
    const { isQuestion } = reply
    const before = try workspace.get()
    if (privateSurfaceActive(before) || before.assistant.conversation.generation !== token ||
        before.assistant.conversation.turn !== "Thinking") return
    const requested = { ...try request(token, workVersion), authority }
    const offeredRead = actions.some((action) => action.kind === "proposeReadPlan")
    const unavailableSave = actions.some((action) => action.kind === "proposeReadPlan" && action.steps.includes("SaveMailAppointment")) &&
      (try managed.ownsSurfaces())
    const planned = offeredRead && !unavailableSave ? try agent.apply(actions, requested) : undefined
    const current = try workspace.get()
    const { review } = current
    const offered = planned?.some((result) => result.outcome === "Applied") &&
      current.assistant.workVersion === workVersion && review.generation === token && review.workVersion === workVersion &&
      review.request.owner === guidedOwner(guidedAuthority(try setup.get(), webView.window.location.hash), review.request.steps)
    const response = unavailableSave
      ? { text: "I can check your mail and calendar, but I can’t save an appointment from that plan.", isQuestion: false, answers: [] }
      : offeredRead
      ? { text: offered ? "Review the selected-item checks before starting." : "I could not prepare that read plan.", isQuestion: false, answers: [] }
      : { text, isQuestion, answers: [...answers] }
    const responded = workspace.send({ type: "interact", input: { tag: "Respond", token, ...response, audible: false } }, "Host") catch () => undefined
    if (responded === undefined || unavailableSave) return
    try Ref.update(told, (all) => all.slice(seen))
    const applied = planned ?? (try agent.apply(actions, requested))
    try Ref.set(last, { notDone: applied.filter((a) => a.outcome !== "Applied"), unread })
  }

  function take(input: PersonTurn | typeof askedForHelp, source: TurnSource) {
    return accepting.withPermit(Effect.uninterruptible(effect {
      const taken = workspace.send({ type: "interact", input }, "Person") catch () => undefined
      if (taken === undefined) return false
      try Ref.set(asked, { generation: taken.state.assistant.conversation.generation, source })
      return true
    }))
  }

  if (link !== undefined) {
    const { device } = try workspace.get()
    const availability = { connection: device.connectivity, reasoning: true, microphone: device.microphoneAllowed, observation: device.observationAllowed }
    workspace.send({ type: "setAvailability", availability }, "Host") catch () => undefined
    const thinking = Stream.changes(Stream.map(workspace.changes, ({ assistant: { conversation: c } }) => c.turn === "Thinking" ? c.generation : -1))
    try fork.scoped Stream.runDrain(Stream.switchMap(thinking, (token) => token < 0 ? Stream.empty : Stream.fromEffect(answer(link, token))))
  }

  return {
    turnSource,
    startReadReview: recovery.begin,
    resumeReadPlan: effect () => {
      const state = try workspace.get()
      if (!hasNext(state.plan) || !(try recovery.canAccess(state))) return false
      return (workspace.send({ type: "resume" }, "Person") catch () => undefined) !== undefined
    },
    checkGuidedRead: effect () => {
      if (!(try website.clear)) return "Refused"
      const scene = try look()
      const current = scene.workspace
      const pending = nextOutcome(current.plan)
      const rebind = pending.tag === "SaveMailAppointment" && current.plan.mail.ref === "" &&
        current.device.surface === "Email" && priorGuidedMail(current.plan).digest !== ""
      const step: GuidedStep = rebind ? { tag: "ReadMail" } : pending
      const surface = guidedDetails(step).surface
      if (!hasNext(current.plan) || !(try recovery.canAccess(current)) || surface !== current.device.surface || (surface === "Browser" && !current.device.observationAllowed) ||
          current.assistant.conversation.turn !== "Ready" ||
          (current.assistant.activity !== "ReadyForStep" && current.assistant.activity !== "Rechecking")) return "Refused"
      const read = step.tag
      const browserScope = surface === "Browser" ? browserReadScope(current) : undefined
      const account = browserScope === undefined ? undefined : try browserReadAccount()
      if (browserScope !== undefined && account === undefined) return "Refused"
      const context = replyControlContext(current)
      effect function currentBrowserWorkspace() {
        const w = try workspace.get()
        return (try website.clear) && replyControlsCurrent(w, context) && !privateSurfaceActive(w) &&
          w.device.surface === "Browser" && w.device.observationAllowed && activeTab(w.browser).load === "Loaded" &&
          w.assistant.activity === current.assistant.activity && w.assistant.conversation.turn === "Ready" &&
          !w.assistant.conversation.question && w.assistant.replacementId === "" &&
          w.execution.phase === "Idle" && w.commitmentTask === "" &&
          browserReadScope(w) === browserScope
      }
      effect function ownsBrowserRead() {
        return (try browserReadAccount()) === account && (try currentBrowserWorkspace())
      }
      if (browserScope !== undefined && !(try currentBrowserWorkspace())) return "Refused"
      if (read === "ReadLatestRecord") return try guide.checkLatestRecord()
      const found = try guidedReceipt(scene, step, native, managed)
      if (found === undefined) return "NotFound"
      if (found === "PrivateForm") return (try ownsBrowserRead()) ? found : "Refused"
      if (typeof found === "string") return found
      let detailsDigest = ""
      if (read === "SaveMailAppointment") {
        if (found.source.tag !== "CurrentAppointment") return "NotFound"
        const { key, occurrence } = found.source
        const view = sourceAt(scene.calendars, key).view
        detailsDigest = try news.verifySaved(key, view, occurrence, entryAt(view, occurrence).committed)
        if (detailsDigest === "" || (current.plan.saveRecovery.tag === "GuidedSaveUntouched" &&
            detailsDigest !== current.plan.calendarApproval.detailsDigest)) return "NotFound"
      }
      const keyBytes = new TextEncoder().encode(JSON.stringify([found.source.tag, ...found.identity]))
      const sourceKey = try Effect.catchDefect(digest.digestHex(Digest.sha256, keyBytes), () => Effect.succeed(""))
      if (sourceKey === "" || !(try recovery.canAccess(current))) return "Refused"
      if (!rebind && usedSource(current.plan, sourceKey)) return "Used"
      const confirmed = try look()
      if (browserScope !== undefined && !(try ownsBrowserRead())) return "Refused"
      const rechecked = try guidedReceipt(confirmed, step, native, managed,
        found.source.tag === "NamedDocument" || found.source.tag === "SearchDocument" || found.source.tag === "PublicCollectionDocument" || found.source.tag === "PublicSortDocument" ? found.source.documentId : undefined)
      if (rechecked === "PrivateForm") return (try ownsBrowserRead()) ? rechecked : "Refused"
      const sameRecord = try Effect.orDie(Effect.try(() => JSON.stringify(found) === JSON.stringify(rechecked)))
      if (!sameRecord) return typeof rechecked === "string" ? rechecked : "Changed"
      if (browserScope !== undefined && !(try ownsBrowserRead())) return "Refused"
      const evidence = try Effect.orDie(Effect.try(() => withhold({ text: found.text, passwords: [] })))
      const report = {
        owner: current.plan.owner,
        task: current.assistant.taskId,
        version: current.assistant.workVersion,
        deviceVersion: current.device.contextVersion,
        browserRevision: current.browser.revision,
        step,
        sourceKey,
        evidence
      }
      const confirmation = distinctReadConfirmation(found.source, report, rebind)
      if (confirmation !== undefined) {
        const accepted = workspace.send(confirmation, "Host") catch () => undefined
        if (accepted !== undefined) try recovery.keepProgress()
        return accepted === undefined ? "Refused" : "Confirmed"
      }
      const savedCheckpoint = current.plan.saveRecovery
      if (read === "SaveMailAppointment" && savedCheckpoint.tag === "GuidedSaveReconcile") {
        const { occurrence, owner, calendar, mailDigest } = savedCheckpoint
        if (detailsDigest !== savedCheckpoint.detailsDigest) return "NotFound"
        const accepted = workspace.send({ type: "reconcileGuidedSave", recoveryCheck: {
          report, saved: { occurrence, owner, calendar, mailDigest, detailsDigest }
        } }, "Host") catch () => undefined
        if (accepted !== undefined) try recovery.keepProgress()
        return accepted === undefined ? "Refused" : "Confirmed"
      }
      if (read === "SaveMailAppointment" && current.plan.savedEvidence === "") {
        const now = confirmed.workspace
        if (now.assistant.taskId !== report.task || now.assistant.workVersion !== report.version ||
            now.device.contextVersion !== report.deviceVersion || now.browser.revision !== report.browserRevision ||
            now.plan.savedOccurrence !== current.plan.savedOccurrence) return "Refused"
        const saved = { approval: current.plan.calendarApproval, occurrence: current.plan.savedOccurrence, evidence }
        workspace.send({ type: "observeGuidedCalendar", saved }, "Host") catch () => undefined
      }
      const accepted = workspace.send({ type: "confirmGuided", report }, "Host") catch () => undefined
      if (accepted !== undefined) try recovery.keepProgress()
      return accepted === undefined ? "Refused" : "Confirmed"
    },
    say: (input) => take(input, { origin: origins[input.tag] }),
    help: effect (need) => {
      const text = helpWith(need, try registry.get())
      const context = try Effect.orDie(Effect.try(() => withhold({ text, passwords: [] })))
      try take(askedForHelp, { origin: "AskedForHelp", context })
    }
  }
}).pipe(Layer.provide(Layer.merge(client, Digest.layerWebCrypto)))
