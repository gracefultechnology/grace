// spec/app/workspace.md, "An authenticated restart restores the reviewed plan paused at its next outcome"
import { Machine as Setup, type GraceAccount } from "../gen/app__setup.effect.vibe"
import { Machine as Accounts } from "../gen/app__accounts.effect.vibe"
import {
  Machine as Workspaces, Rejected, canAbandonTask, canStartReadReview, startReadReview, guidedCheckpoint, guidedDetails, parseEvent, privateSurfaceActive,
  validGuidedCheckpoint, type GuidedCheckpoint, type GuidedFence, type GuidedStep, type Workspace, type WorkspaceResult
} from "../gen/app__workspace.effect.vibe"
import type { GuidedRecordName, GuidedTaskRecords } from "./preferencesPlugin.ts"
import { accountPlugin } from "./accountPlugin.ts"
import { browserSessionScope } from "./graceAccount.vibe"
import { guidedAuthority, guidedOwner } from "./managedReads.vibe"
import { withhold } from "./private.ts"
import { webView } from "./surfacePlugin.ts"

const DigestHex = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/))
const NativeStatus = Schema.Union([Schema.Struct({ kind: Schema.Literal("signedIn"), voiceDisclosureScope: DigestHex }),
  Schema.Struct({ kind: Schema.Literal("signedOut"), legacySignInNeedsCleanup: Schema.optional(Schema.Literal(true)) })])
const Revision = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const RecordValue = Schema.Struct({ revision: Revision, value: Schema.optional(Schema.NullOr(Schema.String)) })
schema Written { revision: Revision }
const Envelope = Schema.fromJsonString(Schema.Struct({ version: Schema.Literal(1), scope: DigestHex, checkpoint: Schema.Unknown }))
const legacySave = Schema.is(Schema.Struct({ save: Schema.Struct({
  tag: Schema.Literal("GuidedSaveReconcile"), occurrence: Schema.String, detailsDigest: Schema.optionalKey(Schema.Never)
}) }))
const needsMailOrCalendar = (steps: readonly GuidedStep[]) => steps.some((step) => {
  const { surface } = guidedDetails(step)
  return surface === "Email" || surface === "Calendar"
})

function safeCheckpoint(checkpoint: GuidedCheckpoint) {
  if (!Number.isSafeInteger(checkpoint.workVersion + 2) || !validGuidedCheckpoint(checkpoint)) return false
  const { request, receipts, correction, save } = checkpoint
  if (save.tag === "GuidedSaveReconcile" && save.detailsDigest !== "" && !Schema.is(DigestHex)(save.detailsDigest)) return false
  const publicText = (text: string) => text.length <= 32768 && withhold({ text, passwords: [] }) === text
  if (!publicText(request.goal) || !request.steps.every((step) => publicText(guidedDetails(step).subject)) ||
      !receipts.every((receipt) => publicText(receipt.evidence))) return false
  if (correction.tag === "NoGuidedCheckpointCorrection") return true
  if (!publicText(correction.label) || !URL.canParse(correction.url)) return false
  const address = new URL(correction.url)
  return address.protocol === "https:" && !address.username && !address.password && !address.search && !address.hash
}

const webKey = (name: GuidedRecordName) => "grace/" + name
const nameFor = (scope: string): GuidedRecordName => `guided-task-${scope}`
const webRecords: GuidedTaskRecords = {
  read: async ({ name }) => {
    const value = webView.window.localStorage.getItem(webKey(name))
    return value === null ? { revision: 0 } : JSON.parse(value)
  },
  write: async ({ name, revision, value }) => {
    const write = async () => {
      const key = webKey(name)
      const stored = webView.window.localStorage.getItem(key)
      const prior = stored === null ? 0 : Schema.decodeUnknownSync(RecordValue)(JSON.parse(stored)).revision
      if (prior !== revision) throw new Error("The guided task changed")
      webView.window.localStorage.setItem(key, JSON.stringify({ revision: revision + 1, value }))
      return { revision: revision + 1 }
    }
    const locks = webView.window.navigator.locks
    if (locks === undefined) throw new Error("Browser checkpoint locking is unavailable")
    return locks.request(webKey(name), write)
  },
}

const checkpointValue = (scope: string, checkpoint: GuidedCheckpoint) => JSON.stringify({ version: 1, scope, checkpoint })

type ScopeSet = { device?: string; connected?: string; localCalendar?: string; session?: string }
type BoundTask = { task: string; owner: string; scope: string; revision: number; saved: string | null; awaiting?: string }
error CheckpointUnavailable {}
effect function checkpointOf(scope: string, value: string | null | undefined) {
  if (!value) return undefined
  const envelope = Schema.decodeUnknownEffect(Envelope)(value) catch () => undefined
  if (envelope?.scope !== scope) return undefined
  const raw = envelope.checkpoint
  const checkpoint = legacySave(raw) ? { ...raw, save: { ...raw.save, occurrence: "", detailsDigest: "" } } : raw
  const event = parseEvent({ type: "restoreGuided", recovery: { owner: "", checkpoint } })
  if (event?.type !== "restoreGuided" || !safeCheckpoint(event.recovery.checkpoint)) return undefined
  return event.recovery.checkpoint
}

function taskRecords(backend: GuidedTaskRecords | undefined) {
  effect function read(scope: string) {
    if (!backend) return { revision: 0 }
    return try Schema.decodeUnknownEffect(RecordValue)(try timeout(tryPromise(() => backend.read({ name: nameFor(scope) })), "2 seconds"))
  }

  effect function save(current: BoundTask, checkpoint: GuidedCheckpoint | null, advanceRevision = false): boolean!! {
    if (!backend) return false
    if (current.awaiting !== undefined) {
      const observed = read(current.scope) catch () => undefined
      if (observed === undefined) return false
      if (observed.revision === current.revision + 1 && observed.value === current.awaiting) {
        current.revision = observed.revision
        current.saved = current.awaiting
      } else if (observed.revision !== current.revision || (observed.value ?? "") !== (current.saved ?? "")) return false
      delete current.awaiting
    }
    if (!Number.isSafeInteger(current.revision + 1)) return false
    const value = checkpoint === null ? "" : checkpointValue(current.scope, checkpoint)
    if (!advanceRevision && value === (current.saved ?? "")) return true
    const revision = current.revision
    const receipt = effect {
      const raw = try timeout(tryPromise(() => backend.write({ name: nameFor(current.scope), revision, value })), "4 seconds")
      return try Schema.decodeUnknownEffect(Written)(raw)
    } catch () => undefined
    if (receipt?.revision !== revision + 1) {
      const observed = read(current.scope) catch () => undefined
      if (observed === undefined || observed.revision !== revision + 1 || observed.value !== value) {
        current.awaiting = value
        return false
      }
    }
    current.revision = revision + 1
    current.saved = value
    return true
  }

  effect function clear(current: BoundTask) {
    const observed = read(current.scope) catch () => undefined
    if (observed === undefined || observed.revision < current.revision) return false
    if (!observed.value && (observed.revision > current.revision || (current.awaiting === undefined && !current.saved))) return true
    if (observed.value) {
      const existing = try checkpointOf(current.scope, observed.value)
      if (existing === undefined || existing.request.owner !== current.owner) return false
      if (existing.request.task !== current.task) return observed.revision > current.revision
    }
    current.revision = observed.revision
    current.saved = observed.value ?? null
    delete current.awaiting
    return try save(current, null, true)
  }

  return { read, save, clear }
}

effect function digest(value: string) {
  const bytes = try tryPromise(() => webView.window.crypto.subtle.digest("SHA-256", new TextEncoder().encode(value)))
  return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("")
}

function scopeFor(scopes: ScopeSet | undefined, steps: readonly GuidedStep[]) {
  if (!needsMailOrCalendar(steps)) return scopes?.device
  return scopes?.connected ?? (steps.every((step) => step.tag !== "ReadMail" && step.tag !== "SaveMailAppointment") ? scopes?.localCalendar : undefined)
}

effect function nativeRecoveryIdentity(account: GraceAccount["tag"]) {
  const bridge = accountPlugin
  if (!bridge || (account !== "GraceDeviceSignedIn" && account !== "GraceDeviceSignedOut")) return undefined
  const raw = try timeout(tryPromise(() => bridge.status()), "2 seconds")
  const status = try Schema.decodeUnknownEffect(NativeStatus)(raw)
  if (status.kind === "signedIn" && account === "GraceDeviceSignedIn") return "native/" + status.voiceDisclosureScope
  if (status.kind === "signedOut" && status.legacySignInNeedsCleanup !== true && account === "GraceDeviceSignedOut") return "local/native"
  return undefined
}

function sessionChanges(native: boolean) {
  const nativeAccount = native && accountPlugin !== undefined ? accountPlugin : undefined
  return nativeAccount === undefined
    ? Stream.fromEventListener(webView.document, "visibilitychange")
    : Stream.callback<void>((queue) => acquireRelease(
        promise(() => nativeAccount.addListener("sessionChanged", () => { Queue.offerUnsafe(queue, undefined) })),
        (handle) => promise(() => handle.remove())
      ))
}

export service GuidedRecovery {
  canAccess(state: Workspace): boolean!!
  begin(revision: number): boolean!!
  flushSave(task: string, version: number): boolean!!
  abandon(fence: GuidedFence): WorkspaceResult!(Rejected | CheckpointUnavailable)
  keepProgress(): void!!
  beforeOpen(): void!!
}

export const guidedRecovery = (native: boolean, port: GuidedTaskRecords | undefined) => Layer.effect(GuidedRecovery, effect {
  const workspace = try Workspaces
  const setup = try Setup
  const accounts = try Accounts
  const writer = try Semaphore.make(1)
  const backend = native ? port : port ?? webRecords
  const { read, save, clear } = taskRecords(backend)
  let binding: BoundTask | undefined
  let latest: ScopeSet | undefined
  let hosted: { accountId: string; owner: string; session: string } | undefined
  const checked = new Set<string>()

  effect function actualScopes(fresh: boolean) {
    const state = try setup.get()
    const account = state.graceAccount
    const owners = guidedAuthority(state, webView.window.location.hash)
    let identity: string | undefined
    let session: string | undefined
    if (native) {
      identity = try nativeRecoveryIdentity(account.tag)
      if (identity === undefined) return undefined
    } else if (account.tag === "GraceSignedIn") {
      const scope = fresh || hosted?.accountId !== account.accountId ? try browserSessionScope() : hosted
      if (scope === undefined || scope.accountId !== account.accountId) return undefined
      hosted = scope
      identity = "web/" + scope.owner
      session = scope.session
    } else {
      hosted = undefined
      if (account.tag === "GraceSignedOut") {
        if (fresh && (try browserSessionScope()) !== undefined) return undefined
        identity = "local/web"
      } else if (account.tag !== "AccountUnavailable") return undefined
    }

    const localSources = (try accounts.get()).accounts.filter((source) =>
      source.id !== 0 && (source.use.mail || source.use.calendar) && source.address.trim() !== ""
    ).map((source) => JSON.stringify([source.id, source.provider, source.address.trim().toLowerCase()])).sort()
    const local = (owners.connected === "tablet" && localSources.length > 0) ? localSources : undefined
    const connected = owners.connected === undefined ? undefined : owners.connected === "tablet" ? local : owners.connected
    if (identity === undefined && (local === undefined || owners.connected !== "tablet")) return undefined
    const device = identity === undefined ? undefined : try digest(JSON.stringify([identity, "browser"]))
    const source = connected === undefined ? undefined : try digest(JSON.stringify([identity ?? "local/web", connected]))
    const localCalendar = identity !== undefined && owners.connected === "tablet" && local === undefined
      ? try digest(JSON.stringify([identity, "tablet-calendar"])) : undefined
    const current = try setup.get()
    if (JSON.stringify([current.graceAccount, current.googleLink]) !== JSON.stringify([account, state.googleLink])) return undefined
    return { device, connected: source, localCalendar, session }
  }

  effect function owns(owner: string, steps: readonly GuidedStep[]) {
    return owner !== "" && owner === guidedOwner(guidedAuthority(try setup.get(), webView.window.location.hash), steps)
  }

  effect function restore(scope: string, scopes: ScopeSet) {
    if (checked.has(scope) || !backend) return
    const saved = read(scope) catch () => undefined
    if (saved === undefined) return
    const value = saved.value ?? ""
    const checkpoint = try checkpointOf(scope, value)
    if (checkpoint === undefined) { checked.add(scope); return }
    const request = checkpoint.request
    if (scopeFor(scopes, request.steps) !== scope || !(try owns(request.owner, request.steps))) return
    const currentScopes = actualScopes(true) catch () => undefined
    if (currentScopes === undefined || scopeFor(currentScopes, request.steps) !== scope ||
        (scopes.session !== undefined && currentScopes.session !== scopes.session)) return
    const state = try workspace.get()
    if (state.assistant.taskId !== "" || privateSurfaceActive(state) || !(try owns(request.owner, request.steps))) return
    const sent = workspace.send({ type: "restoreGuided", recovery: { owner: request.owner, checkpoint } }, "Store") catch () => undefined
    if (sent !== undefined) {
      checked.add(scope)
      binding = { task: request.task, owner: request.owner, scope, revision: saved.revision, saved: value }
    }
  }

  effect function syncTask(fresh = false) {
    const needsFresh = fresh && (native || binding !== undefined || (try setup.get()).graceAccount.tag === "GraceSignedIn")
    const scopes = actualScopes(needsFresh) catch () => undefined
    const state = try workspace.get()
    if (scopes === undefined) return
    const before = latest
    latest = scopes
    const current = binding
    if (current !== undefined) {
      const { assistant, plan } = state
      const sameTask = current.task === assistant.taskId && current.owner === plan.owner && plan.steps.length > 0
      const stillOwns = sameTask && scopeFor(scopes, plan.steps) === current.scope && (try owns(plan.owner, plan.steps))
      if (stillOwns) {
        const checkpoint = guidedCheckpoint(state)
        if (safeCheckpoint(checkpoint)) try save(current, checkpoint)
        else try clear(current)
        return
      }
      if (sameTask && (plan.owner === "tablet" || scopeFor(scopes, plan.steps) !== undefined && (try owns(plan.owner, plan.steps)))) {
        const dropped = workspace.send({ type: "discardGuidedRecovery", fence: { task: current.task, version: assistant.workVersion } }, "Host") catch () => undefined
        if (dropped === undefined) return
      } else if (sameTask) return
      else if ([scopes.device, scopes.connected, scopes.localCalendar].includes(current.scope)) {
        if (!(try clear(current))) return
        checked.delete(current.scope)
      }
      binding = undefined
      if (sameTask) checked.delete(current.scope)
      return
    }
    if (state.plan.steps.length > 0 && state.assistant.taskId !== "") {
      const scope = scopeFor(scopes, state.plan.steps)
      if (scope === undefined || scopeFor(before, state.plan.steps) !== scope ||
          !(try owns(state.plan.owner, state.plan.steps))) return
      const saved = read(scope) catch () => undefined
      if (!backend || saved === undefined) return
      const confirmed = actualScopes(true) catch () => undefined
      if (scopeFor(confirmed, state.plan.steps) !== scope || confirmed?.session !== scopes.session) return
      const after = try workspace.get()
      if (after.assistant.taskId !== state.assistant.taskId || after.plan.owner !== state.plan.owner ||
          !(try owns(after.plan.owner, after.plan.steps))) return
      const existing = try checkpointOf(scope, saved?.value)
      if (existing !== undefined && (existing.request.task !== after.assistant.taskId || existing.request.owner !== after.plan.owner)) return
      checked.add(scope)
      const held = { task: after.assistant.taskId, owner: after.plan.owner, scope, revision: saved.revision, saved: saved.value ?? null }
      binding = held
      const checkpoint = guidedCheckpoint(after)
      if (safeCheckpoint(checkpoint)) try save(held, checkpoint)
      return
    }
    if (state.assistant.taskId !== "" || state.assistant.presentation !== "Closed" ||
        state.device.readiness !== "Ready" || privateSurfaceActive(state)) return
    if (scopes.device !== undefined) try restore(scopes.device, scopes)
    const connected = scopes.connected ?? scopes.localCalendar
    if (binding === undefined && connected !== undefined) try restore(connected, scopes)
  }

  const taskChanges = Stream.changes(Stream.map(workspace.changes, (state) => JSON.stringify([
    state.device.readiness, state.assistant.activity, state.assistant.presentation,
    privateSurfaceActive(state), guidedCheckpoint(state)
  ])))
  const changes = Stream.mergeAll([
    Stream.as(taskChanges, false), Stream.as(setup.changes, true),
    Stream.as(accounts.changes, false), Stream.as(sessionChanges(native), true)
  ], { concurrency: "unbounded" })
  try fork.scoped Stream.runForEach(changes, (fresh) => writer.withPermit(syncTask(fresh)))

  return {
    canAccess: effect (state) => {
      const { plan, assistant } = state
      if (privateSurfaceActive(state) || !(try owns(plan.owner, plan.steps))) return false
      const account = (try setup.get()).graceAccount.tag
      const held = binding
      if (held === undefined && account !== "GraceSignedIn") return !native || accountPlugin === undefined || account === "GraceDeviceSignedOut"
      if (held !== undefined && (held.task !== assistant.taskId || held.owner !== plan.owner)) return false
      const scopes = actualScopes(true) catch () => undefined
      const scope = scopeFor(scopes, plan.steps)
      if (scope !== undefined && held !== undefined && scope !== held.scope) try writer.withPermit(syncTask())
      const now = try workspace.get()
      return scope !== undefined && (held === undefined || binding === held && scope === held.scope) &&
        now.assistant.taskId === assistant.taskId && now.assistant.workVersion === assistant.workVersion &&
        !privateSurfaceActive(now) && (try owns(plan.owner, plan.steps))
    },
    abandon: (fence) => writer.withPermit(effect {
      const event = { type: "abandonTask" } as const
      const state = try workspace.get()
      if (state.assistant.taskId !== fence.task || state.assistant.workVersion !== fence.version || !canAbandonTask(state, "Person"))
        throw new Rejected({ event, state, by: "Person" })
      const current = binding?.task === fence.task && binding.owner === state.plan.owner ? binding : undefined
      let endedDurably = false
      if (current !== undefined) {
        const scopes = actualScopes(true) catch () => undefined
        if (scopes === undefined) throw new CheckpointUnavailable()
        if (scopeFor(scopes, state.plan.steps) === current.scope && (try owns(state.plan.owner, state.plan.steps))) {
          if (!(try clear(current))) throw new CheckpointUnavailable()
          endedDurably = true
        }
      }
      const after = try workspace.get()
      if (after.assistant.taskId !== fence.task || after.plan.owner !== state.plan.owner ||
          (!endedDurably && after.assistant.workVersion !== fence.version))
        throw new Rejected({ event, state: after, by: "Person" })
      const result = endedDurably && after.assistant.activity === "Finished" ? { state: after, out: [] }
        : endedDurably && after.assistant.presentation === "Closed"
          ? try workspace.send({ type: "discardGuidedRecovery", fence: { task: fence.task, version: after.assistant.workVersion } }, "Host")
          : try workspace.send(event, "Person")
      if (current !== undefined) {
        checked.delete(current.scope)
        binding = undefined
      }
      return result
    }),
    keepProgress: () => writer.withPermit(syncTask()),
    beforeOpen: () => writer.withPermit(syncTask(true)),
    flushSave: (task, version) => writer.withPermit(effect {
      const current = binding
      if (!backend || current === undefined || current.task !== task) return false
      const scopes = actualScopes(true) catch () => undefined
      const state = try workspace.get()
      const { assistant, plan } = state
      if (scopeFor(scopes, plan.steps) !== current.scope || assistant.taskId !== task ||
          assistant.workVersion !== version || plan.owner !== current.owner || !(try owns(plan.owner, plan.steps))) return false
      const checkpoint = guidedCheckpoint(state)
      if (checkpoint.save.tag !== "GuidedSaveReconcile" || !safeCheckpoint(checkpoint) ||
          !(try save(current, checkpoint))) return false
      const stored = read(current.scope) catch () => undefined
      if (stored === undefined || stored.revision !== current.revision || stored.value !== current.saved) return false
      const afterScopes = actualScopes(true) catch () => undefined
      const after = try workspace.get()
      return after.assistant.taskId === task && after.assistant.workVersion === version &&
        scopeFor(afterScopes, after.plan.steps) === current.scope && afterScopes?.session === scopes?.session &&
        (try owns(after.plan.owner, after.plan.steps)) &&
        JSON.stringify(guidedCheckpoint(after)) === JSON.stringify(checkpoint)
    }),
    begin: effect (reviewRevision) => {
      const state = try workspace.get()
      const request = state.review.request
      if (state.review.revision !== reviewRevision || privateSurfaceActive(state) || !(try owns(request.owner, request.steps))) return false
      const scopes = actualScopes(true) catch () => undefined
      const scope = scopeFor(scopes, request.steps)
      const account = (try setup.get()).graceAccount.tag
      if (account === "GraceDeviceSignInNeedsCleanup" || scope === undefined && (account === "GraceDeviceSignedIn" || account === "GraceSignedIn")) return false
      return try writer.withPermit(effect {
        const saved = scope === undefined ? undefined : (read(scope) catch () => undefined)
        const after = try workspace.get()
        if (after.review.revision !== reviewRevision || privateSurfaceActive(after) || !(try owns(request.owner, request.steps))) return false
        if (scope !== undefined) {
          const check = actualScopes(true) catch () => undefined
          if (scopeFor(check, request.steps) !== scope || check?.session !== scopes?.session) return false
        }
        if (!canStartReadReview(after, reviewRevision, "Person")) return false
        const existing = scope === undefined ? undefined : try checkpointOf(scope, saved?.value)
        let held: BoundTask | undefined
        if (scope !== undefined) {
          if (!backend || saved === undefined) return false
          const checkpoint = guidedCheckpoint(startReadReview(after, reviewRevision, "Person"))
          if (!safeCheckpoint(checkpoint)) return false
          const sameReview = saved.value === checkpointValue(scope, checkpoint)
          if (existing !== undefined && !sameReview &&
              (binding === undefined || binding.task !== existing.request.task || binding.owner !== existing.request.owner || binding.revision !== saved.revision)) return false
          held = { task: request.task, owner: request.owner, scope, revision: saved.revision, saved: saved.value ?? null }
          if (!(try save(held, checkpoint))) return false
          const check = actualScopes(true) catch () => undefined
          if (scopeFor(check, request.steps) !== scope || check?.session !== scopes?.session) {
            try save(held, existing ?? null)
            return false
          }
        }
        const sent = workspace.send({ type: "startReadReview", reviewRevision }, "Person") catch () => undefined
        if (sent === undefined) {
          if (held !== undefined) try save(held, existing ?? null)
          return false
        }
        if (held !== undefined) {
          checked.add(held.scope)
          binding = held
        }
        return true
      })
    }
  }
})
