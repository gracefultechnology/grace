// spec/app/files.md, "A library belongs to one owner and identifies files independently of their names"; spec/app/files.md, "Saving one attachment or all selected photos is one acknowledged local transaction"
import { browserSessionScope } from "./graceAccount.vibe"
import type { FileAttachment, FilesPort } from "./filesPlugin.ts"
import { HeldFile } from "./instances.vibe"
import { webView } from "./surfacePlugin.ts"

error BrowserFilesUnavailable
const attachmentSource = HeldFile
schema MailFile {
  id: Schema.NonEmptyString; name: Schema.NonEmptyString; kind: "photo" | "pdf"; savedAt: Schema.Int; pages: Schema.Int; source: attachmentSource; version: Schema.NonEmptyString
  from?: Schema.NonEmptyString; subject?: Schema.NonEmptyString
}
schema StoredFile { entry: MailFile; data: string }
type Access = { owner: string; session: string }
const storedFiles = Schema.decodeUnknownSync(Schema.Array(StoredFile))
const storedFile = Schema.decodeUnknownSync(StoredFile)
const sourceIdentity = (file: HeldFile) => JSON.stringify([file.origin, file.account, file.container, file.sourceRef])

function contentType(name: string) {
  const ext = name.toLowerCase().split(".").at(-1)
  return ext === "pdf" ? "application/pdf" : ext === "png" ? "image/png" : ext === "webp" ? "image/webp" : "image/jpeg"
}

effect function opened(owner: string) {
  return try acquireRelease(tryPromise(() => new Promise<IDBDatabase>((resolve, reject) => {
    const request = webView.window.indexedDB.open("grace-files/" + owner, 1)
    request.onupgradeneeded = () => { request.result.createObjectStore("files", { keyPath: "entry.id" }) }
    request.onsuccess = () => resolve(request.result)
    request.onerror = () => reject(request.error)
  })), (db) => sync(() => db.close()))
}

effect function runTransaction<A, R>(owner: string, mode: IDBTransactionMode, open: (store: IDBObjectStore) => IDBRequest<R>, update: (raw: unknown, store: IDBObjectStore) => A | undefined) {
  return try scoped(effect {
    const db = try opened(owner)
    return try tryPromise(() => new Promise<A>((resolve, reject) => {
      const tx = db.transaction("files", mode)
      const store = tx.objectStore("files")
      const request = open(store)
      let result: A
      tx.onabort = () => reject(tx.error ?? new Error("File transaction failed"))
      tx.oncomplete = () => resolve(result)
      request.onsuccess = () => {
        try {
          const value = update(request.result, store)
          if (value === undefined) tx.abort()
          else result = value
        }
        catch { tx.abort() }
      }
    }))
  })
}

effect function transact<A>(owner: string, mode: IDBTransactionMode, update: (rows: readonly StoredFile[], store: IDBObjectStore) => A | undefined) {
  return try runTransaction(owner, mode, (store) => store.getAll(), (raw, store) => update(storedFiles(raw), store))
}

effect function transactOne<A>(owner: string, mode: IDBTransactionMode, id: string, update: (row: StoredFile | undefined, store: IDBObjectStore) => A | undefined) {
  return try runTransaction(owner, mode, (store) => store.get(id), (raw, store) => update(raw === undefined ? undefined : storedFile(raw), store))
}

export function browserFiles(): FilesPort {
  const leases = new Map<string, Access>()
  type LiveScope = Effect.Success<ReturnType<typeof browserSessionScope>>
  let scopeCheck: Deferred.Deferred<LiveScope | undefined> | undefined

  effect function liveScope(): (LiveScope | undefined)!! {
    if (scopeCheck !== undefined) return try Deferred.await(scopeCheck)
    const gate = try Deferred.make<LiveScope | undefined>()
    scopeCheck = gate
    return try Effect.ensuring(
      effect {
        const result = browserSessionScope() catch () => undefined
        try Deferred.succeed(gate, result)
        return result
      },
      effect {
        if (scopeCheck === gate) scopeCheck = undefined
        try Deferred.succeed(gate, undefined)
      }
    )
  }

  effect function current(token: string) {
    const saved = leases.get(token)
    if (!saved) throw new BrowserFilesUnavailable()
    const now = try liveScope()
    if (now === undefined || saved.owner !== now.owner || saved.session !== now.session || leases.get(token) !== saved) throw new BrowserFilesUnavailable()
    return { owner: now.owner, saved }
  }

  effect function read<A>(lease: string, mode: IDBTransactionMode, update: (rows: readonly StoredFile[], store: IDBObjectStore) => A | undefined) {
    const { owner, saved } = try current(lease)
    const result = try transact(owner, mode, update)
    if (mode === "readwrite") try current(lease)
    else if (leases.get(lease) !== saved) throw new BrowserFilesUnavailable()
    return result
  }

  effect function readOne<A>(lease: string, mode: IDBTransactionMode, id: string, update: (row: StoredFile | undefined, store: IDBObjectStore) => A | undefined) {
    const { owner, saved } = try current(lease)
    const result = try transactOne(owner, mode, id, update)
    if (mode === "readwrite") try current(lease)
    else if (leases.get(lease) !== saved) throw new BrowserFilesUnavailable()
    return result
  }

  function imported(rows: readonly StoredFile[], store: IDBObjectStore, attachments: readonly FileAttachment[]) {
    if (attachments.length === 0 || attachments.length > 250) return undefined
    const known = new Map(rows.map((row) => [sourceIdentity(row.entry.source), row]))
    const entries: MailFile[] = []
    for (const { file, data, version, from, subject } of attachments) {
      const key = sourceIdentity(file)
      const prior = known.get(key)
      if (prior) {
        if (prior.entry.source.contentRef !== file.contentRef || prior.data !== data || prior.entry.kind !== (file.kind === "Pdf" ? "pdf" : "photo")) return undefined
        entries.push(prior.entry)
        continue
      }
      if (!version || !data || data.length > 6_990_508 || known.size >= 250) return undefined
      const entry: MailFile = { id: webView.window.crypto.randomUUID(), name: file.name, kind: file.kind === "Pdf" ? "pdf" : "photo",
        savedAt: Date.now(), pages: file.pages, source: file, version, ...from ? { from } : {}, ...subject ? { subject } : {} }
      const row = { entry, data }
      store.add(row)
      known.set(key, row)
      entries.push(entry)
    }
    return { entries }
  }

  return {
    open: (expected) => runPromise(effect {
      const access = try browserSessionScope()
      if (access === undefined || (expected && access.owner !== expected.owner)) throw new BrowserFilesUnavailable()
      const lease = try Effect.try(() => webView.window.crypto.randomUUID())
      leases.clear()
      leases.set(lease, access)
      return { lease }
    }),
    close: ({ lease }) => runPromise(sync(() => { leases.delete(lease) })),
    list: ({ lease }) => runPromise(read(lease, "readonly", (rows) => ({ entries: rows.map((row) => row.entry).sort((a, b) => b.savedAt - a.savedAt) }))),
    preview: ({ lease, id, page }) => runPromise(readOne(lease, "readonly", id, (row) => {
      if (!row || (row.entry.kind === "pdf" ? page < 1 || page > row.entry.pages : page !== 0)) return undefined
      return { id, page, image: "data:" + contentType(row.entry.name) + ";base64," + row.data }
    })),
    content: ({ lease, id }) => runPromise(readOne(lease, "readonly", id, (row) => {
      return row && { id, mimeType: contentType(row.entry.name), data: row.data }
    })),
    remove: ({ lease, id }) => runPromise(readOne(lease, "readwrite", id, (row, store) => {
      if (!row || row.entry.kind !== "photo") return undefined
      store.delete(id)
      return true
    }) |> Effect.asVoid(%)),
    saveAttachments: ({ lease, attachments }) => runPromise(read(lease, "readwrite", (rows, store) => imported(rows, store, attachments))),
  }
}
