// spec/app/accounts.md, "Story: Connect the email I already use"; spec/app/accounts.md, "Nothing she types to sign in enters the tablet’s state"; spec/app/accounts.md, "Other email connects through its own servers, asking for them when the tablet cannot find them"; spec/app/email.md, "Story: Read an email and its original attachment"; spec/app/email.md, "Each search or content read needs current access and the user's choice"; spec/app/email.md, "Story: Write or reply and confirm before sending"; spec/app/email.md, "An email sent while offline waits in Outbox and goes once, by itself, when the tablet is back online"; spec/app/emailItem.md, "Story: Delete a message and recover it safely"; spec/app/calendarView.md, "Story: Browse my calendar and open an exact occurrence"; spec/app/calendar.md, "Story: Add and correct an appointment or bill reminder"
import type { OtherReport, Provider, SheetReport, Use } from "../gen/app__accounts.effect.vibe"
import { approveDelete, approveSave, beginEdit, confirmDelete, create, edit, initial as noEntry, requestDelete, save, validDetails, validIdentity, type Calendar, type EntryDetails } from "../gen/app__calendar.effect.vibe"
import { seriesAt, type CalendarView, type DeleteScope } from "../gen/app__calendarView.effect.vibe"
import type { DraftSnapshot, ListingScope, ReadReceipt, Recipient, ReplyHeader, SendStatus } from "../gen/app__email.effect.vibe"
import type { ChangeReceipt, Folder, MessageChange, MessageIdentity, MetadataReceipt } from "../gen/app__emailItem.effect.vibe"
import type { SavedFile } from "../gen/app__files.effect.vibe"
import { ContactList, DraftSaved, Feed, Grants, Listing, Operation, OtherCheck, ReadResponse, Refusal, Session, SessionOutcome, Stored, WireAttachment, WireEvent, WireMessage } from "./connector.schema.ts"
import type { CloudLink } from "./conversation.vibe"
import { google } from "./google.vibe"
import { providers } from "./providers.vibe"

export type Routes = { readonly slug: string; readonly accounts: string; readonly mail: string; readonly calendar: string }
export type SecretPassword = Brand.Branded<Redacted.Redacted<string>, "SecretPassword">
type WireMessage = typeof WireMessage.Type
type WireEvent = typeof WireEvent.Type
type WireAttachment = typeof WireAttachment.Type
const branded = Brand.nominal<SecretPassword>()
export const secretPassword = (typed: string): SecretPassword => branded(Redacted.make(typed))

export type AccountRef = { readonly provider: Provider; readonly address: string }
export type SignInRequest = { readonly provider: Provider; readonly attempt: number; readonly renewing: string }
export type OtherForm = { readonly attempt: number; readonly address: string; readonly password: SecretPassword }
export type ServersForm = OtherForm & { readonly incoming: string; readonly outgoing: string }
export type MailContent = {
  readonly ref: string; readonly from: string; readonly fromAddress: string; readonly subject: string
  readonly receivedAt: number; readonly snippet: string; readonly body: string; readonly version: string
  readonly to: readonly string[]
}
export type Listed = { readonly receipt: MetadataReceipt; readonly content: MailContent }
export type Opened = { readonly receipt: ReadReceipt; readonly content: MailContent }
export type Contact = { readonly name: string; readonly address: string }
export type ChangeOp = { readonly identity: MessageIdentity; readonly change: Exclude<MessageChange, "NoMessageChange">; readonly revision: number; readonly version: string }
export type DraftStored = { readonly draftId: string; readonly persisted: boolean }
export type SendOutcome = { readonly resultStatus: Extract<SendStatus, "Sent" | "SendFailed" | "SendUnknown">; readonly evidence: string }
export type Published = { readonly incoming: Calendar; readonly seriesVersion: number; readonly scheduleVerified: boolean }
export type StoreReceipt = { readonly revision: number; readonly succeeded: boolean; readonly published: readonly Published[] }
export type DeletionReceipt = { readonly succeeded: boolean; readonly evidence: string }

export error NeedsSignIn
export error Unreachable
export error ProviderRefused { status: number }
export type ConnectorFailure = NeedsSignIn | Unreachable | ProviderRefused

export service SignInPage {
  open(url: string): void!!
  close(url: string): void!!
}

export type MailConnection = {
  readonly list: (scope: ListingScope, revisionOf: (ref: string) => number) => Stream.Stream<Listed, ConnectorFailure>
  readonly read: (ref: string, generation: number) => Opened!ConnectorFailure
  readonly header: (ref: string, generation: number) => ReplyHeader!ConnectorFailure
  readonly resolve: (contact: string) => Recipient!ConnectorFailure
  readonly contacts: () => readonly Contact[]!ConnectorFailure
  readonly change: (op: ChangeOp) => ChangeReceipt!NeedsSignIn
  readonly saveDraft: (snapshot: DraftSnapshot) => DraftStored!NeedsSignIn
  readonly deleteDraft: (draftId: string) => boolean!NeedsSignIn
  readonly send: (operationId: string, snapshot: DraftSnapshot) => SendOutcome!NeedsSignIn
  readonly lookup: (operationId: string) => SendOutcome!NeedsSignIn
}

export type CalendarConnection = {
  readonly feed: (view: CalendarView) => Stream.Stream<Published, ConnectorFailure>
  readonly write: (entry: Calendar, view: CalendarView) => StoreReceipt!NeedsSignIn
  readonly verifySaved: (view: CalendarView, occurrence: string, expected: EntryDetails) => boolean!ConnectorFailure
  readonly remove: (identity: Calendar["identity"], scope: DeleteScope) => DeletionReceipt!NeedsSignIn
}

export service Connector {
  signIn(request: SignInRequest): SheetReport!!
  connectOther(form: OtherForm): OtherReport!Unreachable
  connectServers(form: ServersForm): OtherReport!Unreachable
  readonly mail: (account: AccountRef) => MailConnection
  readonly calendar: (account: AccountRef) => CalendarConnection
}

const routes: Record<Provider, Routes> = { Gmail: google, ...providers }
const nothing: Use = { mail: false, calendar: false, contacts: false }
const sentMail = "in:sent"
const searched: Record<Folder, string | undefined> = { InboxFolder: "in:inbox", SentFolder: sentMail, DraftsFolder: "in:drafts", TrashFolder: "in:trash", PurgedFolder: undefined }
const operations: Record<ChangeOp["change"], string> = { ReadMessage: "mark-read", UnreadMessage: "mark-unread", TrashMessage: "trash", RestoreMessage: "untrash", PurgeMessage: "purge" }
const checked: Record<typeof OtherCheck.Type["outcome"], OtherReport["outcome"]> = {
  allowed: "OtherAllowed", passwordRefused: "OtherPasswordRefused", needsServers: "OtherNeedsServers", refused: "OtherRefused"
}
const ended: Record<typeof SessionOutcome.Type["status"], SheetReport["outcome"]> = { allowed: "Allowed", cancelled: "Cancelled", refused: "Refused" }
const minute = 60 * 1000

function folderOf(labels: readonly string[]): Folder {
  return labels.includes("TRASH") ? "TrashFolder" : labels.includes("DRAFT") ? "DraftsFolder" : labels.includes("SENT") ? "SentFolder" : "InboxFolder"
}

function receivedOf(m: WireMessage) {
  const at = Date.parse(m.receivedAt)
  return Number.isNaN(at) ? undefined : at
}

function content(m: WireMessage, receivedAt: number, body: string): MailContent {
  return { ref: m.externalId, from: m.from, fromAddress: m.fromEmail ?? "", subject: m.subject, receivedAt, snippet: m.snippet, body, version: m.metadata.historyId ?? "", to: m.to }
}

function repliedTo(sent: readonly WireMessage[]): ReadonlySet<string> {
  return new Set(sent.filter((s) => s.labels.includes("SENT")).flatMap((s) => (s.metadata.referencesHeader ?? "").trim().split(/\s+/).slice(-1).filter((id) => id !== "")))
}

function listed(scope: ListingScope, m: WireMessage, revision: number, replied: ReadonlySet<string>): Listed[] {
  const identity = { owner: scope.owner, provider: scope.provider, account: scope.account, ref: m.externalId }
  const receivedAt = receivedOf(m)
  const answered = replied.has(m.metadata.messageIdHeader ?? "")
  return receivedAt === undefined ? [] : [{
    receipt: { seed: { identity, folder: folderOf(m.labels), unread: m.isUnread, answered }, revision, evidence: `history:${m.metadata.historyId ?? ""}` },
    content: content(m, receivedAt, "")
  }]
}

function searchOf(folder: string, text: string) {
  return [folder, ...text.split(/\s+/).map((w) => w.replace(/"/g, "")).filter((w) => w !== "").map((w) => `"${w}"`)].join(" ")
}

function asset(account: AccountRef, m: WireMessage, savedAt: number, a: WireAttachment): SavedFile[] {
  const kind = a.mimeType === "application/pdf" ? "Pdf" : a.mimeType.startsWith("image/") ? "Photo" : undefined
  const pages = kind === "Pdf" ? a.pages ?? 0 : 0
  return kind === undefined || a.filename === "" || (kind === "Pdf" && pages < 1) ? [] : [{
    id: `${m.externalId}/${a.partId}`, kind, name: a.filename, origin: account.provider, account: account.address, container: m.externalId,
    sourceRef: m.externalId, contentRef: a.partId, group: m.externalId, savedAt, pages
  }]
}

function manifest(account: AccountRef, ref: string, m: WireMessage, all: readonly WireAttachment[] | undefined): SavedFile[] | undefined {
  const savedAt = receivedOf(m)
  const kept = savedAt === undefined ? [] : (all ?? []).flatMap((a) => asset(account, m, savedAt, a))
  return all === undefined || savedAt === undefined || m.externalId !== ref || kept.length !== all.length ? undefined : kept
}

function carried(file: SavedFile) {
  return { kind: file.kind, name: file.name, origin: file.origin, account: file.account, sourceRef: file.sourceRef, contentRef: file.contentRef, pages: file.pages }
}

const addresses = (to: string) => to.split(/[,;]/).map((a) => a.trim()).filter((a) => a !== "")
const iso = (at: number) => new Date(at).toISOString()

function wallClock(at: number, timeZone: string) {
  const parts = new Intl.DateTimeFormat("en-US", { timeZone, hourCycle: "h23", year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "numeric", second: "numeric" }).formatToParts(at)
  const part = (type: string) => Number(parts.find((p) => p.type === type)?.value)
  return Date.UTC(part("year"), part("month") - 1, part("day"), part("hour"), part("minute"), part("second"))
}

function midnight(date: string, timeZone: string) {
  const guess = Date.parse(`${date}T00:00:00Z`)
  const first = guess - (wallClock(guess, timeZone) - guess)
  return guess - (wallClock(first, timeZone) - first)
}

const dateIn = (at: number, timeZone: string) => new Intl.DateTimeFormat("en-CA", { timeZone, year: "numeric", month: "2-digit", day: "2-digit" }).format(at)

function exactly(zones: ReadonlySet<string>, text: string, allDay: boolean, timeZone: string) {
  const at = /(?:[zZ]|[+-]\d\d:?\d\d)$/.test(text) ? Date.parse(text) : Number.NaN
  if (Number.isNaN(at)) return undefined
  return allDay && !(zones.has(timeZone) && midnight(dateIn(at, timeZone), timeZone) === at) ? undefined : at
}

function schedule(zones: ReadonlySet<string>, e: WireEvent, timeZone: string) {
  const exact = [exactly(zones, e.startAt, e.isAllDay, timeZone), exactly(zones, e.endAt, e.isAllDay, timeZone)]
  const loose = [Date.parse(e.startAt), Date.parse(e.endAt)]
  const [startAt, endAt] = exact.every((t) => t !== undefined) ? exact : loose
  return { startAt: startAt ?? Number.NaN, endAt: endAt ?? Number.NaN, verified: exact.every((t) => t !== undefined) }
}

function participantOf(e: WireEvent) {
  const other = e.attendees.find((a) => !a.self)
  return other?.displayName ?? other?.email ?? ""
}

function details(e: WireEvent, startAt: number, endAt: number, timezone: string, known: EntryDetails | undefined): EntryDetails {
  const kept = known ?? { participant: participantOf(e), seriesId: "", recurrence: "Once" as const, reminderEnabled: false, leadTime: 0, important: false }
  return {
    title: e.title, location: e.location, notes: e.description, startAt, endAt, timezone, allDay: e.isAllDay,
    participant: kept.participant, seriesId: kept.seriesId, recurrence: kept.recurrence, reminderEnabled: kept.reminderEnabled, leadTime: kept.leadTime, important: kept.important
  }
}

function sameDetails(a: EntryDetails, b: EntryDetails) {
  return (Object.keys(a) as (keyof EntryDetails)[]).every((k) => a[k] === b[k])
}

const seriesVersionOf = (view: CalendarView, seriesId: string) => seriesId === "" ? 0 : Math.max(0, seriesAt(view, seriesId).version)

function refreshed(known: Calendar | undefined, view: CalendarView, e: WireEvent, entry: EntryDetails): Calendar | undefined {
  if (known === undefined) {
    const identity = { owner: view.owner, calendarId: view.calendarId, occurrenceId: e.externalId, sourceRef: "", kind: "Appointment" as const, billRef: "", billOrigin: "", billAccount: "" }
    return validIdentity(identity) ? save(approveSave(create(noEntry, identity, entry, "CalendarUser"), 1, "CalendarUser"), 1, true, "CalendarStore") : undefined
  }
  if (known.phase !== "Saved" || sameDetails(known.committed, entry)) return undefined
  const edited = edit(beginEdit(known, "CalendarUser"), entry, "CalendarUser")
  return save(approveSave(edited, edited.revision, "CalendarUser"), edited.revision, true, "CalendarStore")
}

const deleted = (known: Calendar) => confirmDelete(approveDelete(requestDelete(known, "CalendarUser"), "CalendarUser"), true, "CalendarStore")

function published(zones: ReadonlySet<string>, view: CalendarView, events: readonly WireEvent[]): Published[] {
  const own = view.entries.filter((c) => c.identity.owner === view.owner && c.identity.calendarId === view.calendarId)
  const changed = events.flatMap((e) => {
    const known = own.find((c) => c.identity.occurrenceId === e.externalId)
    const timezone = e.timezone ?? view.timezone
    const { startAt, endAt, verified } = schedule(zones, e, timezone)
    const entry = details(e, startAt, endAt, timezone, known?.committed)
    const incoming = validDetails(entry) ? refreshed(known, view, e, entry) : undefined
    return incoming === undefined ? [] : [{ incoming, seriesVersion: seriesVersionOf(view, entry.seriesId), scheduleVerified: verified }]
  })
  const gone = own.filter((c) => c.phase === "Saved" && c.committed.startAt < view.window.untilTime && c.committed.endAt > view.window.fromTime && !events.some((e) => e.externalId === c.identity.occurrenceId))
  return [...changed, ...gone.map((c) => ({ incoming: deleted(c), seriesVersion: seriesVersionOf(view, c.committed.seriesId), scheduleVerified: true }))]
}

function event({ draft: d, committed: c, hasSaved }: Calendar) {
  const moved = !hasSaved || d.startAt !== c.startAt || d.endAt !== c.endAt || d.timezone !== c.timezone || d.allDay !== c.allDay
  const fields = { title: d.title, description: d.notes, location: d.location }
  if (!moved) return fields
  return d.allDay || (hasSaved && c.allDay) ? undefined : { ...fields, startAt: iso(d.startAt), endAt: iso(d.endAt), timeZone: d.timezone }
}

function adopted(zones: ReadonlySet<string>, view: CalendarView, entry: Calendar, saved: WireEvent): Published[] {
  const identity = { ...entry.identity, occurrenceId: saved.externalId }
  const timezone = saved.timezone ?? entry.draft.timezone
  const { startAt, endAt, verified } = schedule(zones, saved, timezone)
  const stored = details(saved, startAt, endAt, timezone, entry.draft)
  if (saved.externalId === entry.identity.occurrenceId || !validIdentity(identity) || !validDetails(stored)) return []
  const seriesVersion = seriesVersionOf(view, entry.draft.seriesId)
  const placed = save(approveSave(create(noEntry, identity, stored, "CalendarUser"), 1, "CalendarUser"), 1, true, "CalendarStore")
  return [
    { incoming: deleted(save(entry, entry.revision, true, "CalendarStore")), seriesVersion, scheduleVerified: true },
    { incoming: placed, seriesVersion, scheduleVerified: verified && startAt === entry.draft.startAt && endAt === entry.draft.endAt }
  ]
}

function requestIdOf(text: string) {
  const hex = [0x811c9dc5, 0x2c1b3c6d, 0x9e3779b9, 0x85ebca6b].map((seed) => {
    let h = seed
    for (const c of text) h = Math.imul(h ^ (c.codePointAt(0) ?? 0), 0x01000193) >>> 0
    return h.toString(16).padStart(8, "0")
  }).join("")
  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-4${hex.slice(13, 16)}-${"89ab"[parseInt(hex[16], 16) % 4]}${hex.slice(17, 20)}-${hex.slice(20)}`
}

const outcome = (resultStatus: SendOutcome["resultStatus"], evidence: string): SendOutcome => ({ resultStatus, evidence })

const certain = (e: ProviderRefused) => e.status >= 400

type Receipt = typeof Operation.Type["receipt"]

function sendOutcome(r: Receipt): SendOutcome {
  return match (r.state) {
    when "succeeded": r.providerResult?.messageId === undefined ? outcome("SendUnknown", "") : outcome("Sent", `message:${r.providerResult.messageId}`);
    when "rejected": outcome("SendFailed", `rejected:${r.rejectionCode ?? ""}`);
    when "prepared": outcome("SendFailed", "not-sent");
    when "dispatched": outcome("SendUnknown", "");
    when "outcome-unknown": outcome("SendUnknown", "");
  }
}

export const connector = (link: CloudLink) => Layer.effect(Connector, effect {
  const http = try HttpClient.HttpClient
  const page = try SignInPage
  const zones = new Set([...try orDie(Effect.try(() => Intl.supportedValuesOf("timeZone"))), "UTC"])

  effect function reconnects(sent: HttpClientRequest.HttpClientRequest, response: HttpClientResponse.HttpClientResponse) {
    if (!sent.url.includes("/inbox-v1/")) return true
    const body = response.json catch effect () => null
    return Option.getOrUndefined(Schema.decodeUnknownOption(Refusal)(body))?.code === "reauth_required"
  }

  effect function call(request: HttpClientRequest.HttpClientRequest!ConnectorFailure) {
    const sent = try request
    const response = Effect.provideService(http.execute(HttpClientRequest.bearerToken(sent, link.key)), HttpClient.TracerPropagationEnabled, false)
      catch effect () => { throw new Unreachable() }
    if (response.status === 401 || (response.status === 409 && (try reconnects(sent, response)))) throw new NeedsSignIn()
    if (response.status >= 500) throw new Unreachable()
    if (response.status >= 400) throw new ProviderRefused({ status: response.status })
    return response
  }

  effect function fetched<A>(request: HttpClientRequest.HttpClientRequest!ConnectorFailure, schema: Schema.Decoder<A>) {
    const response = try call(request)
    const body = response.json catch effect () => { throw new ProviderRefused({ status: response.status }) }
    return Schema.decodeUnknownEffect(schema)(body) catch effect () => { throw new ProviderRefused({ status: response.status }) }
  }

  const get = (url: string, params: Record<string, string>) => Effect.succeed(HttpClientRequest.setUrlParams(HttpClientRequest.get(`${link.url}${url}`), params))
  const post = (url: string, body: object) => Effect.succeed(HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`${link.url}${url}`), body))

  effect function grantOf(account: AccountRef) {
    const address = account.address.toLowerCase()
    const found = (try fetched(get(routes[account.provider].accounts, { side: "owner" }), Grants)).find((g) => g.connected && g.identity?.email?.toLowerCase() === address)
    if (found === undefined || found.connectionId === null) throw new NeedsSignIn()
    return found.connectionId
  }

  effect function visit({ provider, attempt, renewing }: SignInRequest) {
    const session = try fetched(post(`/api/v1/eliza/connections/${routes[provider].slug}/sessions`, { loginHint: renewing }), Session)
    const waited = ensuring(effect {
      try page.open(session.pageUrl)
      return try fetched(get(`/api/v1/eliza/connections/sessions/${session.sessionId}`, {}), SessionOutcome)
    }, page.close(session.pageUrl))
    const answer = try onInterrupt(waited, () => Effect.ignore(call(Effect.succeed(HttpClientRequest.make("DELETE")(`${link.url}/api/v1/eliza/connections/sessions/${session.sessionId}`)))))
    const address = answer.address ?? ""
    const result = answer.status === "allowed" && address === "" ? "Refused" : ended[answer.status]
    return { attempt, outcome: result, address: result === "Allowed" ? address : "", granted: result === "Allowed" ? answer.granted ?? nothing : nothing } satisfies SheetReport
  }

  effect function check(attempt: number, body: object) {
    const c = fetched(post("/api/v1/eliza/connections/other", body), OtherCheck) catch effect () => { throw new Unreachable() }
    return { attempt, outcome: checked[c.outcome], address: c.address } satisfies OtherReport
  }

  function mail(account: AccountRef): MailConnection {
    const at = routes[account.provider].mail
    const asked = effect (path: string, params: Record<string, string>) => try get(`${at}${path}`, { ...params, grantId: try grantOf(account) })
    const posted = effect (path: string, body: object) => try post(`${at}${path}`, { ...body, grantId: try grantOf(account) })
    const removed = effect (path: string) =>
      HttpClientRequest.setUrlParams(HttpClientRequest.make("DELETE")(`${link.url}${path}`), { grantId: try grantOf(account) })
    const requestOf = (purpose: string) => requestIdOf(`${account.provider}:${account.address}:${purpose}`)

    effect function read(ref: string) {
      return try fetched(asked("/read", { messageId: ref }), ReadResponse)
    }

    effect function contacts(query: string) {
      return (try fetched(asked("/contacts", { query }), ContactList)).contacts.map((c): Contact => ({ name: c.name, address: c.email }))
    }

    effect function operate(requestId: string, proposal: object) {
      const { receipt } = try fetched(posted("/inbox-v1/operations", { requestId, proposal }), Operation)
      return receipt.state !== "prepared" ? receipt : (try fetched(posted(`/inbox-v1/operations/${requestId}/dispatch`, { reviewDigest: receipt.reviewDigest, proposal }), Operation)).receipt
    }

    effect function outgoing({ content: c, replyTo, attachments }: DraftSnapshot) {
      const recipients = { to: addresses(c.to), cc: c.cc, bcc: c.bcc, subject: c.subject, bodyText: c.body }
      const sources = [...new Set(attachments.map((f) => f.sourceRef))]
      if (attachments.length > 0) {
        if (sources.length !== 1 || attachments.some((f) => f.origin !== account.provider || f.account !== account.address)) throw new ProviderRefused({ status: 422 })
        const { message } = try read(sources[0])
        return { kind: "send", mode: "forward", ...recipients, forwardAttachments: { messageId: sources[0], historyId: message.metadata.historyId ?? "", partIds: attachments.map((f) => f.contentRef) } }
      }
      if (replyTo === "") return { kind: "send", mode: "compose", ...recipients }
      const { message } = try read(replyTo)
      const threaded = c.subject === (/^re:/i.test(message.subject) ? message.subject : `Re: ${message.subject}`)
      return threaded ? { kind: "send", mode: "reply", replyMessageId: replyTo, ...recipients } : { kind: "send", mode: "compose", ...recipients }
    }

    effect function looked(operationId: string) {
      const { receipt } = try fetched(asked(`/inbox-v1/operations/${requestOf(`send:${operationId}`)}`, {}), Operation)
      return sendOutcome(receipt)
    }

    effect function lookup(operationId: string) {
      return looked(operationId) catch effect (e) => match (e) {
        when NeedsSignIn: throw e;
        when ProviderRefused: e.status === 404 ? outcome("SendFailed", "not-sent") : outcome("SendUnknown", "");
        when Unreachable: outcome("SendUnknown", "");
      }
    }

    return {
      list: (scope, revisionOf) => {
        const folder = searched[scope.folder]
        return folder === undefined ? Stream.empty : Stream.unwrap(effect {
          const { messages } = try fetched(asked("/search", { query: searchOf(folder, scope.query), maxResults: "50" }), Listing)
          const sent = scope.folder === "SentFolder" ? messages : (try fetched(asked("/search", { query: sentMail, maxResults: "50" }), Listing)).messages
          const replied = repliedTo(sent)
          return Stream.fromIterable(messages.flatMap((m) => listed(scope, m, revisionOf(m.externalId), replied)))
        })
      },
      read: effect (ref, generation) => {
        const { message, bodyText, attachments } = try read(ref)
        const assets = manifest(account, ref, message, attachments)
        return { receipt: { generation, succeeded: assets !== undefined, assets: assets ?? [], suspicion: "" }, content: content(message, receivedOf(message) ?? 0, bodyText) }
      },
      header: effect (ref, generation) => {
        const { message } = try read(ref)
        const address = [message.replyTo, message.fromEmail].find((a) => a?.includes("@"))
        return { ref, generation, address: address ?? "", subject: /^re:/i.test(message.subject) ? message.subject : `Re: ${message.subject}`, verified: address !== undefined && message.externalId === ref }
      },
      resolve: effect (contact) => {
        const named = (try contacts(contact)).filter((c) => c.name.toLowerCase() === contact.trim().toLowerCase())
        return named.length === 1 ? { address: named[0].address, verified: true } : { address: "", verified: false }
      },
      contacts: () => contacts(""),
      change: effect (op) => {
        const proposal = { kind: operations[op.change], messageId: op.identity.ref, expectedHistoryId: op.version }
        const requestId = requestOf(`${op.identity.ref}:${op.change}:${op.version}:${op.revision}`)
        const answered = { identity: op.identity, revision: op.revision }
        return Effect.map(operate(requestId, proposal), (r): ChangeReceipt => match (r.state) {
          when "succeeded": r.providerResult === null ? { ...answered, result: "ChangeUnknown", evidence: "" } : { ...answered, result: "ChangeIdle", evidence: `history:${r.providerResult.historyId ?? ""}` };
          when "rejected": { ...answered, result: "ChangeFailed", evidence: `rejected:${r.rejectionCode ?? ""}` };
          default: { ...answered, result: "ChangeUnknown", evidence: "" };
        }) catch effect (e) => match (e) {
          when NeedsSignIn: throw e;
          when ProviderRefused: certain(e) ? { ...answered, result: "ChangeFailed", evidence: `refused:${e.status}` } : { ...answered, result: "ChangeUnknown", evidence: "" };
          when Unreachable: { ...answered, result: "ChangeUnknown", evidence: "" };
        }
      },
      saveDraft: effect ({ id, content: c, attachments }) => {
        const body = { draftId: id, to: addresses(c.to), cc: c.cc, bcc: c.bcc, subject: c.subject, bodyText: c.body, attachments: attachments.map(carried) }
        return Effect.map(fetched(posted("/drafts", body), DraftSaved), ({ draftId }): DraftStored => ({ draftId, persisted: draftId === id })) catch effect (e) => match (e) {
          when NeedsSignIn: throw e;
          default: { draftId: id, persisted: false };
        }
      },
      deleteDraft: effect (draftId) => {
        return Effect.as(call(removed(`${at}/drafts/${encodeURIComponent(draftId)}`)), true) catch effect (e) => match (e) {
          when NeedsSignIn: throw e;
          default: false;
        }
      },
      send: effect (operationId, snapshot) => {
        const sent = effect { return sendOutcome(try operate(requestOf(`send:${operationId}`), try outgoing(snapshot))) }
        return sent catch effect (e) => match (e) {
          when NeedsSignIn: throw e;
          when ProviderRefused: e.status === 409 || !certain(e) ? try lookup(operationId) : outcome("SendFailed", `refused:${e.status}`);
          when Unreachable: outcome("SendUnknown", "");
        }
      },
      lookup
    }
  }

  function calendar(account: AccountRef): CalendarConnection {
    const at = routes[account.provider].calendar
    const url = (path: string) => `${link.url}${at}${path}`
    const removal = effect (id: string, calendarId: string) =>
      HttpClientRequest.setUrlParams(HttpClientRequest.make("DELETE")(url(`/events/${encodeURIComponent(id)}`)), { grantId: try grantOf(account), calendarId })

    effect function stored(entry: Calendar, view: CalendarView) {
      const { calendarId, occurrenceId: id } = entry.identity
      const fields = event(entry)
      if (fields === undefined) throw new ProviderRefused({ status: 422 })
      const body = { ...fields, calendarId, grantId: try grantOf(account) }
      const request = entry.hasSaved
        ? HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.patch(url(`/events/${encodeURIComponent(id)}`)), body)
        : HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(url("/events")), body)
      const { event: saved } = try fetched(Effect.succeed(request), Stored)
      return entry.hasSaved ? [] : adopted(zones, view, entry, saved)
    }

    effect function readEvents(view: CalendarView, from: number, until: number) {
      const params = { calendarId: view.calendarId, timeZone: view.timezone, timeMin: iso(from), timeMax: iso(until), grantId: try grantOf(account) }
      return (try fetched(get(`${at}/feed`, params), Feed)).events
    }

    return {
      feed: (view) => Stream.unwrap(effect {
        const feed = try readEvents(view, view.window.fromTime, view.window.untilTime)
        return Stream.fromIterable(published(zones, view, feed))
      }),
      verifySaved: effect (view, occurrence, expected) => {
        const feed = try readEvents(view, expected.startAt, expected.endAt)
        const saved = feed.find((row) => row.externalId === occurrence)
        if (saved === undefined) return false
        const timezone = saved.timezone ?? view.timezone
        const { startAt, endAt, verified } = schedule(zones, saved, timezone)
        return verified && sameDetails(details(saved, startAt, endAt, timezone, expected), expected)
      },
      write: effect (entry, view) => {
        const revision = entry.revision
        return Effect.map(stored(entry, view), (published): StoreReceipt => ({ revision, succeeded: true, published })) catch effect (e) => match (e) {
          when NeedsSignIn: throw e;
          default: { revision, succeeded: false, published: [] };
        }
      },
      remove: effect ({ calendarId, occurrenceId: id }, scope) => {
        if (scope === "EntireSeries") return { succeeded: false, evidence: "series-unsupported" }
        return Effect.as(call(removal(id, calendarId)), { succeeded: true, evidence: `deleted:${id}` }) catch effect (e) => match (e) {
          when NeedsSignIn: throw e;
          when ProviderRefused: { succeeded: false, evidence: `refused:${e.status}` };
          when Unreachable: { succeeded: false, evidence: "" };
        }
      }
    }
  }

  return {
    signIn: effect (request) => {
      const refused: SheetReport = { attempt: request.attempt, outcome: "Refused", address: "", granted: nothing }
      return request.provider === "OtherEmail" ? refused : (visit(request) catch () => refused)
    },
    connectOther: (form) => check(form.attempt, { address: form.address, password: Redacted.value(form.password) }),
    connectServers: (form) => check(form.attempt, { address: form.address, password: Redacted.value(form.password), incoming: form.incoming, outgoing: form.outgoing }),
    mail,
    calendar
  }
}).pipe(Layer.provide(FetchHttpClient.layer))
