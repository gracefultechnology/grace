// spec/app/accounts.md, "Story: Connect the email I already use"; spec/app/accounts.md, "Only the current sign-in attempt can add or renew an account"; spec/app/accounts.md, "Other email connects through its own servers, asking for them when the tablet cannot find them"; spec/app/accounts.md, "Nothing she types to sign in enters the tablet’s state"; spec/app/accounts.md, "Accounts start empty and each address is on the tablet once"; spec/app/accounts.md, "Signing in again renews the same account"; spec/app/accounts.md, "The settings pages go back one step at a time"; spec/app/accounts.md, "Mail settings can be looked up from her address, and fill the form for her to check"; spec/app/proposal.md, "Story: Say yes to exactly what Grace proposes for my calendar"
import { accountAt, accountWith, freshName, initial as initialAccounts, lookupFinds, Machine as Accounts, parseState as parseAccounts, stored as storedAccounts, told, type Accounts as Registry, type Event, type FoundServer, type OtherReport, type Provider, type Security, type ServerKind, type SheetReport } from "../gen/app__accounts.effect.vibe"
import { stored as storedProposal } from "../gen/app__proposal.effect.vibe"
import { type GraceAccount, Machine as Setup } from "../gen/app__setup.effect.vibe"
import { Machine as Workspaces } from "../gen/app__workspace.effect.vibe"
import { Connector, type OtherForm, type SecretPassword, type ShownPage } from "./connector.vibe"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { compatibleStore, Instances } from "./instances.vibe"
import { Resolved, serversIn, serversListed, validHostname } from "./mailSettings.ts"

const restarted = Layer.effectDiscard(effect {
  try Effect.orDie((try Accounts).send({ type: "restartAccounts" }, "AccountHost"))
})

const stateKey = "accounts"
const rawRecord = Schema.Record(Schema.String, Schema.Unknown)
const readRecord = Schema.decodeUnknownOption(Schema.fromJsonString(rawRecord))
const readSignIn = Schema.decodeUnknownOption(rawRecord)
const readRows = Schema.decodeUnknownOption(Schema.Array(rawRecord))

function upgradedAccounts(text: string) {
  const raw = Option.getOrUndefined(readRecord(text))
  if (raw === undefined) return undefined
  if (parseAccounts(raw) !== undefined) return text
  const rows = Option.getOrUndefined(readRows(raw.accounts))
  const signIn = Option.getOrUndefined(readSignIn(raw.signIn))
  if (rows === undefined || signIn === undefined) return undefined
  const { lookup, incoming, outgoing } = initialAccounts.signIn
  const upgraded = parseAccounts({
    discarding: initialAccounts.discarding,
    ...raw,
    signIn: { lookup, incoming, outgoing, ...signIn },
    accounts: rows.map((row) => ({ fromName: "", ...row })),
  })
  return upgraded === undefined ? undefined : JSON.stringify(upgraded)
}

const accountStorage = Layer.unwrap(effect {
  return Layer.provide(storedAccounts(stateKey), compatibleStore(try KeyValueStore.KeyValueStore, stateKey, (text) => Effect.succeed(upgradedAccounts(text))))
})

export const accounts = Layer.mergeAll(Layer.provideMerge(restarted, accountStorage), storedProposal("proposal"))

export type OtherDetails = { readonly name: string; readonly address: string; readonly password: SecretPassword }
export type MailServers = { readonly incoming: string; readonly outgoing: string }

export type Note = { readonly id: number; readonly text: string }
export type Watched<A> = { readonly subscribe: (listener: () => void) => () => void; readonly current: () => A }

export service SignIns {
  other(details: OtherDetails): void!!
  servers(servers: MailServers): void!!
  lookUp(): void!!
  readonly notes: Watched<Note | undefined>
  readonly owner: Watched<string>
  readonly page: Watched<ShownPage | undefined>
}

function watched<A>(initial: A) {
  const listeners = new Set<() => void>()
  const held = { value: initial }
  const view: Watched<A> = {
    subscribe: (listener) => {
      listeners.add(listener)
      return () => { listeners.delete(listener) }
    },
    current: () => held.value
  }
  return {
    view,
    set: (value: A) => sync(() => {
      held.value = value
      listeners.forEach((listener) => listener())
    })
  }
}

const signedInAs = (account: GraceAccount) => account.tag === "GraceSignedIn" ? account.accountId : account.tag

const companies: Record<Provider, string> = { Gmail: "Gmail", Outlook: "Outlook", Yahoo: "Yahoo", ICloud: "iCloud", Aol: "AOL", OtherEmail: "Email" }
const internetCompanies: Record<string, string> = { "comcast.net": "Comcast", "att.net": "AT&T", "verizon.net": "Verizon", "cox.net": "Cox", "charter.net": "Charter" }
const noteFor = "2600 millis"

export const domainOf = (address: string) => {
  const at = address.lastIndexOf("@")
  if (at < 0) return ""
  const domain = address.slice(at + 1).trim().toLowerCase()
  return validHostname(domain) ? domain : ""
}

function nameFor(a: Registry, provider: Provider, address: string): string {
  const known = accountWith(a, address)
  if (known.id !== 0) return known.name
  const domain = domainOf(address)
  const label = domain.split(".")[0] ?? ""
  const base = provider !== "OtherEmail" ? companies[provider] : internetCompanies[domain] ?? (label === "" ? companies[provider] : label.charAt(0).toUpperCase() + label.slice(1))
  const local = address.slice(0, address.lastIndexOf("@"))
  const numbered = Array.from({ length: a.accounts.length + 1 }, (_, n) => n === 0 ? `${base} (${local})` : `${base} (${local} ${n + 1})`)
  return [base, ...numbered].find((name) => freshName(a, name)) ?? base
}

function noteOf(before: Registry, after: Registry): string | undefined {
  const said = told(before, after)
  return match (said.kind) {
    when "TellConnected": `${accountAt(after, said.account).name} connected`;
    when "TellRenewed": `${accountAt(after, said.account).name} connected`;
    when "TellRemoved": `${accountAt(before, said.account).name} removed from this tablet`;
    default: undefined;
  }
}

type Held = OtherForm & { readonly name: string; readonly domain: string }

const lookupDeadline = "8 seconds"
const setupFiles = (domain: string) => [
  `https://autoconfig.${domain}/mail/config-v1.1.xml`,
  `https://${domain}/.well-known/autoconfig/mail/config-v1.1.xml`,
  `https://autoconfig.thunderbird.net/v1.1/${encodeURIComponent(domain)}`
]
const records: readonly { readonly service: string; readonly kind: ServerKind; readonly security: Security }[] = [
  { service: "_imaps._tcp", kind: "ImapServer", security: "SecureDirect" },
  { service: "_submission._tcp", kind: "SmtpServer", security: "SecureUpgrade" }
]

const nothingFound: readonly FoundServer[] = []
const unfinished = (attempt: number): SheetReport => ({ attempt, outcome: "Refused", address: "", granted: { mail: false, calendar: false, contacts: false } })
const refused = (attempt: number): OtherReport => ({ attempt, outcome: "OtherRefused", address: "" })
const leaving: readonly Event[] = [{ type: "cancelSignIn" }, { type: "keepAccount" }, { type: "goBack" }, { type: "goBack" }, { type: "goBack" }]

export const signIns = Layer.effect(SignIns, effect {
  const registry = try Accounts
  const workspace = try Workspaces
  const setup = try Setup
  const shelf = try Instances
  const connector = Option.getOrUndefined(try Effect.serviceOption(Connector))
  const held = try Ref.make<Held | undefined>(undefined)
  const notes = watched<Note | undefined>(undefined)
  const page = watched<ShownPage | undefined>(undefined)
  const owner = watched("")
  const http = try HttpClient.HttpClient
  const counter = { next: 1 }

  effect function show(text: string) {
    try notes.set({ id: counter.next, text })
    counter.next += 1
    try sleep(noteFor)
    try notes.set(undefined)
  }

  effect function learnOwner(cloud: Connector.Shape) {
    const name = cloud.ownerName() catch () => ""
    try owner.set(name)
  }

  if (connector !== undefined) {
    try fork.scoped Stream.runForEach(connector.shown, page.set)
    const signedIn = Stream.changes(Stream.map(setup.changes, ({ graceAccount }) => signedInAs(graceAccount)))
    try fork.scoped Stream.runDrain(Stream.switchMap(signedIn, () => Stream.fromEffect(learnOwner(connector))))
  }

  effect function renew(id: number) {
    const box = try shelf.mail(id)
    const { owner, provider, account, connection } = try box.get()
    const use = accountAt(try registry.get(), id).use
    if (!use.mail) {
      if (connection !== "Connected") box.send({ type: "endConnection", resultStatus: "Disconnected" }, "MailConnector") catch () => undefined
      return
    }
    try box.send({ type: "connect", owner, provider, account }, "MailUser")
    const { generation } = try box.get()
    try box.send({ type: "authorize", generation, verified: true, readGranted: true, sendGranted: true }, "MailConnector")
    try box.send({ type: "readMail", kind: "Search", ref: "", approved: true }, "MailUser")
  }

  effect function answer(event: Event, otherwise: Event) {
    const taken = registry.send(event, "AccountConnector") catch () => undefined
    if (taken === undefined) registry.send(otherwise, "AccountConnector") catch () => undefined
  }

  effect function leave() {
    for (const event of leaving) registry.send(event, "AccountPerson") catch () => undefined
  }

  const onPage = Stream.changes(Stream.map(workspace.changes, ({ device }) => device.surface === "DeviceSettings" && device.settingsPage === "EmailCalendarSettings"))
  try fork.scoped Stream.runForEach(Stream.filter(onPage, (open) => !open), () => leave())

  const news = Stream.mapAccum(registry.changes, (): Registry | undefined => undefined, (before, after) => [after, before === undefined ? [] : [{ after, said: told(before, after), note: noteOf(before, after) }]] as const)
  const notices = Stream.filter(Stream.map(news, ({ note }) => note), (note): note is string => note !== undefined)
  try fork.scoped Stream.runForEach(news, effect ({ after, said }) => {
    if (said.kind === "TellRenewed") renew(after.shown) catch () => undefined
  })
  try fork.scoped Stream.runDrain(Stream.switchMap(notices, (text) => Stream.fromEffect(show(text))))

  effect function visit(attempt: number) {
    const a = try registry.get()
    const { provider, renewing } = a.signIn
    const sheet = connector === undefined ? unfinished(attempt) : try connector.signIn({ provider, attempt, renewing: accountAt(a, renewing).address })
    try answer({ type: "sheetResult", sheet, name: nameFor(try registry.get(), provider, sheet.address) }, { type: "sheetResult", sheet: unfinished(attempt), name: "" })
  }

  effect function report(event: "otherResult" | "serversResult", check: OtherReport, fromName: string) {
    try answer({ type: event, check, name: nameFor(try registry.get(), "OtherEmail", check.address), fromName }, { type: event, check: refused(check.attempt), name: "", fromName: "" })
  }

  const attempts = Stream.changes(Stream.map(registry.changes, (a) => a.signIn.stage === "ProviderPage" ? a.signIn.attempt : -1))
  try fork.scoped Stream.runDrain(Stream.switchMap(attempts, (attempt) => attempt < 0 ? Stream.empty : Stream.fromEffect(visit(attempt))))
  try fork.scoped Stream.runForEach(registry.changes, (a) => a.page === "OtherEmailPage" || a.page === "MailServersPage" ? Effect.void : Ref.set(held, undefined))

  effect function other({ name, address, password }: OtherDetails) {
    const domain = domainOf(address)
    const asked = registry.send({ type: "submitOther", domain }, "AccountPerson") catch () => undefined
    if (asked?.signIn.stage !== "CheckingOther") return
    const form = { attempt: asked.signIn.attempt, name, address, password }
    try Ref.set(held, { ...form, domain })
    const check = connector === undefined ? refused(form.attempt) : (connector.connectOther(form) catch () => refused(form.attempt))
    try report("otherResult", check, name)
  }

  effect function servers({ incoming, outgoing }: MailServers) {
    const asked = registry.send({ type: "submitServers" }, "AccountPerson") catch () => undefined
    if (asked?.signIn.stage !== "CheckingServers") return
    const { attempt, domain } = asked.signIn
    const form = try Ref.get(held)
    const check = connector === undefined || form?.domain !== domain ? refused(attempt)
      : (connector.connectServers({ attempt, name: form.name, address: form.address, password: form.password, incoming, outgoing }) catch () => refused(attempt))
    try report("serversResult", check, form?.name ?? "")
  }

  effect function fetchedText(url: string) {
    const response = try Effect.provideService(http.execute(HttpClientRequest.get(url)), HttpClient.TracerPropagationEnabled, false)
    if (response.status !== 200) return ""
    return try response.text
  }

  effect function listedIn(service: string, domain: string) {
    const url = `https://dns.google/resolve?name=${encodeURIComponent(`${service}.${domain}`)}&type=SRV`
    return try Schema.decodeUnknownEffect(Schema.fromJsonString(Resolved))(try fetchedText(url))
  }

  effect function fromFile(url: string, domain: string) {
    return timeout(effect {
      const xml = try fetchedText(url)
      return try Effect.try(() => serversIn(xml, domain))
    }, lookupDeadline) catch () => nothingFound
  }

  effect function fromRecord({ service, kind, security }: (typeof records)[number], domain: string) {
    return timeout(effect {
      const answer = try listedIn(service, domain)
      return try Effect.try(() => serversListed(answer, kind, security))
    }, lookupDeadline) catch () => nothingFound
  }

  effect function serversOf(domain: string) {
    if (!(Effect.try(() => validHostname(domain)) catch () => false)) return [] as FoundServer[]
    const files = setupFiles(domain)
    const asked: Fiber.Fiber<readonly FoundServer[]>[] = []
    for (const url of files) asked.push(try fork fromFile(url, domain))
    for (const record of records) asked.push(try fork fromRecord(record, domain))
    const found: FoundServer[] = []
    for (const [index, fiber] of asked.entries()) {
      found.push(...(try join fiber))
      if (index < files.length && lookupFinds(found)) return found
    }
    return found
  }

  effect function lookUp() {
    const asked = registry.send({ type: "lookUpServers" }, "AccountPerson") catch () => undefined
    if (asked?.signIn.lookup !== "LookingUp") return
    const { attempt, domain } = asked.signIn
    const found = try serversOf(domain)
    registry.send({ type: "serversLookedUp", report: { attempt, found } }, "AccountConnector") catch () => undefined
  }

  return {
    other: (details) => Effect.provideService(other(details), HttpClient.TracerPropagationEnabled, false),
    servers: (typed) => Effect.provideService(servers(typed), HttpClient.TracerPropagationEnabled, false),
    lookUp,
    notes: notes.view,
    page: page.view,
    owner: owner.view
  }
}).pipe(Layer.provide(FetchHttpClient.layer))
