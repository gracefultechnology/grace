// spec/app/surface.md, "Story: Use the website under Grace's controls"; spec/app/surface.md, "Story: Keep the page still while Grace covers it"; spec/app/websiteRequests.md, "Story: Answer what a website asks of me"; spec/app/browser.md, "Load results must match the tab and request that produced them"; spec/app/websiteRequests.md, "Looking away from a page ends what it asked, and never accepts it"; spec/app/surface.md, "A Grace control is drawn over the page only after the host routes its rect to Grace"; spec/app/surface.md, "A new page waits for its first routing before it takes any touch"; spec/app/surface.md, "The page is paused while Grace's window is in the background"; spec/app/surface.md, "The page shows only on the ready browser surface while Grace is not expanded"; spec/app/websiteRequests.md, "A download is saved with a visible status or visibly not saved"; spec/app/websiteRequests.md, "Only the website I am on can ask, and my answer holds for that website and those devices until Close browser"; spec/app/workspace.md, "A page that moves by itself where the person is not looking only records where it went"; spec/app/surface.md, "The page fills the rect the interface measured for it"; spec/app/browser.md, "Overflow retains the selected tab and the most recently used other tabs in opening order"; spec/app/websiteRequests.md, "Allow asks Android, and a website gets a device only when Android allows it too"; spec/app/websiteRequests.md, "When the app or browser I confirmed does not open, I am told"; spec/app/websiteRequests.md, "Website sign-ins last across tabs and Close browser until browsing data is cleared after one confirmation"; spec/app/websiteRequests.md, "A website's request is held only for the current page of the tab I am looking at"; spec/app/browser.md, "Back and Forward stay within the selected tab's history"; spec/app/browser.md, "A page that moves by itself keeps the address the person is typing"
import { type Rect, Machine as PageLayers, canDraw, canPlace, canRecreate, canRequestRouting, canSetHostVisible, canShow, noRect, pageRuns, pageShows, within } from "../gen/app__surface.effect.vibe"
import { type Tab, tabUrl } from "../gen/app__browser.effect.vibe"
import { type Event, Machine as Workspaces, Rejected, type Workspace, canChangePage, canUnexpectedPage } from "../gen/app__workspace.effect.vibe"
import type { BrowserInput } from "../gen/app__browserControls.effect.vibe"
import { type AndroidOutcome, type Event as WebsiteEvent, Machine as WebsiteRequests, Rejected as RequestRejected, type WebsiteActor, type WebsiteReply, canFollowView, opensElsewhere } from "../gen/app__websiteRequests.effect.vibe"
import { type Corners, NativePage, type PageEvent } from "./nativePage.vibe"
import { PageId, type RequestKey } from "./nativePage.schema.ts"
import { webView } from "./surfacePlugin.ts"

type Measured = { page: Rect; corners: Corners; controls: Rect[] }

type Control = { show: (drawn: boolean) => void; rect: Rect | undefined; at: Rect | undefined }

export service PageHost {
  website(event: WebsiteEvent): void!!
  closeBrowser(): void!Rejected
  readonly said: ReadonlyMap<number, string>
  watch(element: HTMLElement, part: Part): void!!
  unwatch(element: HTMLElement): void!!
}

export data Part {
  Area
  Control { show: (drawn: boolean) => void }
  Strip
}

const TAB_WIDTH = 240
const STRIP_SPARE = 140

function rectOf(element: Element, outward: boolean): Rect {
  const { left, top, right, bottom } = element.getBoundingClientRect()
  const [start, end] = outward ? [Math.floor, Math.ceil] : [Math.ceil, Math.floor]
  const x = start(left)
  const y = start(top)
  return { x, y, width: Math.max(0, end(right) - x), height: Math.max(0, end(bottom) - y) }
}

const sameRect = (a: Rect, b: Rect) => a.x === b.x && a.y === b.y && a.width === b.width && a.height === b.height
const sameRects = (a: Rect[], b: Rect[]) => a.length === b.length && a.every((r, i) => sameRect(r, b[i]))

function follow(controls: ReadonlyMap<HTMLElement, Control>, drawn: Rect[]) {
  const isDrawn = (rect: Rect | undefined) => rect !== undefined && drawn.some((r) => sameRect(r, rect))
  for (const [element, control] of controls) {
    const { rect, at } = control
    if (isDrawn(rect)) control.at = rect
    control.show(isDrawn(control.at))
    const held = rect !== undefined && at !== undefined && isDrawn(at) && !isDrawn(rect)
    element.style.transform = held ? `translate(${at.x - rect.x}px, ${at.y - rect.y}px)` : ""
    element.style.clipPath = held ? `inset(0 ${Math.max(0, rect.width - at.width)}px ${Math.max(0, rect.height - at.height)}px 0)` : ""
  }
}

function measure(area: HTMLElement | undefined, controls: ReadonlyMap<HTMLElement, Control>, drawn: Rect[], before: Measured): Measured {
  for (const element of controls.keys()) element.style.transform = element.style.clipPath = ""
  for (const [element, control] of controls) control.rect = element.isConnected ? rectOf(element, true) : undefined
  follow(controls, drawn)
  const style = area === undefined ? undefined : webView.window.getComputedStyle(area)
  return {
    page: area === undefined ? before.page : rectOf(area, false),
    corners: style === undefined ? before.corners : {
      topLeft: parseFloat(style.borderTopLeftRadius), topRight: parseFloat(style.borderTopRightRadius),
      bottomRight: parseFloat(style.borderBottomRightRadius), bottomLeft: parseFloat(style.borderBottomLeftRadius)
    },
    controls: placedRects(controls)
  }
}

function placedRects(controls: ReadonlyMap<HTMLElement, Control>): Rect[] {
  const placed = [...controls.values()].flatMap(({ rect, at }) => [rect, at]).filter((r) => r !== undefined)
  return placed.filter((r, i) => placed.findIndex((other) => sameRect(other, r)) === i).sort((a, b) => a.y - b.y || a.x - b.x)
}

const pageOf = (tab: number) => PageId.make(`tab-${tab}`)

type Held = { from: number; to: number }

type Page = { tab: Tab; held: Held; url: string; load: number | undefined; own: number | undefined; asked: { version: number; url: string }[] }

type Request = { page: PageId; key: RequestKey }

data Signal {
  Woken
  Heard { event: PageEvent }
  Person { event: WebsiteEvent }
  ClosedBrowser
  Visible { visible: boolean }
  Android { request: number; verdict: AndroidOutcome }
  Purged { clean: boolean }
}

const sameHistory = (a: Tab, b: Tab) => a.history.length === b.history.length && a.history.every((url, i) => url === b.history[i])

const holds = (held: Held, cursor: number) => cursor >= held.from && cursor <= held.to

const samePast = (before: Tab, after: Tab) => before.history.slice(0, before.cursor + 1).every((url, i) => url === after.history[i])

function track(page: Page, tab: Tab) {
  const { held, tab: before } = page
  page.held = sameHistory(before, tab) && holds(held, tab.cursor) ? held
    : tab.cursor === before.cursor + 1 && samePast(before, tab) ? { from: held.from, to: tab.cursor }
    : { from: tab.cursor, to: tab.cursor }
  page.tab = tab
}

effect function warn(what: string, page: PageId | undefined, cause: unknown) {
  try annotateLogs(logWarning(what, cause), { page: page ?? "every page" })
}

effect function present(native: NativePage.Shape, pages: ReadonlyMap<PageId, Page>, paused: Set<PageId>, presented: PageId | null | undefined, selected: number | undefined, runs: boolean) {
  const id = selected !== undefined && pages.has(pageOf(selected)) ? pageOf(selected) : null
  for (const page of pages.keys()) {
    const run = runs && page === id
    if (run === paused.has(page)) (run ? native.resume(page) : native.pause(page)) catch effect (cause) => try warn(run ? "resume" : "pause", page, cause)
    if (run) paused.delete(page)
    else paused.add(page)
  }
  if (id !== presented) native.present(id) catch effect (cause) => try warn("present", id ?? undefined, cause)
  return id
}

effect function watchPage(layer: PageLayers.Shape, onMeasured: () => void!!) {
  const controls = new Map<HTMLElement, Control>()
  let area: HTMLElement | undefined = undefined
  let stripWidth = 0
  let measured: Measured = { page: noRect, corners: { topLeft: 0, topRight: 0, bottomRight: 0, bottomLeft: 0 }, controls: [] }
  const frames = Experimental.Animations.make({
    requestAnimationFrame: (callback) => webView.window.requestAnimationFrame(callback),
    cancelAnimationFrame: (id) => webView.window.cancelAnimationFrame(id),
    now: () => webView.window.performance.now(),
    querySelector: (selector) => webView.document.querySelector(selector)
  })
  const moved = try Queue.unbounded<void>()
  const remeasure = () => { Queue.offerUnsafe(moved, undefined) }
  const resized = new webView.window.ResizeObserver(remeasure)
  const stripResized = new webView.window.ResizeObserver(([entry]) => {
    stripWidth = entry.contentRect.width
    remeasure()
  })
  try addFinalizer(() => sync(() => { resized.disconnect(); stripResized.disconnect() }))
  const moves = ["resize", "transitionend", "transitioncancel", "animationend"].map((name) => Stream.fromEventListener(webView.window, name, { capture: true }))
  try fork.scoped Stream.runForEach(Stream.mergeAll(moves, { concurrency: "unbounded" }), () => sync(remeasure))
  try fork.scoped Stream.runForEach(Stream.changesWith(Stream.map(layer.changes, (l) => l.drawn), sameRects), () => sync(remeasure))
  try fork.scoped effect {
    while (true) {
      try Queue.takeAll(moved)
      try frames.nextFrame
      try Queue.clear(moved)
      measured = measure(area, controls, (try layer.get()).drawn, measured)
      try onMeasured()
    }
  }

  function watch(element: HTMLElement, part: Part) {
    switch (part._tag) {
      case "Area": {
        area = element
        return resized.observe(element)
      }
      case "Control": {
        controls.set(element, { show: part.show, rect: undefined, at: undefined })
        return resized.observe(element)
      }
      case "Strip": return stripResized.observe(element)
      default: {
        const unwatched: never = part
        return unwatched
      }
    }
  }

  function unwatch(element: HTMLElement) {
    controls.delete(element)
    if (area === element) area = undefined
    resized.unobserve(element)
    stripResized.unobserve(element)
  }

  return {
    get measured() { return measured },
    get stripWidth() { return stripWidth },
    follow: (drawn: Rect[]) => follow(controls, drawn),
    effect watch(element: HTMLElement, part: Part) {
      watch(element, part)
      remeasure()
    },
    effect unwatch(element: HTMLElement) {
      unwatch(element)
      measured = { ...measured, controls: placedRects(controls) }
      remeasure()
    }
  }
}

effect function report(workspace: Workspaces.Shape, event: Event) {
  workspace.send(event, "Host") catch effect (error) => match (error) {
    when Rejected: undefined;
  }
}

effect function resizeTabs(workspace: Workspaces.Shape, w: Workspace, stripWidth: number) {
  if (stripWidth <= 0) return
  const resize: BrowserInput = { tag: "ResizeTabs", revision: w.browser.revision, capacity: Math.max(1, Math.floor((stripWidth - STRIP_SPARE) / TAB_WIDTH)) }
  if (resize.capacity !== w.browser.capacity && canChangePage(w, resize, "Host")) try report(workspace, { type: "changePage", browserInput: resize })
}

const goesElsewhere = (page: Page, url: string | undefined): url is string => url !== undefined && url !== "" && url !== page.url

effect function moved(workspace: Workspaces.Shape, page: Page, tab: number, url: string) {
  page.url = url
  const before = try workspace.get()
  const shown = before.browser.tabs.find((t) => t.id === tab)
  const superseded = shown?.load === "Loading" && shown.loadVersion === page.own
  if (shown !== undefined && (shown.load !== "Loading" || superseded) && url !== tabUrl(shown)) {
    const unexpected = { id: tab, revision: before.browser.revision, loadVersion: page.load ?? -1, destination: url }
    try report(workspace, canUnexpectedPage(before, unexpected, "Host") ? { type: "unexpectedPage", unexpected } : { type: "unwatchedPage", unexpected })
    const after = (try workspace.get()).browser.tabs.find((t) => t.id === tab)
    if (after !== undefined && after.loadVersion !== shown.loadVersion) {
      page.own = after.loadVersion
      if (superseded) {
        page.tab = after
        page.held = { from: after.cursor, to: after.cursor }
      }
    }
  }
  const now = (try workspace.get()).browser.tabs.find((t) => t.id === tab)
  if (now !== undefined && url === tabUrl(now) && (page.asked.length === 0 || page.asked.at(-1)?.version === now.loadVersion)) {
    page.load = now.loadVersion
    page.asked = []
  }
}

effect function changed(workspace: Workspaces.Shape, page: Page, tab: number, event: Extract<PageEvent, { _tag: "Changed" }>) {
  if (goesElsewhere(page, event.url)) try moved(workspace, page, tab, event.url)
  const now = (try workspace.get()).browser.tabs.find((t) => t.id === tab)
  if (now !== undefined && !event.loading && now.load === "Loading" && page.load === now.loadVersion)
    try report(workspace, { type: "receiveLoad", loadReport: { id: tab, version: now.loadVersion, result: event.result } })
}

effect function step(native: NativePage.Shape, page: Page, tab: Tab, close: (tab: number) => void!!) {
  const id = pageOf(tab.id)
  if (page.load === tab.loadVersion) return track(page, tab)
  const direction = sameHistory(tab, page.tab) ? Math.sign(tab.cursor - page.tab.cursor) : undefined
  if (direction !== undefined && direction !== 0 && page.asked.length > 0) return
  const next = direction !== undefined && page.tab.cursor + direction !== tab.cursor ? { ...tab, cursor: page.tab.cursor + direction, loadVersion: -1 } : tab
  const inPage = direction === 0 || (direction !== undefined && holds(page.held, next.cursor))
  const to = inPage ? next : tab
  const command = !inPage ? native.navigate(id, tabUrl(to)) : direction === -1 ? native.back(id) : direction === 1 ? native.forward(id) : native.reload(id)
  page.asked.push({ version: to.loadVersion, url: direction === 0 ? page.url : tabUrl(to) })
  track(page, to)
  command catch effect (cause) => { try warn("follow", id, cause); try close(tab.id) }
}

export const pageHost = Layer.effect(PageHost, effect {
  const workspace = try Workspaces
  const layer = try PageLayers
  const native = try NativePage
  const requests = try WebsiteRequests
  const scope = try Scope.Scope
  const asked = new Map<number, Request>()
  const said = new Map<number, string>()
  const forget = (id: number) => { asked.delete(id); said.delete(id) }
  const saving = new Map<number, Request>()
  const signals = try Queue.unbounded<Signal>()
  const pages = new Map<PageId, Page>()
  const unmade = new Map<number, number>()
  const measurer = try watchPage(layer, () => Queue.offer(signals, Signal.Woken()))
  let presented: PageId | null | undefined = null
  const paused = new Set<PageId>()
  const ended: AndroidOutcome = "AndroidEnded"

  effect function website(event: WebsiteEvent, by: WebsiteActor) {
    const result = requests.send(event, by) catch (error) => match (error) {
      when RequestRejected: undefined;
    }
    if (result !== undefined) for (const reply of result.out) try answer(reply)
    return result
  }
  effect function answer(reply: WebsiteReply): void!! {
    const request = asked.get(reply.request)
    if (request === undefined) return
    if (reply.answer === "AskAndroid") {
      try fork.in(scope) effect {
        const verdict = native.grant(request.page, request.key) catch effect (failed) => {
          try warn("grant", request.page, failed)
          return ended
        }
        try Queue.offer(signals, Signal.Android({ request: reply.request, verdict }))
      }
      return
    }
    forget(reply.request)
    const done = Effect.as(native.reply({ id: request.page, key: request.key, ask: reply.ask, answer: reply.answer, text: reply.text }), true) catch effect (cause) => {
      if (reply.answer === "SaveDownload" || opensElsewhere(reply.answer) || reply.answer === "Allowed") try warn("reply", request.page, cause)
      return false
    }
    if (reply.answer === "SaveDownload") {
      if (done) saving.set(reply.request, request)
      else try website({ type: "finishDownload", id: reply.request, saved: false }, "WebsiteHost")
    }
    if (opensElsewhere(reply.answer)) try website({ type: "finishOpening", id: reply.request, opened: done }, "WebsiteHost")
  }

  effect function syncRequests() {
    const w = try workspace.get()
    const view = { shown: pageShows(w.device, w.assistant), selected: w.browser.selected, paused: !pageRuns(try layer.get()) }
    if (canFollowView(try requests.get(), view, "WebsiteHost")) try website({ type: "followView", view }, "WebsiteHost")
    if (w.device.surface !== "DeviceSettings" && (try requests.get()).clearing === "ConfirmingClear") try website({ type: "settingsClosed" }, "WebsiteHost")
  }

  effect function place(id: PageId) {
    native.place(id, measurer.measured.page, measurer.measured.corners) catch effect (cause) => try warn("place", id, cause)
  }

  effect function unsaved(page: PageId | undefined) {
    for (const [id, request] of [...saving]) if (page === undefined || request.page === page) {
      saving.delete(id)
      try website({ type: "finishDownload", id, saved: false }, "WebsiteHost")
    }
  }

  effect function close(tab: number) {
    const id = pageOf(tab)
    pages.delete(id)
    paused.delete(id)
    if (presented === id) presented = undefined
    native.destroy(id) catch effect (cause) => try warn("destroy", id, cause)
    try unsaved(id)
    if ((try requests.get()).tabs.includes(tab)) try website({ type: "closeTab", tab }, "WebsiteHost")
  }

  effect function clearBrowsingData() {
    const former = [...pages.keys()]
    pages.clear()
    paused.clear()
    presented = undefined
    try unsaved(undefined)
    try fork.in(scope) effect {
      const clean = native.purge() catch effect (cause) => { try warn("purge", undefined, cause); return false }
      if (!clean) for (const id of former) native.destroy(id) catch effect (cause) => try warn("destroy", id, cause)
      try Queue.offer(signals, Signal.Purged({ clean }))
    }
  }

  effect function open(tab: Tab, shown: boolean) {
    const id = pageOf(tab.id)
    if (unmade.get(tab.id) === tab.loadVersion) return
    const made = Effect.as(native.create(id, tabUrl(tab)), true) catch effect (cause) => { try warn("create", id, cause); return false }
    if (!made) {
      if (tab.load !== "Loading") return
      unmade.set(tab.id, tab.loadVersion)
      try report(workspace, { type: "receiveLoad", loadReport: { id: tab.id, version: tab.loadVersion, result: "LoadFailed" } })
      return
    }
    unmade.delete(tab.id)
    pages.set(id, { tab, held: { from: tab.cursor, to: tab.cursor }, url: "", load: undefined, own: undefined, asked: [{ version: tab.loadVersion, url: tabUrl(tab) }] })
    presented = undefined
    try place(id)
    const l = try layer.get()
    if (!canRecreate(l)) return
    if (shown) try Effect.orDie(layer.send({ type: "recreate" }))
    else native.route(id, l.routed) catch effect (cause) => { try warn("route", id, cause); try close(tab.id) }
  }

  effect function syncTabs() {
    const w = try workspace.get()
    const tabs = w.browser.tabs
    for (const { tab } of [...pages.values()]) if (!tabs.some((t) => t.id === tab.id)) try close(tab.id)
    for (const id of [...unmade.keys()]) if (!tabs.some((t) => t.id === id)) unmade.delete(id)
    const purging = (try requests.get()).clearing === "Purging"
    for (const tab of tabs) {
      const page = pages.get(pageOf(tab.id))
      if (page === undefined) { if (tabUrl(tab) !== "" && !purging) try open(tab, tab.id === w.browser.selected && pageShows(w.device, w.assistant)) }
      else if (tabUrl(tab) === "") try close(tab.id)
      else if (tab.loadVersion !== page.tab.loadVersion) try step(native, page, tab, close)
      else track(page, tab)
    }
  }

  effect function reconcile() {
    while (true) {
      try syncTabs()
      try resizeTabs(workspace, try workspace.get(), measurer.stripWidth)
      const w = try workspace.get()
      let l = try layer.get()
      if (canPlace(l, measurer.measured.page)) {
        l = try Effect.orDie(layer.send({ type: "place", page: measurer.measured.page }))
        for (const id of pages.keys()) try place(id)
      }
      const visible = pageShows(w.device, w.assistant)
      if (canShow(l, w.device, w.assistant)) l = try Effect.orDie(layer.send({ type: "show", s: w.device, a: w.assistant }))
      presented = try present(native, pages, paused, presented, visible ? w.browser.selected : undefined, pageRuns(l))
      try syncRequests()
      const drawable = measurer.measured.controls.filter((r) => (!l.routingReady || within([r], l.routed)) && (!l.pending || within([r], l.requested)))
      if (canDraw(l, drawable)) {
        l = try Effect.orDie(layer.send({ type: "draw", rects: drawable }))
        measurer.follow(l.drawn)
      }
      const wanted = measurer.measured.controls
      const settled = l.routingReady && within(l.routed, wanted) && within(wanted, l.routed)
      if (l.pending || settled || !canRequestRouting(l, wanted)) return
      const routing = try Effect.orDie(layer.send({ type: "requestRouting", rects: wanted }))
      for (const [id, { tab }] of [...pages]) native.route(id, wanted) catch effect (cause) => {
        try warn("route", id, cause)
        try close(tab.id)
      }
      try Effect.orDie(layer.send({ type: "acknowledgeRouting", version: routing.version }))
    }
  }

  effect function raise(tab: number, event: Extract<PageEvent, { _tag: "Asked" }>) {
    try syncRequests()
    const id = (try requests.get()).nextId
    asked.set(id, { page: event.id, key: event.key })
    said.set(id, event.said)
    const report = { tab, ask: event.ask, fromTap: true, topFrame: event.topFrame }
    if ((try website({ type: "raise", report }, "WebsiteHost")) !== undefined) return
    forget(id)
    native.reply({ id: event.id, key: event.key, ask: event.ask, answer: "Refused", text: "" }) catch effect (cause) => try warn("refuse", event.id, cause)
  }

  const numberOf = (requests: ReadonlyMap<number, Request>, page: PageId, key: RequestKey) => [...requests].find(([, r]) => r.page === page && r.key === key)?.[0]

  effect function started(page: Page, tab: number, url: string | undefined) {
    const unasked = page.asked.length === 0
    const at = page.asked.findLastIndex((a) => a.url === url)
    page.load = page.asked.splice(0, at + 1 || 1).at(-1)?.version ?? page.load
    if (unasked && goesElsewhere(page, url)) try moved(workspace, page, tab, url)
    const now = (try workspace.get()).browser.tabs.find((t) => t.id === tab)
    if (now !== undefined && now.loadVersion !== page.tab.loadVersion) try step(native, page, now, close)
    try website({ type: "pageStarted", tab }, "WebsiteHost")
  }

  effect function hear(event: PageEvent) {
    const page = pages.get(event.id)
    if (page === undefined) return
    const tab = page.tab.id
    switch (event._tag) {
      case "Crashed": return try close(tab)
      case "Started": return try started(page, tab, event.url)
      case "Asked": return try raise(tab, event)
      case "Changed": return try changed(workspace, page, tab, event)
      case "Downloaded": {
        const id = numberOf(saving, event.id, event.key)
        if (id === undefined) return
        saving.delete(id)
        return try website({ type: "finishDownload", id, saved: event.saved }, "WebsiteHost")
      }
      case "Withdrawn": {
        const id = numberOf(asked, event.id, event.key)
        if (id !== undefined) try website({ type: "withdrawPermission", id }, "WebsiteHost")
        return
      }
      default: {
        const unheard: never = event
        return unheard
      }
    }
  }

  effect function apply(signal: Signal) {
    switch (signal._tag) {
      case "Woken": return
      case "Heard": return try hear(signal.event)
      case "Person": {
        const result = try website(signal.event, "WebsitePerson")
        if (result !== undefined && signal.event.type === "answerClearBrowsingData" && signal.event.confirmed) try clearBrowsingData()
        return
      }
      case "ClosedBrowser": return try website({ type: "closeBrowser" }, "WebsiteHost")
      case "Visible": {
        if (canSetHostVisible(try layer.get(), signal.visible)) try Effect.orDie(layer.send({ type: "setHostVisible", visible: signal.visible }))
        return
      }
      case "Purged": return try website({ type: "purgeFinished", clean: signal.clean }, "WebsiteHost")
      case "Android": {
        forget(signal.request)
        try website({ type: "androidAnswered", id: signal.request, verdict: signal.verdict }, "WebsiteHost")
        return
      }
      default: {
        const unapplied: never = signal
        return unapplied
      }
    }
  }

  native.claim() catch effect (cause) => try warn("claim", undefined, cause)
  const visibility = Stream.map(Stream.concat(Stream.make(undefined), Stream.fromEventListener(webView.document, "visibilitychange")), () => Signal.Visible({ visible: !webView.hidden() }))
  try fork.scoped Stream.runForEach(workspace.changes, () => Queue.offer(signals, Signal.Woken()))
  try fork.scoped Stream.runForEach(native.events, (event) => Queue.offer(signals, Signal.Heard({ event })))
  try fork.scoped Stream.runForEach(visibility, (signal) => Queue.offer(signals, signal))
  try fork.scoped effect {
    while (true) {
      for (const signal of try Queue.takeAll(signals)) try apply(signal)
      try reconcile()
    }
  }
  return {
    effect website(event: WebsiteEvent) {
      try Queue.offer(signals, Signal.Person({ event }))
    },
    effect closeBrowser() {
      try workspace.send({ type: "closeBrowser" }, "Person")
      try Queue.offer(signals, Signal.ClosedBrowser())
    },
    said,
    watch: measurer.watch,
    unwatch: measurer.unwatch
  }
})
