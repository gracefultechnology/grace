// spec/app/conversation.md, "Responses have a written equivalent and only current callbacks change the turn"; spec/app/preferences.md, "Undo restores the last setting choice without changing the microphone"
import type { Refusal } from "../gen/app__agentActions.effect.vibe"
import { brightnessChoice, type DisplayPreferences, muteChoice, volumeChoice } from "../gen/app__preferences.effect.vibe"
import type { Request } from "../gen/app__request.effect.vibe"
import type { Event, Workspace, WorkspaceActor } from "../gen/app__workspace.effect.vibe"
import type { Action } from "./reply.schema.ts"

export type GraceAction = typeof Action.Type
export type Outcome = "Applied" | "NotYetAvailable" | "NotFound" | Refusal
export type Applied = { readonly action: GraceAction; readonly outcome: Outcome }

export service Agent { apply(actions: readonly GraceAction[], request: Request): readonly Applied[]!! }

export type Step = { readonly event: Event; readonly by: WorkspaceActor }

const asPerson = (event: Event): Step => ({ event, by: "Person" })
const preview = (settings: DisplayPreferences) => [asPerson({ type: "changePreferences", settings })]

/** What Grace's action asks of the workspace alone, as the person's own events; undefined where it is not the workspace's. */
export function workspaceSteps(action: GraceAction, w: Workspace): readonly Step[] | undefined {
  const session = w.preferences.session
  return match (action) {
    when { kind: "open", let surface }: [asPerson({ type: "visit", destination: surface })];
    when { kind: "setTextSize", let size }: preview({ ...session, textSize: size });
    when { kind: "setPace", let pace }: preview({ ...session, pace });
    when { kind: "setVolume", let volume }: preview(volumeChoice(session, volume));
    when { kind: "setMuted", let muted }: preview(muteChoice(session, muted));
    when { kind: "setBrightness", let brightness }: preview(brightnessChoice(session, brightness));
    when { kind: "setVoiceOutput", let on }: preview({ ...session, voiceOutput: on });
    when { kind: "undoSetting" }: [asPerson({ type: "undoPreferences" })];
    default: undefined;
  }
}

/** Opening a Settings page, as the person's taps on Settings and then the page. */
export const settingSteps = (page: Extract<Event, { type: "chooseSettingsPage" }>["page"], w: Workspace): readonly Step[] => [
  ...w.device.surface === "DeviceSettings" ? [] : [asPerson({ type: "visit", destination: "DeviceSettings" })],
  asPerson({ type: "chooseSettingsPage", page })
]

export const visitSteps = (destination: Extract<Event, { type: "visit" }>["destination"], w: Workspace): readonly Step[] =>
  w.device.surface === destination ? [] : [asPerson({ type: "visit", destination })]
