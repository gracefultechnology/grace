// Gmail and Google Calendar on Eliza Cloud's own Google routes. Upstream follow-up: the cloud does not yet serve Gmail drafts, contacts,
// a send lookup by Idempotency-Key, mark-unread and purge operations, client-chosen event ids, event metadata, or a provider sign-in session; the test fake does.
import type { Routes } from "./connector.vibe"

export const google: Routes = {
  slug: "google",
  accounts: "/api/v1/eliza/google/accounts",
  mail: "/api/v1/eliza/google/gmail",
  calendar: "/api/v1/eliza/google/calendar"
}
