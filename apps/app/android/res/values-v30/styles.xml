<resources>
 <!-- shortEdges (values/styles.xml) letterboxes a cutout on a long edge, a tablet held in
      landscape; API 30's always draws the full-screen window under every cutout. -->
 <style name="AppTheme" parent="BaseTheme">
  <item name="android:windowLayoutInDisplayCutoutMode">always</item>
 </style>
</resources>
