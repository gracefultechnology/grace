<?xml version="1.0" encoding="utf-8"?>
<!-- An ordinary app leaves Wi-Fi to the system: no Wi-Fi permission, though upstream WiFiPlugin's
     library manifest declares them (launcher/AndroidManifest.xml). Location stays: websites ask for
     it (../AndroidManifest.xml). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
 <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
 <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" tools:node="remove" />
</manifest>
