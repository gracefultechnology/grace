{
  "schema": 1,
  "sdk": { "min": 29, "target": 36, "compile": 36 },
  "releaseMinify": true,
  "buildTypes": {
    "release": { "proguardFiles": [{ "root": "consumer", "path": "android/proguard-rules.pro" }] }
  },
  "kotlin": true,
  "nativeLibraries": "extract-16k",
  "embeddedAgent": {
    "host": { "root": "consumer", "path": "artifacts/agent/host.json" },
    "character": { "root": "consumer", "path": "agent/character.json" },
    "policy": { "root": "consumer", "path": "artifacts/agent/policy.json" }
  },
  "modules": [
    { "name": "capacitor-android", "source": { "root": "dependencies", "path": "capacitor" } },
    { "name": "eliza-browser-surface", "source": { "root": "upstream", "path": "packages/os/android/browser-surface" } },
    { "name": "elizaos-capacitor-passwords", "source": { "root": "upstream", "path": "packages/os/android/passwords" } },
    { "name": "eliza-wifi", "source": { "root": "upstream", "path": "packages/os/android/wifi" } },
    { "name": "eliza-reminders", "source": { "root": "upstream", "path": "packages/os/android/reminders" } }
  ],
  "signing": { "storeFile": "GRACE_KEYSTORE", "storePassword": "GRACE_KEYSTORE_PASSWORD", "keyAlias": "GRACE_KEY_ALIAS", "keyPassword": "GRACE_KEY_PASSWORD" },
  "manifest": { "root": "consumer", "path": "android/AndroidManifest.xml" },
  "flavors": [
    {
      "name": "standalone",
      "buildConfigFields": [{ "name": "IS_LAUNCHER", "type": "boolean", "value": false }],
      "manifest": { "root": "consumer", "path": "android/standalone/AndroidManifest.xml" }
    },
    {
      "name": "launcher",
      "buildConfigFields": [{ "name": "IS_LAUNCHER", "type": "boolean", "value": true }],
      "manifest": { "root": "consumer", "path": "android/launcher/AndroidManifest.xml" }
    }
  ],
  "sourceSets": {
    "androidTest": { "java": [{ "root": "consumer", "path": "test/android" }] },
    "main": {
      "java": [{ "root": "consumer", "path": "android/java" }],
      "res": [{ "root": "consumer", "path": "android/res" }]
    }
  },
  "dependencies": [
    { "configuration": "implementation", "module": "androidx.appcompat:appcompat", "toolchainVersion": "androidxAppCompatVersion" },
    { "configuration": "implementation", "coordinate": "com.squareup.okhttp3:okhttp:5.3.2" },
    { "configuration": "implementation", "coordinate": "androidx.credentials:credentials:1.6.0" },
    { "configuration": "implementation", "coordinate": "androidx.credentials:credentials-play-services-auth:1.6.0" },
    { "configuration": "implementation", "coordinate": "com.google.android.libraries.identity.googleid:googleid:1.1.1" }
  ]
}
