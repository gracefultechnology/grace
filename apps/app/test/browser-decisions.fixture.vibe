// spec/app/workspace.md, "Story: Follow one reviewed plan across apps"
import { CLEF_DECISION_TIMEOUT_MS, createClefDecisionsClient } from "@elizaos/cloud/clef-decisions"
import type { application } from "../src/app.vibe"

export effect function decisionCloud(url: string, key: string): { host: NonNullable<Parameters<typeof application>[2]>; deadlineMs: number }!unknown {
  const choose = try Effect.try(() => createClefDecisionsClient({ baseUrl: url, headers: () => ({ Authorization: `Bearer ${key}` }) }))
  return { host: { url, key, guideDecision: (request, signal) => runPromise(tryPromise(() => choose(request, signal))) }, deadlineMs: CLEF_DECISION_TIMEOUT_MS }
}
