const refusals: Record<string, { status: number; body: object }> = {
  Unauthorized: { status: 401, body: { error: "unauthorized" } },
  Missing: { status: 404, body: { error: "The selected Google account or message is unavailable. Reconnect Google or refresh the selection.", code: "not_found" } },
  NoConnection: { status: 404, body: { error: "Google connection not found." } },
  NoOperation: { status: 404, body: { error: "Operation not found" } },
  Stale: { status: 412, body: { error: "The event changed since it was read. Read it again before changing it.", code: "precondition_failed" } },
  StaleRevision: { status: 409, body: { error: "Selected message changed; review its current labels", code: "stale_revision" } },
  ReviewChanged: { status: 409, body: { error: "Reviewed content or provider state changed", code: "stale_revision" } },
  DigestChanged: { status: 409, body: { error: "Review changed", code: "stale_revision" } },
  Rebound: { status: 409, body: { error: "Request ID is already bound to a different reviewed operation" } },
  SubjectMismatch: { status: 400, body: { error: "Reply subject must match the selected message", code: "reply_subject_mismatch" } },
  NoRecipient: { status: 400, body: { error: "At least one recipient is required to send" } },
  BadAddress: { status: 400, body: { error: "Use an unambiguous email address without a display name" } },
  ModeMismatch: { status: 400, body: { error: "Reply identity is not valid for this compose mode" } },
  NoParts: { status: 400, body: { error: "Explicit source attachment parts required" } },
  BadUpload: { status: 400, body: { error: "invalid_request" } },
  ProviderFailed: { status: 502, body: { error: "Google request failed." } },
  Reconnect: { status: 409, body: { error: "Reconnect Google to keep using Gmail.", code: "reauth_required" } },
  ConsentRequired: { status: 403, body: { error: "speech_consent_required" } },
  ProofInvalid: { status: 401, body: { success: false, error: "credential_proof_invalid", errorDescription: "Mobile credential proof is invalid", retryable: false } },
  SessionClosed: { status: 410, body: { error: "session_closed" } },
  Expired: { status: 409, body: { error: "Google connection is not active. Reconnect the selected account." } },
  Unavailable: { status: 503, body: { error: "unavailable" } },
  Unsupported: { status: 413, body: { error: "Supported PDF, image or TXT attachments must be at most 5 MiB" } }
}

