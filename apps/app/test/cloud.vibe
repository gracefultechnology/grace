// spec/app/accounts.md, "Story: Connect the email I already use"; spec/app/accounts.md, "Story: Choose what each email brings and take it off the tablet"; spec/app/email.md, "Story: Write or reply and confirm before sending"; spec/app/conversation.md, "Story: Talk or type without losing the conversation"

import { Base64Url } from "effect/encoding"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import policy from "../agent/policy.json" with { type: "json" }

type Attachment = { partId: string; attachmentId: string | null; filename: string; mimeType: string; size: number; pages?: number }

type Mail = {
  externalId: string
  threadId: string
  subject: string
  from: string
  fromEmail: string | null
  replyTo: string | null
  to: string[]
  cc: string[]
  bcc: string[]
  snippet: string
  receivedAt: string
  isUnread: boolean
  isImportant: boolean
  likelyReplyNeeded: boolean
  triageScore: number
  triageReason: string
  labels: string[]
  htmlLink: string | null
  metadata: { historyId: string; sizeEstimate: number | null; dateHeader: string | null; messageIdHeader: string; referencesHeader: string | null; listId: string | null; precedence: string | null; autoSubmitted: string | null }
  attachments: Attachment[]
  bodyText: string
  suspicion?: string
}

type Appointment = {
  externalId: string
  calendarId: string
  title: string
  description: string
  location: string
  status: string
  startAt: string
  endAt: string
  isAllDay: boolean
  timezone: string | null
  htmlLink: string | null
  conferenceLink: string | null
  etag: string
  organizer: Record<string, unknown> | null
  attendees: { email: string | null; displayName: string | null; responseStatus: string | null; self: boolean; organizer: boolean; optional: boolean }[]
  metadata: { etag: string; iCalUID: string | null; recurringEventId: string | null; createdAt: string | null; updatedAt: string | null }
  recurrence?: readonly string[]
  reminders?: typeof Reminders.Type
}

schema Turn { said: string; outcome: "streaming" | "completed" | "aborted" }

type Receipt = {
  requestId: string
  kind: Proposal["kind"]
  reviewDigest: string
  state: "prepared" | "dispatched" | "succeeded" | "rejected" | "outcome-unknown"
  providerResult: Record<string, unknown> | null
  rejectionCode: string | null
  createdAt: string
  dispatchedAt: string | null
  finishedAt: string | null
}

type Slug = "google" | "outlook" | "yahoo" | "icloud" | "aol" | "other"
type Contact = { name: string; email: string }

type Box = {
  provider: Slug
  address: string
  grantId: string
  expired: boolean
  mail: Mail[]
  calendar: Appointment[]
  contacts: Contact[]
}

type GoogleConsent = { state: string; address: string; token: string; expiresAt: number; used: boolean }
type Session = { sessionId: string; provider: Slug; loginHint: string; status: "pending" | "allowed" | "cancelled" | "refused"; address: string }

type Account = {
  key: string
  credentialId: string
  code: string
  expiresAt: string
  acknowledged: boolean
  boxes: Box[]
  sessions: Session[]
  outage: boolean
  mailFault?: Outage["mailFault"]
  calendarFault?: Outage["calendarFault"]
  calendarCreateRequests: number
  sendLookups: string[]
  script: Scripted[]
  decision?: ScriptedDecision
  turns: (Turn & { id: number; context: string })[]
  changes: { receipt: Receipt; proposal: Proposal; grantId: string }[]
  consents: string[]
  googleRequests: string[]
  speech: { sessionId: string; token: string; expiresAt: string; opened: boolean }[]
}

const Uuid = Schema.String.check(Schema.isUUID())

const between = (min: number, max: number) => Schema.String.check(Schema.isMinLength(min), Schema.isMaxLength(max))
const ClientId = between(1, 200)
const Environment = between(1, 50)
const State = between(1, 256)
const Verifier = between(43, 128)
const Proof = between(1, 256)
const Secret = between(1, 512)
const DeviceName = between(1, 80)
const IdToken = between(20, 8192)
const ChallengeId = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{43}$/))
const ServerAuthCode = between(10, 2048).check(Schema.isPattern(/^[A-Za-z0-9/_.~-]+$/))
const Url = between(1, 2000).check(Schema.makeFilter((s: string) => URL.canParse(s)))
const mailbox = /^[A-Za-z0-9.!#$%&'*+\-/=?^_`{|}~]+@[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,63}$/
const Filled = Schema.String.check(Schema.makeFilter((s: string) => s.trim() !== ""))
const Mailbox = Schema.String.check(Schema.isPattern(mailbox))
const Instant = Schema.String.check(Schema.makeFilter((s: string) => !Number.isNaN(Date.parse(s))))
const Slugs = Schema.Literals(["google", "outlook", "yahoo", "icloud", "aol", "other"])

schema Steward { clientId: ClientId; challengeId: ChallengeId; idToken: IdToken; codeVerifier: Verifier }
schema SignIn { clientId: ClientId; environment: Environment; redirectUri: Url; state: State; codeVerifier: Verifier; deviceName?: DeviceName; steward: Steward; serverAuthCode?: ServerAuthCode }
schema Acknowledgement { clientId: ClientId; environment: Environment; redirectUri: Url; code: Proof; state: State; codeVerifier: Proof; credentialId: Uuid; secret: Secret }
schema ChatMessage { role: string; content: string }
schema ChatRequest { model: Filled; messages: ChatMessage[]; stream?: boolean; response_format?: { type: string } }
schema Change { kind: "trash" | "untrash" | "mark-read" | "mark-unread" | "purge"; messageId: string; expectedHistoryId: string }
schema Forwarded { messageId: string; historyId: string; partIds: string[] }
schema Uploaded { name: string; mimeType: string; dataBase64: string }
schema Outgoing { kind: "send"; mode: "compose" | "reply" | "reply-all" | "forward"; to?: string[]; cc?: string[]; bcc?: string[]; subject: string; bodyText: string; replyMessageId?: string; attachments?: Uploaded[]; forwardAttachments?: Forwarded }
schema Proposal = Change | Outgoing
schema Prepare { grantId: Uuid; requestId: Uuid; proposal: Proposal }
schema Dispatch { grantId: Uuid; reviewDigest: string; proposal: Proposal }
schema Attendee { email: Mailbox; displayName?: Filled; optional?: boolean }
schema Reminder { method: "popup" | "email"; minutes: number }
schema Reminders { useDefault: boolean; overrides?: Reminder[] }
schema NewAppointment { side?: "owner" | "agent"; grantId?: Filled; calendarId?: Filled; title: Filled; description?: string; location?: string; startAt: Instant; endAt: Instant; timeZone: Filled; attendees?: Attendee[]; recurrence?: Filled[]; reminders?: Reminders }
schema AppointmentChange { side?: "owner" | "agent"; grantId?: Filled; calendarId?: Filled; title?: Filled; description?: string; location?: string; startAt?: Instant; endAt?: Instant; timeZone?: Filled; attendees?: Attendee[] }
schema Selected { grantId: Uuid }
schema FeedQuery { timeMin: Instant; timeMax: Instant; grantId?: string; calendarId?: string; timeZone?: string }
schema MessageQuery { messageId: string; grantId?: string }
schema AttachmentQuery { grantId?: string; messageId: string; partId: string; historyId: string; opaque?: "1" }
schema DraftQuery { grantId?: string; draftId: string; content?: "1" }
schema DraftsQuery { grantId?: string; pageToken?: string }
schema SearchQuery { query: string; grantId?: string; maxResults?: string }
schema ContactQuery { query: string; grantId?: string }
schema RemovalQuery { side?: "owner" | "agent"; grantId?: string; calendarId?: Filled }
schema AccountsQuery { side?: string }
schema Carried { kind: "Pdf" | "Photo"; name: string; origin: string; account: string; sourceRef: string; contentRef: string; pages: number }
schema DraftBody { grantId?: string; draftId?: string; to: string[]; cc?: string[]; bcc?: string[]; subject: string; bodyText: string; attachments?: Carried[] }
schema SentMail { subject: string; labels: string[]; bcc: string[]; attachments: { filename: string }[] }
schema SentBox { mail: SentMail[] }
schema Boxes { boxes: SentBox[] }
schema SessionStart { loginHint?: string }
schema PageChoice { address: string; choice: "allow" | "cancel" | "unfinished" }
schema OtherConnect { address: string; password: string; incoming?: string; outgoing?: string }
schema IncomingMail { to: Mailbox; from: Filled; fromEmail: Mailbox; subject: string; body: string }
schema Expiry { address: string }
schema Outage { down: boolean; mailFault?: "dispatch" | "lookupMissing"; calendarFault?: "createResponse" | "beforeCreate" | "refuseCreate" | "reauthCreate" | "conflictCreate" }
schema ChatContext { includes: string[]; excludes: string[] }
schema Scripted { said?: string; context?: ChatContext; responseFormat?: "json_object"; answer: string }
schema ScriptedDecision { goalIncludes: Filled; labels: Filled[] }
schema Script { replies: Scripted[]; decision?: ScriptedDecision }
schema SessionQuery { sessionId: string }
schema GoogleAuthorization { state: Uuid; response_type: "code"; client_id: "grace-browser-fixture"; redirect_uri: Url; scope: Filled }
schema GoogleCallback { state: Uuid; code: Uuid }
schema GoogleTokenForm { code: Uuid; grant_type: "authorization_code"; client_id: "grace-browser-fixture"; redirect_uri: Url }
schema GoogleIdentity { email: Mailbox; email_verified: true }
schema GoogleToken { access_token: Filled }
schema GmailList { messages: { id: string; threadId: string }[] }
schema GmailQuery { q?: string; maxResults?: string }
schema GmailMessage { id: string; snippet: string; payload: { body: { data: string } } }
schema GoogleEventReferences { items: { id: string }[] }
schema GoogleEventReference { id: string }
schema GoogleEventTime { dateTime: Instant; timeZone: string }
schema GoogleEventBody { summary: Filled; description?: string; location?: string; start: GoogleEventTime; end: GoogleEventTime; attendees?: Attendee[]; recurrence?: Filled[]; reminders?: Reminders }
schema GoogleCalendarPath { calendar: Filled }
schema GoogleMailPath { message: Filled }
schema SpeechSession { consentNonce: Uuid }
schema Recorded { turns: Turn[] }
schema Shown { turns: { context: string }[] }
schema Credential { credentialId: string; secret: string; code: string }
schema Acknowledged { status: "acknowledged" }
schema Delta { content: string }
schema Choice { delta: Delta }
schema Chunk { choices: Choice[] }

const Frame = Schema.Union([
  Schema.Struct({ t: Schema.Literal("hello"), token: Schema.String, errorReasons: Schema.optionalKey(Schema.Literal(true)), timings: Schema.optionalKey(Schema.Literal(true)), extend: Schema.optionalKey(Schema.Literal(true)) }),
  Schema.Struct({ t: Schema.Literals(["prepare", "finish", "cancel"]), id: Schema.String }),
  Schema.Struct({ t: Schema.Literal("tts"), id: Schema.String, text: Schema.String, flush: Schema.optionalKey(Schema.Boolean) }),
  Schema.Struct({ t: Schema.Literal("stop") })
])

