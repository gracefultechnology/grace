// spec/app/surface.md, "Story: Use the website under Grace's controls"; spec/app/conversation.md, "Story: Talk or type without losing the conversation"; spec/app/accounts.md, "Story: Connect the email I already use"; spec/app/accounts.md, "Story: Choose what each email brings and take it off the tablet"; spec/app/email.md, "Story: Read an email and its original attachment"; spec/app/emailItem.md, "Story: Find and open the email I intend"; spec/app/emailItem.md, "Story: Delete a message and recover it safely"; spec/app/email.md, "Story: Write or reply and confirm before sending"; spec/app/email.md, "An email sent while offline waits in Outbox and goes once, by itself, when the tablet is back online"; spec/app/calendarView.md, "Story: Browse my calendar and open an exact occurrence"; spec/app/calendar.md, "Story: Add and correct an appointment or bill reminder"; spec/app/email.md, "A scam warning needs current evidence and holds that message's links"; spec/app/setup.md, "Story: Read the Google mail and calendar I connected"
import { assert, it } from "@effect/vitest"
import { Digest } from "effect/crypto"
import { ExperimentalNodeLocks } from "vibelang-runtime/experimental/platform-node"
import { inject } from "vitest"
import { Client } from "pg"
import { googleRequest } from "../../../vendor/eliza/packages/cloud/src/google.vibe"
import { approveSave, beginEdit, create, edit, initial as noEntry, save, saveFailed, type Calendar } from "../gen/app__calendar.effect.vibe"
import { canStoreCreated, initial as noView, storeCreated } from "../gen/app__calendarView.effect.vibe"
import type { Folder } from "../gen/app__emailItem.effect.vibe"
import { accountRequests, googleChanges, googleReads, googleRoute } from "../src/cloudRequests.vibe"
import { type AccountRef, Connector, connector, NeedsSignIn, secretPassword, SignInPage } from "../src/connector.vibe"
import { Stored } from "../src/connector.schema.ts"
import { client, expire, otherPassword, outage, parts, reply, script, sentMail, sessions, signIn, turns, unending, type Visit, visiting } from "./cloud.vibe"

const cloud = inject("cloud")
const site = inject("site")
const framedVisits = Layer.effectDiscard(effect {
  const page = try SignInPage
  const { shown } = try Connector
  try fork.scoped Stream.runForEach(shown, (at) => at?.inSheet === true ? page.open(at.url) : Effect.void)
})
const connectorAt = (key: string, visits: readonly Visit[] = [], opened?: Deferred.Deferred<string>) =>
  Layer.provideMerge(framedVisits, Layer.provideMerge(connector({ url: cloud, key }, Effect.provide(Experimental.Locks.Locks, ExperimentalNodeLocks.layer)), Layer.effect(SignInPage, visiting(visits, opened))))

schema Payment { amount: string; to: string }
schema Booking { time: string }

effect function status(url: string) {
  return (try HttpClient.get(url)).status
}

effect function kept<A>(url: string, entry: Schema.Codec<A>) {
  return try Schema.decodeUnknownEffect(Schema.Array(entry))(try (try HttpClient.get(url)).json)
}

effect function submit(url: string, form: Record<string, string>) {
  return (try HttpClient.execute(HttpClientRequest.bodyUrlParams(HttpClientRequest.post(url), form))).status
}

it.live("Use the website under Grace's controls: every page answers, and each visit sees only its own payments and bookings", () => effect {
  provide client {
    const [first, second] = [`${site}/${(try signIn(cloud)).credentialId}`, `${site}/${(try signIn(cloud)).credentialId}`]
    const pages = ["", "bill/", "bill/amount.html", "bill/review.html", "bill/confirmation.html", "booking/", "booking/booked.html", "confirm.html", "instruction.html", "statement.pdf"]
    const statuses: number[] = []
    for (const p of pages) statuses.push(try status(`${first}/${p}`))
    const outside = try status(`${site}/`)
    const submitted = [
      try submit(`${first}/bill`, { account: "1", password: "test" }),
      try submit(`${first}/pay`, { amount: "84.12", to: "Riverside Power" }),
      try submit(`${first}/pay`, { amount: "", to: "Riverside Power" }),
      try submit(`${second}/pay`, { amount: "25.00", to: "Riverside Power" }),
      try submit(`${first}/book`, { time: "2026-12-08T09:30" })
    ]
    const records = {
      first: { paid: try kept(`${first}/paid`, Payment), booked: try kept(`${first}/booked`, Booking) },
      second: { paid: try kept(`${second}/paid`, Payment), booked: try kept(`${second}/booked`, Booking) }
    }
    try Effect.try(() => assert.deepStrictEqual({ statuses, outside, submitted, records }, {
      statuses: pages.map(() => 200),
      outside: 404,
      submitted: [200, 200, 400, 200, 200],
      records: {
        first: { paid: [{ amount: "84.12", to: "Riverside Power" }], booked: [{ time: "2026-12-08T09:30" }] },
        second: { paid: [{ amount: "25.00", to: "Riverside Power" }], booked: [] }
      }
    }))
  }
})

it.live("Talk or type without losing the conversation: a turn streams to its end, and a stopped turn is aborted", () => effect {
  provide client {
    const key = (try signIn(cloud)).secret
    const said = "Hello Grace."
    const request = HttpClientRequest.post(`${cloud}/api/v1/chat/completions`).pipe(
      HttpClientRequest.bearerToken(key), HttpClientRequest.bodyJsonUnsafe({ messages: [{ role: "user", content: said }] })
    )
    const missingModel = (try HttpClient.execute(request)).status
    const whole = (try Stream.runCollect(try parts(cloud, key, said))).join("")
    try scoped(effect { try Stream.runHead(try parts(cloud, key, unending)) })
    try script(cloud, key, [{ answer: "Scripted." }])
    const scripted = (try Stream.runCollect(try parts(cloud, key, said))).join("")
    const recorded = try turns(cloud, key)
    try Effect.try(() => assert.deepStrictEqual({ missingModel, whole, scripted, recorded }, {
      missingModel: 400,
      whole: reply(said),
      scripted: "Scripted.",
      recorded: [{ said, outcome: "completed" }, { said: unending, outcome: "aborted" }, { said, outcome: "completed" }]
    }))
  }
})

const gmail: AccountRef = { provider: "Gmail", address: "owner@grace.test" }
const outlook: AccountRef = { provider: "Outlook", address: "margaret@outlook.com" }
const riverview: AccountRef = { provider: "OtherEmail", address: "margaret@riverview.net" }
const scope = (account: AccountRef, folder: Folder, query = "") => ({ owner: account.address, provider: account.provider, account: account.address, folder, query, generation: 1 })

effect function listed(account: AccountRef, folder: Folder, query = "") {
  const found = Stream.runCollect((try Connector).mail(account).list(scope(account, folder, query), () => 0)) catch (e) => e._tag
  return typeof found === "string" ? found : found.map((m) => m.content.subject)
}

effect function versionOf(account: AccountRef, folder: Folder, ref: string) {
  const found = try Stream.runCollect((try Connector).mail(account).list(scope(account, folder), () => 3))
  return found.find((m) => m.receipt.seed.identity.ref === ref)?.content.version ?? ""
}

it.live("Connect the email I already use: each company's own page answers with its outcome only, and an Other email is checked on its own servers", () => effect {
  provide client {
    const { secret } = try signIn(cloud)
    const visits = [{ choice: "allow", address: outlook.address }, { choice: "cancel" }, { choice: "unfinished", address: "margaret@aol.com" }] as const
    provide connectorAt(secret, visits) {
      const connector = try Connector
      const password = secretPassword(otherPassword)
      const pages = [
        try connector.signIn({ provider: "Outlook", attempt: 1, renewing: "" }),
        try connector.signIn({ provider: "Yahoo", attempt: 2, renewing: "" }),
        try connector.signIn({ provider: "Aol", attempt: 3, renewing: "" }),
        try connector.signIn({ provider: "OtherEmail", attempt: 4, renewing: "" })
      ]
      const checks = [
        try connector.connectOther({ attempt: 5, address: "margaret@yahoo.com", password }),
        try connector.connectOther({ attempt: 6, address: riverview.address, password: secretPassword("a guess") }),
        try connector.connectOther({ attempt: 7, address: riverview.address, password }),
        try connector.connectServers({ attempt: 8, address: riverview.address, password, incoming: "mail.riverview.net", outgoing: "smtp.riverview.net" })
      ]
      const inboxes = { outlook: try listed(outlook, "InboxFolder"), riverview: try listed(riverview, "InboxFolder"), yahoo: try listed({ provider: "Yahoo", address: "margaret@yahoo.com" }, "InboxFolder") }
      const all = { mail: true, calendar: true, contacts: true }
      const none = { mail: false, calendar: false, contacts: false }
      try Effect.try(() => assert.deepStrictEqual({ pages, checks, inboxes }, {
        pages: [
          { attempt: 1, outcome: "Allowed", address: outlook.address, granted: all },
          { attempt: 2, outcome: "Cancelled", address: "", granted: none },
          { attempt: 3, outcome: "Refused", address: "", granted: none },
          { attempt: 4, outcome: "Refused", address: "", granted: none }
        ],
        checks: [
          { attempt: 5, outcome: "OtherRefused", address: "margaret@yahoo.com" },
          { attempt: 6, outcome: "OtherPasswordRefused", address: riverview.address },
          { attempt: 7, outcome: "OtherNeedsServers", address: riverview.address },
          { attempt: 8, outcome: "OtherAllowed", address: riverview.address }
        ],
        inboxes: { outlook: ["Thanksgiving dinner sign-up"], riverview: ["Your November bill is ready"], yahoo: "NeedsSignIn" }
      }))
    }
  }
})

schema GoogleAccountSession { sessionId: string; pageUrl: string }
schema GoogleAccountGrant { connectionId: string; connected: boolean; identity: { email: string } }
schema GoogleAccess { access_token: string; token_type: "Bearer"; scope: string }
schema GoogleOwner { email: string; email_verified: true }
schema DeliveryReceipt { id: Schema.NonEmptyString }
schema MailSearchResult { messages: { externalId: string }[] }
schema MailReadResult { message: { externalId: string }; bodyText: string }

effect function googleSession(key: string) {
  const request = HttpClientRequest.post(`${cloud}/api/v1/eliza/connections/google/sessions`).pipe(
    HttpClientRequest.bearerToken(key), HttpClientRequest.bodyJsonUnsafe({ loginHint: "" })
  )
  return try Schema.decodeUnknownEffect(GoogleAccountSession)(try (try HttpClient.execute(request)).json)
}

effect function googleOwnerGrants(key: string) {
  const request = HttpClientRequest.bearerToken(HttpClientRequest.get(`${cloud}/api/v1/eliza/google/accounts?side=owner`), key)
  return try Schema.decodeUnknownEffect(Schema.Array(GoogleAccountGrant))(try (try HttpClient.execute(request)).json)
}

effect function googleCallback(pageUrl: string, address: string) {
  const request = HttpClientRequest.bodyUrlParams(HttpClientRequest.post(pageUrl), { address, choice: "allow" })
  provide FetchHttpClient.RequestInit = { redirect: "manual" } {
    const response = try HttpClient.execute(request)
    try Effect.try(() => assert.equal(response.status, 303))
    return try Effect.try(() => new URL(response.headers.location, cloud))
  }
}

effect function exchangeGoogle(code: string) {
  return try HttpClient.execute(HttpClientRequest.bodyUrlParams(HttpClientRequest.post(`${cloud}/token`), {
    code, client_id: "grace-browser-fixture", grant_type: "authorization_code", redirect_uri: `${cloud}/fake/google/callback`
  }))
}

it.live("Connect the email I already use: Google denies missing consent, reused codes, wrong owners and expired tokens", () => effect {
  provide client {
    const first = (try signIn(cloud, false)).secret
    const other = (try signIn(cloud, false)).secret
    const address = "owner@grace.test"
    const subject = "Delivery after consent"
    const body = "The appointment was moved to the north entrance."
    const deliver = (key: string, to: string) => HttpClient.execute(HttpClientRequest.post(cloud + "/fake/gmail/incoming").pipe(
      HttpClientRequest.bearerToken(key), HttpClientRequest.bodyJsonUnsafe({ to, from: "Reception", fromEmail: "desk@clinic.test", subject, body })
    ))
    const beforeLink = (try deliver(first, address)).status
    const denied = try googleSession(first)
    const cancelled = try submit(denied.pageUrl, { address, choice: "cancel" })
    const deniedSession = try sessions(cloud, first)
    const beforeConsent = try googleOwnerGrants(first)
    const pending = try googleSession(first)
    const different = try googleSession(other)
    const callback = try googleCallback(pending.pageUrl, address)
    const code = callback.searchParams.get("code") ?? ""
    const foreignState = `${callback.origin}${callback.pathname}?code=${code}&state=${different.sessionId}`
    const wrongState = try status(foreignState)
    const afterWrongState = try googleOwnerGrants(first)
    const consented = try status(callback.href)
    const replayedCallback = try status(callback.href)
    const replayedCode = (try exchangeGoogle(code)).status

    const [grant] = try googleOwnerGrants(first)
    const inbox = cloud + googleRoute + "gmail"
    const mail = `${inbox}/search?query=${encodeURIComponent(subject)}&grantId=${grant.connectionId}`
    const withKey = (url: string, key: string) => HttpClient.execute(HttpClientRequest.bearerToken(HttpClientRequest.get(url), key))
    const search = () => effect {
      const result = try withKey(mail, first)
      try Effect.try(() => assert.equal(result.status, 200))
      return try Schema.decodeUnknownEffect(MailSearchResult)(try result.json)
    }
    const beforeDelivery = try search()
    const wrongSenderAccount = (try deliver(other, address)).status
    const wrongRecipient = (try deliver(first, "other@grace.test")).status
    const delivery = try deliver(first, address)
    const { id } = try Schema.decodeUnknownEffect(DeliveryReceipt)(try delivery.json)
    const afterDelivery = try search()
    const read = `${inbox}/read?messageId=${encodeURIComponent(id)}&grantId=${grant.connectionId}`
    const ownerMessage = try Schema.decodeUnknownEffect(MailReadResult)(try (try withKey(read, first)).json)
    const foreignMessage = (try withKey(read, other)).status
    const foreignRead = (try withKey(mail, other)).status

    const rawPage = try googleSession(first)
    const rawCallback = try googleCallback(rawPage.pageUrl, address)
    const given = try exchangeGoogle(rawCallback.searchParams.get("code") ?? "")
    const access = try Schema.decodeUnknownEffect(GoogleAccess)(try given.json)
    const userinfo = `${cloud}/oauth2/v3/userinfo`
    const identity = try Schema.decodeUnknownEffect(GoogleOwner)(try (try withKey(userinfo, access.access_token)).json)
    try expire(cloud, first, address)
    const expiredToken = (try withKey(userinfo, access.access_token)).status
    const expiredConnection = (try withKey(mail, first)).status
    const afterExpiry = (try deliver(first, address)).status

    try Effect.try(() => assert.deepStrictEqual(
      { cancelled, deniedSession, beforeConsent, wrongState, afterWrongState, consented, replayedCallback, replayedCode, foreignRead, identity, expiredToken, expiredConnection },
      { cancelled: 200, deniedSession: ["cancelled"], beforeConsent: [], wrongState: 401, afterWrongState: [], consented: 200, replayedCallback: 401, replayedCode: 401,
        foreignRead: 404, identity: { email: address, email_verified: true }, expiredToken: 401, expiredConnection: 409 }
    ))
    try Effect.try(() => assert.deepStrictEqual(
      { beforeLink, wrongSenderAccount, wrongRecipient, beforeDelivery, delivered: delivery.status, afterDelivery, ownerMessage, foreignMessage, afterExpiry },
      { beforeLink: 404, wrongSenderAccount: 404, wrongRecipient: 404, beforeDelivery: { messages: [] }, delivered: 200,
        afterDelivery: { messages: [{ externalId: id }] }, ownerMessage: { message: { externalId: id }, bodyText: body }, foreignMessage: 404, afterExpiry: 404 }
    ))
  }
})

it.live("Choose what each email brings and take it off the tablet: Cancel on the tablet closes the company's page, an expired sign-in asks again, and signing in again renews the same account", () => effect {
  provide client {
    const { secret } = try signIn(cloud)
    const opened = try Deferred.make<string>()
    provide connectorAt(secret, [{ choice: "away" }, { choice: "allow", address: outlook.address }, { choice: "allow", address: outlook.address }], opened) {
      const connector = try Connector
      const waiting = try Effect.forkChild(connector.signIn({ provider: "Yahoo", attempt: 1, renewing: "" }))
      try Deferred.await(opened)
      try Fiber.interrupt(waiting)
      const closed = try sessions(cloud, secret)
      try connector.signIn({ provider: "Outlook", attempt: 2, renewing: "" })
      try expire(cloud, secret, outlook.address)
      const expired = try listed(outlook, "InboxFolder")
      const renewed = try connector.signIn({ provider: "Outlook", attempt: 3, renewing: outlook.address })
      const again = try listed(outlook, "InboxFolder")
      try Effect.try(() => assert.deepStrictEqual({ closed, expired, renewed: renewed.outcome, again }, {
        closed: ["cancelled"], expired: new NeedsSignIn()._tag, renewed: "Allowed", again: ["Thanksgiving dinner sign-up"]
      }))
    }
  }
})

it.live("Read an email and its original attachment, and find and open the email I intend: listing, search, the message with its PDF, the reply's header, and a scam warning from the company's evidence", () => effect {
  provide client {
    const { secret } = try signIn(cloud)
    provide connectorAt(secret) {
      const mail = (try Connector).mail(gmail)
      const inbox = try listed(gmail, "InboxFolder")
      const found = try listed(gmail, "InboxFolder", "clinic")
      const opened = try mail.read("clinic", 4)
      const header = try mail.header("clinic", 4)
      const form = try mail.attachment(opened.receipt.assets[0], opened.content.version)
      const scam = try mail.read("scam", 5)
      try Effect.try(() => assert.deepStrictEqual({
        scam: [scam.receipt.succeeded, scam.receipt.suspicion !== "", scam.content.fromAddress],
        inbox, found, header, receipt: opened.receipt, attached: opened.content.attachment, form: [form.mimeType, form.data.startsWith("JVBERi")], from: [opened.content.from, opened.content.fromAddress], body: opened.content.body.startsWith("Dear Margaret")
      }, {
        scam: [true, true, "security-alert@acc0unt-help.co"],
        inbox: ["Your Riverside Power bill is ready", "A message for Grace", "Lunch on Sunday?", "Reminder: your appointment tomorrow at 10 am", "Urgent: confirm your password"],
        found: ["Reminder: your appointment tomorrow at 10 am"],
        header: { ref: "clinic", generation: 4, address: "frontdesk@mainst-clinic.test", subject: "Re: Reminder: your appointment tomorrow at 10 am", verified: true },
        receipt: { generation: 4, succeeded: true, suspicion: "", assets: [{
          id: JSON.stringify(["Gmail", gmail.address, "clinic", "2"]), kind: "Pdf", name: "Visit form.pdf", origin: "Gmail", account: gmail.address, container: "clinic",
          sourceRef: "clinic/2", contentRef: "2", group: "clinic", savedAt: opened.content.receivedAt, pages: 2
        }] },
        attached: true, form: ["application/pdf", true],
        from: ["Main St Clinic", "frontdesk@mainst-clinic.test"],
        body: true
      }))
    }
  }
})

it.live("Delete a message and recover it safely: Trash, Restore, unread and Delete for good each come back with the company's receipt", () => effect {
  provide client {
    const { secret } = try signIn(cloud)
    provide connectorAt(secret) {
      const mail = (try Connector).mail(gmail)
      const identity = { owner: gmail.address, provider: "Gmail", account: gmail.address, ref: "family" }
      const changed = effect (change: "TrashMessage" | "RestoreMessage" | "UnreadMessage" | "ReadMessage" | "PurgeMessage", folder: Folder) => {
        const receipt = try mail.change({ identity, change, revision: 3, version: try versionOf(gmail, folder, "family") })
        return [receipt.result, receipt.evidence.startsWith("history:") || receipt.evidence]
      }
      const trashed = try changed("TrashMessage", "InboxFolder")
      const inTrash = try listed(gmail, "TrashFolder")
      const restored = try changed("RestoreMessage", "TrashFolder")
      const stale = try mail.change({ identity, change: "ReadMessage", revision: 3, version: "1" })
      const read = try changed("ReadMessage", "InboxFolder")
      const unread = try changed("UnreadMessage", "InboxFolder")
      try outage(cloud, secret, true)
      const offline = try mail.change({ identity, change: "TrashMessage", revision: 3, version: "1" })
      try outage(cloud, secret, false)
      const purged = try changed("PurgeMessage", "InboxFolder")
      const left = [...try listed(gmail, "InboxFolder"), ...try listed(gmail, "TrashFolder")]
      try Effect.try(() => assert.deepStrictEqual({ trashed, inTrash, restored, stale, read, unread, offline, purged, left }, {
        trashed: ["ChangeIdle", true], inTrash: ["Lunch on Sunday?"], restored: ["ChangeIdle", true],
        stale: { identity, revision: 3, result: "ChangeFailed", evidence: "refused:409" },
        read: ["ChangeIdle", true], unread: ["ChangeIdle", true],
        offline: { identity, revision: 3, result: "ChangeUnknown", evidence: "" },
        purged: ["ChangeIdle", true],
        left: ["Your Riverside Power bill is ready", "A message for Grace", "Reminder: your appointment tomorrow at 10 am", "Urgent: confirm your password"]
      }))
    }
  }
})

it.live("Write or reply and confirm before sending: contacts resolve, drafts keep their attachments, a send goes once per operation, a reply keeps its thread and Bcc, a forward carries the email's own attachment, a photo taken on the tablet goes as its own bytes and one with no bytes is refused, a reply carries an attachment, and one sent while the cloud is down goes later", () => effect {
  provide client {
    const { secret } = try signIn(cloud)
    provide connectorAt(secret) {
      const mail = (try Connector).mail(gmail)
      const [visitForm] = (try mail.read("clinic", 5)).receipt.assets
      const content = { to: "susan@family.test", cc: [], bcc: [], subject: "Sunday", body: "See you on Sunday. Love, Mom" }
      const draft = { id: "draft-sunday", version: 1, content, attachments: [visitForm], replyTo: "" }
      const reply = { ...draft, id: "", attachments: [], content: { ...content, to: "ruth@family.test", subject: "Re: Lunch on Sunday?", body: "Yes please." }, replyTo: "family" }
      const withBcc = { ...reply, content: { ...reply.content, bcc: ["david@family.test"], body: "Yes please, David is coming too." } }
      const camera = { ...visitForm, id: "capture", kind: "Photo" as const, name: "Garden.jpg", origin: "camera", account: "", container: "", sourceRef: "capture", contentRef: "blob-capture", pages: 0 }
      const people = (try mail.contacts()).length
      const resolved = [try mail.resolve("susan"), try mail.resolve("Nobody")]
      const saved = try mail.saveDraft(draft)
      const drafts = try listed(gmail, "DraftsFolder")
      const another = { ...draft, id: "draft-tuesday", content: { ...content, subject: "Tuesday" } }
      try mail.saveDraft(another)
      const both = try mail.draftCount()
      try mail.deleteDraft(another.id)
      const reopened = (try mail.read("draft-sunday", 5)).receipt.assets.map((a) => a.name)
      const restored = try mail.draft("draft-sunday", 2)
      const removed = try mail.deleteDraft("draft-sunday")
      const empty = try mail.draftCount()
      const none = new Map<string, { mimeType: string; data: string }>()
      const sends = [try mail.send("operation-1", reply, none), try mail.send("operation-1", reply, none)]
      const sent = try listed(gmail, "SentFolder")
      const answered = (try Stream.runCollect(mail.list(scope(gmail, "InboxFolder"), () => 0))).filter((m) => m.receipt.seed.answered).map((m) => [m.content.ref, m.content.replied, m.content.attachment])
      const looked = [try mail.lookup("operation-1"), try mail.lookup("operation-never")]
      try outage(cloud, secret, true)
      const offline = try mail.send("operation-2", draft, none)
      try outage(cloud, secret, false)
      const later = [try mail.lookup("operation-2"), try mail.send("operation-2", draft, none), try mail.send("operation-2", draft, none)]
      const copied = try mail.send("operation-3", withBcc, none)
      const unsendable = try mail.send("operation-4", { ...draft, attachments: [camera] }, none)
      const photo = try mail.send("operation-5", { ...draft, attachments: [camera] }, new Map([["capture", { mimeType: "image/jpeg", data: btoa("garden") }]]))
      const withForm = try mail.send("operation-6", { ...reply, attachments: [visitForm] }, none)
      const carried = (try sentMail(cloud, secret)).filter((m) => m.labels.includes("SENT")).map((m) => [m.subject, m.bcc, m.attachments.map((a) => a.filename)])
      const evidence = (s: { readonly evidence: string }) => s.evidence.startsWith("message:")
      try Effect.try(() => assert.deepStrictEqual({
        people, resolved, saved, drafts, reopened, removed, counts: [both, empty],
        restored: [restored.verified, restored.snapshot.content, restored.snapshot.attachments.map((a) => [a.name, a.sourceRef]), restored.snapshot.version], sends: sends.map((s) => [s.resultStatus, evidence(s)]), same: sends[0].evidence === sends[1].evidence && looked[0].evidence === sends[0].evidence,
        sent, answered, looked: looked.map((s) => s.resultStatus), never: looked[1], offline, later: later.map((s) => s.resultStatus), again: later[1].evidence === later[2].evidence,
        copied: copied.resultStatus, unsendable, uploaded: [photo.resultStatus, withForm.resultStatus], carried
      }, {
        people: 6,
        resolved: [{ address: "susan@family.test", verified: true }, { address: "", verified: false }],
        saved: { draftId: "draft-sunday", persisted: true }, drafts: ["Sunday"], reopened: ["Visit form.pdf"], removed: true, counts: [2, 0],
        restored: [true, content, [["Visit form.pdf", "draft-sunday/1"]], 2],
        sends: [["Sent", true], ["Sent", true]], same: true,
        sent: ["Re: Lunch on Sunday?"], answered: [["family", "Yes please.", true]],
        looked: ["Sent", "SendUnknown"], never: { resultStatus: "SendUnknown", evidence: "" },
        offline: { resultStatus: "SendFailed", evidence: "preflight-unreachable" },
        later: ["SendUnknown", "Sent", "Sent"], again: true,
        copied: "Sent",
        unsendable: { resultStatus: "SendFailed", evidence: "refused:422" },
        uploaded: ["Sent", "Sent"],
        carried: [["Re: Lunch on Sunday?", [], []], ["Sunday", [], ["Visit form.pdf"]], ["Re: Lunch on Sunday?", ["david@family.test"], []], ["Sunday", [], ["Garden.jpg"]], ["Re: Lunch on Sunday?", [], ["Visit form.pdf"]]]
      }))
    }
  }
})

it.live("Browse my calendar and open an exact occurrence, and add and correct an appointment: the feed, a new appointment whose provider receipt binds its reminder, person and source email to the saved occurrence, and, when no receipt arrived, the feed brings the company's copy with the reminder, person and email the tablet's entry held and the tablet's entry leaves, a refresh that keeps what only the tablet knows, a change, an all-day day that stays one date in every zone and is never turned into a timed one, and a deletion the company cannot confirm twice", () => effect {
  provide client {
    const { secret } = try signIn(cloud)
    provide connectorAt(secret) {
      const calendar = (try Connector).calendar(gmail)
      const now = try Clock.currentTimeMillis
      const hour = 60 * 60 * 1000
      const day = 24 * hour
      const view = (entries: Calendar[], timezone = "UTC") => ({ ...noView, owner: gmail.address, calendarId: "primary", timezone, window: { ...noView.window, fromTime: now - day, untilTime: now + 30 * day }, entries })
      const feed = effect (entries: Calendar[], timezone = "UTC") => Array.from(try Stream.runCollect(calendar.feed(view(entries, timezone))))
      const imported = try feed([])
      const found = (id: string) => imported.find((p) => p.incoming.identity.occurrenceId === id)
      const eyeCheck = found("eye-check")?.incoming ?? noEntry
      const start = now + day
      const identity = { owner: gmail.address, calendarId: "primary", occurrenceId: "clinic-visit", sourceRef: "clinic", sourceAccount: 1, kind: "Appointment" as const, billRef: "", billOrigin: "", billAccount: "" }
      const details = { ...eyeCheck.committed, title: "Doctor’s appointment", location: "Main St clinic", participant: "Dr. Patel", notes: "From the clinic’s email · Visit form attached", startAt: start, endAt: start + hour, reminderEnabled: true, leadTime: day }
      const fresh = approveSave(create(noEntry, identity, details, "CalendarUser"), 1, "CalendarUser")
      const refusalEntry = approveSave(create(noEntry, { ...identity, occurrenceId: "refused-calendar-visit" }, details, "CalendarUser"), 1, "CalendarUser")
      try outage(cloud, secret, false, "reauthCreate")
      const reconnect = calendar.write(refusalEntry, view([])) catch (cause) => cause._tag
      try Effect.try(() => assert.equal(reconnect, "NeedsSignIn"))
      try outage(cloud, secret, false, "conflictCreate")
      const conflict = try calendar.write(refusalEntry, view([]))
      try Effect.try(() => assert.isFalse(conflict.succeeded))
      const awaiting = save(fresh, 1, true, "CalendarStore")
      try outage(cloud, secret, false, "createResponse")
      const dropped = try calendar.write(fresh, view([eyeCheck]))
      const failed = saveFailed(fresh, fresh.revision, "CalendarStore")
      const reapproved = approveSave(failed, failed.revision, "CalendarUser")
      const corrected = edit(failed, { ...failed.draft, participant: "Another person" }, "CalendarUser")
      const changedDraft = approveSave(corrected, corrected.revision, "CalendarUser")
      const rebound = try calendar.write(changedDraft, view([changedDraft]))
      const { secret: alternateKey } = try signIn(cloud)
      const changedGrant = effect {
        provide connectorAt(alternateKey) {
          const other = (try Connector).calendar(gmail)
          const receipt = try other.write(reapproved, view([reapproved]))
          const remote = Array.from(try Stream.runCollect(other.feed(view([]))))
          return [receipt.succeeded, remote.some(({ incoming }) => incoming.committed.title === details.title)]
        }
      }
      const grantIsolation = try changedGrant
      try outage(cloud, secret, false, "createResponse")
      const duringOutage = try feed([awaiting])
      const independent = duringOutage.find(({ incoming }) => incoming.identity.occurrenceId === "eye-check")
      const unbound = duringOutage.find(({ incoming }) => incoming.committed.title === details.title)
      const recover = effect {
        provide connectorAt(secret) {
          const restarted = (try Connector).calendar(gmail)
          return Array.from(try Stream.runCollect(restarted.feed(view([eyeCheck, awaiting])))).filter((p) => p.incoming.committed.title === details.title)
        }
      }
      const copied = try recover
      const added = try calendar.write(reapproved, view([eyeCheck, reapproved]))
      const upgraded = effect (format: "revision" | "damaged-revision" | "occurrence", receipt?: string) => {
        const key = format === "occurrence" ? alternateKey : secret
        const { connectionId: grantId } = (try googleOwnerGrants(key))[0]
        provide Layer.merge(Layer.fresh(KeyValueStore.layerMemory), Digest.layerWebCrypto) {
          const storage = try KeyValueStore.KeyValueStore
          const digest = try Digest.Digest
          const hash = (fields: readonly unknown[]) => Effect.map(digest.digest(Digest.sha256, new TextEncoder().encode(JSON.stringify(fields))),
            (bytes) => Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join(""))
          const body = { title: details.title, description: details.notes, location: details.location, startAt: new Date(details.startAt).toISOString(),
            endAt: new Date(details.endAt).toISOString(), timeZone: details.timezone, calendarId: identity.calendarId, grantId }
          const fingerprint = try hash([body, identity.sourceAccount, identity.sourceRef, details.participant, details.seriesId, details.recurrence, details.reminderEnabled, details.leadTime, details.important])
          const seedClaim = effect {
            if (format !== "occurrence") {
              const original = try hash([cloud, gmail.provider, grantId, gmail.address, identity.owner, identity.calendarId, identity.occurrenceId, fresh.revision])
              try storage.set("calendar-create:" + original, format === "revision" ? fingerprint : "damaged")
              if (receipt !== undefined) try storage.set("calendar-create:" + original + ":receipt", receipt)
              return format === "revision" ? added.providerId : undefined
            }
            const scope = try hash([cloud, gmail.provider, gmail.address.toLowerCase(), identity.calendarId, identity.occurrenceId])
            const mutation = try hash([scope, grantId, fresh.revision])
            const request = HttpClientRequest.post(`${cloud}/api/v1/eliza/google/calendar/events`).pipe(
              HttpClientRequest.bearerToken(key), HttpClientRequest.setHeader("Idempotency-Key", mutation), HttpClientRequest.bodyJsonUnsafe(body))
            const saved = try Schema.decodeUnknownEffect(Stored)(try (try HttpClient.execute(request)).json)
            try storage.set("calendar-create:" + scope, JSON.stringify({ grantId, mutation, fingerprint, providerId: receipt }))
            if (receipt !== undefined) try outage(cloud, key, false, "conflictCreate")
            return saved.event.externalId
          }
          const expectedId = try seedClaim
          provide connectorAt(key) {
            const saved = try (try Connector).calendar(gmail).write(reapproved, view([reapproved]))
            try Effect.try(() => assert.equal(saved.providerId, expectedId))
            return saved
          }
        }
      }
      const migrated = try upgraded("revision")
      try outage(cloud, secret, false, "conflictCreate")
      const received = try upgraded("revision", added.providerId)
      try outage(cloud, secret, false)
      try Effect.try(() => assert.deepStrictEqual([migrated, received], [added, added]))
      const damaged = try upgraded("damaged-revision")
      try Effect.try(() => assert.isFalse(damaged.succeeded))
      const fromTablet = try upgraded("occurrence")
      try upgraded("occurrence", fromTablet.providerId)
      const created = { owner: identity.owner, calendarId: identity.calendarId, localId: identity.occurrenceId, providerId: added.providerId ?? "", revision: added.revision }
      const pending = view([eyeCheck, reapproved])
      try Effect.try(() => assert.isTrue(canStoreCreated(pending, created, "ViewStore")))
      const settled = storeCreated(pending, created, "ViewStore")
      const visit = settled.entries.find((e) => e.identity.occurrenceId === created.providerId) ?? noEntry
      const providerCopies = (try feed([])).filter((p) => p.incoming.committed.title === details.title).length
      const unchanged = (try feed([eyeCheck, visit])).map((p) => p.incoming.identity.occurrenceId)
      const elsewhere = effect {
        provide connectorAt(secret) {
          return try (try Connector).calendar(gmail).write(edit(beginEdit(visit, "CalendarUser"), { ...visit.committed, title: "Check-up at 11" }, "CalendarUser"), view([eyeCheck, visit]))
        }
      }
      const otherTablet = try elsewhere
      const refreshed = (try feed([eyeCheck, visit])).find((p) => p.incoming.identity.occurrenceId === visit.identity.occurrenceId)?.incoming ?? noEntry
      const moved = edit(beginEdit(refreshed, "CalendarUser"), { ...refreshed.committed, title: "Check-up with Dr. Patel" }, "CalendarUser")
      const changed = try calendar.write(moved, view([eyeCheck, refreshed]))
      const birthdayIn = effect (timezone: string, entries: Calendar[] = []) => (try feed(entries, timezone)).find((p) => p.incoming.identity.occurrenceId === "birthday")
      const seen = try birthdayIn("Asia/Tokyo")
      const elsewhereSeen = try birthdayIn("UTC")
      const birthday = seen?.incoming ?? noEntry
      const renamed = try calendar.write(edit(beginEdit(birthday, "CalendarUser"), { ...birthday.committed, title: "Joan’s 80th birthday" }, "CalendarUser"), view([birthday], "Asia/Tokyo"))
      const shifted = try calendar.write(edit(beginEdit(birthday, "CalendarUser"), { ...birthday.committed, startAt: birthday.committed.startAt + day, endAt: birthday.committed.endAt + day }, "CalendarUser"), view([birthday], "Asia/Tokyo"))
      const newAllDay = try calendar.write(approveSave(create(noEntry, { ...identity, occurrenceId: "picnic", sourceRef: "", sourceAccount: 0 }, { ...birthday.committed, title: "Picnic" }, "CalendarUser"), 1, "CalendarUser"), view([], "Asia/Tokyo"))
      const afterRename = (try birthdayIn("Asia/Tokyo", [birthday]))?.incoming.committed
      const removed = [try calendar.remove(visit.identity, "ThisOccurrence"), try calendar.remove(visit.identity, "ThisOccurrence"), try calendar.remove(eyeCheck.identity, "EntireSeries")]
      const gone = (try feed([eyeCheck, visit])).filter((p) => p.incoming.identity.occurrenceId === visit.identity.occurrenceId).map((p) => p.incoming.phase)
      const held = approveSave(create(noEntry, { ...identity, occurrenceId: "delayed-visit" }, { ...details, title: "Second appointment" }, "CalendarUser"), 1, "CalendarUser")
      try outage(cloud, secret, false, "beforeCreate")
      const interrupted = try calendar.write(held, view([]))
      const local = save(held, 1, true, "CalendarStore")
      const restartDelayed = effect {
        provide connectorAt(secret) {
          const reopened = (try Connector).calendar(gmail)
          const first = Array.from(try Stream.runCollect(reopened.feed(view([local]))))
          const next = Array.from(try Stream.runCollect(reopened.feed(view([local]))))
          return [first.some((p) => p.incoming.identity.occurrenceId === local.identity.occurrenceId && p.incoming.phase === "Deleted"),
            first.some((p) => p.incoming.phase === "Saved" && p.incoming.identity.occurrenceId === "eye-check"),
            next.filter((p) => p.incoming.phase === "Saved" && p.incoming.committed.title === local.committed.title).map((p) => p.incoming.identity.sourceRef)] as const
        }
      }
      const retried = try restartDelayed
      const outlookRecovery = effect {
        provide connectorAt(secret, [{ choice: "allow", address: outlook.address }]) {
          const otherConnector = try Connector
          try otherConnector.signIn({ provider: "Outlook", attempt: 1, renewing: "" })
          const remote = otherConnector.calendar(outlook)
          const approved = approveSave(create(noEntry, { ...identity, owner: outlook.address }, details, "CalendarUser"), 1, "CalendarUser")
          const empty = { ...view([]), owner: outlook.address }
          try outage(cloud, secret, false, "refuseCreate")
          const declined = try remote.write(approved, empty)
          const [accepted, simultaneous] = try Effect.all([remote.write(approved, empty), remote.write(approved, empty)], { concurrency: 2 })
          const uncertain = approveSave(create(noEntry, { ...identity, owner: outlook.address, occurrenceId: "uncertain-visit" }, { ...details, title: "Uncertain appointment" }, "CalendarUser"), 1, "CalendarUser")
          try outage(cloud, secret, false, "createResponse")
          const lost = try remote.write(uncertain, empty)
          const failed = saveFailed(uncertain, uncertain.revision, "CalendarStore")
          const again = try remote.write(approveSave(failed, failed.revision, "CalendarUser"), empty)
          const remoteEvents = Array.from(try Stream.runCollect(remote.feed(empty)))
          return [declined.succeeded, accepted.succeeded, accepted.providerId === simultaneous.providerId, remoteEvents.filter((p) => p.incoming.committed.title === approved.draft.title).length,
            lost.succeeded, again.succeeded, remoteEvents.filter((p) => p.incoming.committed.title === uncertain.draft.title).length] as const
        }
      }
      const otherProvider = try outlookRecovery
      const legacy = { ...local, identity: { ...local.identity, occurrenceId: "tablet-d204c887-3602-4dcf-8fc5-ddb9902f288a" } }
      const observed = try feed([legacy])
      const legacyEvidence = [observed.some((p) => p.incoming.identity.occurrenceId === legacy.identity.occurrenceId),
        observed.filter((p) => p.incoming.committed.title === local.committed.title).map((p) => [p.incoming.identity.sourceRef, p.incoming.committed.reminderEnabled])]
      const r = refreshed.committed
      const tokyoMidnight = Date.parse(`${new Date(Math.floor(now / day) * day + 3 * day).toISOString().slice(0, 10)}T00:00:00+09:00`)
      try Effect.try(() => assert.deepStrictEqual({
        eyeCheck: [eyeCheck.phase, eyeCheck.committed.participant, found("eye-check")?.scheduleVerified],
        legacyEvidence, added, grantIsolation, isolated: [rebound.succeeded, independent?.incoming.committed.title, unbound?.incoming.identity.sourceRef, unbound?.incoming.committed.reminderEnabled,
          duringOutage.some(({ incoming }) => incoming.identity.occurrenceId === awaiting.identity.occurrenceId && incoming.phase === "Deleted")], recovery: [dropped.succeeded, providerCopies, interrupted.succeeded, retried, otherProvider], localRemoved: settled.entries.every((e) => e.identity.occurrenceId !== identity.occurrenceId),
        copied: copied.map((p) => [p.incoming.identity.occurrenceId === identity.occurrenceId, p.incoming.phase, p.incoming.committed.participant, p.incoming.identity.sourceRef, p.incoming.identity.sourceAccount, p.incoming.committed.reminderEnabled, p.scheduleVerified]),
        visit: [visit.phase, visit.identity.sourceAccount, visit.identity.sourceRef, visit.committed.participant, visit.committed.reminderEnabled, visit.committed.leadTime],
        unchanged, elsewhere: otherTablet.succeeded,
        refreshed: [r.title, r.participant, r.reminderEnabled, r.leadTime, refreshed.identity.sourceRef, refreshed.revision > visit.revision], changed,
        allDay: [seen?.incoming.committed.allDay, seen?.incoming.committed.startAt === tokyoMidnight, seen?.incoming.committed.timezone, seen?.scheduleVerified],
        floating: [elsewhereSeen?.incoming.committed.startAt === tokyoMidnight + 9 * hour, elsewhereSeen?.incoming.committed.timezone, elsewhereSeen?.scheduleVerified],
        stored: [renamed.succeeded, shifted.succeeded, newAllDay.succeeded, afterRename?.title, afterRename?.allDay, afterRename?.startAt === tokyoMidnight],
        removed, gone
      }, {
        eyeCheck: ["Saved", "Dr. Patel", true],
        added: { revision: 2, succeeded: true, published: [], providerId: visit.identity.occurrenceId },
        isolated: [false, eyeCheck.committed.title, "", false, false],
        grantIsolation: [false, false],
        legacyEvidence: [false, [["", false]]],
        recovery: [false, 1, false, [false, true, ["clinic"]], [false, true, true, 1, false, false, 1]],
        localRemoved: true,
        copied: [[false, "Saved", "Dr. Patel", "clinic", 1, true, true], [true, "Deleted", "Dr. Patel", "clinic", 1, true, true]],
        visit: ["Saved", 1, "clinic", "Dr. Patel", true, day],
        unchanged: ["birthday"],
        elsewhere: true,
        refreshed: ["Check-up at 11", "Dr. Patel", true, day, "clinic", true],
        changed: { revision: moved.revision, succeeded: true, published: [] },
        allDay: [true, true, "Asia/Tokyo", true],
        floating: [true, "UTC", true],
        stored: [true, false, false, "Joan’s 80th birthday", true, true],
        removed: [{ succeeded: true, evidence: `deleted:${visit.identity.occurrenceId}` }, { succeeded: false, evidence: "" }, { succeeded: false, evidence: "series-unsupported" }],
        gone: ["Deleted"]
      }))
    }
  }
})

it.live("Read the Google mail and calendar I connected: the pinned Eliza Cloud routes every Google read and change Grace makes, and the status, connect and disconnect of her Google link", () => effect {
  const env = { PUBLIC_API_ORIGIN: "https://api.grace.test", WEB_ORIGIN: "https://app.grace.test" }
  const storage = try Effect.try(() => new Client())
  try tryPromise(() => storage.end())
  const requests = [
    ...googleReads.map((route) => [googleRoute + route, "GET"] as const),
    ...googleChanges.map((route) => [googleRoute + route, "POST"] as const),
    ...Object.entries(accountRequests).filter(([path]) => path.startsWith(googleRoute)),
  ]
  const providerCalls: string[] = []
  const denyProvider: typeof fetch = async (input) => {
    providerCalls.push(String(input))
    throw new Error("Unexpected provider request")
  }
  const unrouted = try Effect.forEach(requests, ([path, method]) => effect {
    const sent = HttpClientRequest.make(method)(env.PUBLIC_API_ORIGIN + path, { headers: { origin: env.WEB_ORIGIN } })
    const request = try HttpServerRequest.toWeb(HttpServerRequest.fromClientRequest(sent))
    const response = try tryPromise(() => googleRequest(request, env, storage, "account", denyProvider))
    const { error } = try Schema.decodeUnknownEffect(Schema.Struct({ error: Schema.optional(Schema.String) }))(try tryPromise(() => response.json()))
    return error === "route_not_found" ? [method + " " + path] : []
  })
  try Effect.try(() => assert.deepStrictEqual({ unrouted: unrouted.flat(), providerCalls }, { unrouted: [], providerCalls: [] }))
})
