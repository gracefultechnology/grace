[
  { "tap": "Wi-Fi" },
  { "tap": "Wi-Fi settings" },
  { "tap": "Look for networks" },
  { "expect": "The tablet uses its location only to find Wi-Fi networks nearby." },
  { "grant": "android.permission.ACCESS_FINE_LOCATION" },
  { "tap": "Allow" },
  { "expect": "AndroidWifi" },
  { "expect": "Connected" },
  { "call": "ElizaWiFi.getConnectivity", "returns": { "online": true } },
  { "forget": "AndroidWifi" },
  { "tap": "AndroidWifi" },
  { "approve": "Save" },
  { "expect": "Connected" },
  { "call": "ElizaWiFi.getConnectivity", "returns": { "online": true, "validated": true, "ssid": "AndroidWifi" } }
]
