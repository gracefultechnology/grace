{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowJs": true,
    "customConditions": ["eliza-source"],
    "jsx": "react-jsx",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node",
      "vite/client"
