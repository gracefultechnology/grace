// spec/app/setup.md, "Story: Sign in to Grace and manage my subscription"
import { migrate, readIdentity, Store, storeLayer } from "@elizaos/cloud-worker"
import { NodeFileSystem } from "@effect/platform-node"

const Binding = Schema.Struct({
  CLOUD_IDENTITY_DIGEST: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/)),
  CLOUD_ENVIRONMENT: Schema.Literals(["staging", "production"])
})
const Worker = Schema.Struct({
  env: Schema.Struct({
    staging: Schema.Struct({ vars: Binding }),
    production: Schema.Struct({ vars: Binding })
  })
})
const renamedMigrations = [
  ["0125_device_mail_lease.sql", "0126_device_mail_lease.sql"],
  ["0126_normalize_renewed_device_grants.sql", "0127_normalize_renewed_device_grants.sql"]
] as const

error EnvironmentMismatch

const migration = effect {
  const fs = try FileSystem.FileSystem
  const file = try fs.readFileString("wrangler.jsonc")
  const settings = try Schema.decodeUnknownEffect(Schema.fromJsonString(Worker))(file)
  const name = try Config.withDefault(Config.String("CLOUD_ENVIRONMENT"), "staging")
  const environment = try Schema.decodeUnknownEffect(Schema.Literals(["staging", "production"]))(name)
  const vars = settings.env[environment].vars
  if (vars.CLOUD_ENVIRONMENT !== environment) throw new EnvironmentMismatch()
  const url = Redacted.value(try Config.Redacted("DATABASE_URL"))
  const now = try Clock.currentTimeMillis
  const options = { digest: vars.CLOUD_IDENTITY_DIGEST, environment, now }
  provide storeLayer({ kind: "pg", url }) {
    const store = try Store
    try store.transaction(effect (tx) => {
      try tx.query("SELECT pg_advisory_xact_lock(4242001)")
      const identity = try readIdentity(tx)
      if (identity.kind !== "identified" || identity.digest !== options.digest || identity.environment !== options.environment) return
      for (const [previous, current] of renamedMigrations) {
        try tx.query("INSERT INTO schema_migrations (name, applied_at) SELECT $1, applied_at FROM schema_migrations WHERE name = $2 ON CONFLICT DO NOTHING", [current, previous])
      }
    })
    const result = try migrate(options)
    try annotateLogs(logInfo("Grace database is ready"), { environment, migrations: result.applied })
  }
}

await Effect.runPromise(Effect.provide(migration, NodeFileSystem.layer))
