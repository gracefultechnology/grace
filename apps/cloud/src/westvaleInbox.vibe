// spec/app/email.md, "A private sign-in suggestion requires one current message from the website's issuer"; spec/app/browserControls.md, "An email code suggestion belongs to the current private website field"
import { cloudCredential, readConnectedInboxMessage, s256, tokenDigest, type CloudBindings } from "@elizaos/cloud/worker"
import { FetchHttpClient, HttpClient, HttpClientRequest, HttpIncomingMessage, HttpServerRequest, HttpServerResponse } from "effect/http"

const origin = "https://westvaleelectric.com"
const sender = "verification@westvaleelectric.com"
export const inboxPath = "/api/product/email/westvale/"
export const deviceInboxPaths = ["enroll", "offer", "fill"].map((action) => inboxPath + action)
type Database = Parameters<typeof readConnectedInboxMessage>[1]
const publicRequest = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{43}$/))
const challengeId = Schema.String.check(Schema.isPattern(/^[0-9a-f]{32}$/))
const fingerprint = Schema.String.check(Schema.isPattern(/^[0-9a-f]{64}$/))
schema Enrollment { proof: publicRequest }
schema Consent { request: publicRequest; accountId: string; grant: string; stamp: fingerprint }
schema Challenge { proof: publicRequest; challenge: challengeId }
schema Selection { proof: publicRequest; challenge: challengeId; message: fingerprint }
schema Active { active: boolean }
schema Matched { matched: boolean }
const nothing = () => response(200, { available: false })
const denied = () => response(403, { error: "inbox_approval_required" })

function response(status: number, value: unknown) {
  return HttpServerResponse.toWeb(HttpServerResponse.jsonUnsafe(value, { status, headers: { "cache-control": "private, no-store" } }))
}

function inputBody(request: Request) {
  if (request.headers.get("content-type")?.split(";")[0] !== "application/json") return Promise.resolve(null)
  return runPromise(effect {
    const limited = Effect.provideService(HttpServerRequest.fromWeb(request).json, HttpIncomingMessage.MaxBodySize, ByteSize.kibibytes(4))
    return limited catch () => null
  })
}

type Approval = { session_key: string; grant_id: string; email: string; requested_at: string }

async function approval(db: Database, account: string, device: string, request: string) {
  const result = await db.query<Approval>(`
    SELECT p.session_key, p.grant_id::text, g.email, p.requested_at::text
    FROM cloud_mail_device_authorizations p
    JOIN device_grants d ON d.key = p.device_key
    JOIN accounts a ON a.key = d.user_id
    JOIN sessions s ON s.key = p.session_key AND s.user_id = a.key
    JOIN cloud_google_connections g ON g.account_id = a.key AND g.id = p.grant_id
    WHERE p.origin = $1 AND p.request = $2 AND d.secret_digest = $3 AND a.key = $4
      AND a.status = 'active' AND d.phase = 'active' AND d.key_expires_at > $5
      AND d.issued_at >= a.devices_revoked_before AND g.mail AND s.live
      AND s.access_expires_at > $5 AND (s.state->>'epoch')::bigint = a.sessions_revoked_before
  `, [origin, request, device, account, Date.now()])
  return result.rows[0]
}

async function enroll(db: Database, account: string, device: string, request: string) {
  const result = await db.query(`
    INSERT INTO cloud_mail_device_authorizations (device_key, origin, request, requested_at)
    SELECT key, $1, $2, $5 FROM device_grants WHERE secret_digest = $3 AND user_id = $4 AND phase = 'active'
    ON CONFLICT (device_key, origin) DO UPDATE SET request = EXCLUDED.request, requested_at = EXCLUDED.requested_at,
      session_key = CASE WHEN cloud_mail_device_authorizations.request = EXCLUDED.request THEN cloud_mail_device_authorizations.session_key END,
      grant_id = CASE WHEN cloud_mail_device_authorizations.request = EXCLUDED.request THEN cloud_mail_device_authorizations.grant_id END
  `, [origin, request, device, account, Date.now()])
  if (result.rowCount !== 1) return denied()
  const current = await approval(db, account, device, request)
  return response(200, { request, approved: Boolean(current) })
}

type Pending = { session_key: string; grant_id: string; approved: boolean }

async function consent(request: Request, db: Database, env: CloudBindings, account: string, digest: string) {
  const reading = request.method === "GET"
  if ((!reading && request.method !== "POST") || request.headers.has("authorization") ||
      (!reading && request.headers.get("origin") !== env.WEB_ORIGIN)) return denied()
  const input = reading ? null : Schema.decodeUnknownOption(Consent)(await inputBody(request))
  if (input && Option.isNone(input)) return response(400, { error: "invalid_request" })
  const choice = input && Option.isSome(input) ? input.value : null
  const requestId = choice?.request ?? new URL(request.url).searchParams.get("request")
  if (!Schema.is(publicRequest)(requestId)) return response(400, { error: "invalid_request" })
  const now = Date.now()
  const result = await db.query<Pending>(`
    SELECT s.key AS session_key, g.id::text AS grant_id, COALESCE(p.session_key = s.key AND p.grant_id = g.id, false) AS approved
    FROM cloud_mail_device_authorizations p JOIN device_grants d ON d.key = p.device_key
    JOIN accounts a ON a.key = d.user_id JOIN sessions s ON s.user_id = a.key
    JOIN cloud_google_connections g ON g.account_id = a.key
    WHERE p.origin = $1 AND p.request = $2 AND a.key = $3 AND s.access_digest = $4 AND g.mail
      AND a.status = 'active' AND s.live AND s.access_expires_at > $5
      AND (s.state->>'epoch')::bigint = a.sessions_revoked_before AND d.phase = 'active'
      AND d.key_expires_at > $5 AND d.issued_at >= a.devices_revoked_before
      AND (p.requested_at > $6 OR (p.session_key = s.key AND p.grant_id = g.id))
  `, [origin, requestId, account, digest, now, now - 600000])
  const row = result.rows[0]
  if (!row) return denied()
  const stamp = tokenDigest(JSON.stringify([origin, requestId, row.session_key, row.grant_id]))
  if (reading) return response(200, { accountId: account, grant: row.grant_id, stamp, approved: row.approved })
  if (!choice || choice.accountId !== account || choice.grant !== row.grant_id || choice.stamp !== stamp) return denied()
  const update = await db.query(`
    UPDATE cloud_mail_device_authorizations p SET session_key = $1, grant_id = $2
    FROM sessions s, accounts a, device_grants d, cloud_google_connections g
    WHERE p.origin = $3 AND p.request = $4 AND p.device_key = d.key AND d.user_id = $5
      AND a.key = d.user_id AND a.status = 'active' AND s.key = $1 AND s.user_id = a.key
      AND s.access_digest = $6 AND s.live AND s.access_expires_at > $7
      AND (s.state->>'epoch')::bigint = a.sessions_revoked_before AND g.id = $2 AND g.account_id = a.key AND g.mail
      AND d.phase = 'active' AND d.key_expires_at > $7 AND d.issued_at >= a.devices_revoked_before
      AND (p.requested_at > $8 OR (p.session_key = s.key AND p.grant_id = g.id))
  `, [row.session_key, row.grant_id, origin, requestId, account, digest, Date.now(), Date.now() - 600000])
  return update.rowCount === 1 ? response(200, { approved: true }) : denied()
}

function singleHeader(headers: readonly { name: string; value: string }[], key: string) {
  const matches = headers.filter((entry) => entry.name.toLowerCase() === key)
  return matches.length === 1 ? matches[0].value.trim() : null
}

async function issuerConfirms(challenge: string, receipt: string, email: string, messageId: string, code?: string) {
  const body = JSON.stringify({ challenge, receipt, messageId, recipientHash: tokenDigest(email), ...(code === undefined ? {} : { code }) })
  const request = HttpClientRequest.bodyText(HttpClientRequest.post(origin + "/api/sign-in/email-autofill"), body, "application/json")
  const verify = effect {
    const remote = try HttpClient.execute(request)
    if (remote.status !== 200 || !remote.headers["content-type"]?.startsWith("application/json")) return false
    const value = try remote.json
    if (code === undefined) return Schema.is(Active)(value) && value.active
    return Schema.is(Matched)(value) && value.matched
  }
  return runPromise(Effect.provideService(Effect.provide(timeout(verify, "6 seconds"), FetchHttpClient.layer),
    FetchHttpClient.RequestInit, { redirect: "error", cache: "no-store" }))
}

export async function westvaleInbox(request: Request, env: CloudBindings, db: Database, account: string) {
  const path = new URL(request.url).pathname
  const credential = await cloudCredential(request)
  if (!credential) return denied()
  if (path === inboxPath + "consent" && credential.kind === "browser") return consent(request, db, env, account, credential.hash)
  if (credential.kind !== "device" || !deviceInboxPaths.includes(path)) return denied()
  if (request.headers.get("content-type")?.split(";")[0] !== "application/json") return response(415, { error: "json_required" })
  const raw = await inputBody(request)
  const enrollment = Schema.decodeUnknownOption(Enrollment)(raw)
  if (Option.isNone(enrollment)) return response(400, { error: "invalid_request" })
  const requestId = s256(enrollment.value.proof)
  if (path === inboxPath + "enroll") return enroll(db, account, credential.hash, requestId)
  const input = Schema.decodeUnknownOption(Challenge)(raw)
  const filling = path === inboxPath + "fill"
  const selection = filling ? Schema.decodeUnknownOption(Selection)(raw) : null
  if (Option.isNone(input) || (selection && Option.isNone(selection))) return response(400, { error: "invalid_request" })
  const accepted = await approval(db, account, credential.hash, requestId)
  if (!accepted) return denied()
  const challenge = input.value.challenge
  const inactive = () => filling ? response(409, { error: "suggestion_expired" }) : nothing()
  const email = accepted.email.trim().toLowerCase()
  const select = { sender, subject: "Westvale Electric sign-in " + challenge, headers: ["From", "To", "Subject", "X-Westvale-Inbox-Receipt"] }
  const envelope = await readConnectedInboxMessage(env, db, account, accepted.grant_id, select)
  if (!envelope) return inactive()
  const header = (name: string) => singleHeader(envelope.headers, name)
  const receipt = header("x-westvale-inbox-receipt")
  const received = Date.parse(envelope.receivedAt)
  const fresh = () => received <= Date.now() && Date.now() - received < 600000
  if (!fresh() || header("from")?.toLowerCase() !== sender || header("to")?.toLowerCase() !== email ||
      header("subject") !== select.subject || !receipt || !Schema.is(publicRequest)(receipt)) return inactive()
  const message = tokenDigest(JSON.stringify([accepted.session_key, accepted.grant_id, requestId, challenge, envelope.id, receipt]))
  const stillCurrent = async () => {
    const latest = await approval(db, account, credential.hash, requestId)
    return fresh() && latest?.session_key === accepted.session_key && latest.grant_id === accepted.grant_id
  }
  if (!filling) return await issuerConfirms(challenge, receipt, email, envelope.rfcId) && await stillCurrent()
    ? response(200, { available: true, message }) : nothing()
  if (!selection || Option.isNone(selection) || selection.value.message !== message ||
      !await issuerConfirms(challenge, receipt, email, envelope.rfcId) || !await stillCurrent()) return inactive()
  const original = await readConnectedInboxMessage(env, db, account, accepted.grant_id, { ...select, selected: envelope.id })
  if (!original || original.rfcId !== envelope.rfcId || original.receivedAt !== envelope.receivedAt || singleHeader(original.headers, "x-westvale-inbox-receipt") !== receipt) return inactive()
  const matches = (original.text ?? "").split(/\r?\n/).map((line) => /^Westvale verification code: ([0-9]{6})$/.exec(line)).filter((match) => match !== null)
  if (matches.length !== 1 || !await stillCurrent()) return inactive()
  const code = matches[0][1]
  return await issuerConfirms(challenge, receipt, email, envelope.rfcId, code) && await stillCurrent() ? response(200, { code }) : inactive()
}
