{
  "name": "@grace/cloud",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --dir ../../vendor/eliza run gen --owner cloud && pnpm --dir ../../vendor/eliza --filter @elizaos/cloud run build:worker && vibelang -p tsconfig.json",
    "dev": "pnpm build && wrangler dev --local --port 8787",
    "bundle": "pnpm build && wrangler deploy --env production --dry-run --outdir .wrangler/bundle",
    "deploy": "pnpm build && wrangler deploy --env production",
    "migrate": "pnpm build && node --env-file-if-exists=.dev.vars dist/src/migrate.js"
  },
  "dependencies": {
    "@elizaos/cloud": "link:../../vendor/eliza/packages/cloud",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13",
    "@effect/platform-node": "4.1.1"
  },
  "devDependencies": {
    "wrangler": "4.164.0",
    "vibelang": "0.0.13"
  }
}
