{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["QUINT_HOME"],
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "patches/**",
    "tsconfig.base.json",
    "vibestack/*.ts",
    "vibestack/gen/**",
    "vibestack/proof/**",
    "vibestack/std/**",
    "vibestack/testing/**",
    "vibestack/stories/**",
    "vibestack/design/**",
    "!vibestack/**/{node_modules,.cache}/**",
    "!vibestack/selftest.ts",
    "!vibestack/remote-cache.ts",
    "!vibestack/proof/lib.dfy",
    "!vibestack/{testing,stories,design}/test/**",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "gen": {
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen"
      ],
      "outputs": [
        "generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@grace/cloud#build": {
      "dependsOn": ["//#gen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vendor/eliza/tsconfig.base.json",
        "$TURBO_ROOT$/vendor/eliza/packages/{cloud,cloud-worker}/package.json",
        "$TURBO_ROOT$/vendor/eliza/packages/{cloud,cloud-worker}/tsconfig*.json",
        "$TURBO_ROOT$/vendor/eliza/packages/{cloud,cloud-worker}/src/**",
        "$TURBO_ROOT$/vendor/eliza/packages/design-system/**"
      ],
      "outputs": [
        "dist/**",
        "$TURBO_ROOT$/vendor/eliza/packages/cloud/dist/{gen,src}/**",
        "$TURBO_ROOT$/vendor/eliza/packages/cloud-worker/dist/{gen,src,pages}/**",
        "$TURBO_ROOT$/vendor/eliza/packages/design-system/generated/**"
      ]
    },
    "@grace/cloud#typecheck": {
      "dependsOn": ["@grace/cloud#build"],
      "outputs": [".vibe/declarations/**"]
    },
    "@grace/cloud#test": {
      "dependsOn": ["@grace/cloud#build"],
      "outputs": [".cache/test-result-*.json"]
    },
    "@repo/app#gen": {
      "inputs": [
        "$TURBO_ROOT$/vendor/eliza/packages/{cloud,core,os,os-bridges}/package.json",
        "$TURBO_ROOT$/vendor/eliza/packages/{cloud,core,os,os-bridges}/src/**",
        "$TURBO_ROOT$/vendor/eliza/packages/os/browser/src/**",
        "$TURBO_ROOT$/vendor/eliza/packages/{os,os-bridges,cloud}/{gen,android,aosp}/**/*.{ts,tsx,mjs,js,vibe}"
      ],
      "outputs": []
    },
    "@repo/app#build": {
      "dependsOn": ["gen", "//#gen", "^build"],
      "env": ["VITE_GRACE_CLOUD_*"],
      "outputs": ["dist/**"]
    },
    "@repo/app#typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/benchmark#test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "cache": false
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "cache": false
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "//#build"
      ],
      "cache": false
    },
    "//#gen:eliza": {
      "env": ["!VITE_*"],
      "inputs": [
        "vendor/eliza/{package.json,pnpm-lock.yaml,pnpm-workspace.yaml}",
        "vendor/eliza/{apps,packages}/*/package.json",
        "vendor/eliza/packages/{agent,core,os}/src/**",
        "vendor/eliza/packages/os/android/android-runtime-packaging.ts",
        "vendor/eliza/packages/{agent,core,os}/tsconfig*.json",
        "vendor/eliza/spec/**/*.md",
        "vendor/eliza/tsconfig.base.json",
        "vendor/eliza/vibestack/**",
        "!vendor/eliza/vibestack/**/{node_modules,.cache,.spec-cache,dist,gen}/**"
      ],
      "outputs": [
        "vendor/eliza/packages/{agent,agent-host,cloud,cloud-worker,core,core-node,os,os-bridges}/gen/**",
        "vendor/eliza/packages/{agent,core,os}/dist/{gen,src}/**",
        "vendor/eliza/packages/os/dist/android/**"
      ]
    },
    "//#gen": {
      "dependsOn": ["//#gen:eliza"],
      "env": ["!VITE_*"],
      "inputs": [
        "spec/**",
        "apps/*/package.json",
        "apps/*/spec/**",
        "packages/*/package.json",
        "packages/*/spec/**",
        "package.json"
      ],
      "outputs": [
        "gen/**",
        "apps/*/gen/**",
        "packages/*/gen/**"
      ]
    },
    "//#build": {
      "dependsOn": [
        "vibestack-studio#build"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!vibestack/fixtures/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "//#gen"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "spec/**",
        "src/**",
        "test/**"
      ],
      "outputs": []
    },
    "//#test": {
      "dependsOn": [
        "//#gen",
        "^build"
      ],
      "inputs": [
        "*",
        "!.git",
        "!*.md",
        "vibestack/**",
        "!vibestack/{examples,studio}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "spec/**",
        "!spec/**/*.md",
        "src/**",
        "test/**"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:a": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!vibestack/{studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:b": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!vibestack/{studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:rest": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        ".gitignore",
        "eslint.config.js",
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "patches/**",
        "apps/*/package.json",
        "packages/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "README.md",
        "LICENSE",
        "spec/**",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:docs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.claude/worktrees/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**"
      ],
      "outputs": []
    },
    "//#selftest:examples": {
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/{docs,tools}.ts",
        "!vibestack/{studio,fixtures}/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "package.json"
      ],
      "outputs": [
        "vibestack/examples/*/.spec-cache/tests-*.json.{gz,zst}"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#check": {
      "dependsOn": [
        "//#build",
        "//#typecheck",
        "//#test",
        "@repo/app#build",
        "@repo/app#typecheck",
        "@repo/app#test",
        "@repo/app#test:browser"
      ],
      "cache": false
    },
    "//#lint:js": {
      "dependsOn": [
        "@repo/design-system#build",
        "@repo/app#typecheck",
        "@repo/benchmark#typecheck",
        "@grace/cloud#typecheck",
        "vibestack-studio#typecheck"
      ],
      "inputs": [
        "vendor/eliza/tsconfig.base.json",
        "vendor/eliza/packages/os-bridges/tsconfig*.json",
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts"
      ],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": [
        "**/*.css",
        "!.claude/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "!vibestack/{examples,fixtures}/**",
        "stylelint.config.js",
        "package.json",
        "pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "//#analyze": {
      "dependsOn": ["//#gen", "@repo/design-system#build", "@repo/ui#gen", "vibestack-studio#gen"],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts",
        ".madgerc",
        ".jscpd.json"
      ],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "cache": false,
      "persistent": true
    },
    "@grace/cloud#dev": {
      "dependsOn": ["//#gen"],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#gen": {
      "env": ["!VITE_*"],
      "outputs": ["gen/**", "generated/**"]
    },
    "vibestack-studio#dev": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#build": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "vibestack-studio#typecheck": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "vibestack-studio#test": {
      "dependsOn": [
        "gen",
        "^build",
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/fixtures/**",
        "$TURBO_ROOT$/vibestack/proof/lib.dfy",
        "!$TURBO_ROOT$/vibestack/fixtures/**/.DS_Store"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "vibestack-studio#test:browser": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/ui#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "package.json",
        "src/**",
        "styles.css",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "@repo/ui#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/design-system#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "generated/**",
        "design.md"
      ]
    },
    "@repo/cli#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/cli#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/spec/**/*.md"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    }
  },
  "remoteCache": {
    "apiUrl": "https://vibestack-turbo-cache.shawmakesmagic.workers.dev",
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 60,
    "teamSlug": "vibestack"
  }
}
